{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.commerce.product-to-listing.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "max_attempts": 3,
  "steps": [
    {
      "step_kind": "SUBMIT_CHILD",
      "step_code": "submit_catalog",
      "step_order": 1,
      "child_skill_id": "skill.cloudmold.commerce.catalog-matrix.v1",
      "child_skill_version": "1.2.0",
      "child_run_id": "$input.runIds.catalog",
      "arguments": {
        "$object": "$input.catalog",
        "$overrides": {}
      }
    },
    {
      "step_kind": "WAIT_CHILD",
      "step_code": "wait_catalog",
      "step_order": 2,
      "poll_interval_seconds": 2,
      "arguments": ["$steps.submit_catalog.result.childTaskId"]
    },
    {
      "step_kind": "SUBMIT_CHILD",
      "step_code": "submit_master",
      "step_order": 3,
      "child_skill_id": "skill.cloudmold.commerce.reuse-ready-master.v1",
      "child_skill_version": "1.2.1",
      "child_run_id": "$input.runIds.master",
      "arguments": {
        "$object": "$input.master",
        "$overrides": {}
      }
    },
    {
      "step_kind": "WAIT_CHILD",
      "step_code": "wait_master",
      "step_order": 4,
      "poll_interval_seconds": 2,
      "arguments": ["$steps.submit_master.result.childTaskId"]
    },
    {
      "step_code": "listing_create",
      "step_order": 5,
      "capability_id": "capability.cloudmold.listing.listing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.listing.commands.0",
          "$overrides": {
            "merchantId": "$steps.wait_master.result.outputs.merchant_approve.merchantId",
            "shopId": "$steps.wait_master.result.outputs.merchant_approve.shopId",
            "canonicalSpuId": "$steps.wait_catalog.result.outputs.define_1.canonicalSpuId",
            "publisherRef": "$steps.wait_master.result.outputs.principal.principalId",
            "/offers/0/canonicalSkuId": "$steps.wait_catalog.result.outputs.define_1.canonicalSkuId",
            "/offers/1/canonicalSkuId": "$steps.wait_catalog.result.outputs.define_2.canonicalSkuId",
            "/offers/2/canonicalSkuId": "$steps.wait_catalog.result.outputs.define_3.canonicalSkuId",
            "/offers/3/canonicalSkuId": "$steps.wait_catalog.result.outputs.define_4.canonicalSkuId",
            "/offers/4/canonicalSkuId": "$steps.wait_catalog.result.outputs.define_5.canonicalSkuId",
            "/offers/5/canonicalSkuId": "$steps.wait_catalog.result.outputs.define_6.canonicalSkuId",
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "listing_submit",
      "step_order": 6,
      "capability_id": "capability.cloudmold.listing.listing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.listing.commands.1",
          "$overrides": {
            "listingId": "$steps.listing_create.result.listingId",
            "expectedVersion": 1,
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "listing_completion",
      "step_order": 7,
      "capability_id": "capability.cloudmold.listing.listing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.listing.commands.2",
          "$overrides": {
            "listingId": "$steps.listing_create.result.listingId",
            "expectedVersion": 2,
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "listing_business",
      "step_order": 8,
      "capability_id": "capability.cloudmold.listing.listing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.listing.commands.3",
          "$overrides": {
            "listingId": "$steps.listing_create.result.listingId",
            "expectedVersion": 3,
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "listing_risk",
      "step_order": 9,
      "capability_id": "capability.cloudmold.listing.listing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.listing.commands.4",
          "$overrides": {
            "listingId": "$steps.listing_create.result.listingId",
            "expectedVersion": 4,
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "listing_publish",
      "step_order": 10,
      "capability_id": "capability.cloudmold.listing.listing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.listing.commands.5",
          "$overrides": {
            "listingId": "$steps.listing_create.result.listingId",
            "expectedVersion": 5,
            "publisherRef": "$steps.wait_master.result.outputs.principal.principalId",
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_kind": "WAIT_CAPABILITY",
      "step_code": "listing_terminal_readback",
      "step_order": 11,
      "capability_id": "capability.cloudmold.listing.listing-query.get-listing-terminal-readback.v1",
      "operation_type": "READ",
      "poll_interval_seconds": 2,
      "wait_success": {
        "/overallResultCode": "CONFIRMED_PUBLISHED"
      },
      "wait_failure": {
        "/overallResultCode": ["CHANNEL_PUBLISH_FAILED"]
      },
      "arguments": [
        {
          "$object": "$input.readback",
          "$overrides": {
            "listingId": "$steps.listing_publish.result.listingId"
          }
        }
      ]
    }
  ]
}
