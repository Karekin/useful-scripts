{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.warehouse.allocation-transfer-readback.v1",
  "skill_version": "1.0.0",
  "risk_level": "R1",
  "workflow_level": "INTERNAL_SUBFLOW",
  "max_attempts": 5,
  "steps": [
    {
      "step_kind": "WAIT_CAPABILITY",
      "step_code": "inspect_allocation_transfer",
      "step_order": 1,
      "capability_id": "capability.cloudmold.integration.yudao-legacy-operations-query.get-movement-order.v1",
      "poll_interval_seconds": 30,
      "wait_success": {
        "/sourceSystem": "WMS",
        "/documentType": "MOVEMENT_ORDER",
        "/status": 4
      },
      "wait_failure": {
        "/status": [5]
      },
      "arguments": ["$input.movementOrderId"]
    }
  ]
}
