{
  "flowId": "workflow.cloudmold.erp.stock-count-approve.v1",
  "requiredInputs": ["authority", "command"],
  "steps": [
    {"id": "validate-merchant-shop", "capabilityId": "capability.cloudmold.merchant.merchant-reference-validation.require-active-reference.v1", "write": false, "arguments": ["$input.authority.reference"], "expect": {"result.merchantStatus": "ACTIVE", "result.shopStatus": "ACTIVE"}},
    {"id": "authorize-owner", "capabilityId": "capability.cloudmold.merchant.merchant-operator-authorization.require-authorized-operator.v1", "write": false, "arguments": ["$input.authority.operator"], "expect": {"result.roleCode": "OWNER", "result.assignmentStatus": "ACTIVE"}},
    {"id": "create", "capabilityId": "capability.cloudmold.integration.yudao-erp-command.create-stock-check.v1", "write": true, "arguments": ["$input.command"]},
    {"id": "approve", "capabilityId": "capability.cloudmold.integration.yudao-erp-command.set-stock-check-status.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "documentId": "$steps.create.result", "targetStatus": 20}]},
    {"id": "assert", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-stock-check.v1", "write": false, "arguments": ["$steps.create.result"], "expect": {"result.sourceSystem": "ERP", "result.documentType": "STOCK_CHECK", "result.status": 20}}
  ]
}
