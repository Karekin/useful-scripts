{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.supplier.admission-lifecycle.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "workflow_level": "BUSINESS_ROLE",
  "owner_role": "supplier-governance",
  "max_attempts": 5,
  "steps": [
    {
      "step_code": "register_supplier", "step_order": 1,
      "capability_id": "capability.cloudmold.supplier.supplier-profile-command.execute.v1",
      "operation_type": "WRITE", "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.commands.0.command", "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey"}}, "$input.commands.0.actorPrincipalId"]
    },
    {
      "step_code": "submit_admission", "step_order": 2,
      "capability_id": "capability.cloudmold.supplier.supplier-profile-command.execute.v1",
      "operation_type": "WRITE", "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.commands.1.command", "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey", "/admission/supplierId": "$steps.register_supplier.result.supplierId", "/admission/expectedVersion": "$steps.register_supplier.result.aggregateVersion"}}, "$input.commands.1.actorPrincipalId"]
    },
    {
      "step_code": "approve_admission", "step_order": 3,
      "capability_id": "capability.cloudmold.supplier.supplier-profile-command.execute.v1",
      "operation_type": "WRITE", "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.commands.2.command", "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey", "/admission/supplierId": "$steps.submit_admission.result.supplierId", "/admission/expectedVersion": "$steps.submit_admission.result.aggregateVersion"}}, "$input.commands.2.actorPrincipalId"]
    }
  ]
}
