{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.inventory.stock-transfer-lifecycle.v1",
  "skill_version": "1.0.0",
  "risk_level": "R2",
  "workflow_level": "BUSINESS_ROLE",
  "owner_role": "inventory-transfer-operator",
  "max_attempts": 5,
  "steps": [
    {
      "step_code": "dispatch_stock",
      "step_order": 1,
      "capability_id": "capability.cloudmold.inventory.inventory-stock-transfer.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.commands.0", "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey"}}]
    },
    {
      "step_code": "receive_stock",
      "step_order": 2,
      "capability_id": "capability.cloudmold.inventory.inventory-stock-transfer.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.commands.1", "$overrides": {
        "/idempotencyKey": "$task.stepIdempotencyKey",
        "/movementGroupId": "$steps.dispatch_stock.result.movementGroupId"
      }}]
    }
  ]
}
