{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.pricing.reprice-lifecycle.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "workflow_level": "BUSINESS_ROLE",
  "owner_role": "pricing-revenue-operator",
  "max_attempts": 3,
  "steps": [
    {
      "step_code": "reprice_published_listing",
      "step_order": 1,
      "capability_id": "capability.cloudmold.listing.listing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.reprice", "$overrides": {"idempotencyKey": "$task.stepIdempotencyKey"}}]
    },
    {
      "step_code": "confirm_repriced_channel_listing",
      "step_order": 2,
      "capability_id": "capability.cloudmold.listing.listing-command.record-channel-publish-receipt.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.receipt", "$overrides": {
        "listingId": "$steps.reprice_published_listing.result.listingId",
        "expectedVersion": "$steps.reprice_published_listing.result.aggregateVersion",
        "idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_kind": "WAIT_CAPABILITY",
      "step_code": "verify_repriced_listing",
      "step_order": 3,
      "capability_id": "capability.cloudmold.listing.listing-query.get-listing-terminal-readback.v1",
      "operation_type": "READ",
      "poll_interval_seconds": 2,
      "wait_success": {"/overallResultCode": "CONFIRMED_PUBLISHED"},
      "wait_failure": {"/overallResultCode": ["CHANNEL_PUBLISH_FAILED"]},
      "arguments": [{"$object": "$input.readback", "$overrides": {
        "listingId": "$steps.reprice_published_listing.result.listingId"
      }}]
    }
  ]
}
