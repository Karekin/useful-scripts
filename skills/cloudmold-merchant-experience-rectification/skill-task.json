{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.merchant-experience.rectification-lifecycle.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "workflow_level": "BUSINESS_ROLE",
  "owner_role": "merchant-experience-operator",
  "max_attempts": 3,
  "steps": [
    {
      "step_code": "validate_responsible_merchant",
      "step_order": 1,
      "capability_id": "capability.cloudmold.merchant.merchant-reference-validation.require-active-reference.v1",
      "operation_type": "READ",
      "arguments": ["$input.merchantReference"]
    },
    {
      "step_code": "open_merchant_rectification_case",
      "step_order": 2,
      "capability_id": "capability.cloudmold.operationsintelligence.operations-intelligence-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.operationsCommands.0", "$overrides": {
        "/runId": "$task.runId",
        "/idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_code": "notice_merchant_rectification_case",
      "step_order": 3,
      "capability_id": "capability.cloudmold.operationsintelligence.operations-intelligence-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.operationsCommands.1", "$overrides": {
        "/runId": "$task.runId",
        "/alert/alertId": "$steps.open_merchant_rectification_case.result.aggregateId",
        "/idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_code": "claim_merchant_rectification_case",
      "step_order": 4,
      "capability_id": "capability.cloudmold.operationsintelligence.operations-intelligence-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.operationsCommands.2", "$overrides": {
        "/runId": "$task.runId",
        "/alert/alertId": "$steps.open_merchant_rectification_case.result.aggregateId",
        "/idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_code": "reopen_consumer_ticket",
      "step_order": 5,
      "capability_id": "capability.cloudmold.customerservice.customer-service-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.ticketCommands.0", "$overrides": {
        "ticketId": "$input.ticketId",
        "expectedVersion": 5,
        "idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_code": "notify_rectification_progress",
      "step_order": 6,
      "capability_id": "capability.cloudmold.customerservice.customer-service-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.ticketCommands.1", "$overrides": {
        "ticketId": "$input.ticketId",
        "expectedVersion": 6,
        "idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_code": "resolve_recovered_experience",
      "step_order": 7,
      "capability_id": "capability.cloudmold.customerservice.customer-service-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.ticketCommands.2", "$overrides": {
        "ticketId": "$input.ticketId",
        "expectedVersion": 6,
        "idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_code": "verify_merchant_rectification",
      "step_order": 8,
      "capability_id": "capability.cloudmold.customerservice.customer-service-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.ticketCommands.3", "$overrides": {
        "ticketId": "$input.ticketId",
        "expectedVersion": 7,
        "idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_code": "collect_recovery_feedback",
      "step_order": 9,
      "capability_id": "capability.cloudmold.customerservice.customer-service-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.ticketCommands.4", "$overrides": {
        "ticketId": "$input.ticketId",
        "expectedVersion": 7,
        "idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_code": "close_recovered_ticket",
      "step_order": 10,
      "capability_id": "capability.cloudmold.customerservice.customer-service-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.ticketCommands.5", "$overrides": {
        "ticketId": "$input.ticketId",
        "expectedVersion": 7,
        "idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_code": "resolve_merchant_rectification_case",
      "step_order": 11,
      "capability_id": "capability.cloudmold.operationsintelligence.operations-intelligence-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.operationsCommands.3", "$overrides": {
        "/runId": "$task.runId",
        "/alert/alertId": "$steps.open_merchant_rectification_case.result.aggregateId",
        "/idempotencyKey": "$task.stepIdempotencyKey"
      }}]
    },
    {
      "step_kind": "WAIT_CAPABILITY",
      "step_code": "verify_merchant_rectification_case",
      "step_order": 12,
      "capability_id": "capability.cloudmold.operationsintelligence.operations-intelligence-query.get-alert.v1",
      "operation_type": "READ",
      "poll_interval_seconds": 2,
      "wait_success": {"/status": "RESOLVED", "/aggregateVersion": 4},
      "wait_failure": {"/status": ["INVALID", "CLOSED_NO_ACTION"]},
      "arguments": ["$steps.open_merchant_rectification_case.result.aggregateId"]
    },
    {
      "step_kind": "WAIT_CAPABILITY",
      "step_code": "verify_recovered_ticket",
      "step_order": 13,
      "capability_id": "capability.cloudmold.customerservice.customer-service-query.get-ticket.v1",
      "operation_type": "READ",
      "poll_interval_seconds": 2,
      "wait_success": {"/ticketStatus": "CLOSED"},
      "wait_failure": {"/ticketStatus": ["FAILED", "CANCELLED"]},
      "arguments": ["$input.ticketId"]
    }
  ]
}
