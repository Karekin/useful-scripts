{
  "flowId": "workflow.cloudmold.wms.physical-full-chain.v1",
  "requiredInputs": ["authority", "merchant", "sourceWarehouse", "targetWarehouse", "category", "item", "receipt", "movement", "shipment", "check"],
  "steps": [
    {"id": "validate-merchant-shop", "capabilityId": "capability.cloudmold.merchant.merchant-reference-validation.require-active-reference.v1", "write": false, "arguments": ["$input.authority.reference"], "expect": {"result.merchantStatus": "ACTIVE", "result.shopStatus": "ACTIVE"}},
    {"id": "authorize-owner", "capabilityId": "capability.cloudmold.merchant.merchant-operator-authorization.require-authorized-operator.v1", "write": false, "arguments": ["$input.authority.operator"], "expect": {"result.roleCode": "OWNER", "result.assignmentStatus": "ACTIVE"}},
    {"id": "create-merchant", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.create-merchant.v1", "write": true, "arguments": [{"idempotencyKey": "$input.merchant.code", "code": "$input.merchant.code", "name": "$input.merchant.name", "type": "$input.merchant.type", "level": "$input.merchant.level", "address": "$input.merchant.address", "mobile": "$input.merchant.mobile", "contact": "$input.merchant.contact", "email": "$input.merchant.email", "remark": "$input.merchant.remark"}]},
    {"id": "create-source-warehouse", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.create-warehouse.v1", "write": true, "arguments": [{"idempotencyKey": "$input.sourceWarehouse.code", "code": "$input.sourceWarehouse.code", "name": "$input.sourceWarehouse.name", "sort": "$input.sourceWarehouse.sort", "remark": "$input.sourceWarehouse.remark"}]},
    {"id": "create-target-warehouse", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.create-warehouse.v1", "write": true, "arguments": [{"idempotencyKey": "$input.targetWarehouse.code", "code": "$input.targetWarehouse.code", "name": "$input.targetWarehouse.name", "sort": "$input.targetWarehouse.sort", "remark": "$input.targetWarehouse.remark"}]},
    {"id": "create-category", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.create-item-category.v1", "write": true, "arguments": [{"idempotencyKey": "$input.category.code", "parentId": "$input.category.parentId", "code": "$input.category.code", "name": "$input.category.name", "sort": "$input.category.sort", "status": "$input.category.status"}]},
    {"id": "create-item", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.create-item.v1", "write": true, "arguments": [{"idempotencyKey": "$input.item.code", "code": "$input.item.code", "name": "$input.item.name", "categoryId": "$steps.create-category.result", "unit": "$input.item.unit", "remark": "$input.item.remark", "skus": "$input.item.skus"}]},
    {"id": "resolve-sku", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-wms-item-sku.v1", "write": false, "arguments": ["$steps.create-item.result"], "expect": {"result.itemCode": "CMITEM0718A", "result.skuCode": "CMSKU0718A"}},
    {"id": "create-receipt", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.create-receipt-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "no": "$input.receipt.no", "type": 101, "orderTime": "$input.receipt.orderTime", "bizOrderNo": "$input.receipt.bizOrderNo", "merchantId": "$steps.create-merchant.result", "remark": "$input.receipt.remark", "warehouseId": "$steps.create-source-warehouse.result", "details": [{"skuId": "$steps.resolve-sku.result.skuId", "quantity": 10, "price": 39.8, "totalPrice": 398}]}]},
    {"id": "complete-receipt", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.complete-receipt-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "documentId": "$steps.create-receipt.result"}]},
    {"id": "assert-receipt", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-receipt-order.v1", "write": false, "arguments": ["$steps.create-receipt.result"], "expect": {"result.sourceSystem": "WMS", "result.documentType": "RECEIPT_ORDER", "result.status": 4, "result.quantity": 10}},
    {"id": "source-inventory", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-wms-inventory.v1", "write": false, "arguments": ["$steps.create-source-warehouse.result", "$steps.resolve-sku.result.skuId"]},
    {"id": "create-movement", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.create-movement-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "no": "$input.movement.no", "orderTime": "$input.movement.orderTime", "remark": "$input.movement.remark", "sourceWarehouseId": "$steps.create-source-warehouse.result", "targetWarehouseId": "$steps.create-target-warehouse.result", "details": [{"skuId": "$steps.resolve-sku.result.skuId", "quantity": 3, "price": 39.8, "totalPrice": 119.4}]}]},
    {"id": "complete-movement", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.complete-movement-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "documentId": "$steps.create-movement.result"}]},
    {"id": "assert-movement", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-movement-order.v1", "write": false, "arguments": ["$steps.create-movement.result"], "expect": {"result.sourceSystem": "WMS", "result.documentType": "MOVEMENT_ORDER", "result.status": 4, "result.quantity": 3}},
    {"id": "target-inventory-after-movement", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-wms-inventory.v1", "write": false, "arguments": ["$steps.create-target-warehouse.result", "$steps.resolve-sku.result.skuId"]},
    {"id": "create-shipment", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.create-shipment-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "no": "$input.shipment.no", "type": 201, "orderTime": "$input.shipment.orderTime", "bizOrderNo": "$input.shipment.bizOrderNo", "merchantId": "$steps.create-merchant.result", "remark": "$input.shipment.remark", "warehouseId": "$steps.create-target-warehouse.result", "details": [{"skuId": "$steps.resolve-sku.result.skuId", "quantity": 2, "price": 39.8, "totalPrice": 79.6}]}]},
    {"id": "complete-shipment", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.complete-shipment-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "documentId": "$steps.create-shipment.result"}]},
    {"id": "assert-shipment", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-shipment-order.v1", "write": false, "arguments": ["$steps.create-shipment.result"], "expect": {"result.sourceSystem": "WMS", "result.documentType": "SHIPMENT_ORDER", "result.status": 4, "result.quantity": 2}},
    {"id": "target-inventory-after-shipment", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-wms-inventory.v1", "write": false, "arguments": ["$steps.create-target-warehouse.result", "$steps.resolve-sku.result.skuId"], "expect": {"result.quantity": 1}},
    {"id": "create-check", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.create-check-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "no": "$input.check.no", "orderTime": "$input.check.orderTime", "remark": "$input.check.remark", "warehouseId": "$steps.create-target-warehouse.result", "details": [{"skuId": "$steps.resolve-sku.result.skuId", "inventoryId": "$steps.target-inventory-after-shipment.result.inventoryId", "receiptTime": "$input.check.receiptTime", "quantity": 1, "checkQuantity": 1, "price": 39.8}]}]},
    {"id": "complete-check", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.complete-check-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "documentId": "$steps.create-check.result"}]},
    {"id": "assert-check", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-check-order.v1", "write": false, "arguments": ["$steps.create-check.result"], "expect": {"result.sourceSystem": "WMS", "result.documentType": "CHECK_ORDER", "result.status": 4, "result.quantity": 0}},
    {"id": "final-source-inventory", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-wms-inventory.v1", "write": false, "arguments": ["$steps.create-source-warehouse.result", "$steps.resolve-sku.result.skuId"], "expect": {"result.quantity": 7}},
    {"id": "final-target-inventory", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-wms-inventory.v1", "write": false, "arguments": ["$steps.create-target-warehouse.result", "$steps.resolve-sku.result.skuId"], "expect": {"result.quantity": 1}}
  ]
}
