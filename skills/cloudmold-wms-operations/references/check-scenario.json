{
  "flowId": "workflow.cloudmold.wms.check-complete.v1",
  "requiredInputs": ["authority", "command"],
  "steps": [
    {"id": "validate-merchant-shop", "capabilityId": "capability.cloudmold.merchant.merchant-reference-validation.require-active-reference.v1", "write": false, "arguments": ["$input.authority.reference"], "expect": {"result.merchantStatus": "ACTIVE", "result.shopStatus": "ACTIVE"}},
    {"id": "authorize-owner", "capabilityId": "capability.cloudmold.merchant.merchant-operator-authorization.require-authorized-operator.v1", "write": false, "arguments": ["$input.authority.operator"], "expect": {"result.roleCode": "OWNER", "result.assignmentStatus": "ACTIVE"}},
    {"id": "create", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.create-check-order.v1", "write": true, "arguments": ["$input.command"]},
    {"id": "complete", "capabilityId": "capability.cloudmold.integration.yudao-wms-command.complete-check-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "documentId": "$steps.create.result"}]},
    {"id": "assert", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-check-order.v1", "write": false, "arguments": ["$steps.create.result"], "expect": {"result.sourceSystem": "WMS", "result.documentType": "CHECK_ORDER", "result.status": 4}}
  ]
}
