        "actorPrincipalId": "$input.independentReviewerPrincipalId",
        "expectedVersion": 2
      }}]
    },
    {
      "step_code": "verify_publication_disclosure",
      "step_order": 15,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.partnerMarketingCommands.7", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "actorPrincipalId": "$input.independentReviewerPrincipalId",
        "/publication/caseId": "$steps.open_candidate_case.result.caseId",
        "/publication/expectedVersion": "$steps.approve_content.result.aggregateVersion",
        "/publication/externalPublishRef": "$steps.community_create.result.aggregateId"
      }}]
    },
    {
      "step_kind": "SUBMIT_CHILD",
      "step_code": "submit_consumer_validation",
      "step_order": 16,
      "child_skill_id": "skill.cloudmold.consumer.shopping-journey.v1",
      "child_skill_version": "1.1.1",
      "arguments": {"$object": "$input.consumer", "$overrides": {
        "listingId": "$steps.wait_product_launch.result.outputs.listing_create.listingId",
        "/behaviorCommands/4/canonicalSpuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSpuId",
        "/behaviorCommands/4/skuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "/behaviorCommands/4/listingId": "$steps.wait_product_launch.result.outputs.listing_create.listingId",
        "/behaviorCommands/4/listingOfferId": "$steps.wait_product_launch.result.outputs.listing_create.offers.0.listingOfferId",
        "/behaviorCommands/5/canonicalSpuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSpuId",
        "/behaviorCommands/5/skuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "/behaviorCommands/5/listingId": "$steps.wait_product_launch.result.outputs.listing_create.listingId",
        "/behaviorCommands/5/listingOfferId": "$steps.wait_product_launch.result.outputs.listing_create.offers.0.listingOfferId",
        "/favoriteCommand/canonicalSpuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSpuId",
        "/behaviorCommands/6/canonicalSpuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSpuId",
        "/behaviorCommands/6/skuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "/behaviorCommands/6/listingId": "$steps.wait_product_launch.result.outputs.listing_create.listingId",
        "/behaviorCommands/6/listingOfferId": "$steps.wait_product_launch.result.outputs.listing_create.offers.0.listingOfferId",
        "/behaviorCommands/7/canonicalSpuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSpuId",
        "/behaviorCommands/7/skuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "/behaviorCommands/7/listingId": "$steps.wait_product_launch.result.outputs.listing_create.listingId",
        "/behaviorCommands/7/listingOfferId": "$steps.wait_product_launch.result.outputs.listing_create.offers.0.listingOfferId",
        "/commands/0/ownerId": "$steps.wait_product_launch.result.outputs.wait_master.outputs.merchant_approve.merchantId",
        "/commands/0/canonicalSkuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "/commands/0/warehouseId": "$steps.wait_product_launch.result.outputs.wait_master.outputs.warehouse_network.warehouseId",
        "/commands/1/items/0/canonicalSkuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "/commands/1/items/0/listingId": "$steps.wait_product_launch.result.outputs.listing_create.listingId",
        "/commands/1/items/0/listingOfferId": "$steps.wait_product_launch.result.outputs.listing_create.offers.0.listingOfferId",
        "/commands/2/ownerId": "$steps.wait_product_launch.result.outputs.wait_master.outputs.merchant_approve.merchantId",
        "/commands/2/canonicalSkuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "/commands/2/warehouseId": "$steps.wait_product_launch.result.outputs.wait_master.outputs.warehouse_network.warehouseId",
        "/commands/6/sellerId": "$steps.wait_product_launch.result.outputs.wait_master.outputs.merchant_approve.merchantId",
        "/commands/6/warehouseId": "$steps.wait_product_launch.result.outputs.wait_master.outputs.warehouse_network.warehouseId",
        "/commands/6/items/0/canonicalSkuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "/commands/7/ownerId": "$steps.wait_product_launch.result.outputs.wait_master.outputs.merchant_approve.merchantId",
        "/commands/7/canonicalSkuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "/commands/7/warehouseId": "$steps.wait_product_launch.result.outputs.wait_master.outputs.warehouse_network.warehouseId",
        "/customerServiceCommands/3/assignedAgentPrincipalId": "$input.operatorPrincipalId",
        "/communityCommands/0/canonicalSpuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSpuId",
        "/communityCommands/0/canonicalSkuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "/communityCommands/0/listingId": "$steps.wait_product_launch.result.outputs.listing_create.listingId",
        "/communityCommands/0/listingOfferId": "$steps.wait_product_launch.result.outputs.listing_create.offers.0.listingOfferId",
        "/communityCommands/2/actorPrincipalId": "$input.operatorPrincipalId"
      }}
    },
    {
      "step_kind": "WAIT_CHILD",
      "step_code": "wait_consumer_validation",
      "step_order": 17,
      "arguments": ["$steps.submit_consumer_validation.result.childTaskId"]
    },
    {
      "step_code": "reconcile_attribution",
      "step_order": 18,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.partnerMarketingCommands.8", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "actorPrincipalId": "$input.operatorPrincipalId",
        "/attribution/caseId": "$steps.open_candidate_case.result.caseId",
        "/attribution/expectedVersion": "$steps.verify_publication_disclosure.result.aggregateVersion",
        "/attribution/attributedOrderId": "$steps.wait_consumer_validation.result.outputs.order_place.orderId",
        "/attribution/attributedPaymentId": "$steps.wait_consumer_validation.result.outputs.payment_capture.paymentId"
      }}]
    },
    {
      "step_code": "approve_settlement",
      "step_order": 19,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.partnerMarketingCommands.9", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "actorPrincipalId": "$input.independentReviewerPrincipalId",
        "/settlementApproval/caseId": "$steps.open_candidate_case.result.caseId",
        "/settlementApproval/expectedVersion": "$steps.reconcile_attribution.result.aggregateVersion"
      }}]
    },
    {
      "step_code": "mark_settlement_paid",
      "step_order": 20,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.partnerMarketingCommands.10", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "actorPrincipalId": "$input.financePrincipalId",
        "/settlementPayment/caseId": "$steps.open_candidate_case.result.caseId",
        "/settlementPayment/expectedVersion": "$steps.approve_settlement.result.aggregateVersion"
      }}]
    },
    {
      "step_code": "close_case",
      "step_order": 21,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.partnerMarketingCommands.11", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "actorPrincipalId": "$input.operatorPrincipalId",
        "/caseClose/caseId": "$steps.open_candidate_case.result.caseId",
        "/caseClose/expectedVersion": "$steps.mark_settlement_paid.result.aggregateVersion"
      }}]
    },
    {
      "step_kind": "WAIT_CAPABILITY",
      "step_code": "verify_partner_marketing_closed",
      "step_order": 22,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-query.get-workflow.v1",
      "operation_type": "READ",
      "poll_interval_seconds": 2,
      "wait_success": {
        "/status": "SUCCEEDED",
        "/currentStatus": "CLOSED",
        "/terminal": true,
        "/aggregateVersion": 12
      },
      "wait_failure": {"/status": ["FAILED"]},
      "arguments": ["$steps.open_candidate_case.result.caseId"]
    }
  ]
}
