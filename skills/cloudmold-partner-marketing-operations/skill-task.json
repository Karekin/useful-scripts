{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.partner-marketing.kol-media-operations.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "workflow_level": "BUSINESS_ROLE",
  "owner_role": "partner-marketing-operations",
  "max_attempts": 3,
  "steps": [
    {
      "step_kind": "SUBMIT_CHILD",
      "step_code": "submit_product_launch",
      "step_order": 1,
      "child_skill_id": "skill.cloudmold.commerce.product-to-listing.v1",
      "child_skill_version": "1.1.0",
      "arguments": {"$object": "$input.product", "$overrides": {}}
    },
    {
      "step_kind": "WAIT_CHILD",
      "step_code": "wait_product_launch",
      "step_order": 2,
      "arguments": ["$steps.submit_product_launch.result.childTaskId"]
    },
    {
      "step_kind": "SUBMIT_CHILD",
      "step_code": "submit_placement_campaign",
      "step_order": 3,
      "child_skill_id": "skill.cloudmold.engagement.promotion-campaign-operations.v1",
      "child_skill_version": "1.0.0",
      "arguments": {"$object": "$input.campaign", "$overrides": {
        "/campaignCommand/sourceId": "$input.partnerMarketingCommands.0.candidateCase.caseCode"
      }}
    },
    {
      "step_kind": "WAIT_CHILD",
      "step_code": "wait_placement_campaign",
      "step_order": 4,
      "arguments": ["$steps.submit_placement_campaign.result.childTaskId"]
    },
    {
      "step_code": "open_candidate_case",
      "step_order": 5,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.partnerMarketingCommands.0", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "/candidateCase/creatorPrincipalId": "$input.operatorPrincipalId",
        "actorPrincipalId": "$input.operatorPrincipalId"
      }}]
    },
    {
      "step_code": "qualify_candidate",
      "step_order": 6,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.partnerMarketingCommands.1", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "actorPrincipalId": "$input.operatorPrincipalId",
        "/qualification/caseId": "$steps.open_candidate_case.result.caseId",
        "/qualification/expectedVersion": "$steps.open_candidate_case.result.aggregateVersion"
      }}]
    },
    {
      "step_code": "start_outreach",
      "step_order": 7,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.partnerMarketingCommands.2", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "actorPrincipalId": "$input.operatorPrincipalId",
        "/outreach/caseId": "$steps.open_candidate_case.result.caseId",
        "/outreach/expectedVersion": "$steps.qualify_candidate.result.aggregateVersion"
      }}]
    },
    {
      "step_code": "submit_brief",
      "step_order": 8,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.partnerMarketingCommands.3", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "actorPrincipalId": "$input.operatorPrincipalId",
        "/brief/caseId": "$steps.open_candidate_case.result.caseId",
        "/brief/expectedVersion": "$steps.start_outreach.result.aggregateVersion",
        "/brief/campaignId": "$steps.wait_placement_campaign.result.outputs.campaign_activate.aggregateId",
        "/brief/listingId": "$steps.wait_product_launch.result.outputs.listing_create.listingId"
