      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.communityCommands.0", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "authorPrincipalId": "$input.operatorPrincipalId",
        "canonicalSpuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSpuId",
        "canonicalSkuId": "$steps.wait_product_launch.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
        "listingId": "$steps.wait_product_launch.result.outputs.listing_create.listingId",
        "listingOfferId": "$steps.wait_product_launch.result.outputs.listing_create.offers.0.listingOfferId"
      }}]
    },
    {
      "step_code": "community_submit",
      "step_order": 11,
      "capability_id": "capability.cloudmold.engagement.engagement-command.transition-community-content.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.communityCommands.1", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "contentId": "$steps.community_create.result.aggregateId",
        "actorPrincipalId": "$input.operatorPrincipalId",
        "expectedVersion": 1
      }}]
    },
    {
      "step_code": "submit_content",
      "step_order": 12,
      "capability_id": "capability.cloudmold.partnermarketing.partner-marketing-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.partnerMarketingCommands.5", "$overrides": {
        "runId": "$task.runId",
        "idempotencyKey": "$task.stepIdempotencyKey",
