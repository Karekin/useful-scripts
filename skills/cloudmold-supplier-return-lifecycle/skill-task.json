{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.supply.supplier-return-lifecycle.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "workflow_level": "BUSINESS_ROLE",
  "owner_role": "supplier-return-operator",
  "max_attempts": 5,
  "steps": [
    {
      "step_code": "create_return_draft", "step_order": 1,
      "capability_id": "capability.cloudmold.warehouse.supplier-return-command.execute.v1",
      "operation_type": "WRITE", "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.commands.0.command", "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey"}}, "$input.commands.0.actorPrincipalId"]
    },
    {
      "step_code": "submit_return", "step_order": 2,
      "capability_id": "capability.cloudmold.warehouse.supplier-return-command.execute.v1",
      "operation_type": "WRITE", "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.commands.1.command", "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey", "/returnId": "$steps.create_return_draft.result.returnId", "/expectedVersion": "$steps.create_return_draft.result.aggregateVersion"}}, "$input.commands.1.actorPrincipalId"]
    },
    {
      "step_code": "approve_return", "step_order": 3,
      "capability_id": "capability.cloudmold.warehouse.supplier-return-command.execute.v1",
      "operation_type": "WRITE", "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.commands.2.command", "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey", "/returnId": "$steps.submit_return.result.returnId", "/expectedVersion": "$steps.submit_return.result.aggregateVersion"}}, "$input.commands.2.actorPrincipalId"]
    },
    {
      "step_code": "dispatch_return", "step_order": 4,
      "capability_id": "capability.cloudmold.warehouse.supplier-return-command.execute.v1",
      "operation_type": "WRITE", "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.commands.3.command", "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey", "/returnId": "$steps.approve_return.result.returnId", "/expectedVersion": "$steps.approve_return.result.aggregateVersion"}}, "$input.commands.3.actorPrincipalId"]
    },
    {
      "step_code": "complete_return", "step_order": 5,
      "capability_id": "capability.cloudmold.warehouse.supplier-return-command.execute.v1",
      "operation_type": "WRITE", "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{"$object": "$input.commands.4.command", "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey", "/returnId": "$steps.dispatch_return.result.returnId", "/expectedVersion": "$steps.dispatch_return.result.aggregateVersion"}}, "$input.commands.4.actorPrincipalId"]
    },
    {
      "step_code": "post_supplier_return_reversal", "step_order": 6,
      "capability_id": "capability.cloudmold.finance.supplier-return-reversal-command.post.v1",
      "operation_type": "WRITE", "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/envelope/idempotencyKey"},
      "arguments": [{"$object": "$input.financeReversal.command", "$overrides": {"/envelope/idempotencyKey": "$task.stepIdempotencyKey", "/envelope/runId": "$task.runId", "/supplierReturnId": "$steps.complete_return.result.returnId", "/expectedSupplierReturnVersion": "$steps.complete_return.result.aggregateVersion"}}, "$input.financeReversal.actorPrincipalId"]
    },
    {
      "step_code": "verify_return", "step_order": 7,
      "capability_id": "capability.cloudmold.warehouse.supplier-return-query.require-by-return-id.v1",
      "operation_type": "READ", "approval_required": false,
      "arguments": ["$steps.complete_return.result.returnId"]
    }
  ]
}
