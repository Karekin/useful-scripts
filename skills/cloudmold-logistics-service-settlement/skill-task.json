{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.finance.logistics-service-settlement-lifecycle.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "workflow_level": "BUSINESS_ROLE",
  "owner_role": "logistics-settlement-operator",
  "max_attempts": 3,
  "steps": [
    {
      "step_kind": "SUBMIT_CHILD",
      "step_code": "submit_logistics_settlement",
      "step_order": 1,
      "child_skill_id": "skill.cloudmold.finance.close-lifecycle.v1",
      "child_skill_version": "1.0.0",
      "child_run_id": "$input.runIds.settlement",
      "arguments": {"$object": "$input.settlement", "$overrides": {}}
    },
    {
      "step_kind": "WAIT_CHILD",
      "step_code": "wait_logistics_settlement",
      "step_order": 2,
      "poll_interval_seconds": 2,
      "arguments": ["$steps.submit_logistics_settlement.result.childTaskId"]
    }
  ]
}
