{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.finance.close-lifecycle.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "workflow_level": "BUSINESS_ROLE",
  "owner_role": "finance-operations",
  "max_attempts": 3,
  "steps": [
    {
      "step_code": "link_finance_maker",
      "step_order": 1,
      "capability_id": "capability.cloudmold.identity.identity-command.link-source.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.makerIdentityCommand",
        "$overrides": {"idempotencyKey": "$task.stepIdempotencyKey"}
      }]
    },
    {
      "step_code": "link_finance_checker",
      "step_order": 2,
      "capability_id": "capability.cloudmold.identity.identity-command.link-source.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.checkerIdentityCommand",
        "$overrides": {"idempotencyKey": "$task.stepIdempotencyKey"}
      }]
    },
    {
      "step_code": "open_period",
      "step_order": 3,
      "capability_id": "capability.cloudmold.finance.finance-close-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.0",
        "$overrides": {"idempotencyKey": "$task.stepIdempotencyKey"}
      }, "$steps.link_finance_maker.result.principalId"]
    },
    {
      "step_code": "import_statement",
      "step_order": 4,
      "capability_id": "capability.cloudmold.finance.finance-close-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.1",
        "$overrides": {
          "idempotencyKey": "$task.stepIdempotencyKey",
          "/statement/periodId": "$steps.open_period.result.periodId"
        }
      }, "$steps.link_finance_maker.result.principalId"]
    },
    {
      "step_code": "reconcile_statement",
      "step_order": 5,
      "capability_id": "capability.cloudmold.finance.finance-close-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.2",
        "$overrides": {
          "idempotencyKey": "$task.stepIdempotencyKey",
          "/statement/statementId": "$steps.import_statement.result.statementId"
        }
      }, "$steps.link_finance_maker.result.principalId"]
    },
    {
      "step_code": "resolve_difference",
      "step_order": 6,
      "capability_id": "capability.cloudmold.finance.finance-close-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.3",
        "$overrides": {
          "idempotencyKey": "$task.stepIdempotencyKey",
          "/differenceResolution/differenceId": "$steps.reconcile_statement.result.differenceId"
        }
      }, "$steps.link_finance_checker.result.principalId"]
    },
    {
      "step_code": "create_settlement",
      "step_order": 7,
      "capability_id": "capability.cloudmold.finance.finance-close-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.4",
        "$overrides": {
          "idempotencyKey": "$task.stepIdempotencyKey",
          "/settlement/periodId": "$steps.open_period.result.periodId",
          "/settlement/statementId": "$steps.import_statement.result.statementId"
        }
      }, "$steps.link_finance_maker.result.principalId"]
    },
    {
      "step_code": "confirm_settlement",
      "step_order": 8,
      "capability_id": "capability.cloudmold.finance.finance-close-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.5",
        "$overrides": {
          "idempotencyKey": "$task.stepIdempotencyKey",
          "/settlement/settlementBatchId": "$steps.create_settlement.result.settlementBatchId"
        }
      }, "$steps.link_finance_checker.result.principalId"]
    },
    {
      "step_code": "prepare_journal",
      "step_order": 9,
      "capability_id": "capability.cloudmold.finance.finance-close-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.6",
        "$overrides": {
          "idempotencyKey": "$task.stepIdempotencyKey",
          "/journalEntry/periodId": "$steps.open_period.result.periodId",
          "/journalEntry/sourceId": "$steps.create_settlement.result.settlementBatchId"
        }
      }, "$steps.link_finance_maker.result.principalId"]
    },
    {
      "step_code": "post_journal",
      "step_order": 10,
      "capability_id": "capability.cloudmold.finance.finance-close-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.7",
        "$overrides": {
          "idempotencyKey": "$task.stepIdempotencyKey",
          "/journalEntry/journalEntryId": "$steps.prepare_journal.result.journalEntryId"
        }
      }, "$steps.link_finance_checker.result.principalId"]
    },
    {
      "step_code": "close_period",
      "step_order": 11,
      "capability_id": "capability.cloudmold.finance.finance-close-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.8",
        "$overrides": {
          "idempotencyKey": "$task.stepIdempotencyKey",
          "/period/periodId": "$steps.open_period.result.periodId"
        }
      }, "$steps.link_finance_checker.result.principalId"]
    },
    {
      "step_code": "verify_closed_period",
      "step_order": 12,
      "step_kind": "WAIT_CAPABILITY",
      "capability_id": "capability.cloudmold.finance.finance-close-query.require-period.v1",
      "poll_interval_seconds": 2,
      "wait_success": {"/status": "CLOSED"},
      "wait_failure": {"/status": ["FAILED", "CANCELLED"]},
      "arguments": ["$steps.open_period.result.periodId"]
    }
  ]
}
