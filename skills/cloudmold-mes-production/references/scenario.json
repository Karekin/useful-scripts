{
  "flowId": "workflow.cloudmold.mes.work-order-complete.v2",
  "requiredInputs": ["authority", "unitMeasure", "itemType", "item", "workOrder"],
  "steps": [
    {"id": "validate-merchant-shop", "capabilityId": "capability.cloudmold.merchant.merchant-reference-validation.require-active-reference.v1", "write": false, "arguments": ["$input.authority.reference"], "expect": {"result.merchantStatus": "ACTIVE", "result.shopStatus": "ACTIVE"}},
    {"id": "authorize-owner", "capabilityId": "capability.cloudmold.merchant.merchant-operator-authorization.require-authorized-operator.v1", "write": false, "arguments": ["$input.authority.operator"], "expect": {"result.roleCode": "OWNER", "result.assignmentStatus": "ACTIVE"}},
    {"id": "create-unit-measure", "capabilityId": "capability.cloudmold.integration.yudao-mes-command.create-unit-measure.v1", "write": true, "arguments": [{"idempotencyKey": "$input.unitMeasure.code", "code": "$input.unitMeasure.code", "name": "$input.unitMeasure.name", "primaryFlag": "$input.unitMeasure.primaryFlag", "primaryId": "$input.unitMeasure.primaryId", "changeRate": "$input.unitMeasure.changeRate", "status": "$input.unitMeasure.status", "remark": "$input.unitMeasure.remark"}]},
    {"id": "create-item-type", "capabilityId": "capability.cloudmold.integration.yudao-mes-command.create-item-type.v1", "write": true, "arguments": [{"idempotencyKey": "$input.itemType.code", "parentId": "$input.itemType.parentId", "code": "$input.itemType.code", "name": "$input.itemType.name", "itemOrProduct": "$input.itemType.itemOrProduct", "sort": "$input.itemType.sort", "status": "$input.itemType.status", "remark": "$input.itemType.remark"}]},
    {"id": "create-item", "capabilityId": "capability.cloudmold.integration.yudao-mes-command.create-item.v1", "write": true, "arguments": [{"idempotencyKey": "$input.item.code", "code": "$input.item.code", "name": "$input.item.name", "specification": "$input.item.specification", "unitMeasureId": "$steps.create-unit-measure.result", "itemTypeId": "$steps.create-item-type.result", "safeStockFlag": "$input.item.safeStockFlag", "minStock": "$input.item.minStock", "maxStock": "$input.item.maxStock", "highValue": "$input.item.highValue", "batchFlag": "$input.item.batchFlag", "remark": "$input.item.remark"}]},
    {"id": "create-work-order", "capabilityId": "capability.cloudmold.integration.yudao-mes-command.create-work-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "code": "$input.workOrder.code", "name": "$input.workOrder.name", "type": "$input.workOrder.type", "orderSourceType": "$input.workOrder.orderSourceType", "orderSourceCode": "$input.workOrder.orderSourceCode", "productId": "$steps.create-item.result", "quantity": "$input.workOrder.quantity", "clientId": "$input.workOrder.clientId", "vendorId": "$input.workOrder.vendorId", "batchCode": "$input.workOrder.batchCode", "requestDate": "$input.workOrder.requestDate", "parentId": "$input.workOrder.parentId", "remark": "$input.workOrder.remark"}]},
    {"id": "confirm-work-order", "capabilityId": "capability.cloudmold.integration.yudao-mes-command.confirm-work-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "documentId": "$steps.create-work-order.result"}]},
    {"id": "finish-work-order", "capabilityId": "capability.cloudmold.integration.yudao-mes-command.finish-work-order.v1", "write": true, "arguments": [{"idempotencyKey": "$idempotency.key", "documentId": "$steps.create-work-order.result"}]},
    {"id": "assert-work-order", "capabilityId": "capability.cloudmold.integration.yudao-legacy-operations-query.get-work-order.v1", "write": false, "arguments": ["$steps.create-work-order.result"], "expect": {"result.sourceSystem": "MES", "result.documentType": "WORK_ORDER", "result.status": 2, "result.quantity": 2}}
  ]
}
