{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.consumer.paid-unshipped-order-scenario.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "workflow_level": "INTERNAL_SUBFLOW",
  "max_attempts": 3,
  "steps": [
    {
      "step_code": "consumer_principal",
      "step_order": 1,
      "capability_id": "capability.cloudmold.identity.identity-query.resolve-active-source.v1",
      "operation_type": "READ",
      "arguments": [
        {
          "$object": "$input.identityReference",
          "$overrides": {}
        }
      ]
    },
    {
      "step_code": "listing_published",
      "step_order": 2,
      "capability_id": "capability.cloudmold.listing.app-listing-query.require-published.v1",
      "operation_type": "READ",
      "arguments": [
        "$input.listingId"
      ]
    },
    {
      "step_code": "inventory_receive",
      "step_order": 3,
      "capability_id": "capability.cloudmold.inventory.inventory-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.commands.0",
          "$overrides": {
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "order_place",
      "step_order": 4,
      "capability_id": "capability.cloudmold.order.order-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.commands.1",
          "$overrides": {
            "buyerId": "$steps.consumer_principal.result.principalId",
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "inventory_reserve",
      "step_order": 5,
      "capability_id": "capability.cloudmold.inventory.inventory-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.commands.2",
          "$overrides": {
            "businessId": "$steps.order_place.result.orderId",
            "businessItemId": "$steps.order_place.result.items.0.orderItemId",
            "businessNo": "$steps.order_place.result.orderNo",
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "order_inventory",
      "step_order": 6,
      "capability_id": "capability.cloudmold.order.order-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.commands.3",
          "$overrides": {
            "orderId": "$steps.order_place.result.orderId",
            "expectedVersion": 1,
            "/reservationReferences/0/orderItemId": "$steps.order_place.result.items.0.orderItemId",
            "/reservationReferences/0/reservationId": "$steps.inventory_reserve.result.reservationId",
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "payment_capture",
      "step_order": 7,
      "capability_id": "capability.cloudmold.payment.payment-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.commands.4",
          "$overrides": {
            "orderId": "$steps.order_place.result.orderId",
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "order_payment",
      "step_order": 8,
      "capability_id": "capability.cloudmold.order.order-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.commands.5",
          "$overrides": {
            "orderId": "$steps.order_place.result.orderId",
            "expectedVersion": 2,
            "paymentId": "$steps.payment_capture.result.paymentId",
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    },
    {
      "step_code": "fulfillment_create",
      "step_order": 9,
      "capability_id": "capability.cloudmold.fulfillment.fulfillment-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "$object": "$input.commands.6",
          "$overrides": {
            "orderId": "$steps.order_place.result.orderId",
            "/items/0/orderItemId": "$steps.order_place.result.items.0.orderItemId",
            "/items/0/reservationId": "$steps.inventory_reserve.result.reservationId",
            "idempotencyKey": "$task.stepIdempotencyKey"
          }
        }
      ]
    }
  ]
}
