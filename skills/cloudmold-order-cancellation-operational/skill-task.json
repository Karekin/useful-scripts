{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.commerce.order-cancellation-operational.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "workflow_level": "BUSINESS_ROLE",
  "owner_role": "order-exception-operator",
  "max_attempts": 3,
  "steps": [
    {
      "step_code": "start_order_cancellation",
      "step_order": 1,
      "capability_id": "capability.cloudmold.order.order-cancellation-saga-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {
        "argument_index": 0,
        "json_pointer": "/idempotencyKey"
      },
      "arguments": [
        {
          "operation": "START",
          "cancellationMode": "$input.cancellationMode",
          "responsibilityParty": "$input.responsibilityParty",
          "responsibilityCode": "$input.responsibilityCode",
          "idempotencyKey": "$task.stepIdempotencyKey",
          "runId": "$task.runId",
          "orderId": "$input.orderId",
          "reason": "$input.reason",
          "correlationId": "$input.correlationId",
          "occurredAt": "$input.occurredAt"
        }
      ]
    },
    {
      "step_kind": "WAIT_CAPABILITY",
      "step_code": "wait_order_cancellation",
      "step_order": 2,
      "capability_id": "capability.cloudmold.order.commerce-workflow-query.inspect-order-cancellation.v1",
      "poll_interval_seconds": 30,
      "wait_success": {
        "/status": "SUCCEEDED"
      },
      "wait_failure": {
        "/status": ["MANUAL_REVIEW", "FAILED"]
      },
      "arguments": [
        "$steps.start_order_cancellation.result.sagaId"
      ]
    }
  ]
}
