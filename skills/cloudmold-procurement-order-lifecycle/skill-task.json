{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.procurement.order-lifecycle.v1",
  "skill_version": "1.0.0",
  "risk_level": "R3",
  "workflow_level": "BUSINESS_ROLE",
  "owner_role": "procurement-order-operator",
  "max_attempts": 5,
  "steps": [
    {
      "step_code": "purchase_order_create",
      "step_order": 1,
      "capability_id": "capability.cloudmold.procurement.procurement-command.execute.sig-b366ae5e9a17.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "operation": "CREATE_PURCHASE_ORDER",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "runId": "$task.runId",
        "correlationId": "$input.correlationId",
        "occurredAt": "$input.occurredAt",
        "purchaseOrder": "$input.purchaseOrder"
      }, "$input.actorPrincipalId"]
    },
    {
      "step_code": "purchase_order_dispatch",
      "step_order": 2,
      "capability_id": "capability.cloudmold.procurement.procurement-command.execute.sig-b366ae5e9a17.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "operation": "DISPATCH_PURCHASE_ORDER",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "runId": "$task.runId",
        "correlationId": "$input.correlationId",
        "occurredAt": "$input.occurredAt",
        "purchaseOrder": {
          "orderId": "$steps.purchase_order_create.result.aggregateId",
          "expectedVersion": "$steps.purchase_order_create.result.aggregateVersion",
          "reasonCode": "AI_PROCUREMENT_APPROVED"
        }
      }, "$input.actorPrincipalId"]
    },
    {
      "step_code": "supplier_confirm_order",
      "step_order": 3,
      "capability_id": "capability.cloudmold.procurement.procurement-command.execute.sig-b366ae5e9a17.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "operation": "SUPPLIER_CONFIRM_PURCHASE_ORDER",
        "idempotencyKey": "$task.stepIdempotencyKey",
        "runId": "$task.runId",
        "correlationId": "$input.correlationId",
        "occurredAt": "$input.occurredAt",
        "purchaseOrder": {
          "orderId": "$steps.purchase_order_create.result.aggregateId",
          "expectedVersion": "$steps.purchase_order_dispatch.result.aggregateVersion",
          "reasonCode": "SUPPLIER_ACKNOWLEDGED"
        }
      }, "$input.actorPrincipalId"]
    },
    {
      "step_kind": "WAIT_CAPABILITY",
      "step_code": "procurement_terminal_readback",
      "step_order": 4,
      "capability_id": "capability.cloudmold.procurement.procurement-query.require-current.v1",
      "poll_interval_seconds": 10,
      "wait_success": {"/status": "SUPPLIER_CONFIRMED"},
      "wait_failure": {"/status": ["CANCELLED"]},
      "arguments": ["$steps.purchase_order_create.result.aggregateId"]
    }
  ]
}
