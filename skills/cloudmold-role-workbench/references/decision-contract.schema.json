{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloudmold.deerflow-decision/v1",
  "title": "CloudMold DeerFlow bounded decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "decisionType",
    "status",
    "facts",
    "options",
    "recommendation",
    "risks",
    "confidence",
    "missingFacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cloudmold.deerflow-decision/v1"
    },
    "decisionType": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["READY", "NEEDS_DATA", "NEEDS_REVIEW"]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRef", "field", "value"],
        "properties": {
          "sourceRef": {"type": "string", "minLength": 1},
          "field": {"type": "string", "minLength": 1},
          "value": {}
        }
      }
    },
    "options": {"type": "array", "items": {"type": "object"}},
    "recommendation": {"type": "object"},
    "risks": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "missingFacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "evidenceRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
