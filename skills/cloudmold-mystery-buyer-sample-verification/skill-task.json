{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.quality.mystery-buyer-sample-verification.v1",
  "skill_version": "1.0.1",
  "risk_level": "R3",
  "workflow_level": "INTERNAL_SUBFLOW",
  "owner_role": "quality-operations",
  "max_attempts": 3,
  "steps": [
    {
      "step_code": "link_mystery_buyer_inspector",
      "step_order": 1,
      "capability_id": "capability.cloudmold.identity.identity-command.link-source.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.inspectorIdentityCommand",
        "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey", "/runId": "$task.runId"}
      }]
    },
    {
      "step_code": "create_mystery_buyer_standard",
      "step_order": 2,
      "capability_id": "capability.cloudmold.quality.quality-command.execute.sig-4bd92dbcbb2e.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.0",
        "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey", "/runId": "$task.runId"}
      }, "$input.managerPrincipalId"]
    },
    {
      "step_code": "publish_mystery_buyer_standard",
      "step_order": 3,
      "capability_id": "capability.cloudmold.quality.quality-command.execute.sig-4bd92dbcbb2e.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.1",
        "$overrides": {
          "/idempotencyKey": "$task.stepIdempotencyKey",
          "/runId": "$task.runId",
          "/standard/standardId": "$steps.create_mystery_buyer_standard.result.aggregateId"
        }
      }, "$input.managerPrincipalId"]
    },
    {
      "step_code": "certify_mystery_buyer_inspector",
      "step_order": 4,
      "capability_id": "capability.cloudmold.quality.quality-command.execute.sig-4bd92dbcbb2e.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.2",
        "$overrides": {
          "/idempotencyKey": "$task.stepIdempotencyKey",
          "/runId": "$task.runId",
          "/certification/standardId": "$steps.create_mystery_buyer_standard.result.aggregateId",
          "/certification/authenticatorPrincipalId": "$steps.link_mystery_buyer_inspector.result.principalId"
        }
      }, "$input.managerPrincipalId"]
    },
    {
      "step_code": "register_purchased_sample_lot",
      "step_order": 5,
      "capability_id": "capability.cloudmold.inventory.inventory-lot-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.lotCommand",
        "$overrides": {"/idempotencyKey": "$task.stepIdempotencyKey", "/runId": "$task.runId"}
      }]
    },
    {
      "step_code": "receive_purchased_sample",
      "step_order": 6,
      "capability_id": "capability.cloudmold.inventory.inventory-v3-command.execute.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.stockCommand",
        "$overrides": {
          "/idempotencyKey": "$task.stepIdempotencyKey",
          "/runId": "$task.runId",
          "/lotId": "$steps.register_purchased_sample_lot.result.lotId"
        }
      }]
    },
    {
      "step_code": "create_multidimensional_inspection",
      "step_order": 7,
      "capability_id": "capability.cloudmold.quality.quality-command.execute.sig-4bd92dbcbb2e.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.3",
        "$overrides": {
          "/idempotencyKey": "$task.stepIdempotencyKey",
          "/runId": "$task.runId",
          "/inspectionTask/standardId": "$steps.create_mystery_buyer_standard.result.aggregateId",
          "/inspectionTask/lotId": "$steps.register_purchased_sample_lot.result.lotId"
        }
      }, "$input.managerPrincipalId"]
    },
    {
      "step_code": "assign_mystery_buyer_inspector",
      "step_order": 8,
      "capability_id": "capability.cloudmold.quality.quality-command.execute.sig-4bd92dbcbb2e.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.4",
        "$overrides": {
          "/idempotencyKey": "$task.stepIdempotencyKey",
          "/runId": "$task.runId",
          "/inspectionTask/taskId": "$steps.create_multidimensional_inspection.result.aggregateId",
          "/inspectionTask/authenticatorPrincipalId": "$steps.link_mystery_buyer_inspector.result.principalId"
        }
      }, "$input.managerPrincipalId"]
    },
    {
      "step_code": "start_mystery_buyer_inspection",
      "step_order": 9,
      "capability_id": "capability.cloudmold.quality.quality-command.execute.sig-4bd92dbcbb2e.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.5",
        "$overrides": {
          "/idempotencyKey": "$task.stepIdempotencyKey",
          "/runId": "$task.runId",
          "/inspectionTask/taskId": "$steps.create_multidimensional_inspection.result.aggregateId"
        }
      }, "$steps.link_mystery_buyer_inspector.result.principalId"]
    },
    {
      "step_code": "record_pattern_price_content_fitting_pass",
      "step_order": 10,
      "capability_id": "capability.cloudmold.quality.quality-command.execute.sig-4bd92dbcbb2e.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.6",
        "$overrides": {
          "/idempotencyKey": "$task.stepIdempotencyKey",
          "/runId": "$task.runId",
          "/inspectionTask/taskId": "$steps.create_multidimensional_inspection.result.aggregateId"
        }
      }, "$steps.link_mystery_buyer_inspector.result.principalId"]
    },
    {
      "step_code": "complete_mystery_buyer_inspection",
      "step_order": 11,
      "capability_id": "capability.cloudmold.quality.quality-command.execute.sig-4bd92dbcbb2e.v1",
      "operation_type": "WRITE",
      "approval_required": true,
      "idempotency_binding": {"argument_index": 0, "json_pointer": "/idempotencyKey"},
      "arguments": [{
        "$object": "$input.commands.7",
        "$overrides": {
          "/idempotencyKey": "$task.stepIdempotencyKey",
          "/runId": "$task.runId",
          "/inspectionTask/taskId": "$steps.create_multidimensional_inspection.result.aggregateId"
        }
      }, "$steps.link_mystery_buyer_inspector.result.principalId"]
    },
    {
      "step_kind": "WAIT_CAPABILITY",
      "step_code": "verify_quality_badge",
      "step_order": 12,
      "capability_id": "capability.cloudmold.quality.quality-consumer-evidence.get-latest-by-sku.v1",
      "operation_type": "READ",
      "poll_interval_seconds": 2,
      "wait_success": {
        "/status": "VERIFIED",
        "/inspectionStatus": "COMPLETED",
        "/decision": "PASS"
      },
      "wait_failure": {
        "/status": ["REJECTED", "RECALLED"]
      },
      "arguments": ["$input.canonicalSkuId"]
    }
  ]
}
