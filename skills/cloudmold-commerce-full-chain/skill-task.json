{
  "schema_version": "cloudmold.skill-task-definition/v1",
  "skill_id": "skill.cloudmold.commerce.full-chain-hsf.v1",
  "skill_version": "1.3.0",
  "risk_level": "R3",
  "workflow_level": "INTERNAL_SUBFLOW",
  "max_attempts": 3,
  "steps": [
    {
      "step_kind": "SUBMIT_CHILD",
      "step_code": "submit_product",
      "step_order": 1,
      "child_skill_id": "skill.cloudmold.commerce.product-to-listing.v1",
      "child_skill_version": "1.1.0",
      "child_run_id": "$input.product.runIds.product",
      "arguments": {"$object": "$input.product", "$overrides": {}}
    },
    {
      "step_kind": "WAIT_CHILD",
      "step_code": "wait_product",
      "step_order": 2,
      "poll_interval_seconds": 2,
      "arguments": ["$steps.submit_product.result.childTaskId"]
    },
    {
      "step_kind": "SUBMIT_CHILD",
      "step_code": "submit_projection",
      "step_order": 3,
      "child_skill_id": "skill.cloudmold.commerce.legacy-projection-plan.v1",
      "child_skill_version": "1.2.0",
      "child_run_id": "$input.runIds.projection",
      "arguments": {
        "$object": "$input.projection",
        "$overrides": {
          "/plans/0/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
          "/plans/1/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_2.canonicalSkuId",
          "/plans/2/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_3.canonicalSkuId",
          "/plans/3/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_4.canonicalSkuId",
          "/plans/4/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_5.canonicalSkuId",
          "/plans/5/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_6.canonicalSkuId"
        }
      }
    },
    {
      "step_kind": "WAIT_CHILD",
      "step_code": "wait_projection",
      "step_order": 4,
      "poll_interval_seconds": 2,
      "arguments": ["$steps.submit_projection.result.childTaskId"]
    },
    {
      "step_kind": "SUBMIT_CHILD",
      "step_code": "submit_aftersale",
      "step_order": 5,
      "child_skill_id": "skill.cloudmold.commerce.aftersale-saga.v1",
      "child_skill_version": "1.4.0",
      "child_run_id": "$input.runIds.aftersale",
      "arguments": {
        "$object": "$input.aftersale",
        "$overrides": {
          "/commands/6/ownerId": "$steps.wait_product.result.outputs.wait_master.outputs.merchant_approve.merchantId",
          "/commands/6/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
          "/commands/6/warehouseId": "$steps.wait_product.result.outputs.wait_master.outputs.warehouse_network.warehouseId",
          "/commands/7/items/0/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
          "/commands/7/items/0/listingId": "$steps.wait_product.result.outputs.listing_create.listingId",
          "/commands/7/items/0/listingOfferId": "$steps.wait_product.result.outputs.listing_create.offers.0.listingOfferId",
          "/commands/8/ownerId": "$steps.wait_product.result.outputs.wait_master.outputs.merchant_approve.merchantId",
          "/commands/8/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
          "/commands/8/warehouseId": "$steps.wait_product.result.outputs.wait_master.outputs.warehouse_network.warehouseId",
          "/commands/12/sellerId": "$steps.wait_product.result.outputs.wait_master.outputs.merchant_approve.merchantId",
          "/commands/12/warehouseId": "$steps.wait_product.result.outputs.wait_master.outputs.warehouse_network.warehouseId",
          "/commands/12/items/0/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
          "/commands/13/ownerId": "$steps.wait_product.result.outputs.wait_master.outputs.merchant_approve.merchantId",
          "/commands/13/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
          "/commands/13/warehouseId": "$steps.wait_product.result.outputs.wait_master.outputs.warehouse_network.warehouseId"
        }
      }
    },
    {
      "step_kind": "WAIT_CHILD",
      "step_code": "wait_aftersale",
      "step_order": 6,
      "poll_interval_seconds": 2,
      "arguments": ["$steps.submit_aftersale.result.childTaskId"]
    },
    {
      "step_kind": "SUBMIT_CHILD",
      "step_code": "submit_readback",
      "step_order": 7,
      "child_skill_id": "skill.cloudmold.commerce.terminal-readback.v1",
      "child_skill_version": "1.2.0",
      "child_run_id": "$input.runIds.readback",
      "arguments": {
        "$object": "$input.readback",
        "$overrides": {
          "/authority/reference/merchantId": "$steps.wait_product.result.outputs.wait_master.outputs.merchant_approve.merchantId",
          "/authority/reference/shopId": "$steps.wait_product.result.outputs.wait_master.outputs.merchant_approve.shopId",
          "/authority/operator/principalId": "$steps.wait_product.result.outputs.wait_master.outputs.principal.principalId",
          "/product/skuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
          "/product/spuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_1.canonicalSpuId",
          "/listing/validation/canonicalSkuId": "$steps.wait_product.result.outputs.wait_catalog.outputs.define_1.canonicalSkuId",
          "/listing/validation/listingId": "$steps.wait_product.result.outputs.listing_create.listingId",
          "/listing/validation/listingOfferId": "$steps.wait_product.result.outputs.listing_create.offers.0.listingOfferId",
          "/order/orderId": "$steps.wait_aftersale.result.outputs.order_place.orderId",
          "/order/orderItemId": "$steps.wait_aftersale.result.outputs.order_place.items.0.orderItemId",
          "/payment/paymentId": "$steps.wait_aftersale.result.outputs.payment_capture.paymentId",
          "/fulfillment/fulfillmentId": "$steps.wait_aftersale.result.outputs.fulfillment_create.fulfillmentId",
          "/fulfillment/shipmentId": "$steps.wait_aftersale.result.outputs.fulfillment_ship.shipmentId",
          "/aftersale/afterSaleId": "$steps.wait_aftersale.result.outputs.aftersale_request.afterSaleId",
          "/aftersale/returnFulfillmentId": "$steps.wait_aftersale.result.outputs.aftersale_approve.returnFulfillmentId",
          "/warehouse/warehouseId": "$steps.wait_product.result.outputs.wait_master.outputs.warehouse_network.warehouseId",
          "/warehouse/locationId": "$steps.wait_product.result.outputs.wait_master.outputs.warehouse_network.locationId"
        }
      }
    },
    {
      "step_kind": "WAIT_CHILD",
      "step_code": "wait_readback",
      "step_order": 8,
      "poll_interval_seconds": 2,
      "arguments": ["$steps.submit_readback.result.childTaskId"]
    }
  ]
}
