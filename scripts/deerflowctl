#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
USEFUL_SCRIPTS_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
DEPLOYMENT_DIR="$USEFUL_SCRIPTS_ROOT/yml/deer-flow"
DEER_FLOW_REPO="${DEER_FLOW_REPO:-$(cd "$USEFUL_SCRIPTS_ROOT/.." && pwd)/deer-flow}"
DEER_FLOW_EXPECTED_VERSION="${DEER_FLOW_EXPECTED_VERSION:-v2.0.0}"
DEER_FLOW_RUNTIME_DIR="${DEER_FLOW_RUNTIME_DIR:-$DEPLOYMENT_DIR/runtime}"
export DOCKER_CONFIG="${DEER_FLOW_DOCKER_CONFIG:-$DEER_FLOW_RUNTIME_DIR/docker-config}"

export DEER_FLOW_HOME="$DEER_FLOW_RUNTIME_DIR/home"
export DEER_FLOW_CONFIG_PATH="$DEPLOYMENT_DIR/config.cloudmold.yaml"
export DEER_FLOW_EXTENSIONS_CONFIG_PATH="$DEPLOYMENT_DIR/extensions_config.cloudmold.json"
export DEER_FLOW_REPO_ROOT="$DEER_FLOW_REPO"
export CLOUDMOLD_SKILLS_PATH="$USEFUL_SCRIPTS_ROOT/skills"
export PORT="${DEER_FLOW_BIND_ADDRESS:-127.0.0.1}:${DEER_FLOW_PORT:-2026}"

DOCKER_COMPOSE_BIN="${DOCKER_COMPOSE_BIN:-$(command -v docker-compose || true)}"
test -n "$DOCKER_COMPOSE_BIN" || {
  printf 'deerflowctl: docker-compose is not installed\n' >&2
  exit 1
}

compose=(
  "$DOCKER_COMPOSE_BIN"
  -p deer-flow
  -f "$DEER_FLOW_REPO/docker/docker-compose.yaml"
  -f "$DEPLOYMENT_DIR/docker-compose.cloudmold.yaml"
)

fail() {
  printf 'deerflowctl: %s\n' "$*" >&2
  exit 1
}

check_repository() {
  test -f "$DEER_FLOW_REPO/Makefile" || fail "DeerFlow repository not found: $DEER_FLOW_REPO"
  local actual_version
  actual_version="$(git -C "$DEER_FLOW_REPO" describe --tags --exact-match 2>/dev/null || true)"
  test "$actual_version" = "$DEER_FLOW_EXPECTED_VERSION" || fail "expected $DEER_FLOW_EXPECTED_VERSION, found ${actual_version:-unversioned}"
}

ensure_runtime_files() {
  umask 077
  mkdir -p "$DEER_FLOW_HOME" "$DOCKER_CONFIG"
  if test ! -f "$DOCKER_CONFIG/config.json"; then
    printf '{"auths":{}}\n' > "$DOCKER_CONFIG/config.json"
  fi
  if test ! -f "$DEER_FLOW_HOME/.better-auth-secret"; then
    openssl rand -hex 32 > "$DEER_FLOW_HOME/.better-auth-secret"
  fi
  if test ! -f "$DEER_FLOW_HOME/.internal-auth-token"; then
    openssl rand -hex 32 > "$DEER_FLOW_HOME/.internal-auth-token"
  fi
  if test ! -f "$DEER_FLOW_HOME/.admin-email"; then
    printf 'agent-admin@cloudmold.cn\n' > "$DEER_FLOW_HOME/.admin-email"
  fi
  if test ! -f "$DEER_FLOW_HOME/.admin-password"; then
    printf 'Aa1!%s\n' "$(openssl rand -hex 24)" > "$DEER_FLOW_HOME/.admin-password"
  fi
  export BETTER_AUTH_SECRET
  BETTER_AUTH_SECRET="$(<"$DEER_FLOW_HOME/.better-auth-secret")"
  export DEER_FLOW_INTERNAL_AUTH_TOKEN
  DEER_FLOW_INTERNAL_AUTH_TOKEN="$(<"$DEER_FLOW_HOME/.internal-auth-token")"

  if test ! -f "$DEER_FLOW_REPO/.env"; then
    cp "$DEER_FLOW_REPO/.env.example" "$DEER_FLOW_REPO/.env"
  fi
  if test ! -f "$DEER_FLOW_REPO/frontend/.env"; then
    cp "$DEER_FLOW_REPO/frontend/.env.example" "$DEER_FLOW_REPO/frontend/.env"
  fi
}

wait_for_gateway() {
  local attempt
  for attempt in $(seq 1 60); do
    if curl --silent --fail --max-time 2 "http://${PORT}/health" >/dev/null; then
      return
    fi
    sleep 1
  done
  fail "Gateway did not become healthy at http://${PORT}/health"
}

bootstrap_admin() {
  local base_url="http://${PORT}"
  local admin_email admin_password setup_status
  admin_email="$(<"$DEER_FLOW_HOME/.admin-email")"
  admin_password="$(<"$DEER_FLOW_HOME/.admin-password")"
  setup_status="$(curl --silent --fail --max-time 5 "$base_url/api/v1/auth/setup-status")"

  if [[ "$setup_status" == *'"needs_setup":true'* ]]; then
    curl --silent --fail --max-time 10 \
      --cookie-jar "$DEER_FLOW_HOME/.admin-cookie-jar" \
      --header 'Content-Type: application/json' \
      --data-binary "{\"email\":\"$admin_email\",\"password\":\"$admin_password\"}" \
      "$base_url/api/v1/auth/initialize" >/dev/null
  else
    curl --silent --fail --max-time 10 \
      --cookie-jar "$DEER_FLOW_HOME/.admin-cookie-jar" \
      --header 'Content-Type: application/x-www-form-urlencoded' \
      --data-urlencode "username=$admin_email" \
      --data-urlencode "password=$admin_password" \
      "$base_url/api/v1/auth/login/local" >/dev/null
  fi

  curl --silent --fail --max-time 10 \
    --cookie "$DEER_FLOW_HOME/.admin-cookie-jar" \
    "$base_url/api/v1/auth/me" >/dev/null
  chmod 600 "$DEER_FLOW_HOME/.admin-email" "$DEER_FLOW_HOME/.admin-password" "$DEER_FLOW_HOME/.admin-cookie-jar"
}

validate() {
  check_repository
  test -f "$DEER_FLOW_CONFIG_PATH" || fail "missing $DEER_FLOW_CONFIG_PATH"
  test -f "$DEER_FLOW_EXTENSIONS_CONFIG_PATH" || fail "missing $DEER_FLOW_EXTENSIONS_CONFIG_PATH"
  test -f "$CLOUDMOLD_SKILLS_PATH/registry.json" || fail "CloudMold Skill registry is missing"
  command -v docker >/dev/null || fail "docker is not installed"
  docker info >/dev/null || fail "docker daemon is unavailable"
  ensure_runtime_files
  "${compose[@]}" config --quiet
}

case "${1:-status}" in
  doctor)
    validate
    printf 'DeerFlow %s deployment configuration is valid.\n' "$DEER_FLOW_EXPECTED_VERSION"
    ;;
  build)
    validate
    "${compose[@]}" build frontend gateway
    ;;
  up)
    validate
    test -n "${OPENAI_API_KEY:-}" || fail "OPENAI_API_KEY is required for agent execution"
    test -n "${OPENAI_BASE_URL:-}" || fail "OPENAI_BASE_URL is required for agent execution"
    "${compose[@]}" up --build -d --remove-orphans frontend gateway nginx
    wait_for_gateway
    bootstrap_admin
    "${compose[@]}" ps
    ;;
  bootstrap)
    validate
    wait_for_gateway
    bootstrap_admin
    printf 'DeerFlow local administrator session is ready.\n'
    ;;
  down)
    validate
    "${compose[@]}" down
    ;;
  restart)
    validate
    "${compose[@]}" restart frontend gateway nginx
    wait_for_gateway
    bootstrap_admin
    ;;
  status)
    validate
    "${compose[@]}" ps
    ;;
  logs)
    validate
    "${compose[@]}" logs --tail "${DEER_FLOW_LOG_TAIL:-200}" "${2:-}"
    ;;
  *)
    fail "usage: deerflowctl {doctor|build|up|bootstrap|down|restart|status|logs [service]}"
    ;;
esac
