    snapshot["warning"] = "本地 TEST/开发库真实聚合；运营漏斗来自行为 Session、支付归因与 Canonical 支付事实，不代表生产全量"
    SNAPSHOT.write_text(json.dumps(snapshot, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return validate()


