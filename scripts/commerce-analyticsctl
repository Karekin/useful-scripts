    SNAPSHOT.write_text(json.dumps(snapshot, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return validate()


def refresh_local_snapshot(tenant_id: int = 1) -> dict[str, int]:
    if tenant_id <= 0:
        raise DataProductError("tenant_id must be a positive integer")

    catalog_metric_ids = {
        metric["id"] for metric in load_json(CATALOG)["metrics"]
    }
    role_model = (
        LAKEHOUSE / "models/ads/ads-ecommerce-role-metrics.sql"
    ).read_text(encoding="utf-8")
    fixed_role_metric_ids = sorted(
        catalog_metric_ids.intersection(
            re.findall(r"'([a-z][a-z0-9_]*\.[a-z0-9_.]+)'", role_model)
        )
    )
    metric_rows: list[list[str]] = []
    for start in range(0, len(fixed_role_metric_ids), 5):
        metric_batch = fixed_role_metric_ids[start:start + 5]
        metric_filter = ", ".join(f"'{metric_id}'" for metric_id in metric_batch)
        rows = _query_starrocks(
            "SELECT metric_id, CAST(metric_value AS STRING), unit, source_row_count, "
            "CAST(numerator AS STRING), COALESCE(CAST(denominator AS STRING), ''), "
            "evidence_note, DATE_FORMAT(data_freshness_at, '%Y-%m-%d %H:%i:%s') "
            "FROM yshopping_ads.ads_ecommerce_role_metrics "
            f"WHERE tenant_id = {tenant_id} AND metric_id IN ({metric_filter}) "
            "ORDER BY metric_id"
        )
        returned_metric_ids = [row[0] for row in rows]
        if len(returned_metric_ids) != len(set(returned_metric_ids)):
            raise DataProductError(
                f"role metric batch returned duplicate tenant rows: {returned_metric_ids}"
            )
        metric_rows.extend(rows)
    if not metric_rows:
        raise DataProductError(f"no governed role metrics for local tenant {tenant_id}")

    snapshot = load_json(SNAPSHOT)
    _overlay_metric_rows(snapshot, metric_rows)
    metrics = snapshot.setdefault("metrics", {})

    manifest = load_json(MANIFEST)
    repository_metrics = {
        "governance.governed_source_candidates": (
            manifest["source_system"]["governed_source_candidates"],
            "路线图与附件审计后的严格分母",
        ),
        "governance.strict_final_source_count": (
            manifest["source_system"]["production_admission_ready_sources"],
            "LOCAL_TEST/PRE_PROD 完整门禁通过且具备生产发布条件的来源数",
        ),
        "governance.sql_model_count": (
            manifest["source_system"]["sql_models"],
            "版本库内 ADS/DWS/DWD/DIM/Bootstrap SQL 模型",
        ),
    }
    for metric_id, (value, note) in repository_metrics.items():
        metrics[metric_id] = {
            "value": value,
            "unit": "count",
            "status": "repository_verified",
            "note": note,
            "freshness": manifest["updated_at"],
        }

    commerce_rows = _query_starrocks(
        "SELECT readiness_status, COUNT(*) FROM yshopping_ads.ads_canonical_commerce_v2_readiness "
        f"WHERE tenant_id = {tenant_id} GROUP BY readiness_status ORDER BY readiness_status"
    )
    commerce_total = sum(int(row[1]) for row in commerce_rows)
    commerce_closure = [
        {
            "label": f"交易 · {'已对账' if status == 'RECONCILED' else '处理中'}",
            "value": int(count),
            "total": commerce_total,
            "tone": "green" if status == "RECONCILED" else "amber",
        }
        for status, count in commerce_rows
    ]
    aftersales_rows = _query_starrocks(
        "SELECT readiness_status, COUNT(*) FROM yshopping_ads.ads_canonical_after_sale_readiness "
        f"WHERE tenant_id = {tenant_id} GROUP BY readiness_status ORDER BY readiness_status"
    )
    aftersales_total = sum(int(row[1]) for row in aftersales_rows)
    commerce_closure.extend(
        {
            "label": f"售后 · {'已对账' if status == 'RECONCILED' else '待恢复'}",
            "value": int(count),
            "total": aftersales_total,
            "tone": "green" if status == "RECONCILED" else "amber",
        }
        for status, count in aftersales_rows
    )

    warehouse_rows = _query_starrocks(
        "SELECT warehouse_id, CAST(SUM(available_quantity) AS STRING), COUNT(*) "
        "FROM yshopping_ads.ads_canonical_inventory_health "
        f"WHERE tenant_id = {tenant_id} AND health_status NOT IN ('INVALID', 'NON_SELLABLE') "
        "GROUP BY warehouse_id ORDER BY SUM(available_quantity) DESC, warehouse_id LIMIT 5"
    )
    responsibility_rows = _query_starrocks(
        "SELECT responsibility, recovery_status, readiness_status, COUNT(*), "
        "CAST(SUM(refunded_amount_minor) / 100.0 AS STRING) "
        "FROM yshopping_ads.ads_canonical_after_sale_readiness "
        f"WHERE tenant_id = {tenant_id} GROUP BY responsibility, recovery_status, readiness_status "
        "ORDER BY responsibility, recovery_status, readiness_status"
    )
    legacy_rows = _query_starrocks(
        "SELECT active_order_count, paid_order_count, paid_buyer_count, repeat_buyer_rate, "
        "gross_paid_amount_yuan, refunded_amount_yuan, net_paid_amount_yuan, "
        "quality_flag_count, unpaid_terminal_order_count, refund_exceeds_paid_order_count, "
        "paid_order_missing_pay_time_count, active_item_on_deleted_order_count, "
        "DATE_FORMAT(data_freshness_at, '%Y-%m-%d %H:%i:%s') "
        "FROM yshopping_ads.ads_legacy_commerce_source_metrics "
        f"WHERE tenant_id = {tenant_id}"
    )

    snapshot["snapshot_id"] = f"tenant-{tenant_id}-local-test-{datetime.now().strftime('%Y%m%d%H%M%S')}"
    snapshot["generated_at"] = datetime.now(timezone(timedelta(hours=8))).isoformat(timespec="seconds")
    snapshot["tenant_label"] = f"Tenant {tenant_id}"
    snapshot["warning"] = "本地 TEST/开发库真实聚合；各指标附样本量与覆盖率，不代表生产全量"
    snapshot["breakdowns"] = {
        "commerce_closure": commerce_closure,
        "warehouse_inventory_top5": [
            {
                "warehouse": _mask_identifier(warehouse),
                "available_quantity": _json_number(available),
                "balance_count": int(balance_count),
                "health": "健康",
            }
            for warehouse, available, balance_count in warehouse_rows
        ],
        "aftersales_responsibility": [
            {
                "party": responsibility or "未标注",
                "recovery": recovery,
                "readiness": readiness,
                "case_count": int(case_count),
                "refund_yuan": _json_number(refund_yuan),
            }
            for responsibility, recovery, readiness, case_count, refund_yuan in responsibility_rows
        ],
    }
    if legacy_rows:
        if len(legacy_rows) != 1 or len(legacy_rows[0]) != 13:
            raise DataProductError(f"unexpected legacy source row shape: {legacy_rows}")
        (
            active_orders, paid_orders, paid_buyers, repeat_rate,
            gross_paid, refunded, net_paid, quality_flags,
            unpaid_terminal, refund_exceeds_paid, missing_pay_time,
            active_item_deleted_order, legacy_freshness,
        ) = legacy_rows[0]
        snapshot["legacy_source_only"] = {
            "evidence_scope": "LEGACY_SOURCE_ONLY",
            "warning": "旧 Trade 当前状态快照，包含质量异常且身份映射未闭合；禁止与 Canonical 指标相加",
            "freshness": legacy_freshness,
            "active_order_count": int(active_orders),
            "paid_order_count": int(paid_orders),
            "paid_buyer_count": int(paid_buyers),
            "repeat_buyer_rate": _json_number(repeat_rate),
            "gross_paid_amount_yuan": _json_number(gross_paid),
            "refunded_amount_yuan": _json_number(refunded),
            "net_paid_amount_yuan": _json_number(net_paid),
            "quality_flag_count": int(quality_flags),
            "quality_flags": {
                "unpaid_terminal_orders": int(unpaid_terminal),
                "refund_exceeds_paid_orders": int(refund_exceeds_paid),
                "paid_orders_missing_pay_time": int(missing_pay_time),
                "active_items_on_deleted_orders": int(active_item_deleted_order),
            },
        }
    SNAPSHOT.write_text(json.dumps(snapshot, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return validate()


def refresh_all_local_snapshot(tenant_id: int = 1) -> dict[str, int]:
    """Refresh the complete role snapshot from one current StarRocks state."""
    refresh_local_snapshot(tenant_id)
    for refresher in (
        refresh_merchant_local_snapshot,
        refresh_operations_local_snapshot,
        refresh_buyer_local_snapshot,
        refresh_merchandise_local_snapshot,
        refresh_finance_local_snapshot,
        refresh_service_local_snapshot,
    ):
        refresher(tenant_id)

    snapshot = load_json(SNAPSHOT)
    snapshot["snapshot_id"] = (
        f"tenant-{tenant_id}-all-roles-local-test-{datetime.now().strftime('%Y%m%d%H%M%S')}"
    )
    snapshot["generated_at"] = datetime.now(
        timezone(timedelta(hours=8))
    ).isoformat(timespec="seconds")
    snapshot["warning"] = (
        "本地 TEST/开发库同批次完整聚合；核心经营、角色主题与治理指标均已刷新，"
        "各指标保留样本量与覆盖率，不代表生产全量"
    )
    SNAPSHOT.write_text(
        json.dumps(snapshot, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )
    return validate()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command",
        choices=[
            "validate",
            "sync-site",
            "status",
            "refresh-all-local-snapshot",
            "refresh-local-snapshot",
            "refresh-merchant-local-snapshot",
            "refresh-operations-local-snapshot",
            "refresh-buyer-local-snapshot",
            "refresh-merchandise-local-snapshot",
            "refresh-finance-local-snapshot",
            "refresh-service-local-snapshot",
        ],
    )
    parser.add_argument("--tenant", type=int, default=1)
    args = parser.parse_args()
    try:
        if args.command == "refresh-all-local-snapshot":
            summary = refresh_all_local_snapshot(args.tenant)
            print(f"all-role local snapshot refreshed for tenant {args.tenant}: {summary}")
        elif args.command == "refresh-merchant-local-snapshot":
            summary = refresh_merchant_local_snapshot(args.tenant)
            print(f"merchant local StarRocks snapshot refreshed at {SNAPSHOT}")
        elif args.command == "refresh-operations-local-snapshot":
            summary = refresh_operations_local_snapshot(args.tenant)
            print(f"operations local StarRocks snapshot refreshed at {SNAPSHOT}")
        elif args.command == "refresh-buyer-local-snapshot":
            summary = refresh_buyer_local_snapshot(args.tenant)
            print(f"buyer local StarRocks snapshot refreshed at {SNAPSHOT}")
        elif args.command == "refresh-merchandise-local-snapshot":
            summary = refresh_merchandise_local_snapshot(args.tenant)
            print(f"merchandise local StarRocks snapshot refreshed at {SNAPSHOT}")
        elif args.command == "refresh-finance-local-snapshot":
            summary = refresh_finance_local_snapshot(args.tenant)
            print(f"finance local StarRocks snapshot refreshed at {SNAPSHOT}")
        elif args.command == "refresh-service-local-snapshot":
            summary = refresh_service_local_snapshot(args.tenant)
            print(f"service local StarRocks snapshot refreshed at {SNAPSHOT}")
        elif args.command == "refresh-local-snapshot":
            summary = refresh_local_snapshot(args.tenant)
            print(f"local StarRocks snapshot refreshed at {SNAPSHOT}")
        elif args.command == "sync-site":
            summary = sync_site()
            print(f"site data synchronized to {SITE_DATA}")
        else:
            summary = validate()
        print(
            "commerce analytics valid: "
            f"{summary['metrics']} KPIs, {summary['views']} views, "
            f"{summary['snapshot_metrics']} snapshot metrics, "
            f"{summary['sql_models']} SQL models, {summary['governed_sources']} governed sources"
        )
        return 0
    except DataProductError as exc:
        print(exc, file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
