{
  "schema_version": 1,
  "portfolio_id": "yshopping-multi-sided-commerce",
  "north_star_system": {
    "platform": "净 GMV 与贡献利润率共同衡量可持续经营，复购、供给与履约质量作为护栏",
    "merchant": "商家净销售额与贡献利润，辅以新客、转化、复购、在售供给和履约质量",
    "growth": "流量、内容与品牌协同驱动可持续增长，转化效率、种草与心智作为护栏",
    "buyer": "成功完成且体验达标的订单价值，辅以首单时长、购买深度、配送承诺和退款体验",
    "supply": "选品、库存与履约协同衡量供给健康，周转、缺货与成本作为护栏",
    "quality": "鉴别真伪与质检合格共同衡量信任根基，时效、人效与纠纷作为护栏",
    "trust": "信任指数与一次解决共同衡量售后信任，打假、保障与纠纷作为护栏",
    "finance": "净收入与毛利润共同衡量经济质量，资金对账、拒付和风险损失作为护栏"
  },
  "journey_stages": [
    {"id":"supply","label":"供给入场","question":"商品、商家、库存是否可售？","domain_assets":["Catalog","Merchant","Listing","Inventory","Procurement"]},
    {"id":"acquisition","label":"流量获取","question":"哪些渠道与活动带来有效新客？","domain_assets":["Promotion","Coupon","Advertising","Engagement"]},
    {"id":"discovery","label":"发现搜索","question":"买家能否快速发现合适商品？","domain_assets":["Product","Search","Engagement","Community"]},
    {"id":"consideration","label":"决策加购","question":"商品、价格与内容是否促成意向？","domain_assets":["Listing","Promotion","Engagement","Review"]},
    {"id":"transaction","label":"下单支付","question":"结算与支付是否顺畅且安全？","domain_assets":["Order","Payment","Risk","Benefit"]},
    {"id":"fulfillment","label":"履约交付","question":"仓配是否按承诺完整交付？","domain_assets":["Warehouse","Inventory","Fulfillment","Logistics"]},
    {"id":"service","label":"售后服务","question":"问题是否快速、低成本地闭环？","domain_assets":["AfterSales","Refund","CustomerService","Compensation"]},
    {"id":"retention","label":"留存复购","question":"买家和商家是否持续获得价值？","domain_assets":["Member","CRM","Community","Gamification"]}
  ],
  "views": [
    {"id":"executive","label":"经营驾驶舱","audience":"管理层","owner":"Business + Finance","question":"增长是否健康、可持续、可对账？","scope_note":"唯一一级总览：只放跨域经营结果与核心护栏，专业过程指标下沉到对应视图。","primary_metrics":["commerce.net_gmv_yuan","finance.contribution_margin_rate","commerce.paid_buyer_count","merchant.active_merchant_count"],"supporting_metrics":["commerce.order_count","commerce.average_order_value_yuan","buyer.repeat_purchase_rate_90d","fulfillment.on_time_delivery_rate","buyer.csat"]},
    {"id":"merchant","label":"商家经营中心","audience":"商家与商家运营","owner":"Merchant","question":"商家的获客、转化与可售经营是否健康？","scope_note":"仅保留商家可直接行动的获客、店铺转化、投放、在售和取消指标。","primary_metrics":["merchant.net_sales_yuan","merchant.new_buyer_count","merchant.store_conversion_rate","marketing.ad_roas"],"supporting_metrics":["marketing.promotion_roi","listing.active_offer_count","merchant.cancellation_rate"]},
    {"id":"growth","label":"增长营销","audience":"增长与品牌团队","owner":"Growth + Content + Brand","question":"流量、内容与品牌是否协同驱动可持续增长？","scope_note":"需求侧全链路：覆盖流量转化漏斗、社区内容种草与品牌心智。","primary_metrics":["funnel.visit_to_pay_rate","commerce.gmv_yuan","content.community_dau","content.seeding_conversion_rate","marketing.brand_health_score","marketing.mind_share_rate"],"supporting_metrics":["buyer.new_paid_buyer_count","traffic.visitor_count","search.success_rate","funnel.product_detail_view_count","funnel.add_to_cart_rate","funnel.checkout_start_rate","funnel.cart_abandonment_rate","promotion.coupon_redemption_rate","content.publish_count","content.engagement_rate","content.creator_count","content.content_impression","content.penetration_rate","content.kol_count","marketing.brand_nps","marketing.imkt_roi","marketing.media_impression","marketing.brand_search_count","marketing.market_share_rate","marketing.ad_reach"]},
    {"id":"buyer","label":"买家旅程","audience":"产品、用户增长与体验团队","owner":"Buyer Experience","question":"买家的首单、复购深度与履约体验是否连贯？","scope_note":"仅关注买家生命周期与体验，不重复展示平台规模和商家经营结果。","primary_metrics":["buyer.time_to_first_order_hours","buyer.order_frequency_90d","buyer.category_breadth_90d","buyer.delivery_promise_hit_rate"],"supporting_metrics":["buyer.return_rate","buyer.refund_cycle_hours"]},
    {"id":"supply","label":"供应链","audience":"供应链与履约团队","owner":"Supply Chain + Logistics + Buying","question":"选品、库存、履约是否高效协同？","scope_note":"供给侧全链路：覆盖选品（含潮流）、库存周转、采购与履约配送。","primary_metrics":["catalog.selection_breadth","inventory.in_stock_rate","inventory.turnover_days","procurement.otif_rate","logistics.ship_hours","logistics.delivery_on_time_rate","logistics.cost_per_order_yuan","logistics.warehouse_turnover_days","trend.trend_gmv_share","trend.new_hit_rate","trend.scarcity_supply_count","trend.trend_capture_hours"],"supporting_metrics":["catalog.active_sku_count","listing.approval_rate","inventory.available_quantity","inventory.stockout_rate","inventory.sell_through_rate_30d","inventory.aged_stock_value_yuan","procurement.receipt_fulfillment_rate","inventory.balance_count","inventory.canonical_v3_rate","inventory.low_stock_balance_count","inventory.out_of_stock_balance_count","procurement.purchase_order_count","procurement.open_order_count","logistics.same_next_day_rate","logistics.exception_rate","logistics.return_logistics_cost_yuan","logistics.warehouse_efficiency","trend.first_launch_count","trend.keyword_heat","trend.hit_rate","trend.trend_turnover_days"]},
    {"id":"quality","label":"鉴别质检中心","audience":"鉴别与质检团队","owner":"Authentication & Quality","question":"每一件商品是否做到真鉴别、严质检、快时效？","scope_note":"得物特色：先鉴别后发货。覆盖鉴别真伪、质检、鉴定师人效与真伪纠纷，是平台信任的根基。","primary_metrics":["quality.authentication_accuracy_rate","quality.inspection_pass_rate","quality.authentication_tat_hours","quality.auth_dispute_rate"],"supporting_metrics":["quality.recheck_rate","quality.authenticator_productivity","quality.sku_coverage_rate","quality.defect_rate"]},
    {"id":"trust","label":"信任保障","audience":"信任与服务团队","owner":"Customer Service + Trust & Safety","question":"用户是否敢买、问题快闭环、假货零容忍？","scope_note":"售后与信任侧：覆盖客服一次解决、售后闭合、信任指数、假货打假与保障赔付。","primary_metrics":["service.first_contact_resolution_rate","service.resolution_sla_rate","aftersales.reconciled_rate","service.order_defect_rate","trust.trust_index","trust.dispute_rate","trust.counterfeit_takedown_rate","trust.protection_payout_rate"],"supporting_metrics":["aftersales.case_count","service.first_response_minutes","aftersales.recovery_required_count","trust.fraud_loss_yuan","trust.ip_complaint_count","trust.safety_incident_count","trust.risk_order_rate"]},
    {"id":"finance","label":"财务与风控","audience":"财务、支付与风险团队","owner":"Finance + Risk","question":"交易是否盈利、资金是否守恒、风险是否可控？","scope_note":"仅关注收入、毛利、资金、对账、支付和风险损失，不重复经营规模卡片。","primary_metrics":["finance.net_revenue_yuan","finance.gross_profit_yuan","platform.take_rate","risk.loss_amount_yuan"],"supporting_metrics":["commerce.captured_amount_yuan","aftersales.refunded_amount_yuan","finance.discount_funding_yuan","payment.success_rate","risk.flagged_order_rate","risk.chargeback_rate","commerce.reconciled_rate"]}
  ]
}
