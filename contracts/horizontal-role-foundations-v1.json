    },
    {
      "ownerRole": "privacy-security-operator",
      "displayName": "隐私与信息安全运营",
      "stage": "FOUNDATION_REQUIRED",
      "authoritySources": ["IAM", "SIEM", "数据分类与隐私请求系统"],
      "controlledArtifacts": ["权限复核单", "访问异常工单", "安全演练工单"],
      "approvalBoundary": "生产授权、密钥操作、数据披露和事件定级由安全责任人批准",
      "prohibitedAutomation": ["自动授予生产权限", "自动导出密钥", "自动披露数据", "自动定级安全事件"],
      "exitCriteria": ["最小权限数据视图", "安全责任人绑定", "双人复核模板", "安全事件终态回读"]
    },
    {
      "ownerRole": "enterprise-platform-operator",
      "displayName": "企业平台工程运营",
