      "prohibitedAutomation": ["自动批准预算", "自动调整公司目标", "自动关闭审计整改", "自动形成审计结论"],
      "exitCriteria": ["项目与预算最小权限", "管理层或内审责任人绑定", "预算审批模板", "整改终态回读"]
