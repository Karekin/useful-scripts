      "prohibitedAutomation": ["自动录用", "自动绩效定级", "自动薪酬调整", "自动劳动处分"],
      "exitCriteria": ["人员主数据最小化授权", "HR 责任人绑定", "劳动合规审批模板", "终态回读"]
    },
    {
      "ownerRole": "legal-ip-operator",
      "displayName": "法务与知识产权运营",
