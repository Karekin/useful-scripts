      "authoritySources": ["CMDB", "可观测性平台", "CI/CD 与变更系统"],
      "controlledArtifacts": ["SLO 异常工单", "变更风险评审单", "灾备演练证据"],
      "approvalBoundary": "生产变更、回滚和灾备切换由变更负责人批准",
      "prohibitedAutomation": ["自动发布生产变更", "自动回滚", "自动灾备切换", "自动扩容收费资源"],
      "exitCriteria": ["服务与变更对象绑定", "变更责任人绑定", "变更审批模板", "部署或演练终态回读"]
    },
    {
      "ownerRole": "strategy-pmo-control-operator",
