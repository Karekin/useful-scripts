# ============================================================================
# 基础配置
# ============================================================================
TZ=Asia/Shanghai
COMPOSE_PROJECT_NAME=data-algo-platform

# ============================================================================
# GitHub Git-Sync 配置
# ============================================================================
GITHUB_APP_ID=2505691
GITHUB_INSTALLATION_ID=100416609
GITSYNC_REPO=https://github.com/CloudMold/data-ml-platform-assets.git
GITSYNC_REF=master

# ============================================================================
# MinIO 对象存储配置
# ============================================================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=CHANGE_ME
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1

# ============================================================================
# Airflow 配置
# ============================================================================
# 数据库连接
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres/airflow

# 执行器
AIRFLOW__CORE__EXECUTOR=LocalExecutor

# 安全密钥（生产环境必须修改）
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME

# DAGs 配置
AIRFLOW__CORE__DAGS_FOLDER=/code/current/airflow/dags
AIRFLOW__CORE__LOAD_EXAMPLES=False
PYTHONPATH=/code/current/airflow

# SMTP 邮件配置 (QQ 邮箱)
AIRFLOW__SMTP__SMTP_HOST=smtp.qq.com
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=445923692@qq.com
AIRFLOW__SMTP__SMTP_PASSWORD_FILE=/run/secrets/qq_smtp_password
AIRFLOW__SMTP__SMTP_PORT=587
AIRFLOW__SMTP__SMTP_MAIL_FROM=445923692@qq.com
AIRFLOW__SMTP__SMTP_TIMEOUT=30
AIRFLOW__SMTP__SMTP_RETRY_LIMIT=5

# ============================================================================
# MySQL 配置
# ============================================================================
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=mydb

# ============================================================================
# Amoro 配置
# ============================================================================
AMORO_JVM_XMS=1024

# ============================================================================
# Flink 配置
# ============================================================================
FLINK_JOBMANAGER_RPC_ADDRESS=flink-jobmanager
FLINK_TASKMANAGER_SLOTS=2
