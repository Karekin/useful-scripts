  "semantic_profiles": {
    "campaign_definition": {
      "target_boundary": "Promotion Campaign and immutable CampaignVersion, rule/version, eligibility policy, Catalog/Listing binding and separately owned inventory budget",
      "required_semantics": ["campaign_id_version_type_status_and_effective_window", "rule_policy_and_asset_template_version", "catalog_spu_sku_listing_offer_mapping", "eligibility_audience_channel_and_tenant_scope", "inventory_budget_reservation_release_and_owning_inventory_reference", "approval_publish_pause_close_and_rollback_history"]
    },
    "participation_task": {
      "target_boundary": "Participant Task/Attempt/Assistance history and Qualification decision; participation never creates a reward by itself",
      "required_semantics": ["task_definition_version_instance_attempt_and_operation_ids", "actor_inviter_invitee_helper_and_subject_principal_mappings", "qualification_policy_version_and_evaluation_result", "idempotency_retry_duplicate_and_abuse_controls", "event_time_expiry_revocation_and_compensation_history", "reward_entitlement_reference_without_direct_grant_authority"]
    },
    "prize_entitlement": {
      "target_boundary": "Versioned Prize/Draw definition, immutable DrawAttempt/Outcome and separately issued RewardEntitlement with delivery evidence",
      "required_semantics": ["prize_pool_prize_version_draw_attempt_and_outcome_ids", "selection_algorithm_randomness_seed_commitment_and_audit", "probability_weight_quota_limit_and_exhaustion_semantics", "winner_principal_qualification_and_duplicate_prevention", "entitlement_issue_claim_expire_revoke_and_reversal_history", "coupon_goods_points_coin_or_cash_delivery_reference_to_owning_domain"]
    },
    "commerce_order": {
      "target_boundary": "Promotion reservation or purchase intent referencing canonical Order, Payment, Listing, Inventory and Fulfillment without duplicating their authority",
      "required_semantics": ["reservation_purchase_order_and_order_item_business_keys", "campaign_version_listing_offer_sku_and_merchant_mappings", "requested_payable_discount_and_refund_minor_units_with_iso_currency", "payment_attempt_capture_refund_and_settlement_references", "inventory_reservation_allocation_release_and_fulfillment_references", "cancel_expire_refund_and_compensation_state_machine"]
    },
    "merchant_enrollment": {
      "target_boundary": "Merchant campaign enrollment application, review and eligibility decision; Merchant and Listing remain independent authorities",
      "required_semantics": ["merchant_shop_campaign_version_and_application_ids", "applicant_reviewer_and_approver_principal_mappings", "submitted_terms_policy_version_and_evidence_refs", "review_decision_reason_effective_window_and_appeal", "listing_offer_scope_and_sales_eligibility_recheck", "withdraw_suspend_expire_and_audit_history"]
    },
    "notification": {
      "target_boundary": "Notification intent, preference evaluation, delivery attempts and receipts; notice does not prove participation or purchase",
      "required_semantics": ["campaign_version_notification_intent_and_recipient_principal", "template_version_channel_locale_and_render_digest", "preference_consent_quiet_hours_and_suppression_reason", "attempt_provider_message_receipt_and_failure_identity", "scheduled_sent_delivered_read_expired_and_cancelled_times", "proof_that_delivery_does_not_create_participation_order_or_reward"]
    },
    "reward_ledger": {
      "target_boundary": "Reward Entitlement plus immutable points/coin/coupon ledger and external Payment reference; summaries never replace ledger entries",
      "required_semantics": ["entitlement_transaction_entry_account_and_counter_entry_ids", "reward_type_typed_unit_iso_currency_or_points_coin_definition_version", "signed_integer_quantity_minor_units_and_precision", "earn_hold_spend_expire_revoke_refund_and_compensation_entries", "coupon_entitlement_payment_or_catalog_delivery_reference", "per_unit_zero_sum_or_issuance_redemption_conservation"]
    },
    "risk_education": {
      "target_boundary": "Versioned education Question/Answer taxonomy, user Attempt, Risk signal/review and separately issued coupon entitlement",
      "required_semantics": ["question_answer_policy_and_content_version_ids", "participant_attempt_response_and_scoring_identity", "correct_answer_access_classification_and_leak_prevention", "risk_signal_review_policy_version_and_decision_reference", "coupon_entitlement_issue_reference_without_row_level_self_grant", "attempt_retry_expiry_revocation_and_audit_history"]
    },
    "sensitive_behavior": {
      "target_boundary": "Restricted keyword/code observation with purpose, consent and retention; never a credential, profile or automatic reward authority",
      "required_semantics": ["observation_event_session_and_principal_pseudonymous_identity", "keyword_or_code_type_schema_version_and_digest", "purpose_consent_legal_basis_and_retention", "event_client_server_ingestion_times_and_timezone", "secret_credential_token_and_personal_content_exclusion", "qualification_review_and_reward_entitlement_references_without_inference"]
    }
  },
