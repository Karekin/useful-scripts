{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/inventory-migration-balance-assessed-v2.schema.json",
  "title": "inventory.migration.balance_assessed payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "migration_run_id", "assessment_id", "legacy_balance_id", "source_system", "source_type",
    "source_id", "source_classification", "source_version", "source_updated_at", "source_snapshot_hash",
    "source_owner_id", "resolved_owner_type", "resolved_owner_id", "source_sku_id",
    "resolved_canonical_sku_id", "source_warehouse_id", "resolved_warehouse_id", "source_location_id",
    "resolved_location_id", "source_lot_id", "resolved_lot_id", "lot_tracking_policy", "stock_status",
    "quality_status", "source_uom_code", "resolved_base_uom_code", "source_on_hand_quantity",
    "source_reserved_quantity", "source_in_transit_quantity", "active_reservation_count",
    "active_reservation_quantity", "reservation_allocation_count", "reservation_allocation_quantity",
    "assessment_status", "blocker_codes", "policy_version", "verification_ref", "assessed_at"
  ],
  "properties": {
    "migration_run_id": {"type": "string", "format": "uuid"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "legacy_balance_id": {"type": "string", "format": "uuid"},
    "source_system": {"type": "string", "const": "CLOUDMOLD_INVENTORY_V1"},
    "source_type": {"type": "string", "const": "BALANCE"},
    "source_id": {"type": "string", "format": "uuid"},
    "source_classification": {"type": "string", "enum": ["CONTROLLED_CANARY", "CONTROLLED_FIXTURE", "CONTROLLED_SCENARIO", "CONCURRENCY_PROBE", "UNCLASSIFIED"]},
    "source_version": {"type": "integer", "minimum": 1},
    "source_updated_at": {"type": "string", "format": "date-time"},
    "source_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_owner_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "resolved_owner_type": {"type": ["string", "null"], "enum": [null, "MERCHANT"]},
    "resolved_owner_id": {"type": ["string", "null"], "format": "uuid"},
    "source_sku_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "resolved_canonical_sku_id": {"type": ["string", "null"], "format": "uuid"},
    "source_warehouse_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "resolved_warehouse_id": {"type": ["string", "null"], "format": "uuid"},
    "source_location_id": {"type": ["string", "null"], "maxLength": 128},
    "resolved_location_id": {"type": ["string", "null"], "format": "uuid"},
    "source_lot_id": {"type": ["string", "null"], "maxLength": 128},
    "resolved_lot_id": {"type": ["string", "null"], "format": "uuid"},
    "lot_tracking_policy": {"type": "string", "const": "UNRESOLVED"},
    "stock_status": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 32},
    "quality_status": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 32},
    "source_uom_code": {"type": "string", "pattern": "^[A-Z0-9._-]+$", "maxLength": 32},
    "resolved_base_uom_code": {"type": ["string", "null"], "pattern": "^[A-Z0-9._-]+$", "maxLength": 32},
    "source_on_hand_quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "source_reserved_quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "source_in_transit_quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "active_reservation_count": {"type": "integer", "minimum": 0},
    "active_reservation_quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "reservation_allocation_count": {"type": "integer", "const": 0},
    "reservation_allocation_quantity": {"type": "string", "pattern": "^0(\\.0{1,6})?$"},
    "assessment_status": {"type": "string", "enum": ["ELIGIBLE", "BLOCKED", "REJECTED"]},
    "blocker_codes": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64}, "uniqueItems": true},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "verification_ref": {"type": "string", "pattern": "^(?i:sha256|sha512|ticket|run|evidence|vault|kms|token):[A-Za-z0-9._/-]+$", "maxLength": 256},
    "assessed_at": {"type": "string", "format": "date-time"}
  }
}
