{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/return-fulfillment-status-changed-v1.schema.json",
  "title": "return_fulfillment.status.changed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "return_fulfillment_id", "return_fulfillment_no", "return_fulfillment_item_id", "after_sale_id", "after_sale_item_id", "order_id",
    "order_item_id", "canonical_sku_id", "quantity", "owner_id", "warehouse_id", "uom_code",
    "return_shipment_id", "carrier_code", "waybill_no", "return_shipping_amount_minor", "currency_code",
    "handed_over_at", "in_transit_at", "received_at", "receiver_id", "inspection_id", "quality_status",
    "received_quantity", "accepted_quantity", "rejected_quantity", "inspection_result",
    "inspector_id", "inspected_at", "previous_status", "current_status"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "return_fulfillment_id": {"type": "string", "format": "uuid"},
    "return_fulfillment_no": {"type": "string", "minLength": 1, "maxLength": 32},
    "return_fulfillment_item_id": {"type": "string", "format": "uuid"},
    "after_sale_id": {"type": "string", "format": "uuid"},
    "after_sale_item_id": {"type": "string", "format": "uuid"},
    "order_id": {"type": "string", "format": "uuid"},
    "order_item_id": {"type": "string", "format": "uuid"},
    "canonical_sku_id": {"type": "string", "format": "uuid"},
    "warehouse_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "owner_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.0{1,6})?$"},
    "uom_code": {"type": "string", "const": "PCS"},
    "return_shipment_id": {"type": ["string", "null"], "format": "uuid"},
    "carrier_code": {"type": ["string", "null"], "maxLength": 64},
    "waybill_no": {"type": ["string", "null"], "maxLength": 128},
    "return_shipping_amount_minor": {"type": "integer", "const": 0},
    "currency_code": {"type": "string", "const": "CNY"},
    "handed_over_at": {"type": ["string", "null"], "format": "date-time"},
    "in_transit_at": {"type": ["string", "null"], "format": "date-time"},
    "received_at": {"type": ["string", "null"], "format": "date-time"},
    "receiver_id": {"type": ["string", "null"], "maxLength": 128},
    "inspection_id": {"type": ["string", "null"], "format": "uuid"},
    "quality_status": {"type": ["string", "null"], "enum": [null, "QUALIFIED"]},
    "received_quantity": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
    "accepted_quantity": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
    "rejected_quantity": {"type": ["string", "null"], "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
    "inspection_result": {"type": ["string", "null"], "enum": [null, "ACCEPTED"]},
    "inspector_id": {"type": ["string", "null"], "maxLength": 128},
    "inspected_at": {"type": ["string", "null"], "format": "date-time"},
    "previous_status": {"type": ["string", "null"], "enum": [null, "CREATED", "HANDED_OVER", "IN_TRANSIT", "RECEIVED", "INSPECTION_ACCEPTED"]},
    "current_status": {"type": "string", "enum": ["CREATED", "HANDED_OVER", "IN_TRANSIT", "RECEIVED", "INSPECTION_ACCEPTED"]}
  }
}
