{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/operations-intelligence-clue-reviewed-v1.schema.json","title":"operations_intelligence.clue.reviewed payload v1","type":"object","additionalProperties":false,
