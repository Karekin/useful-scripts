{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://cloudmold.local/contracts/risk-cluster-status-changed-v1.schema.json",
  "title": "risk.cluster.status_changed payload v1", "type": "object", "additionalProperties": false,
  "required": ["cluster_id", "cluster_code", "current_status", "risk_level", "member_count", "edge_count", "operation"],
  "properties": {
    "cluster_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"}, "cluster_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"},
    "previous_status": {"type": ["string", "null"], "enum": ["OPEN", "UNDER_REVIEW", "CONFIRMED", "DISMISSED", "CLOSED", null]}, "current_status": {"type": "string", "enum": ["OPEN", "UNDER_REVIEW", "CONFIRMED", "DISMISSED", "CLOSED"]},
    "risk_level": {"type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]}, "member_count": {"type": "integer", "minimum": 0}, "edge_count": {"type": "integer", "minimum": 0},
    "operation": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
  }
}
