{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/after-sale-resolution-saga-status-changed-v3.schema.json",
  "title": "after_sale.resolution_saga.status.changed payload v3 cumulative order settlement",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "saga_id", "after_sale_id", "after_sale_item_id", "order_id", "order_item_id", "payment_id", "return_fulfillment_id", "return_shipment_id", "inspection_id", "canonical_sku_id", "quantity", "accepted_quantity", "returned_quantity", "uom_code", "approved_amount_minor", "gross_amount_minor", "benefit_amount_minor", "net_amount_minor", "refunded_amount_minor", "currency_code", "previous_status", "current_status", "active_step", "step_ordinal", "attempt", "inventory_operation_id", "inventory_ledger_transaction_id", "benefit_reversal_status", "benefit_reversal_batch_id", "benefit_reversal_amount_minor", "payment_refund_transaction_id", "order_settlement_effect_id", "order_settlement_version", "order_return_full", "order_refund_operation_id", "order_return_operation_id", "order_version", "checkpoints", "error_code", "error_message", "next_retry_at"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "saga_id": {"type": "string", "format": "uuid"},
    "after_sale_id": {"type": "string", "format": "uuid"},
    "after_sale_item_id": {"type": "string", "format": "uuid"},
    "order_id": {"type": "string", "format": "uuid"},
    "order_item_id": {"type": "string", "format": "uuid"},
    "payment_id": {"type": "string", "format": "uuid"},
    "return_fulfillment_id": {"type": "string", "format": "uuid"},
    "return_shipment_id": {"type": "string", "format": "uuid"},
    "inspection_id": {"type": "string", "format": "uuid"},
    "canonical_sku_id": {"type": "string", "format": "uuid"},
    "quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.0{1,6})?$"},
    "accepted_quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.0{1,6})?$"},
    "returned_quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
    "uom_code": {"const": "PCS"},
    "approved_amount_minor": {"type": "integer", "minimum": 0},
    "gross_amount_minor": {"type": "integer", "minimum": 0},
    "benefit_amount_minor": {"type": "integer", "minimum": 0},
    "net_amount_minor": {"type": "integer", "minimum": 1},
    "refunded_amount_minor": {"type": "integer", "minimum": 0},
    "currency_code": {"const": "CNY"},
    "previous_status": {"type": ["string", "null"]},
    "current_status": {"type": "string", "enum": ["REQUESTED", "RETURNING_INVENTORY", "INVENTORY_RETURNED", "REVERSING_BENEFITS", "BENEFITS_REVERSED", "REFUNDING_PAYMENT", "PAYMENT_REFUNDED", "SETTLING_ORDER", "ORDER_SETTLED", "CONFIRMING_ORDER_REFUND", "ORDER_REFUNDED", "RETURNING_ORDER", "ORDER_RETURNED", "RETRY_SCHEDULED", "MANUAL_REVIEW", "COMPLETED"]},
    "active_step": {"type": "string", "enum": ["NONE", "RETURN_INVENTORY", "REVERSE_BENEFITS", "REFUND_PAYMENT", "SETTLE_ORDER", "CONFIRM_ORDER_REFUND", "RETURN_ORDER", "COMPLETE"]},
    "step_ordinal": {"type": "integer", "minimum": 0, "maximum": 7},
    "attempt": {"type": "integer", "minimum": 0},
    "inventory_operation_id": {"type": ["integer", "null"], "minimum": 1},
    "inventory_ledger_transaction_id": {"type": ["integer", "null"], "minimum": 1},
    "benefit_reversal_status": {"type": "string", "enum": ["NOT_REQUIRED", "PENDING", "RECORDED"]},
    "benefit_reversal_batch_id": {"type": ["string", "null"], "format": "uuid"},
    "benefit_reversal_amount_minor": {"type": "integer", "minimum": 0},
    "payment_refund_transaction_id": {"type": ["integer", "null"], "minimum": 1},
    "order_settlement_effect_id": {"type": ["string", "null"], "format": "uuid"},
    "order_settlement_version": {"type": ["integer", "null"], "minimum": 1},
    "order_return_full": {"type": ["boolean", "null"]},
    "order_refund_operation_id": {"type": ["integer", "null"], "minimum": 1},
    "order_return_operation_id": {"type": ["integer", "null"], "minimum": 1},
    "order_version": {"type": ["integer", "null"], "minimum": 1},
    "checkpoints": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory_returned", "benefit_reversed", "payment_refunded", "order_settled", "order_refund_confirmed", "order_returned"],
      "properties": {
        "inventory_returned": {"type": "boolean"},
        "benefit_reversed": {"type": "boolean"},
        "payment_refunded": {"type": "boolean"},
        "order_settled": {"type": "boolean"},
        "order_refund_confirmed": {"type": "boolean"},
        "order_returned": {"type": "boolean"}
      }
    },
    "error_code": {"type": ["string", "null"], "maxLength": 64},
    "error_message": {"type": ["string", "null"], "maxLength": 512},
    "next_retry_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
