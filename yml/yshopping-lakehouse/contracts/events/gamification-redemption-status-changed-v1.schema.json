{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/gamification-redemption-status-changed-v1.schema.json",
  "title": "gamification.redemption.status_changed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["redemption_intent_id", "game_id", "principal_id", "adapter_code", "source_asset_class", "collectible_definition_id", "collectible_version", "quantity", "currency_code", "amount_microunits", "external_intent_ref", "external_result_ref", "previous_status", "current_status", "source_ledger_transaction_id", "contains_external_balance"],
  "properties": {
    "redemption_intent_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "game_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "principal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "adapter_code": {"type": "string", "const": "MALL_REDEMPTION_V1"},
    "source_asset_class": {"type": "string", "enum": ["GAME_COLLECTIBLE", "GAME_VIRTUAL_CURRENCY"]},
    "collectible_definition_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "collectible_version": {"type": ["integer", "null"], "minimum": 1},
    "quantity": {"type": ["integer", "null"], "minimum": 1},
    "currency_code": {"type": ["string", "null"], "pattern": "^GAME_COIN_(?!.*(?:TOKEN|COUPON|POINT|CNY|RMB|USD|MONEY))[A-Z0-9_]{2,40}$"},
    "amount_microunits": {"type": ["integer", "null"], "minimum": 1},
    "external_intent_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "external_result_ref": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "previous_status": {"type": ["string", "null"], "enum": [null, "PENDING"]},
    "current_status": {"type": "string", "enum": ["PENDING", "SUCCEEDED", "REJECTED"]},
    "source_ledger_transaction_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "contains_external_balance": {"type": "boolean", "const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"source_asset_class": {"const": "GAME_COLLECTIBLE"}}, "required": ["source_asset_class"]},
      "then": {"properties": {
        "collectible_definition_id": {"type": "string"}, "collectible_version": {"type": "integer", "minimum": 1},
        "quantity": {"type": "integer", "minimum": 1}, "currency_code": {"type": "null"}, "amount_microunits": {"type": "null"}
      }}
    },
    {
      "if": {"properties": {"source_asset_class": {"const": "GAME_VIRTUAL_CURRENCY"}}, "required": ["source_asset_class"]},
      "then": {"properties": {
        "collectible_definition_id": {"type": "null"}, "collectible_version": {"type": "null"}, "quantity": {"type": "null"},
        "currency_code": {"type": "string"}, "amount_microunits": {"type": "integer", "minimum": 1}
      }}
    },
    {
      "if": {"properties": {"current_status": {"const": "PENDING"}}, "required": ["current_status"]},
      "then": {"properties": {"external_result_ref": {"type": "null"}, "source_ledger_transaction_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"current_status": {"const": "REJECTED"}}, "required": ["current_status"]},
      "then": {"properties": {"external_result_ref": {"type": "string"}, "source_ledger_transaction_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"current_status": {"const": "SUCCEEDED"}, "source_asset_class": {"const": "GAME_COLLECTIBLE"}}, "required": ["current_status", "source_asset_class"]},
      "then": {"properties": {"external_result_ref": {"type": "string"}, "source_ledger_transaction_id": {"type": "null"}}}
    },
    {
      "if": {"properties": {"current_status": {"const": "SUCCEEDED"}, "source_asset_class": {"const": "GAME_VIRTUAL_CURRENCY"}}, "required": ["current_status", "source_asset_class"]},
      "then": {"properties": {"external_result_ref": {"type": "string"}, "source_ledger_transaction_id": {"type": "string"}}}
    }
  ]
}
