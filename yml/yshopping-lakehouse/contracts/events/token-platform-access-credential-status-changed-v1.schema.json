{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://cloudmold.local/contracts/token-platform-access-credential-status-changed-v1.schema.json",
  "title": "token_platform.access_credential.status_changed payload v1", "type": "object", "additionalProperties": false,
  "required": ["credential_id", "principal_id", "offering_id", "credential_fingerprint", "key_version", "current_status", "operation"],
  "properties": {
    "credential_id": {"type": "string", "minLength": 1, "maxLength": 64}, "principal_id": {"type": "string", "minLength": 1, "maxLength": 64}, "offering_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "credential_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "key_version": {"type": "integer", "minimum": 1},
    "previous_status": {"type": ["string", "null"], "enum": ["INACTIVE", "ACTIVE", "REVOKED", null]}, "current_status": {"type": "string", "enum": ["INACTIVE", "ACTIVE", "REVOKED"]},
    "expires_at": {"type": "string", "format": "date-time"}, "operation": {"type": "string", "enum": ["CREATE_ACCESS_CREDENTIAL", "ACTIVATE_ACCESS_CREDENTIAL", "REVOKE_ACCESS_CREDENTIAL"]}
  }
}
