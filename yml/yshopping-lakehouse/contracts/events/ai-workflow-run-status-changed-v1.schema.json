{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/ai-workflow-run-status-changed-v1.schema.json",
  "title": "ai.workflow.run.status_changed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "application_id", "workflow_id", "workflow_version", "trigger_type", "current_status", "expected_invocation_count", "started_at", "operation"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"},
    "application_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"},
    "workflow_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"},
    "workflow_version": {"type": "integer", "minimum": 1},
    "trigger_type": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,31}$"},
    "previous_status": {"type": "string", "enum": ["RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]},
    "current_status": {"type": "string", "enum": ["RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]},
    "expected_invocation_count": {"type": "integer", "minimum": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "error_code": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "operation": {"type": "string", "enum": ["START_WORKFLOW_RUN", "COMPLETE_WORKFLOW_RUN", "FAIL_WORKFLOW_RUN", "CANCEL_WORKFLOW_RUN"]}
  }
}
