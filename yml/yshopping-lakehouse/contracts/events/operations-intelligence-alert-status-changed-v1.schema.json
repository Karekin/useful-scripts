{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/operations-intelligence-alert-status-changed-v1.schema.json","title":"operations_intelligence.alert.status_changed payload v1","type":"object","additionalProperties":false,
  "required":["alert_id","alert_code","source_type","source_ref","severity","category","subcategory","evidence_ref","title_sha256","previous_status","current_status","actor_principal_id","reason_code","operation"],
  "properties":{"alert_id":{"$ref":"#/$defs/id"},"alert_code":{"$ref":"#/$defs/code"},"source_type":{"type":"string","enum":["OBSERVATION","CLUE","METADATA_TASK","METRIC"]},"source_ref":{"$ref":"#/$defs/id"},"severity":{"type":"string","enum":["LOW","MEDIUM","HIGH","CRITICAL"]},"category":{"$ref":"#/$defs/code"},"subcategory":{"$ref":"#/$defs/code"},"evidence_ref":{"$ref":"#/$defs/evidence"},"title_sha256":{"$ref":"#/$defs/hash"},"previous_status":{"type":["string","null"],"enum":[null,"OPEN","NOTIFIED","CLAIMED"]},"current_status":{"type":"string","enum":["OPEN","NOTIFIED","CLAIMED","RESOLVED","INVALID","CLOSED_NO_ACTION"]},"actor_principal_id":{"$ref":"#/$defs/id"},"reason_code":{"anyOf":[{"$ref":"#/$defs/code"},{"type":"null"}]},"operation":{"type":"string","enum":["OPEN_ALERT","NOTICE_ALERT","CLAIM_ALERT","RESOLVE_ALERT","INVALIDATE_ALERT","CLOSE_ALERT_NO_ACTION"]}},
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"},"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence":{"type":"string","pattern":"^(?:sha256:[0-9a-f]{64}|restricted:[A-Za-z0-9_-]{16,128})$"}}
}
