{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/risk-payment-dispute-status-changed-v1.schema.json",
  "title": "risk.payment_dispute.status_changed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dispute_id", "order_id", "payment_id", "case_id", "decision_id", "dispute_type", "previous_status", "current_status", "reason_code", "amount_minor", "currency_code", "external_ref", "opened_at", "resolved_at", "occurred_at"],
  "properties": {
    "dispute_id": {"type": "string", "format": "uuid"},
    "order_id": {"type": "string", "format": "uuid"},
    "payment_id": {"type": "string", "format": "uuid"},
    "case_id": {"type": ["string", "null"], "format": "uuid"},
    "decision_id": {"type": ["string", "null"], "format": "uuid"},
    "dispute_type": {"type": "string", "enum": ["CHARGEBACK", "PAYMENT_DISPUTE"]},
    "previous_status": {"type": ["string", "null"], "enum": [null, "OPEN", "WON", "LOST", "REVERSED", "CANCELLED"]},
    "current_status": {"type": "string", "enum": ["OPEN", "WON", "LOST", "REVERSED", "CANCELLED"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,63}$"},
    "amount_minor": {"type": "integer", "minimum": 1},
    "currency_code": {"type": "string", "const": "CNY"},
    "external_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]{1,127}$"},
    "opened_at": {"type": "string", "format": "date-time"},
    "resolved_at": {"type": ["string", "null"], "format": "date-time"},
    "occurred_at": {"type": "string", "format": "date-time"}
  }
}
