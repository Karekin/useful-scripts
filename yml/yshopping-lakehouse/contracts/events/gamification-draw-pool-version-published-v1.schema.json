{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://cloudmold.local/contracts/gamification-draw-pool-version-published-v1.schema.json",
  "title": "gamification.draw_pool.version_published payload v1", "type": "object", "additionalProperties": false,
  "required": ["draw_pool_id", "game_id", "draw_pool_code", "pool_version", "status", "price_microunits", "total_weight", "definition_sha256"],
  "properties": {
    "draw_pool_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"}, "game_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "draw_pool_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}, "pool_version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "const": "PUBLISHED"}, "price_microunits": {"type": "integer", "minimum": 1},
    "total_weight": {"type": "integer", "minimum": 1}, "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
