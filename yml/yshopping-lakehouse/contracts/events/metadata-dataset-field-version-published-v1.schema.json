  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/metadata-dataset-field-version-published-v1.schema.json","title":"metadata.dataset_field.version_published payload v1","type":"object","additionalProperties":false,
