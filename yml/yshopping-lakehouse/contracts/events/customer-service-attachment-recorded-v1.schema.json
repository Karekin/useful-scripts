{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/customer-service-attachment-recorded-v1.schema.json",
  "title":"customer_service.attachment.recorded payload v1","type":"object","additionalProperties":false,
