{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/listing-review-decided-v1.schema.json",
  "title": "listing.review.decided payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "listing_id", "listing_no", "revision", "stage", "decision", "reason"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "listing_id": {"type": "string", "format": "uuid"},
    "listing_no": {"type": "string", "minLength": 1, "maxLength": 32},
    "revision": {"type": "integer", "minimum": 1},
    "stage": {"type": "string", "enum": ["COMPLETION", "BUSINESS", "RISK"]},
    "decision": {"type": "string", "enum": ["PASSED", "REJECTED"]},
    "reason": {"type": ["string", "null"], "maxLength": 256}
  }
}
