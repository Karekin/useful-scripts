{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/merchant-onboarding-status-changed-v1.schema.json",
  "title": "merchant.onboarding.status_changed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "application_id", "legal_entity_id", "owner_principal_id", "channel_code",
    "external_shop_id", "previous_status", "current_status"
  ],
  "properties": {
    "application_id": {"type": "string", "format": "uuid"},
    "legal_entity_id": {"type": "string", "format": "uuid"},
    "owner_principal_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "channel_code": {"type": "string", "minLength": 1, "maxLength": 32},
    "external_shop_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "previous_status": {"type": ["string", "null"], "enum": [null, "DRAFT", "SUBMITTED", "UNDER_REVIEW"]},
    "current_status": {"type": "string", "enum": ["DRAFT", "SUBMITTED", "UNDER_REVIEW", "APPROVED", "REJECTED", "WITHDRAWN"]},
    "merchant_id": {"type": "string", "format": "uuid"},
    "shop_id": {"type": "string", "format": "uuid"}
  }
}
