{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/inventory-migration-pilot-batch-status-changed-v1.schema.json",
  "title": "inventory.migration.pilot_batch_status_changed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pilot_batch_id", "migration_run_id", "environment", "environment_fingerprint",
    "source_system", "source_type", "source_classification", "manifest_hash", "policy_version",
    "policy_hash", "expected_item_count", "expected_on_hand_quantity", "approved_item_count",
    "approved_on_hand_quantity", "admitted_item_count", "admitted_on_hand_quantity",
    "approval_count", "approval_roles", "requester_system_user_id", "approver_system_user_ids",
    "executor_system_user_id", "warehouse_id", "base_uom_code", "source_watermark_kind",
    "source_watermark_value", "source_watermark_captured_at", "target_watermark_kind",
    "target_watermark_value", "target_watermark_applied_at", "max_lag_seconds", "execution_window_start",
    "execution_window_end", "batch_status", "execution_available", "cutover_ready"
  ],
  "properties": {
    "pilot_batch_id": {"type": "string", "format": "uuid"},
    "migration_run_id": {"type": "string", "format": "uuid"},
    "environment": {"type": "string", "const": "PRODUCTION"},
    "environment_fingerprint": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_system": {"type": "string", "const": "CLOUDMOLD_INVENTORY_V1"},
    "source_type": {"type": "string", "const": "BALANCE"},
    "source_classification": {"type": "string", "const": "PRODUCTION_HISTORY"},
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 32},
    "policy_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expected_item_count": {"type": "integer", "minimum": 1, "maximum": 10},
    "expected_on_hand_quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]{1,6})?$"},
    "approved_item_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "approved_on_hand_quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "admitted_item_count": {"type": "integer", "minimum": 0, "maximum": 10},
    "admitted_on_hand_quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "approval_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "approval_roles": {"type": "array", "uniqueItems": true, "maxItems": 2, "items": {"type": "string", "enum": ["DATA_OWNER", "CHANGE_MANAGER"]}},
    "requester_system_user_id": {"type": "integer", "minimum": 1},
    "approver_system_user_ids": {"type": "array", "uniqueItems": true, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
    "executor_system_user_id": {"type": ["integer", "null"], "minimum": 1},
    "warehouse_id": {"type": "string", "format": "uuid"},
    "base_uom_code": {"type": "string", "pattern": "^[A-Z0-9._-]+$", "maxLength": 32},
    "source_watermark_kind": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 32},
    "source_watermark_value": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_watermark_captured_at": {"type": "string", "format": "date-time"},
    "target_watermark_kind": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 32},
    "target_watermark_value": {"type": "string", "minLength": 1, "maxLength": 256},
    "target_watermark_applied_at": {"type": "string", "format": "date-time"},
    "max_lag_seconds": {"type": "integer", "minimum": 0, "maximum": 300},
    "execution_window_start": {"type": "string", "format": "date-time"},
    "execution_window_end": {"type": "string", "format": "date-time"},
    "batch_status": {"type": "string", "enum": ["FROZEN", "PARTIALLY_APPROVED", "APPROVED", "ADMISSION_PASSED"]},
    "execution_available": {"type": "boolean", "const": false},
    "cutover_ready": {"type": "boolean", "const": false}
  }
}
