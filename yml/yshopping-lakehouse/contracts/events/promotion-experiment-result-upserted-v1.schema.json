{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/promotion-experiment-result-upserted-v1.schema.json",
  "title": "promotion.experiment_result.upserted payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id", "experiment_code", "campaign_id", "merchant_id",
    "measured_from", "measured_to", "baseline_contribution_profit_minor",
    "treatment_contribution_profit_minor", "incremental_contribution_profit_minor",
    "promotion_cost_minor", "eligible_population_count", "treatment_population_count",
    "control_population_count", "currency_code", "methodology_ref"
  ],
  "properties": {
    "experiment_id": {"type": "string", "format": "uuid"},
    "experiment_code": {"type": "string", "minLength": 8, "maxLength": 128},
    "campaign_id": {"type": "string", "format": "uuid"},
    "merchant_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "measured_from": {"type": "string", "format": "date-time"},
    "measured_to": {"type": "string", "format": "date-time"},
    "baseline_contribution_profit_minor": {"type": "integer", "minimum": 0},
    "treatment_contribution_profit_minor": {"type": "integer", "minimum": 0},
    "incremental_contribution_profit_minor": {"type": "integer"},
    "promotion_cost_minor": {"type": "integer", "minimum": 1},
    "eligible_population_count": {"type": "integer", "minimum": 1},
    "treatment_population_count": {"type": "integer", "minimum": 1},
    "control_population_count": {"type": "integer", "minimum": 1},
    "currency_code": {"type": "string", "const": "CNY"},
    "methodology_ref": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
