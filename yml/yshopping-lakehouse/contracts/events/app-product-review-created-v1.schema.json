{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/app-product-review-created-v1.schema.json",
  "title": "app.product_review.created payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "order_id",
    "order_item_id",
    "listing_id",
    "listing_offer_id",
    "merchant_id",
    "shop_id",
    "canonical_spu_id",
    "canonical_sku_id",
    "product_score",
    "service_score",
    "logistics_score",
    "overall_score",
    "content_digest_sha256",
    "public_summary",
    "moderation_status",
    "moderation_policy"
  ],
  "properties": {
    "review_id": {"type": "string", "format": "uuid"},
    "order_id": {"type": "string", "format": "uuid"},
    "order_item_id": {"type": "string", "format": "uuid"},
    "listing_id": {"type": "string", "format": "uuid"},
    "listing_offer_id": {"type": "string", "format": "uuid"},
    "merchant_id": {"type": "string", "format": "uuid"},
    "shop_id": {"type": "string", "format": "uuid"},
    "canonical_spu_id": {"type": "string", "format": "uuid"},
    "canonical_sku_id": {"type": "string", "format": "uuid"},
    "product_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "service_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "logistics_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "overall_score": {"type": "integer", "minimum": 1, "maximum": 5},
    "content_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "public_summary": {"type": "string", "maxLength": 160},
    "moderation_status": {"type": "string", "maxLength": 32},
    "moderation_policy": {"type": "string", "maxLength": 32}
  }
}
