{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/crm-customer-status-changed-v1.schema.json",
  "title": "crm.customer.status_changed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "customer_id",
    "customer_code",
    "owner_principal_id",
    "previous_status",
    "current_status",
    "follow_up_status",
    "deal_status",
    "lock_status",
    "source_code",
    "industry_code",
    "level_code",
    "last_follow_up_at",
    "next_contact_at",
    "linked_contact_count",
    "linked_opportunity_count"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "customer_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "customer_code": {"type": "string", "minLength": 1, "maxLength": 64},
    "owner_principal_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "previous_status": {
      "type": ["string", "null"],
      "enum": [null, "ACTIVE", "AT_RISK", "DEAL", "INACTIVE", "LOCKED", "ARCHIVED"]
    },
    "current_status": {
      "type": "string",
      "enum": ["ACTIVE", "AT_RISK", "DEAL", "INACTIVE", "LOCKED", "ARCHIVED"]
    },
    "follow_up_status": {"type": "boolean"},
    "deal_status": {"type": "boolean"},
    "lock_status": {"type": "boolean"},
    "source_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "industry_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "level_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "last_follow_up_at": {"type": ["string", "null"], "format": "date-time"},
    "next_contact_at": {"type": ["string", "null"], "format": "date-time"},
    "linked_contact_count": {"type": "integer", "minimum": 0},
    "linked_opportunity_count": {"type": "integer", "minimum": 0}
  }
}
