{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/commerce-behavior-recorded-v1.schema.json",
  "title": "commerce.behavior.recorded payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "behavior_id",
    "session_id",
    "session_version",
    "behavior_type",
    "principal_id",
    "canonical_spu_id",
    "sku_id",
    "listing_id",
    "listing_offer_id",
    "merchant_id",
    "shop_id",
    "channel_code",
    "search_token",
    "result_set_token",
    "result_position",
    "quantity",
    "checkout_token",
    "occurred_at",
    "source_system",
    "source_type",
    "source_id"
  ],
  "properties": {
    "run_id": {"type": "string", "format": "uuid"},
    "behavior_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "session_version": {"type": "integer", "minimum": 1},
    "principal_id": {"type": ["string", "null"], "format": "uuid"},
    "behavior_type": {
      "type": "string",
      "enum": [
        "PDP_VIEWED",
        "SEARCH_REQUESTED",
        "SEARCH_RESULT_EXPOSED",
        "SEARCH_RESULT_CLICKED",
        "CART_ADDED",
        "CART_REMOVED",
        "CHECKOUT_STARTED",
        "CHECKOUT_ABANDONED"
      ]
    },
    "canonical_spu_id": {"type": ["string", "null"], "format": "uuid"},
    "sku_id": {"type": ["string", "null"], "format": "uuid"},
    "listing_id": {"type": ["string", "null"], "format": "uuid"},
    "listing_offer_id": {"type": ["string", "null"], "format": "uuid"},
    "merchant_id": {"type": ["string", "null"], "maxLength": 128},
    "shop_id": {"type": ["string", "null"], "maxLength": 128},
    "channel_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,31}$"},
    "search_token": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "result_set_token": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "result_position": {"type": ["integer", "null"], "minimum": 0},
    "quantity": {"type": ["integer", "null"], "minimum": 1},
    "checkout_token": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "source_system": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"},
    "source_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,31}$"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
