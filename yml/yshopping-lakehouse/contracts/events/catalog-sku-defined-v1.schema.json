{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/catalog-sku-defined-v1.schema.json",
  "title": "catalog.sku.defined payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_style_id", "style_code", "style_name", "brand_ref", "planning_category_ref",
    "planning_year", "season_code", "wave_code", "canonical_spu_id", "spu_code", "product_name",
    "sales_category_ref", "canonical_sku_id", "sku_code", "variant_key", "variant_key_hash",
    "color_id", "color_code", "color_name", "size_group_id", "size_group_code", "size_id",
    "size_code", "size_name", "base_uom_code", "primary_barcode", "status", "version"
  ],
  "properties": {
    "canonical_style_id": {"type": "string", "format": "uuid"},
    "style_code": {"type": "string", "minLength": 1, "maxLength": 64},
    "style_name": {"type": "string", "minLength": 1, "maxLength": 255},
    "brand_ref": {"type": "string", "pattern": "^[A-Z0-9_-]+:[A-Z0-9_-]+:.+$"},
    "planning_category_ref": {"type": "string", "pattern": "^[A-Z0-9_-]+:[A-Z0-9_-]+:.+$"},
    "planning_year": {"type": "integer", "minimum": 2000},
    "season_code": {"type": "string", "enum": ["SPRING", "SUMMER", "AUTUMN", "WINTER", "ALL_SEASON"]},
    "wave_code": {"type": ["string", "null"], "maxLength": 32},
    "canonical_spu_id": {"type": "string", "format": "uuid"},
    "spu_code": {"type": "string", "minLength": 1, "maxLength": 64},
    "product_name": {"type": "string", "minLength": 1, "maxLength": 255},
    "sales_category_ref": {"type": "string", "pattern": "^[A-Z0-9_-]+:[A-Z0-9_-]+:.+$"},
    "canonical_sku_id": {"type": "string", "format": "uuid"},
    "sku_code": {"type": "string", "minLength": 1, "maxLength": 64},
    "variant_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "variant_key_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "color_id": {"type": "string", "format": "uuid"},
    "color_code": {"type": "string", "minLength": 1, "maxLength": 32},
    "color_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "size_group_id": {"type": "string", "format": "uuid"},
    "size_group_code": {"type": "string", "minLength": 1, "maxLength": 32},
    "size_id": {"type": "string", "format": "uuid"},
    "size_code": {"type": "string", "minLength": 1, "maxLength": 32},
    "size_name": {"type": "string", "minLength": 1, "maxLength": 64},
    "base_uom_code": {"type": "string", "const": "PCS"},
    "primary_barcode": {"type": "string", "minLength": 1, "maxLength": 64},
    "status": {"type": "string", "const": "DRAFT"},
    "version": {"type": "integer", "const": 1}
  }
}
