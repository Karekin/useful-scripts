{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/order-status-changed-v2.schema.json",
  "title": "order.status.changed payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "order_id", "order_no", "buyer_id", "previous_status", "current_status",
    "product_amount_minor", "shipping_amount_minor", "discount_amount_minor", "payable_amount_minor",
    "currency_code", "payment_id", "fulfillment_id", "shipment_id", "refund_id", "reason", "items"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "order_id": {"type": "string", "format": "uuid"},
    "order_no": {"type": "string", "minLength": 1, "maxLength": 32},
    "buyer_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "previous_status": {"type": ["string", "null"], "enum": [null, "PLACED", "INVENTORY_RESERVED", "CANCELLATION_PENDING", "PAYMENT_CONFIRMED", "SHIPPED", "COMPLETED", "REFUNDED"]},
    "current_status": {"type": "string", "enum": ["PLACED", "INVENTORY_RESERVED", "CANCELLATION_PENDING", "PAYMENT_CONFIRMED", "SHIPPED", "COMPLETED", "REFUNDED", "RETURNED", "CANCELLED"]},
    "product_amount_minor": {"type": "integer", "minimum": 0},
    "shipping_amount_minor": {"type": "integer", "minimum": 0},
    "discount_amount_minor": {"type": "integer", "minimum": 0},
    "payable_amount_minor": {"type": "integer", "minimum": 0},
    "currency_code": {"type": "string", "enum": ["CNY"]},
    "payment_id": {"type": ["string", "null"]},
    "cancellation_saga_id": {"type": ["string", "null"], "format": "uuid"},
    "pre_cancellation_status": {"type": ["string", "null"], "enum": [null, "INVENTORY_RESERVED"]},
    "responsibility_party": {"type": ["string", "null"], "enum": [null, "MERCHANT", "BUYER", "PLATFORM", "CARRIER"]},
    "responsibility_code": {"type": ["string", "null"], "enum": [null, "MERCHANT_STOCKOUT", "MERCHANT_SELLER_REJECTED", "MERCHANT_MANUAL_CANCEL", "BUYER_CHANGED_MIND", "BUYER_ADDRESS_ERROR", "BUYER_PAYMENT_ABANDONED", "PLATFORM_RISK_BLOCK", "PLATFORM_COMPLIANCE_BLOCK", "PLATFORM_PRICE_ERROR", "CARRIER_UNSERVICEABLE", "CARRIER_CAPACITY_BLOCK", "CARRIER_DAMAGE_RISK"]},
    "fulfillment_id": {"type": ["string", "null"]},
    "shipment_id": {"type": ["string", "null"]},
    "refund_id": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"], "maxLength": 256},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order_item_id", "canonical_sku_id", "quantity", "unit_price_minor", "line_amount_minor",
          "reservation_id", "listing_id", "listing_offer_id", "listing_revision", "listing_version",
          "channel_code", "shop_id"
        ],
        "properties": {
          "order_item_id": {"type": "string", "format": "uuid"},
          "canonical_sku_id": {"type": "string", "format": "uuid"},
          "quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.0{1,6})?$"},
          "unit_price_minor": {"type": "integer", "minimum": 0},
          "line_amount_minor": {"type": "integer", "minimum": 0},
          "merchandise_cost_minor": {"type": ["integer", "null"], "minimum": 0},
          "reservation_id": {"type": ["string", "null"]},
          "listing_id": {"type": "string", "format": "uuid"},
          "listing_offer_id": {"type": "string", "format": "uuid"},
          "listing_revision": {"type": "integer", "minimum": 1},
          "listing_version": {"type": "integer", "minimum": 1},
          "channel_code": {"type": "string", "enum": ["INTERNAL_COMPANY", "YSHOPPING_INTERNAL", "YSHOPPING"]},
          "shop_id": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      }
    }
  }
}
