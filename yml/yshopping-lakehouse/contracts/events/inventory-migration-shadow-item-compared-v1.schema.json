{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/inventory-migration-shadow-item-compared-v1.schema.json",
  "title": "inventory.migration.shadow_item_compared payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "shadow_comparison_id", "shadow_window_id", "shadow_round_id", "pilot_batch_id", "pilot_item_id",
    "round_sequence", "manifest_ordinal", "item_scope_hash", "manifest_hash", "expected_item_set_hash",
    "source_gtid_set", "target_gtid_set", "source_available", "source_version", "source_snapshot_hash",
    "source_grain_hash", "source_on_hand_quantity", "source_reserved_quantity", "source_in_transit_quantity",
    "target_projection_kind", "target_materialized", "target_available", "target_projection_version",
    "target_snapshot_hash", "target_grain_hash", "target_on_hand_quantity", "target_reserved_quantity",
    "target_in_transit_quantity", "comparable", "comparison_result", "difference_fields", "reason_codes",
    "source_observed_at", "target_observed_at", "execution_available", "cutover_ready"
  ],
  "properties": {
    "shadow_comparison_id": {"type": "string", "format": "uuid"},
    "shadow_window_id": {"type": "string", "format": "uuid"},
    "shadow_round_id": {"type": "string", "format": "uuid"},
    "pilot_batch_id": {"type": "string", "format": "uuid"},
    "pilot_item_id": {"type": "string", "format": "uuid"},
    "round_sequence": {"type": "integer", "minimum": 1},
    "manifest_ordinal": {"type": "integer", "minimum": 1},
    "item_scope_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "expected_item_set_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_gtid_set": {"type": "string", "minLength": 1, "maxLength": 4096},
    "target_gtid_set": {"type": "string", "minLength": 1, "maxLength": 4096},
    "source_available": {"type": "boolean", "const": true},
    "source_version": {"type": "integer", "minimum": 1},
    "source_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_grain_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_on_hand_quantity": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "source_reserved_quantity": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "source_in_transit_quantity": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "target_projection_kind": {"type": "string", "const": "CANONICAL_INVENTORY_V3_SHADOW_PROJECTION"},
    "target_materialized": {"type": "boolean", "const": false},
    "target_available": {"type": "boolean"},
    "target_projection_version": {"type": ["integer", "null"], "minimum": 1},
    "target_snapshot_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "target_grain_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "target_on_hand_quantity": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "target_reserved_quantity": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "target_in_transit_quantity": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "comparable": {"type": "boolean"},
    "comparison_result": {"type": "string", "enum": ["MATCH", "DIFFERENT", "UNCOMPARABLE"]},
    "difference_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["GRAIN", "SNAPSHOT", "ON_HAND", "RESERVED", "IN_TRANSIT"]}},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["VALUE_DIFFERENCE", "GRAIN_DIFFERENCE", "SNAPSHOT_DIFFERENCE", "TARGET_MISSING", "TARGET_READ_ERROR", "TARGET_WATERMARK_NOT_COVERED", "WATERMARK_LAG_EXCEEDED", "ROUND_GAP_EXCEEDED", "WATERMARK_VALIDATION_FAILED"]}},
    "source_observed_at": {"type": "string", "format": "date-time"},
    "target_observed_at": {"type": ["string", "null"], "format": "date-time"},
    "execution_available": {"type": "boolean", "const": false},
    "cutover_ready": {"type": "boolean", "const": false}
  }
}
