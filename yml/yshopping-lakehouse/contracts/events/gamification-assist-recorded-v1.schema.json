{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://cloudmold.local/contracts/gamification-assist-recorded-v1.schema.json",
  "title": "gamification.assist.recorded payload v1", "type": "object", "additionalProperties": false,
  "required": ["assist_record_id", "game_id", "helper_principal_id", "beneficiary_principal_id", "quota_date", "ordinal", "assist_limit", "assists_used"],
  "properties": {
    "assist_record_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"}, "game_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "helper_principal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"}, "beneficiary_principal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "quota_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "ordinal": {"type": "integer", "minimum": 1}, "assist_limit": {"type": "integer", "minimum": 0}, "assists_used": {"type": "integer", "minimum": 0}
  }
}
