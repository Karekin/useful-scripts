{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/risk-intelligence-event-taxonomy-retired-v1.schema.json","title":"risk.intelligence_event_taxonomy.retired payload v1","type":"object","additionalProperties":false,
  "required":["taxonomy_id","definition_version","event_code","level_codes","previous_status","current_status","retired_by_principal_id","reason_code","retired_at","source_system","source_table","source_record_key","source_version","source_observed_at","source_evidence_ref","source_evidence_sha256"],
  "properties":{
    "taxonomy_id":{"$ref":"#/$defs/id"},"definition_version":{"type":"integer","minimum":1},"event_code":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"level_codes":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/level"}},
    "previous_status":{"type":"string","const":"PUBLISHED"},"current_status":{"type":"string","const":"RETIRED"},"retired_by_principal_id":{"$ref":"#/$defs/ref"},"reason_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"},"retired_at":{"type":"string","format":"date-time"},
    "source_system":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"},"source_table":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,127}$"},"source_record_key":{"$ref":"#/$defs/ref"},"source_version":{"$ref":"#/$defs/ref"},"source_observed_at":{"type":"string","format":"date-time"},"source_evidence_ref":{"$ref":"#/$defs/evidence"},"source_evidence_sha256":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},"ref":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},"level":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]{0,31}$"},"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence":{"type":"string","pattern":"^(?:sha256:[0-9a-f]{64}|restricted:[A-Za-z0-9_-]{16,128})$"}}
}
