{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://cloudmold.local/contracts/engagement-community-content-status-changed-v1.schema.json",
  "title": "engagement.community.content_status_changed payload v1", "type": "object", "additionalProperties": false,
