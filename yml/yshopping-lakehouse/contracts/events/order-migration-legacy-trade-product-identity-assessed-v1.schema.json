{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/order-migration-legacy-trade-product-identity-assessed-v1.schema.json",
  "title": "order.migration.legacy_trade_product_identity_assessed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity_run_id", "source_migration_run_id", "identity_item_id", "candidate_id",
    "item_evidence_id", "legacy_order_id", "legacy_order_item_id", "legacy_spu_id", "legacy_sku_id",
    "source_item_evidence_hash", "source_parent_cardinality", "source_pair_status",
    "current_reference_status", "current_product_snapshot_hash", "qualification_id",
    "historical_identity_status", "blocker_codes", "identity_admission_allowed",
    "target_mapping_allowed", "evidence_hash", "run_source_item_count", "run_active_item_count",
    "run_source_pair_unambiguous_count", "run_source_parent_conflict_item_count",
    "run_current_relation_observed_count", "run_historical_identity_qualified_count",
    "run_identity_admitted_item_count", "target_mapping_enabled", "run_status",
    "governance_evidence_hash", "policy_version", "verification_ref", "assessed_at"
  ],
  "properties": {
    "identity_run_id": {"type": "string", "format": "uuid"},
    "source_migration_run_id": {"type": "string", "format": "uuid"},
    "identity_item_id": {"type": "string", "format": "uuid"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "item_evidence_id": {"type": "string", "format": "uuid"},
    "legacy_order_id": {"type": "integer", "minimum": 1},
    "legacy_order_item_id": {"type": "integer", "minimum": 1},
    "legacy_spu_id": {"type": ["integer", "null"], "minimum": 1},
    "legacy_sku_id": {"type": ["integer", "null"], "minimum": 1},
    "source_item_evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_parent_cardinality": {"type": "integer", "minimum": 0},
    "source_pair_status": {"type": "string", "enum": ["EXCLUDED", "SOURCE_IDS_MISSING", "SOURCE_PAIR_UNAMBIGUOUS_NOT_HISTORICAL_VERSION", "SOURCE_SKU_PARENT_CONFLICT"]},
    "current_reference_status": {"type": "string", "enum": ["NOT_OBSERVED_EXCLUDED", "CURRENT_RELATION_OBSERVED_NOT_HISTORICAL_VERSION", "CURRENT_RELATION_MISSING_OR_MISMATCH"]},
    "current_product_snapshot_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "qualification_id": {"type": ["string", "null"], "format": "uuid"},
    "historical_identity_status": {"type": "string", "enum": ["EXCLUDED", "QUALIFIED", "MISSING", "AMBIGUOUS"]},
    "blocker_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64}},
    "identity_admission_allowed": {"type": "boolean"},
    "target_mapping_allowed": {"type": "boolean"},
    "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_source_item_count": {"type": "integer", "minimum": 1},
    "run_active_item_count": {"type": "integer", "minimum": 0},
    "run_source_pair_unambiguous_count": {"type": "integer", "minimum": 0},
    "run_source_parent_conflict_item_count": {"type": "integer", "minimum": 0},
    "run_current_relation_observed_count": {"type": "integer", "minimum": 0},
    "run_historical_identity_qualified_count": {"type": "integer", "minimum": 0},
    "run_identity_admitted_item_count": {"type": "integer", "minimum": 0},
    "target_mapping_enabled": {"type": "boolean"},
    "run_status": {"type": "string", "enum": ["READY_FOR_TARGET_MAPPING_ASSESSMENT", "BLOCKED_REQUIRES_HISTORICAL_PRODUCT_IDENTITY"]},
    "governance_evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_version": {"type": "string", "const": "legacy-trade-product-identity-v1"},
    "verification_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "assessed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"historical_identity_status": {"const": "QUALIFIED"}}, "required": ["historical_identity_status"]}, "then": {"properties": {"qualification_id": {"type": "string", "format": "uuid"}, "identity_admission_allowed": {"const": true}, "target_mapping_allowed": {"const": true}, "blocker_codes": {"maxItems": 0}}}},
    {"if": {"properties": {"historical_identity_status": {"enum": ["EXCLUDED", "MISSING", "AMBIGUOUS"]}}, "required": ["historical_identity_status"]}, "then": {"properties": {"qualification_id": {"type": "null"}, "identity_admission_allowed": {"const": false}, "target_mapping_allowed": {"const": false}}}},
    {"if": {"properties": {"current_reference_status": {"const": "CURRENT_RELATION_OBSERVED_NOT_HISTORICAL_VERSION"}}, "required": ["current_reference_status"]}, "then": {"properties": {"current_product_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
    {"if": {"properties": {"target_mapping_enabled": {"const": true}}, "required": ["target_mapping_enabled"]}, "then": {"properties": {"run_status": {"const": "READY_FOR_TARGET_MAPPING_ASSESSMENT"}}}}
  ]
}
