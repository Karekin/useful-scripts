{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/ai-model-invocation-recorded-v1.schema.json",
  "title": "ai.model.invocation.recorded payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["attempt_id", "run_id", "application_id", "workflow_id", "provider_code", "model_code", "attempt_no", "outcome", "input_tokens", "cached_input_tokens", "output_tokens", "total_tokens", "latency_millis", "occurred_at"],
  "properties": {
    "attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"},
    "application_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"},
    "workflow_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$"},
    "provider_code": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,63}$"},
    "model_code": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "attempt_no": {"type": "integer", "minimum": 1},
    "outcome": {"type": "string", "enum": ["SUCCEEDED", "FAILED", "CANCELLED"]},
    "input_tokens": {"type": "integer", "minimum": 0},
    "cached_input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "total_tokens": {"type": "integer", "minimum": 0},
    "latency_millis": {"type": "integer", "minimum": 0},
    "cost_amount_minor": {"type": "integer", "minimum": 0},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "pricing_version_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "error_code": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "occurred_at": {"type": "string", "format": "date-time"}
  }
}
