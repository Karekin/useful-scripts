{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/inventory-migration-pilot-item-status-changed-v1.schema.json",
  "title": "inventory.migration.pilot_item_status_changed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pilot_batch_id", "pilot_item_id", "manifest_ordinal", "item_scope_hash", "manifest_hash",
    "migration_run_id", "assessment_id", "source_system", "source_type", "source_id",
    "source_classification", "source_version", "source_updated_at", "source_snapshot_hash",
    "source_on_hand_quantity", "source_reserved_quantity", "source_in_transit_quantity",
    "active_reservation_count", "active_reservation_quantity", "owner_type", "owner_id",
    "owner_mapping_id", "owner_mapping_version", "owner_mapping_evidence_ref", "canonical_sku_id",
    "sku_mapping_id", "sku_mapping_version", "sku_mapping_evidence_ref",
    "warehouse_source_mapping_id", "warehouse_mapping_version", "warehouse_mapping_evidence_ref",
    "warehouse_id", "location_source_mapping_id", "location_mapping_version",
    "location_mapping_evidence_ref", "location_id", "zone_id", "lot_tracking_policy", "lot_id",
    "lot_mapping_id", "lot_mapping_version", "lot_evidence_ref", "stock_status", "quality_status",
    "base_uom_code", "uom_conversion_ratio", "uom_evidence_ref", "authoritative_record_ref",
    "quantity_evidence_ref", "source_cdc_position", "source_extracted_at", "target_balance_absent",
    "bridge_absent", "item_status",
    "execution_available"
  ],
  "properties": {
    "pilot_batch_id": {"type": "string", "format": "uuid"},
    "pilot_item_id": {"type": "string", "format": "uuid"},
    "manifest_ordinal": {"type": "integer", "minimum": 1, "maximum": 10},
    "item_scope_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "migration_run_id": {"type": "string", "format": "uuid"},
    "assessment_id": {"type": "string", "format": "uuid"},
    "source_system": {"type": "string", "const": "CLOUDMOLD_INVENTORY_V1"},
    "source_type": {"type": "string", "const": "BALANCE"},
    "source_id": {"type": "string", "format": "uuid"},
    "source_classification": {"type": "string", "const": "PRODUCTION_HISTORY"},
    "source_version": {"type": "integer", "minimum": 1},
    "source_updated_at": {"type": "string", "format": "date-time"},
    "source_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_on_hand_quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]{1,6})?$"},
    "source_reserved_quantity": {"type": "string", "pattern": "^0(\\.0{1,6})?$"},
    "source_in_transit_quantity": {"type": "string", "pattern": "^0(\\.0{1,6})?$"},
    "active_reservation_count": {"type": "integer", "const": 0},
    "active_reservation_quantity": {"type": "string", "pattern": "^0(\\.0{1,6})?$"},
    "owner_type": {"type": "string", "const": "MERCHANT"},
    "owner_id": {"type": "string", "format": "uuid"},
    "owner_mapping_id": {"type": "string", "format": "uuid"},
    "owner_mapping_version": {"type": "integer", "minimum": 1},
    "owner_mapping_evidence_ref": {"type": "string", "pattern": "^(?i:sha256|sha512|ticket|run|evidence|vault|kms|token):[A-Za-z0-9._/-]+$", "maxLength": 256},
    "canonical_sku_id": {"type": "string", "format": "uuid"},
    "sku_mapping_id": {"type": "string", "format": "uuid"},
    "sku_mapping_version": {"type": "integer", "minimum": 1},
    "sku_mapping_evidence_ref": {"type": "string", "pattern": "^(?i:sha256|sha512|ticket|run|evidence|vault|kms|token):[A-Za-z0-9._/-]+$", "maxLength": 256},
    "warehouse_source_mapping_id": {"type": "string", "format": "uuid"},
    "warehouse_mapping_version": {"type": "integer", "minimum": 1},
    "warehouse_mapping_evidence_ref": {"type": "string", "pattern": "^(?i:sha256|sha512|ticket|run|evidence|vault|kms|token):[A-Za-z0-9._/-]+$", "maxLength": 256},
    "warehouse_id": {"type": "string", "format": "uuid"},
    "location_source_mapping_id": {"type": "string", "format": "uuid"},
    "location_mapping_version": {"type": "integer", "minimum": 1},
    "location_mapping_evidence_ref": {"type": "string", "pattern": "^(?i:sha256|sha512|ticket|run|evidence|vault|kms|token):[A-Za-z0-9._/-]+$", "maxLength": 256},
    "location_id": {"type": "string", "format": "uuid"},
    "zone_id": {"type": ["string", "null"], "format": "uuid"},
    "lot_tracking_policy": {"type": "string", "enum": ["NOT_TRACKED", "TRACKED"]},
    "lot_id": {"type": ["string", "null"], "format": "uuid"},
    "lot_mapping_id": {"type": ["string", "null"], "format": "uuid"},
    "lot_mapping_version": {"type": ["integer", "null"], "minimum": 1},
    "lot_evidence_ref": {"type": "string", "pattern": "^(?i:sha256|sha512|ticket|run|evidence|vault|kms|token):[A-Za-z0-9._/-]+$", "maxLength": 256},
    "stock_status": {"type": "string", "enum": ["SELLABLE", "NON_SELLABLE"]},
    "quality_status": {"type": "string", "enum": ["PENDING_QC", "QUALIFIED", "DAMAGED", "REJECTED"]},
    "base_uom_code": {"type": "string", "pattern": "^[A-Z0-9._-]+$", "maxLength": 32},
    "uom_conversion_ratio": {"type": "string", "pattern": "^1(\\.0+)?$"},
    "uom_evidence_ref": {"type": "string", "pattern": "^(?i:sha256|sha512|ticket|run|evidence|vault|kms|token):[A-Za-z0-9._/-]+$", "maxLength": 256},
    "authoritative_record_ref": {"type": "string", "pattern": "^(?i:sha256|sha512|ticket|run|evidence|vault|kms|token):[A-Za-z0-9._/-]+$", "maxLength": 256},
    "quantity_evidence_ref": {"type": "string", "pattern": "^(?i:sha256|sha512|ticket|run|evidence|vault|kms|token):[A-Za-z0-9._/-]+$", "maxLength": 256},
    "source_cdc_position": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_extracted_at": {"type": "string", "format": "date-time"},
    "target_balance_absent": {"type": "boolean", "const": true},
    "bridge_absent": {"type": "boolean", "const": true},
    "item_status": {"type": "string", "enum": ["FROZEN", "APPROVED", "ADMISSION_PASSED"]},
    "execution_available": {"type": "boolean", "const": false}
  },
  "allOf": [
    {"if": {"properties": {"lot_tracking_policy": {"const": "NOT_TRACKED"}}}, "then": {"properties": {"lot_id": {"type": "null"}, "lot_mapping_id": {"type": "null"}, "lot_mapping_version": {"type": "null"}}}},
    {"if": {"properties": {"lot_tracking_policy": {"const": "TRACKED"}}}, "then": {"properties": {"lot_id": {"type": "string", "format": "uuid"}, "lot_mapping_id": {"type": "string", "format": "uuid"}, "lot_mapping_version": {"type": "integer", "minimum": 1}}}}
  ]
}
