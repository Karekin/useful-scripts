{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/inventory-stock-changed-v5.schema.json",
  "title": "inventory.stock.changed cost-evidenced payload v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner_type", "owner_id", "canonical_sku_id", "warehouse_id", "location_id",
    "lot_id", "lot_code", "stock_status", "quality_status", "base_uom_code", "uom_code",
    "delta_quantity", "delta_on_hand_quantity", "delta_reserved_quantity",
    "delta_in_transit_quantity", "after_on_hand_quantity", "after_reserved_quantity",
    "after_in_transit_quantity", "after_available_quantity", "movement_type",
    "ledger_transaction_id", "movement_group_id", "entry_role", "counterparty_balance_id",
    "business_type", "business_id", "business_item_id", "business_no",
    "reservation_id", "allocation_id", "unit_cost_amount_minor", "movement_cost_amount_minor",
    "currency_code", "cost_source_system", "cost_source_ref", "cost_policy_version"
  ],
  "properties": {
    "owner_type": {"type": "string", "const": "MERCHANT"},
    "owner_id": {"type": "string", "format": "uuid"},
    "canonical_sku_id": {"type": "string", "format": "uuid"},
    "warehouse_id": {"type": "string", "format": "uuid"},
    "location_id": {"type": "string", "format": "uuid"},
    "lot_id": {"type": ["string", "null"], "format": "uuid"},
    "lot_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "stock_status": {"type": "string", "enum": ["SELLABLE", "NON_SELLABLE"]},
    "quality_status": {"type": "string", "enum": ["PENDING_QC", "QUALIFIED", "DAMAGED", "REJECTED"]},
    "base_uom_code": {"type": "string", "minLength": 1, "maxLength": 32},
    "uom_code": {"type": "string", "minLength": 1, "maxLength": 32},
    "delta_quantity": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$"},
    "delta_on_hand_quantity": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$"},
    "delta_reserved_quantity": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$"},
    "delta_in_transit_quantity": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,6})?$"},
    "after_on_hand_quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
    "after_reserved_quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
    "after_in_transit_quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
    "after_available_quantity": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$"},
    "movement_type": {"type": "string", "enum": ["PURCHASE_RECEIPT", "SALE_SHIPMENT", "SALE_RETURN"]},
    "ledger_transaction_id": {"type": "integer", "minimum": 1},
    "movement_group_id": {"type": "string", "format": "uuid"},
    "entry_role": {"type": "string", "const": "SINGLE"},
    "counterparty_balance_id": {"type": ["string", "null"], "format": "uuid"},
    "business_type": {"type": "string", "minLength": 1, "maxLength": 32},
    "business_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "business_item_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "business_no": {"type": "string", "minLength": 1, "maxLength": 128},
    "reservation_id": {"type": ["string", "null"], "format": "uuid"},
    "allocation_id": {"type": ["string", "null"], "format": "uuid"},
    "unit_cost_amount_minor": {"type": "integer", "minimum": 0},
    "movement_cost_amount_minor": {"type": "integer", "minimum": 0},
    "currency_code": {"type": "string", "pattern": "^[A-Z]{3}$"},
    "cost_source_system": {"type": "string", "minLength": 1, "maxLength": 64},
    "cost_source_ref": {"type": "string", "minLength": 1, "maxLength": 128},
    "cost_policy_version": {"type": "string", "minLength": 1, "maxLength": 64}
  }
}
