{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/metadata-dqc-rule-version-published-v1.schema.json","title":"metadata.dqc_rule.version_published payload v1","type":"object","additionalProperties":false,
  "required":["definition_id","definition_code","definition_version","display_name","owner_principal_id","specification_sha256","artifact_ref","previous_status","current_status","dataset_id","dataset_version","dataset_field","rule_type","severity","expression_sha256","threshold_value","threshold_comparator"],
  "properties":{
    "definition_id":{"$ref":"#/$defs/id"},"definition_code":{"$ref":"#/$defs/code"},"definition_version":{"type":"integer","minimum":1},"display_name":{"type":"string","minLength":3,"maxLength":160},"owner_principal_id":{"$ref":"#/$defs/id"},"specification_sha256":{"$ref":"#/$defs/sha"},"artifact_ref":{"$ref":"#/$defs/ref"},"previous_status":{"type":"string","enum":["DRAFT","PUBLISHED"]},"current_status":{"type":"string","const":"PUBLISHED"},"dataset_id":{"$ref":"#/$defs/id"},"dataset_version":{"type":"integer","minimum":1},"dataset_field":{"anyOf":[{"$ref":"#/$defs/code"},{"type":"null"}]},"rule_type":{"type":"string","enum":["NOT_NULL","UNIQUE","ROW_COUNT","RANGE","FRESHNESS","RECONCILIATION","CUSTOM_HASHED"]},"severity":{"type":"string","enum":["INFO","WARNING","ERROR","CRITICAL"]},"expression_sha256":{"$ref":"#/$defs/sha"},"threshold_value":{"type":"string","pattern":"^-?[0-9]+(?:\\.[0-9]+)?$"},"threshold_comparator":{"type":"string","enum":["EQ","NE","LT","LTE","GT","GTE"]}
  },
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{1,127}$"},"code":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]{1,127}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"ref":{"type":"string","pattern":"^(?:sha256:[0-9a-f]{64}|restricted:[A-Za-z0-9][A-Za-z0-9._/-]{7,159})$"}}
}
