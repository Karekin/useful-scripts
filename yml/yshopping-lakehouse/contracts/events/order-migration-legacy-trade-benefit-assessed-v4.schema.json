{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/order-migration-legacy-trade-benefit-assessed-v4.schema.json",
  "title": "order.migration.legacy_trade_benefit_assessed payload v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "migration_run_id", "candidate_id", "source_scope", "legacy_order_id", "legacy_order_no",
    "source_created_at", "source_updated_at", "legacy_buyer_id", "legacy_order_status",
    "buyer_source_identity_id", "buyer_principal_id", "buyer_identity_version", "buyer_identity_status",
    "source_snapshot_hash", "is_deleted", "header_quantity", "item_row_count", "item_quantity",
    "header_gross_amount_minor", "header_benefit_amount_minor", "header_pay_amount_minor",
    "item_gross_amount_minor", "item_benefit_amount_minor", "item_pay_amount_minor", "negative_money",
    "header_money_mismatch", "header_item_mismatch", "invalid_item_money_count", "assessment_status",
    "blocker_codes", "canonical_import_allowed", "components", "item_evidence_complete",
    "run_source_item_count", "run_active_item_count", "run_excluded_item_count",
    "run_item_evidence_hash", "run_item_evidence_benefit_amount_minor",
    "run_product_snapshot_captured_item_count", "run_product_snapshot_incomplete_item_count",
    "run_product_snapshot_evidence_hash", "run_product_snapshot_evidence_complete", "items",
    "policy_version", "verification_ref", "assessed_at"
  ],
  "properties": {
    "migration_run_id": {"type": "string", "format": "uuid"},
    "candidate_id": {"type": "string", "format": "uuid"},
    "source_scope": {"type": "string", "const": "LOCAL_YUDAO_TRADE_CURRENT"},
    "legacy_order_id": {"type": "integer", "minimum": 1},
    "legacy_order_no": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_created_at": {"type": "string", "format": "date-time"},
    "source_updated_at": {"type": "string", "format": "date-time"},
    "legacy_buyer_id": {"type": "integer", "minimum": 1},
    "legacy_order_status": {"type": "integer"},
    "buyer_source_identity_id": {"type": ["string", "null"], "format": "uuid"},
    "buyer_principal_id": {"type": ["string", "null"], "format": "uuid"},
    "buyer_identity_version": {"type": ["integer", "null"], "minimum": 1},
    "buyer_identity_status": {"type": "string", "enum": ["RESOLVED", "MISSING", "AMBIGUOUS"]},
    "source_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "is_deleted": {"type": "boolean"},
    "header_quantity": {"type": "integer"},
    "item_row_count": {"type": "integer", "minimum": 0},
    "item_quantity": {"type": "integer"},
    "header_gross_amount_minor": {"type": "integer"},
    "header_benefit_amount_minor": {"type": "integer"},
    "header_pay_amount_minor": {"type": "integer"},
    "item_gross_amount_minor": {"type": "integer"},
    "item_benefit_amount_minor": {"type": "integer"},
    "item_pay_amount_minor": {"type": "integer"},
    "negative_money": {"type": "boolean"},
    "header_money_mismatch": {"type": "boolean"},
    "header_item_mismatch": {"type": "boolean"},
    "invalid_item_money_count": {"type": "integer", "minimum": 0},
    "assessment_status": {"type": "string", "enum": [
      "DELETED_EXCLUDED", "NO_BENEFIT", "BENEFIT_REQUIRES_IDENTITY_AND_FUNDING",
      "QUARANTINED_MONEY", "QUARANTINED_HEADER_ITEM"
    ]},
    "blocker_codes": {"type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]+$", "maxLength": 64}},
    "canonical_import_allowed": {"type": "boolean", "const": false},
    "components": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["component_id", "component_type", "amount_minor", "source_reference",
          "identity_resolution_status", "funding_resolution_status", "canonical_import_allowed"],
        "properties": {
          "component_id": {"type": "string", "format": "uuid"},
          "component_type": {"type": "string", "enum": ["GENERIC_DISCOUNT", "COUPON", "POINT", "VIP"]},
          "amount_minor": {"type": "integer", "not": {"const": 0}},
          "source_reference": {"type": ["string", "null"], "maxLength": 128},
          "identity_resolution_status": {"type": "string", "enum": [
            "MISSING_SOURCE_REFERENCE", "AMBIGUOUS_SOURCE_REFERENCE", "SOURCE_REFERENCE_WITHOUT_VERSION",
            "MISSING_ENTITLEMENT_VERSION", "MISSING_BENEFIT_VERSION"
          ]},
          "funding_resolution_status": {"type": "string", "const": "MISSING_NAMED_FUNDER_BREAKDOWN"},
          "canonical_import_allowed": {"type": "boolean", "const": false}
        }
      }
    },
    "item_evidence_complete": {"type": "boolean", "const": true},
    "run_source_item_count": {"type": "integer", "minimum": 1},
    "run_active_item_count": {"type": "integer", "minimum": 0},
    "run_excluded_item_count": {"type": "integer", "minimum": 0},
    "run_item_evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_item_evidence_benefit_amount_minor": {"type": "integer"},
    "run_product_snapshot_captured_item_count": {"type": "integer", "minimum": 0},
    "run_product_snapshot_incomplete_item_count": {"type": "integer", "minimum": 0},
    "run_product_snapshot_evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run_product_snapshot_evidence_complete": {"type": "boolean"},
    "items": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["item_evidence_id", "legacy_order_item_id", "legacy_buyer_id",
          "legacy_item_snapshot_hash", "source_created_at", "source_updated_at", "is_deleted",
          "legacy_spu_id", "legacy_spu_name", "legacy_sku_id", "legacy_sku_properties_json",
          "legacy_sku_pic_url", "historical_product_snapshot_hash", "product_snapshot_status",
          "product_snapshot_semantics", "source_product_identity_status", "item_quantity",
          "unit_price_minor", "gross_amount_minor", "generic_discount_amount_minor",
          "coupon_amount_minor", "point_amount_minor", "vip_amount_minor", "delivery_amount_minor",
          "adjust_amount_minor", "pay_amount_minor", "used_point_quantity", "canonical_import_allowed"],
        "properties": {
          "item_evidence_id": {"type": "string", "format": "uuid"},
          "legacy_order_item_id": {"type": "integer", "minimum": 1},
          "legacy_buyer_id": {"type": "integer", "minimum": 1},
          "legacy_item_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_created_at": {"type": "string", "format": "date-time"},
          "source_updated_at": {"type": "string", "format": "date-time"},
          "is_deleted": {"type": "boolean"},
          "legacy_spu_id": {"type": ["integer", "null"]},
          "legacy_spu_name": {"type": ["string", "null"], "maxLength": 255},
          "legacy_sku_id": {"type": ["integer", "null"]},
          "legacy_sku_properties_json": {"type": ["string", "null"]},
          "legacy_sku_pic_url": {"type": ["string", "null"], "maxLength": 512},
          "historical_product_snapshot_hash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "product_snapshot_status": {"type": "string", "enum": ["CAPTURED", "INCOMPLETE"]},
          "product_snapshot_semantics": {"type": "string", "const": "ORDER_ITEM_ACCEPTED_PRODUCT_SNAPSHOT_V1"},
          "source_product_identity_status": {"type": "string", "enum": ["SOURCE_IDS_PRESENT", "MISSING_SOURCE_IDS"]},
          "item_quantity": {"type": "integer"},
          "unit_price_minor": {"type": "integer"},
          "gross_amount_minor": {"type": "integer"},
          "generic_discount_amount_minor": {"type": "integer"},
          "coupon_amount_minor": {"type": "integer"},
          "point_amount_minor": {"type": "integer"},
          "vip_amount_minor": {"type": "integer"},
          "delivery_amount_minor": {"type": "integer"},
          "adjust_amount_minor": {"type": "integer"},
          "pay_amount_minor": {"type": "integer"},
          "used_point_quantity": {"type": "integer"},
          "canonical_import_allowed": {"type": "boolean", "const": false}
        },
        "allOf": [
          {"if": {"properties": {"product_snapshot_status": {"const": "CAPTURED"}}},
           "then": {"properties": {
             "legacy_spu_id": {"type": "integer", "minimum": 1},
             "legacy_spu_name": {"type": "string", "minLength": 1, "maxLength": 255},
             "legacy_sku_id": {"type": "integer", "minimum": 1},
             "unit_price_minor": {"type": "integer", "minimum": 0},
             "historical_product_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
           }}},
          {"if": {"properties": {"product_snapshot_status": {"const": "INCOMPLETE"}}},
           "then": {"properties": {"historical_product_snapshot_hash": {"type": "null"}}}}
        ]
      }
    },
    "policy_version": {"type": "string", "const": "legacy-trade-benefit-v5"},
    "verification_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "assessed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"buyer_identity_status": {"const": "RESOLVED"}}},
     "then": {"properties": {
       "buyer_source_identity_id": {"type": "string", "format": "uuid"},
       "buyer_principal_id": {"type": "string", "format": "uuid"},
       "buyer_identity_version": {"type": "integer", "minimum": 1}
     }}},
    {"if": {"properties": {"buyer_identity_status": {"enum": ["MISSING", "AMBIGUOUS"]}}},
     "then": {"properties": {
       "buyer_source_identity_id": {"type": "null"},
       "buyer_principal_id": {"type": "null"},
       "buyer_identity_version": {"type": "null"}
     }}},
    {"if": {"properties": {"run_product_snapshot_evidence_complete": {"const": true}}},
     "then": {"properties": {"run_product_snapshot_incomplete_item_count": {"const": 0}}}},
    {"if": {"properties": {"run_product_snapshot_evidence_complete": {"const": false}}},
     "then": {"properties": {"run_product_snapshot_incomplete_item_count": {"minimum": 1}}}}
  ]
}
