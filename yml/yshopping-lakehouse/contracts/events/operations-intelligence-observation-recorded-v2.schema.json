{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/operations-intelligence-observation-recorded-v2.schema.json","title":"operations_intelligence.observation.recorded payload v2","type":"object","additionalProperties":false,
  "required":["observation_id","source_system","source_event_id","observation_type","classification_contract_version","taxonomy_id","taxonomy_version_id","taxonomy_definition_version","event_code","intelligence_level_code","subject_type","subject_ref","evidence_ref","content_sha256","observed_at"],
  "properties":{"observation_id":{"$ref":"#/$defs/id"},"source_system":{"$ref":"#/$defs/code"},"source_event_id":{"$ref":"#/$defs/ref"},"observation_type":{"$ref":"#/$defs/code"},"classification_contract_version":{"type":"integer","const":2},"taxonomy_id":{"$ref":"#/$defs/id"},"taxonomy_version_id":{"$ref":"#/$defs/id"},"taxonomy_definition_version":{"type":"integer","minimum":1},"event_code":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},"intelligence_level_code":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]{0,31}$"},"subject_type":{"type":"string","enum":["PRINCIPAL","ORDER","TICKET","MERCHANT","CONTENT","TASK","DATASET","EXTERNAL_SUBJECT"]},"subject_ref":{"$ref":"#/$defs/ref"},"evidence_ref":{"$ref":"#/$defs/evidence"},"content_sha256":{"$ref":"#/$defs/hash"},"observed_at":{"type":"string","format":"date-time"}},
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},"ref":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"},"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence":{"type":"string","pattern":"^(?:sha256:[0-9a-f]{64}|restricted:[A-Za-z0-9_-]{16,128})$"}}
}
