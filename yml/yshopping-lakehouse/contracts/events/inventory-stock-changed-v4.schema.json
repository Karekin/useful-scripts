{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/inventory-stock-changed-v4.schema.json",
  "title": "inventory.stock.changed migration opening payload v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner_type", "owner_id", "canonical_sku_id", "warehouse_id", "location_id", "lot_id", "lot_code",
    "stock_status", "quality_status", "base_uom_code", "uom_code", "delta_quantity",
    "delta_on_hand_quantity", "delta_reserved_quantity", "delta_in_transit_quantity",
    "after_on_hand_quantity", "after_reserved_quantity", "after_in_transit_quantity",
    "after_available_quantity", "movement_type", "ledger_transaction_id", "movement_group_id", "entry_role",
    "counterparty_balance_id", "business_type", "business_id", "business_item_id", "business_no",
    "reservation_id", "allocation_id", "migration_run_id", "migration_candidate_id",
    "migration_qualification_id", "source_system", "source_type", "source_id", "source_snapshot_hash",
    "opening_driver", "migration_stage", "verification_ref"
  ],
  "properties": {
    "owner_type": {"type": "string", "const": "MERCHANT"},
    "owner_id": {"type": "string", "format": "uuid"},
    "canonical_sku_id": {"type": "string", "format": "uuid"},
    "warehouse_id": {"type": "string", "format": "uuid"},
    "location_id": {"type": "string", "format": "uuid"},
    "lot_id": {"type": ["string", "null"], "format": "uuid"},
    "lot_code": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "stock_status": {"type": "string", "enum": ["SELLABLE", "NON_SELLABLE"]},
    "quality_status": {"type": "string", "enum": ["PENDING_QC", "QUALIFIED", "DAMAGED", "REJECTED"]},
    "base_uom_code": {"type": "string", "minLength": 1, "maxLength": 32},
    "uom_code": {"type": "string", "minLength": 1, "maxLength": 32},
    "delta_quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]{1,6})?$"},
    "delta_on_hand_quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]{1,6})?$"},
    "delta_reserved_quantity": {"type": "string", "pattern": "^0(\\.0{1,6})?$"},
    "delta_in_transit_quantity": {"type": "string", "pattern": "^0(\\.0{1,6})?$"},
    "after_on_hand_quantity": {"type": "string", "pattern": "^[1-9][0-9]*(\\.[0-9]{1,6})?$"},
    "after_reserved_quantity": {"type": "string", "pattern": "^0(\\.0{1,6})?$"},
    "after_in_transit_quantity": {"type": "string", "pattern": "^0(\\.0{1,6})?$"},
    "after_available_quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "movement_type": {"type": "string", "const": "MIGRATION_OPENING"},
    "ledger_transaction_id": {"type": "integer", "minimum": 1},
    "movement_group_id": {"type": "string", "format": "uuid"},
    "entry_role": {"type": "string", "const": "SINGLE"},
    "counterparty_balance_id": {"type": "null"},
    "business_type": {"type": "string", "const": "MIGRATION_OPENING"},
    "business_id": {"type": "string", "format": "uuid"},
    "business_item_id": {"type": "string", "format": "uuid"},
    "business_no": {"type": "string", "format": "uuid"},
    "reservation_id": {"type": "null"},
    "allocation_id": {"type": "null"},
    "migration_run_id": {"type": "string", "format": "uuid"},
    "migration_candidate_id": {"type": "string", "format": "uuid"},
    "migration_qualification_id": {"type": "string", "format": "uuid"},
    "source_system": {"type": "string", "const": "CLOUDMOLD_INVENTORY_V1"},
    "source_type": {"type": "string", "const": "BALANCE"},
    "source_id": {"type": "string", "format": "uuid"},
    "source_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "opening_driver": {"type": "string", "const": "INVENTORY_MIGRATION_QUALIFICATION"},
    "migration_stage": {"type": "string", "const": "MIGRATED"},
    "verification_ref": {"type": "string", "pattern": "^(?i:sha256|sha512|ticket|run|evidence|vault|kms|token):[A-Za-z0-9._/-]+$", "maxLength": 256}
  }
}
