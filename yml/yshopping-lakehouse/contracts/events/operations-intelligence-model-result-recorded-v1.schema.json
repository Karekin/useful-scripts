{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/operations-intelligence-model-result-recorded-v1.schema.json","title":"operations_intelligence.model_result.recorded payload v1","type":"object","additionalProperties":false,
