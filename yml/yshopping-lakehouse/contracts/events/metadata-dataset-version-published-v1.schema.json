{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/metadata-dataset-version-published-v1.schema.json","title":"metadata.dataset.version_published payload v1","type":"object","additionalProperties":false,
  "required":["definition_id","definition_code","definition_version","display_name","owner_principal_id","specification_sha256","artifact_ref","previous_status","current_status","data_source_id","data_source_version","dataset_type","qualified_name","layer_code","grain_code","schema_sha256","storage_location_ref","retention_days","field_count"],
  "properties":{
    "definition_id":{"$ref":"#/$defs/id"},"definition_code":{"$ref":"#/$defs/code"},"definition_version":{"type":"integer","minimum":1},"display_name":{"type":"string","minLength":3,"maxLength":160},"owner_principal_id":{"$ref":"#/$defs/id"},"specification_sha256":{"$ref":"#/$defs/sha"},"artifact_ref":{"$ref":"#/$defs/ref"},"previous_status":{"type":"string","enum":["DRAFT","PUBLISHED"]},"current_status":{"type":"string","const":"PUBLISHED"},"data_source_id":{"$ref":"#/$defs/id"},"data_source_version":{"type":"integer","minimum":1},"dataset_type":{"type":"string","enum":["TABLE","VIEW","REPORT_DATASET","STREAM","FILESET"]},"qualified_name":{"type":"string","minLength":2,"maxLength":256,"pattern":"^[A-Za-z0-9][A-Za-z0-9_.$-]{1,255}$"},"layer_code":{"$ref":"#/$defs/code"},"grain_code":{"$ref":"#/$defs/code"},"schema_sha256":{"$ref":"#/$defs/sha"},"storage_location_ref":{"$ref":"#/$defs/ref"},"retention_days":{"type":"integer","minimum":1,"maximum":36500},"field_count":{"type":"integer","minimum":1,"maximum":5000}
  },
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{1,127}$"},"code":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]{1,127}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"ref":{"type":"string","pattern":"^(?:sha256:[0-9a-f]{64}|restricted:[A-Za-z0-9][A-Za-z0-9._/-]{7,159})$"}}
}
