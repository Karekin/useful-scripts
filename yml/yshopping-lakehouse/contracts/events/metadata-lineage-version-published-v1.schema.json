{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/metadata-lineage-version-published-v1.schema.json","title":"metadata.lineage.version_published payload v1","type":"object","additionalProperties":false,
  "required":["definition_id","definition_code","definition_version","display_name","owner_principal_id","specification_sha256","artifact_ref","previous_status","current_status","source_dataset_id","source_dataset_version","target_dataset_id","target_dataset_version","direction","transform_sha256","transformation_ref"],
  "properties":{
    "definition_id":{"$ref":"#/$defs/id"},"definition_code":{"$ref":"#/$defs/code"},"definition_version":{"type":"integer","minimum":1},"display_name":{"type":"string","minLength":3,"maxLength":160},"owner_principal_id":{"$ref":"#/$defs/id"},"specification_sha256":{"$ref":"#/$defs/sha"},"artifact_ref":{"$ref":"#/$defs/ref"},"previous_status":{"type":"string","enum":["DRAFT","PUBLISHED"]},"current_status":{"type":"string","const":"PUBLISHED"},"source_dataset_id":{"$ref":"#/$defs/id"},"source_dataset_version":{"type":"integer","minimum":1},"target_dataset_id":{"$ref":"#/$defs/id"},"target_dataset_version":{"type":"integer","minimum":1},"direction":{"type":"string","const":"SOURCE_TO_TARGET"},"transform_sha256":{"$ref":"#/$defs/sha"},"transformation_ref":{"$ref":"#/$defs/ref"}
  },
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_.-]{1,127}$"},"code":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_.-]{1,127}$"},"sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},"ref":{"type":"string","pattern":"^(?:sha256:[0-9a-f]{64}|restricted:[A-Za-z0-9][A-Za-z0-9._/-]{7,159})$"}}
}
