{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/promotion-advertising-placement-state-changed-v1.schema.json",
  "title": "promotion.advertising_placement.state_changed payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["placement_id", "placement_code", "campaign_id", "name", "channel_code", "page_code", "slot_code", "creative_ref", "valid_from", "valid_to", "previous_status", "current_status", "operation"],
  "properties": {
