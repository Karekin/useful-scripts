    "channel_code": {"type": "string", "minLength": 1, "maxLength": 32},
    "page_code": {"type": "string", "minLength": 1, "maxLength": 64},
    "slot_code": {"type": "string", "minLength": 1, "maxLength": 64},
    "creative_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_to": {"type": "string", "format": "date-time"},
    "previous_status": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 32},
    "current_status": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 32},
    "operation": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$", "maxLength": 32}
  }
}
