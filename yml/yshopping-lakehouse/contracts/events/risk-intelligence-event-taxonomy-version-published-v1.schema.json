{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cloudmold.local/contracts/risk-intelligence-event-taxonomy-version-published-v1.schema.json","title":"risk.intelligence_event_taxonomy.version_published payload v1","type":"object","additionalProperties":false,
  "required":["taxonomy_id","taxonomy_version_id","definition_version","event_code","level_codes","levels_sha256","previous_status","current_status","approved_by_principal_id","effective_from","source_system","source_table","source_record_key","source_version","source_observed_at","source_evidence_ref","source_evidence_sha256"],
  "properties":{
    "taxonomy_id":{"$ref":"#/$defs/id"},"taxonomy_version_id":{"$ref":"#/$defs/id"},"definition_version":{"type":"integer","minimum":1},"event_code":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "level_codes":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"$ref":"#/$defs/level"}},"levels_sha256":{"$ref":"#/$defs/hash"},
    "previous_status":{"type":"string","enum":["DRAFT","PUBLISHED"]},"current_status":{"type":"string","const":"PUBLISHED"},"approved_by_principal_id":{"$ref":"#/$defs/ref"},"effective_from":{"type":"string","format":"date-time"},
    "source_system":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"},"source_table":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,127}$"},"source_record_key":{"$ref":"#/$defs/ref"},"source_version":{"$ref":"#/$defs/ref"},"source_observed_at":{"type":"string","format":"date-time"},"source_evidence_ref":{"$ref":"#/$defs/evidence"},"source_evidence_sha256":{"$ref":"#/$defs/hash"}
  },
  "$defs":{"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},"ref":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"},"level":{"type":"string","pattern":"^[A-Z][A-Z0-9_-]{0,31}$"},"hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"evidence":{"type":"string","pattern":"^(?:sha256:[0-9a-f]{64}|restricted:[A-Za-z0-9_-]{16,128})$"}}
}
