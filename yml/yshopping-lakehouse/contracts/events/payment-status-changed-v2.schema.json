{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/contracts/payment-status-changed-v2.schema.json",
  "title": "payment.status.changed payload v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id", "payment_id", "payment_no", "order_id", "transaction_id", "transaction_type",
    "previous_status", "current_status", "payable_amount_minor", "captured_amount_minor",
    "refunded_amount_minor", "currency_code", "provider_code", "provider_transaction_id",
    "test_mode", "reason", "cancellation_saga_id", "step_ordinal"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "payment_id": {"type": "string", "format": "uuid"},
    "payment_no": {"type": "string", "minLength": 1, "maxLength": 32},
    "order_id": {"type": "string", "format": "uuid"},
    "transaction_id": {"type": "integer", "minimum": 1},
    "transaction_type": {"type": "string", "const": "REFUND"},
    "previous_status": {"type": "string", "const": "CAPTURED"},
    "current_status": {"type": "string", "const": "REFUNDED"},
    "payable_amount_minor": {"type": "integer", "minimum": 0},
    "captured_amount_minor": {"type": "integer", "minimum": 0},
    "refunded_amount_minor": {"type": "integer", "minimum": 0},
    "currency_code": {"type": "string", "enum": ["CNY"]},
    "provider_code": {"type": "string", "enum": ["INTERNAL_TEST"]},
    "provider_transaction_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "test_mode": {"type": "boolean", "const": true},
    "reason": {"type": ["string", "null"], "maxLength": 255},
    "cancellation_saga_id": {"type": "string", "format": "uuid"},
    "step_ordinal": {"type": "integer", "minimum": 1}
  }
}
