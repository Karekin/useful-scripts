{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://cloudmold.local/contracts/risk-review-status-changed-v1.schema.json",
  "title": "risk.review.status_changed payload v1", "type": "object", "additionalProperties": false,
  "required": ["case_id", "cluster_id", "current_status", "reviewer_principal_id", "operation"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"}, "cluster_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"},
    "previous_status": {"type": ["string", "null"], "enum": ["OPEN", "IN_REVIEW", "DECIDED", "CLOSED", null]}, "current_status": {"type": "string", "enum": ["OPEN", "IN_REVIEW", "DECIDED", "CLOSED"]},
    "reviewer_principal_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,127}$"}, "operation": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
  }
}
