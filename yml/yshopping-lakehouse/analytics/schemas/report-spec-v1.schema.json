{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cloudmold.local/schemas/report-spec-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "version", "title", "owner", "lifecycle", "publication_scope", "datasets", "filters", "metrics", "sections", "guardrails", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "report_id": {"type": "string", "pattern": "[a-z][a-z0-9-]{2,63}"},
    "version": {"type": "string", "pattern": "[0-9]+\\.[0-9]+"},
    "title": {"type": "string", "minLength": 2},
    "owner": {"type": "string", "minLength": 2},
    "lifecycle": {"enum": ["draft", "pilot", "stable", "retired"]},
    "publication_scope": {"enum": ["local_test", "pilot", "production"]},
    "datasets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "yshopping_(ads|dws)\\.[a-z][a-z0-9_]*"}},
    "filters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "type", "required"],
        "properties": {
          "field": {"type": "string", "pattern": "[a-z][a-z0-9_]*"},
          "type": {"enum": ["tenant", "time", "category", "status", "identifier"]},
          "required": {"type": "boolean"}
        }
      }
    },
    "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+"}},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "charts"],
        "properties": {
          "id": {"type": "string", "pattern": "[a-z][a-z0-9-]*"},
          "title": {"type": "string", "minLength": 2},
          "charts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "title", "metrics", "group_by"],
              "properties": {
                "id": {"type": "string", "pattern": "[a-z][a-z0-9-]*"},
                "type": {"enum": ["kpi", "line", "bar", "stacked_bar", "donut", "heatmap", "table", "gate"]},
                "title": {"type": "string", "minLength": 2},
                "metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
                "group_by": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "[a-z][a-z0-9_]*"}},
                "time_field": {"type": "string", "pattern": "[a-z][a-z0-9_]*"},
                "limit": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "guardrails": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8}},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "kind", "notes"],
      "properties": {
        "status": {"enum": ["available", "partial", "missing"]},
        "kind": {"enum": ["local_runtime", "pilot_runtime", "production_runtime", "definition_only"]},
        "notes": {"type": "string", "minLength": 8}
      }
    }
  }
}
