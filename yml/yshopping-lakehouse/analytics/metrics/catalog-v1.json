{
  "schema_version": 1,
  "catalog_id": "cloudmold-core-metrics",
  "owner": "CloudMold Data Platform",
  "evidence_scope": "local_test",
  "metrics": [
    {"id":"inventory.balance_count","display_name":"库存余额记录数","description":"当前规范库存余额粒度的记录数量。","source":"yshopping_ads.ads_canonical_inventory_health","grain":"tenant + balance","expression":"COUNT(*)","aggregation":"count","unit":"count","dimensions":["tenant_id","warehouse_id","health_status","dimension_resolution_status","stock_status","quality_status"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"fail_closed","status":"governed"},
    {"id":"inventory.available_quantity","display_name":"可用库存量","description":"按规范库存余额汇总的可用库存数量。","source":"yshopping_ads.ads_canonical_inventory_health","grain":"tenant + balance","expression":"SUM(available_quantity)","aggregation":"sum","unit":"quantity","dimensions":["tenant_id","warehouse_id","health_status","dimension_resolution_status","stock_status","quality_status"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"fail_closed","status":"governed"},
    {"id":"inventory.low_stock_balance_count","display_name":"低库存余额数","description":"健康状态为 LOW_STOCK 的库存余额记录数。","source":"yshopping_ads.ads_canonical_inventory_health","grain":"tenant + balance","expression":"SUM(CASE WHEN health_status = 'LOW_STOCK' THEN 1 ELSE 0 END)","aggregation":"sum","unit":"count","dimensions":["tenant_id","warehouse_id","health_status","dimension_resolution_status"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"zero","status":"governed"},
    {"id":"inventory.out_of_stock_balance_count","display_name":"缺货余额数","description":"健康状态为 OUT_OF_STOCK 的库存余额记录数。","source":"yshopping_ads.ads_canonical_inventory_health","grain":"tenant + balance","expression":"SUM(CASE WHEN health_status = 'OUT_OF_STOCK' THEN 1 ELSE 0 END)","aggregation":"sum","unit":"count","dimensions":["tenant_id","warehouse_id","health_status","dimension_resolution_status"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"zero","status":"governed"},
    {"id":"inventory.canonical_v3_rate","display_name":"规范维度解析率","description":"库存余额中完成 CANONICAL_V3 维度解析的比例。","source":"yshopping_ads.ads_canonical_inventory_health","grain":"tenant + balance","expression":"100.0 * SUM(CASE WHEN dimension_resolution_status = 'CANONICAL_V3' THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0)","aggregation":"ratio","unit":"percent","dimensions":["tenant_id","warehouse_id","dimension_resolution_status"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"fail_closed","status":"governed"},
    {"id":"procurement.purchase_order_count","display_name":"采购单数","description":"采购履约视图中的去重采购订单数量。","source":"yshopping_ads.ads_purchase_fulfillment","grain":"tenant + purchase order","expression":"COUNT(DISTINCT purchase_order_id)","aggregation":"count_distinct","unit":"count","dimensions":["tenant_id","supplier_id","fulfillment_status"],"freshness_field":"updated_at","freshness_slo_minutes":1440,"null_policy":"fail_closed","status":"governed"},
    {"id":"procurement.receipt_fulfillment_rate","display_name":"采购收货履约率","description":"累计收货数量除以采购下单数量的比例。","source":"yshopping_ads.ads_purchase_fulfillment","grain":"tenant + purchase order","expression":"100.0 * SUM(received_quantity) / NULLIF(SUM(ordered_quantity), 0)","aggregation":"ratio","unit":"percent","dimensions":["tenant_id","supplier_id","fulfillment_status"],"freshness_field":"updated_at","freshness_slo_minutes":1440,"null_policy":"fail_closed","status":"governed"},
    {"id":"procurement.open_order_count","display_name":"未完成采购单数","description":"履约状态为 OPEN 或 PARTIAL 的采购订单数量。","source":"yshopping_ads.ads_purchase_fulfillment","grain":"tenant + purchase order","expression":"SUM(CASE WHEN fulfillment_status IN ('OPEN','PARTIAL') THEN 1 ELSE 0 END)","aggregation":"sum","unit":"count","dimensions":["tenant_id","supplier_id","fulfillment_status"],"freshness_field":"updated_at","freshness_slo_minutes":1440,"null_policy":"zero","status":"governed"},
    {"id":"commerce.order_count","display_name":"交易订单数","description":"规范交易就绪视图中的去重订单数量。","source":"yshopping_ads.ads_canonical_commerce_v2_readiness","grain":"tenant + run + order","expression":"COUNT(DISTINCT order_id)","aggregation":"count_distinct","unit":"count","dimensions":["tenant_id","run_id","readiness_status","currency_code"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"fail_closed","status":"governed"},
    {"id":"commerce.reconciled_rate","display_name":"交易对账闭合率","description":"交易就绪状态为 RECONCILED 的订单比例。","source":"yshopping_ads.ads_canonical_commerce_v2_readiness","grain":"tenant + run + order","expression":"100.0 * SUM(CASE WHEN readiness_status = 'RECONCILED' THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0)","aggregation":"ratio","unit":"percent","dimensions":["tenant_id","run_id","readiness_status","currency_code"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"fail_closed","status":"governed"},
    {"id":"commerce.captured_amount_yuan","display_name":"实收金额","description":"规范交易就绪视图中实收小单位金额换算为元。","source":"yshopping_ads.ads_canonical_commerce_v2_readiness","grain":"tenant + run + order","expression":"SUM(captured_amount_minor) / 100.0","aggregation":"sum","unit":"yuan","dimensions":["tenant_id","run_id","readiness_status","currency_code"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"zero","status":"governed"},
    {"id":"aftersales.case_count","display_name":"售后单数","description":"规范售后就绪视图中的去重售后单数量。","source":"yshopping_ads.ads_canonical_after_sale_readiness","grain":"tenant + run + after sale","expression":"COUNT(DISTINCT after_sale_id)","aggregation":"count_distinct","unit":"count","dimensions":["tenant_id","run_id","readiness_status","recovery_status","after_sale_type","responsibility","warehouse_id","currency_code"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"fail_closed","status":"governed"},
    {"id":"aftersales.reconciled_rate","display_name":"售后闭合率","description":"售后就绪状态为 RECONCILED 的售后单比例。","source":"yshopping_ads.ads_canonical_after_sale_readiness","grain":"tenant + run + after sale","expression":"100.0 * SUM(CASE WHEN readiness_status = 'RECONCILED' THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0)","aggregation":"ratio","unit":"percent","dimensions":["tenant_id","run_id","readiness_status","recovery_status","after_sale_type","responsibility","warehouse_id","currency_code"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"fail_closed","status":"governed"},
    {"id":"aftersales.recovery_required_count","display_name":"待人工恢复售后数","description":"恢复状态为 REQUIRED 或 PENDING 的售后单数量。","source":"yshopping_ads.ads_canonical_after_sale_readiness","grain":"tenant + run + after sale","expression":"SUM(CASE WHEN recovery_status IN ('REQUIRED','PENDING') THEN 1 ELSE 0 END)","aggregation":"sum","unit":"count","dimensions":["tenant_id","run_id","readiness_status","recovery_status","after_sale_type","responsibility","warehouse_id"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"zero","status":"governed"},
    {"id":"aftersales.refunded_amount_yuan","display_name":"已退款金额","description":"规范售后就绪视图中已退款小单位金额换算为元。","source":"yshopping_ads.ads_canonical_after_sale_readiness","grain":"tenant + run + after sale","expression":"SUM(refunded_amount_minor) / 100.0","aggregation":"sum","unit":"yuan","dimensions":["tenant_id","run_id","readiness_status","recovery_status","after_sale_type","responsibility","warehouse_id","currency_code"],"freshness_field":"data_freshness_at","freshness_slo_minutes":60,"null_policy":"zero","status":"governed"},
    {"id":"governance.dataset_count","display_name":"已登记数据集数","description":"元数据治理就绪视图中登记的数据集总数。","source":"yshopping_ads.ads_canonical_metadata_readiness","grain":"tenant","expression":"SUM(dataset_count)","aggregation":"sum","unit":"count","dimensions":["tenant_id","readiness_status"],"freshness_field":null,"freshness_slo_minutes":null,"null_policy":"fail_closed","status":"candidate"},
    {"id":"governance.failed_dqc_result_count","display_name":"失败质量结果数","description":"元数据治理就绪视图中 FAIL 或 ERROR 的质量结果数。","source":"yshopping_ads.ads_canonical_metadata_readiness","grain":"tenant","expression":"SUM(failed_dqc_result_count)","aggregation":"sum","unit":"count","dimensions":["tenant_id","readiness_status"],"freshness_field":null,"freshness_slo_minutes":null,"null_policy":"zero","status":"candidate"},
    {"id":"governance.invalid_reference_count","display_name":"无效治理引用数","description":"无效质量引用、血缘端点与任务运行的合计数量。","source":"yshopping_ads.ads_canonical_metadata_readiness","grain":"tenant","expression":"SUM(invalid_dqc_reference_count + unresolved_lineage_endpoint_count + invalid_task_run_count)","aggregation":"sum","unit":"count","dimensions":["tenant_id","readiness_status"],"freshness_field":null,"freshness_slo_minutes":null,"null_policy":"zero","status":"candidate"},
    {"id":"ai.observation_count","display_name":"AI 观测数","description":"AI 治理就绪视图中的观测记录总数。","source":"yshopping_ads.ads_canonical_ai_intelligence_readiness","grain":"tenant","expression":"SUM(observation_count)","aggregation":"sum","unit":"count","dimensions":["tenant_id","readiness_status"],"freshness_field":null,"freshness_slo_minutes":null,"null_policy":"zero","status":"candidate"},
    {"id":"ai.pending_clue_count","display_name":"待复核线索数","description":"AI 治理就绪视图中尚未完成复核的线索数量。","source":"yshopping_ads.ads_canonical_ai_intelligence_readiness","grain":"tenant","expression":"SUM(pending_clue_count)","aggregation":"sum","unit":"count","dimensions":["tenant_id","readiness_status"],"freshness_field":null,"freshness_slo_minutes":null,"null_policy":"zero","status":"candidate"},
    {"id":"ai.invalid_taxonomy_reference_count","display_name":"无效分类引用数","description":"AI 分类结果中不能解析到受治理分类表的记录数量。","source":"yshopping_ads.ads_canonical_ai_intelligence_readiness","grain":"tenant","expression":"SUM(invalid_taxonomy_reference_count)","aggregation":"sum","unit":"count","dimensions":["tenant_id","readiness_status"],"freshness_field":null,"freshness_slo_minutes":null,"null_policy":"zero","status":"candidate"}
  ]
}
