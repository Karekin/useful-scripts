#!/usr/bin/env python3
"""Generate fail-closed Y-Shopping production readiness evidence."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from production_evidence import (
    SourceEvidenceError,
    blocked_readiness,
    generate_readiness,
    write_json,
)


def main() -> int:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)

    blocked = subparsers.add_parser("blocked")
    blocked.add_argument("--checked-at", required=True)
    blocked.add_argument("--reason", action="append", required=True)
    blocked.add_argument("--output", type=Path)

    generate = subparsers.add_parser("generate-readiness")
    generate.add_argument("collection", type=Path)
    generate.add_argument("--output", type=Path)
    args = parser.parse_args()

    if args.command == "blocked":
        readiness = blocked_readiness(args.checked_at, args.reason)
        errors: list[str] = []
    else:
        readiness, errors = generate_readiness(args.collection)

    if args.output:
        write_json(args.output, readiness)
    else:
        print(json.dumps(readiness, ensure_ascii=False, indent=2, sort_keys=True))
    if errors or readiness["status"] != "READY":
        return 2
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SourceEvidenceError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)
