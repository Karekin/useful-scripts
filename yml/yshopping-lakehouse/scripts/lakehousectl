  reconcile)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    test -n "$RUN_ID" || { echo "--run-id is required" >&2; exit 2; }
    require_running
    safe_run_id=${RUN_ID//\'/\'\'}
    sql -e "
      SELECT 'purchase_order_lines' metric, COUNT(*) value
        FROM yshopping_dwd.dwd_purchase_order_line WHERE tenant_id=$TENANT_ID AND run_id='$safe_run_id'
      UNION ALL
      SELECT 'purchase_receipt_lines', COUNT(*)
        FROM yshopping_dwd.dwd_purchase_receipt_line WHERE tenant_id=$TENANT_ID AND run_id='$safe_run_id'
      UNION ALL
      SELECT 'inventory_movements', COUNT(*)
        FROM yshopping_dwd.dwd_inventory_movement m
        JOIN yshopping_dwd.dwd_purchase_receipt_line r
          ON r.tenant_id=m.tenant_id AND r.receipt_id=m.biz_id AND r.receipt_line_id=m.biz_item_id
       WHERE r.tenant_id=$TENANT_ID AND r.run_id='$safe_run_id';"
    run_tests
    ;;
  reconcile-legacy-commerce-observability)
    require_running
    echo -e "table\tsource_rows\tods_rows\tsource_active\tods_active"
    for source_table in pay_order pay_refund member_user product_browse_history trade_cart; do
      source_filter="deleted = b'0'"
      ods_filter="deleted = FALSE"
      if [[ "$source_table" == "product_browse_history" ]]; then
        source_filter="$source_filter AND user_deleted = b'0'"
        ods_filter="$ods_filter AND user_deleted = FALSE"
      fi
      source_rows=$(docker exec yudao-mysql sh -lc \
        "mysql -uroot -p\"\$MYSQL_ROOT_PASSWORD\" --batch --raw --skip-column-names \
         -D 'ruoyi-vue-pro' -e \"SELECT COUNT(*) FROM $source_table\"")
      source_active=$(docker exec yudao-mysql sh -lc \
        "mysql -uroot -p\"\$MYSQL_ROOT_PASSWORD\" --batch --raw --skip-column-names \
         -D 'ruoyi-vue-pro' -e \"SELECT COUNT(*) FROM $source_table WHERE $source_filter\"")
      ods_rows=$(sql --skip-column-names -e \
        "SELECT COUNT(*) FROM yshopping_ods.$source_table;")
      ods_active=$(sql --skip-column-names -e \
        "SELECT COUNT(*) FROM yshopping_ods.$source_table WHERE $ods_filter;")
      echo -e "$source_table\t$source_rows\t$ods_rows\t$source_active\t$ods_active"
      [[ "$source_rows" == "$ods_rows" && "$source_active" == "$ods_active" ]] || {
        echo "$source_table source/ODS reconciliation failed" >&2
        exit 1
      }
    done
    pii_columns=$(sql --skip-column-names -e "
      SELECT COUNT(*)
      FROM information_schema.columns
      WHERE table_schema = 'yshopping_ods'
        AND table_name IN ('pay_order','pay_refund','member_user')
        AND column_name IN ('notify_url','user_ip','channel_user_id','channel_notify_data',
                            'channel_error_msg','password','mobile','email','nickname','avatar',
                            'birthday','mark','tag_ids');")
    [[ "$pii_columns" == "0" ]] || {
      echo "sensitive columns reached legacy commerce ODS" >&2
      exit 1
    }
    sql -e "
      SELECT 'refund_to_pay_order_matched' AS quality_metric, COUNT(*) AS value
      FROM yshopping_ods.pay_refund refund
      JOIN yshopping_ods.pay_order payment
        ON payment.tenant_id=refund.tenant_id AND payment.id=refund.order_id
      UNION ALL
      SELECT 'pay_order_to_trade_order_matched', COUNT(*)
      FROM yshopping_ods.pay_order payment
      JOIN yshopping_ods.trade_order orders
        ON orders.tenant_id=payment.tenant_id
       AND CAST(orders.id AS VARCHAR)=payment.merchant_order_id
      UNION ALL
      SELECT 'browse_active_unresolved_member', COUNT(*)
      FROM yshopping_ods.product_browse_history browse
      LEFT JOIN yshopping_ods.member_user member
        ON member.tenant_id=browse.tenant_id AND member.id=browse.user_id AND member.deleted=FALSE
      WHERE browse.deleted=FALSE AND browse.user_deleted=FALSE AND member.id IS NULL
      UNION ALL
      SELECT 'cart_active_unresolved_member', COUNT(*)
      FROM yshopping_ods.trade_cart cart
      LEFT JOIN yshopping_ods.member_user member
        ON member.tenant_id=cart.tenant_id AND member.id=cart.user_id AND member.deleted=FALSE
      WHERE cart.deleted=FALSE AND member.id IS NULL;"
    ;;
  reconcile-legacy-trade-benefit-assessment)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    require_running
    result=$(sql --skip-column-names -e "
      SELECT source_order_row_count, non_deleted_order_count, deleted_excluded_count,
             no_benefit_order_count, benefit_evidence_pending_order_count,
             quarantined_order_count, source_benefit_amount_minor,
             component_count, component_amount_minor,
             unresolved_identity_count, unresolved_funding_count,
             import_allowed_component_count, production_migration_enabled,
             exact_order_item_mapping_available, versioned_benefit_identity_available,
             named_funding_breakdown_available, readiness_status, source_scope
      FROM yshopping_ads.ads_legacy_trade_benefit_migration_readiness
      WHERE tenant_id=$TENANT_ID;")
    require_single_row "$result" "legacy Trade benefit migration assessment"
    echo -e "source_orders\tnon_deleted\tdeleted\tno_benefit\tbenefit_pending\tquarantined\tsource_benefit\tcomponents\tcomponent_amount\tunresolved_identity\tunresolved_funding\timport_allowed\tproduction_enabled\torder_item_mapping\tbenefit_identity\tfunding_breakdown\treadiness\tsource_scope"
    echo "$result"
    read -r source_orders non_deleted deleted no_benefit benefit_pending quarantined \
      source_benefit components component_amount unresolved_identity unresolved_funding \
      import_allowed production_enabled order_item_mapping benefit_identity funding_breakdown \
      readiness source_scope <<< "$result"
    [[ "$source_orders" =~ ^[1-9][0-9]*$ \
       && "$non_deleted" -eq $((no_benefit + benefit_pending + quarantined)) \
       && "$source_benefit" == "$component_amount" \
       && "$unresolved_identity" == "$components" \
       && "$unresolved_funding" == "$components" \
       && "$import_allowed" == "0" && "$production_enabled" == "0" \
       && "$order_item_mapping" == "0" && "$benefit_identity" == "0" \
       && "$funding_breakdown" == "0" \
       && "$readiness" == "BLOCKED_REQUIRES_GOVERNED_EVIDENCE" \
       && "$source_scope" == "LOCAL_YUDAO_TRADE_NOT_YSHOPPING_SOURCE" ]] || {
      echo "legacy Trade benefit migration assessment reconciliation failed" >&2
      exit 1
    }
    run_tests
    ;;
  reconcile-canonical-legacy-trade-benefit-assessment)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    test -n "$RUN_ID" || { echo "--run-id is required" >&2; exit 2; }
    [[ "$RUN_ID" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]] || {
      echo "--run-id must be a UUID for canonical legacy Trade benefit assessment" >&2
      exit 2
    }
    require_running
    result=$(sql --skip-column-names -e "
      SELECT backend_source_order_row_count, offline_source_order_row_count,
             backend_non_deleted_order_count, offline_non_deleted_order_count,
             backend_deleted_excluded_count, offline_deleted_excluded_count,
             backend_no_benefit_order_count, offline_no_benefit_order_count,
             backend_benefit_evidence_pending_order_count, offline_benefit_evidence_pending_order_count,
             backend_quarantined_order_count, offline_quarantined_order_count,
             backend_source_benefit_amount_minor, offline_source_benefit_amount_minor,
             backend_component_count, offline_component_count,
             backend_component_amount_minor, offline_component_amount_minor,
             backend_unresolved_identity_count, offline_unresolved_identity_count,
             backend_unresolved_funding_count, offline_unresolved_funding_count,
             missing_offline_candidate_count, missing_backend_candidate_count, candidate_fact_mismatch_count,
             missing_offline_component_count, missing_backend_component_count, component_fact_mismatch_count,
             import_allowed_component_count, production_migration_enabled, reconciliation_status, governed_scope
      FROM yshopping_ads.ads_canonical_legacy_trade_benefit_migration_readiness
      WHERE tenant_id=$TENANT_ID AND migration_run_id='$RUN_ID';")
    require_single_row "$result" "canonical legacy Trade benefit migration assessment"
    echo -e "backend_orders\toffline_orders\tbackend_non_deleted\toffline_non_deleted\tbackend_deleted\toffline_deleted\tbackend_no_benefit\toffline_no_benefit\tbackend_pending\toffline_pending\tbackend_quarantined\toffline_quarantined\tbackend_benefit\toffline_benefit\tbackend_components\toffline_components\tbackend_component_amount\toffline_component_amount\tbackend_unresolved_identity\toffline_unresolved_identity\tbackend_unresolved_funding\toffline_unresolved_funding\tmissing_offline_candidates\tmissing_backend_candidates\tcandidate_mismatches\tmissing_offline_components\tmissing_backend_components\tcomponent_mismatches\timport_allowed\tproduction_enabled\treconciliation\tscope"
    echo "$result"
    IFS=$'\t' read -r backend_orders offline_orders backend_non_deleted offline_non_deleted \
      backend_deleted offline_deleted backend_no_benefit offline_no_benefit backend_pending offline_pending \
      backend_quarantined offline_quarantined backend_benefit offline_benefit backend_components offline_components \
      backend_component_amount offline_component_amount backend_unresolved_identity offline_unresolved_identity \
      backend_unresolved_funding offline_unresolved_funding missing_offline_candidates missing_backend_candidates \
      candidate_mismatches missing_offline_components missing_backend_components component_mismatches \
      import_allowed production_enabled reconciliation scope <<< "$result"
    [[ "$backend_orders" =~ ^[1-9][0-9]*$ && "$backend_orders" == "$offline_orders" \
       && "$backend_non_deleted" == "$offline_non_deleted" && "$backend_deleted" == "$offline_deleted" \
       && "$backend_no_benefit" == "$offline_no_benefit" && "$backend_pending" == "$offline_pending" \
       && "$backend_quarantined" == "$offline_quarantined" && "$backend_benefit" == "$offline_benefit" \
       && "$backend_components" == "$offline_components" \
       && "$backend_component_amount" == "$offline_component_amount" \
       && "$backend_unresolved_identity" == "$offline_unresolved_identity" \
       && "$backend_unresolved_funding" == "$offline_unresolved_funding" \
       && "$missing_offline_candidates" == "0" && "$missing_backend_candidates" == "0" \
       && "$candidate_mismatches" == "0" && "$missing_offline_components" == "0" \
       && "$missing_backend_components" == "0" && "$component_mismatches" == "0" \
       && "$import_allowed" == "0" && "$production_enabled" == "0" \
       && "$reconciliation" == "MATCHED_LOCAL_SNAPSHOT_BLOCKED_REQUIRES_GOVERNED_EVIDENCE" \
       && "$scope" == "LOCAL_YUDAO_TRADE_NOT_YSHOPPING_SOURCE" ]] || {
      echo "canonical legacy Trade benefit migration assessment reconciliation failed" >&2
      exit 1
    }
    run_tests
    ;;
  reconcile-canonical-inventory)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    test -n "$RUN_ID" || { echo "--run-id is required" >&2; exit 2; }
    require_running
    safe_run_id=${RUN_ID//\'/\'\'}
    result=$(sql --skip-column-names -e "
      SELECT COUNT(*) events,
             MAX(aggregate_version) max_version,
             MAX(IF(aggregate_version=6, after_on_hand_quantity, NULL)) final_on_hand,
             MAX(IF(aggregate_version=6, after_reserved_quantity, NULL)) final_reserved,
             MAX(IF(aggregate_version=6, after_available_quantity, NULL)) final_available
      FROM yshopping_dwd.dwd_canonical_inventory_movement
      WHERE tenant_id=$TENANT_ID AND business_id='$safe_run_id';")
    require_single_row "$result" "canonical inventory reconciliation"
    echo -e "events\tmax_version\tfinal_on_hand\tfinal_reserved\tfinal_available"
    echo "$result"
    read -r events max_version final_on_hand final_reserved final_available <<< "$result"
    [[ "$events" == "6" && "$max_version" == "6" && "$final_on_hand" == "8.000000" \
       && "$final_reserved" == "0.000000" && "$final_available" == "8.000000" ]] || {
      echo "canonical inventory reconciliation failed" >&2
      exit 1
    }
    run_tests
    ;;
  reconcile-canonical-inventory-lot)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    test -n "$RUN_ID" || { echo "--run-id is required" >&2; exit 2; }
    require_running
    safe_run_id=${RUN_ID//\'/\'\'}
    result=$(sql --skip-column-names -e "
      SELECT
        (SELECT COUNT(*) FROM yshopping_dwd.dwd_canonical_inventory_lot_lifecycle_event
          WHERE tenant_id=$TENANT_ID AND run_id='$safe_run_id') lifecycle_events,
        (SELECT COUNT(*) FROM yshopping_dwd.dwd_canonical_inventory_lot_source_mapping_event
          WHERE tenant_id=$TENANT_ID AND run_id='$safe_run_id') mapping_events,
        (SELECT COUNT(*) FROM yshopping_dwd.dwd_canonical_inventory_movement
          WHERE tenant_id=$TENANT_ID AND schema_version=3 AND business_id='$safe_run_id') inventory_events,
        lot_status, lot_version, source_mapping_count, effective_mapping_count,
        on_hand_quantity, reserved_quantity, in_transit_quantity, unreserved_quantity,
        allocatable_quantity, allocation_eligibility, readiness_status
      FROM yshopping_ads.ads_canonical_inventory_lot_readiness
      WHERE tenant_id=$TENANT_ID AND run_id='$safe_run_id';")
    require_single_row "$result" "canonical Inventory Lot reconciliation"
    echo -e "lifecycle_events\tmapping_events\tinventory_events\tlot_status\tlot_version\tmappings\teffective_mappings\ton_hand\treserved\tin_transit\tunreserved\tallocatable\teligibility\treadiness"
    echo "$result"
    read -r lifecycle_events mapping_events inventory_events lot_status lot_version mappings effective_mappings \
      on_hand reserved in_transit unreserved allocatable eligibility readiness <<< "$result"
    [[ "$lifecycle_events" == "2" && "$mapping_events" == "3" && "$inventory_events" == "3" \
       && "$lot_status" == "RECALLED" && "$lot_version" == "2" \
       && "$mappings" == "2" && "$effective_mappings" == "1" \
       && "$on_hand" == "10.000000" && "$reserved" == "0.000000" \
       && "$in_transit" == "0.000000" && "$unreserved" == "10.000000" \
       && "$allocatable" == "0.000000" && "$eligibility" == "LOT_RECALLED" \
       && "$readiness" == "RECALLED_FENCED" ]] || {
      echo "canonical Inventory Lot reconciliation failed" >&2
      exit 1
    }
    run_tests
    ;;
  reconcile-canonical-inventory-migration)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    test -n "$RUN_ID" || { echo "--run-id is required" >&2; exit 2; }
    [[ "$RUN_ID" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$ ]] || {
      echo "--run-id must be a UUID for canonical Inventory migration" >&2
      exit 2
    }
    require_running
    result=$(sql --skip-column-names -e "
      SELECT candidate_count, assessment_event_count, distinct_source_count,
             eligible_count, blocked_count, rejected_count,
             blockerless_blocked_count, eligible_with_blocker_count, false_allocation_claim_count,
             source_on_hand_quantity, source_reserved_quantity, source_in_transit_quantity,
             active_reservation_count, active_reservation_quantity,
             qualification_count, qualification_event_count, controlled_canary_count,
             invalid_qualification_status_count, nonzero_qualification_hold_count,
             qualification_assessment_mismatch_count, qualified_on_hand_quantity,
             opening_event_count, distinct_opening_qualification_count,
             opening_on_hand_quantity, opening_hold_delta_count, invalid_opening_driver_count,
             post_qualification_legacy_write_count,
             migration_stage, readiness_status
      FROM yshopping_ads.ads_canonical_inventory_migration_readiness
      WHERE tenant_id=$TENANT_ID AND migration_run_id='$RUN_ID';")
    require_single_row "$result" "canonical Inventory migration reconciliation"
    echo -e "candidates\tassessment_events\tdistinct_sources\teligible\tblocked\trejected\tblockerless_blocked\teligible_with_blocker\tfalse_allocations\ton_hand\treserved\tin_transit\tactive_reservations\tactive_reservation_quantity\tqualifications\tqualification_events\tcontrolled_canaries\tinvalid_qualification_status\tnonzero_qualification_holds\tqualification_mismatch\tqualified_quantity\topening_events\tdistinct_opening_qualifications\topening_quantity\topening_holds\tinvalid_opening_driver\tpost_qualification_legacy_writes\tstage\treadiness"
    echo "$result"
    IFS=$'\t' read -r candidates assessment_events distinct_sources eligible blocked rejected \
      blockerless eligible_with_blocker false_allocations on_hand reserved in_transit \
      active_reservations active_reservation_quantity qualifications qualification_events controlled_canaries \
      invalid_qualification_status nonzero_qualification_holds qualification_mismatch qualified_quantity \
      opening_events distinct_opening_qualifications opening_quantity opening_holds invalid_opening_driver \
      post_qualification_legacy_writes stage readiness <<< "$result"
    [[ "$candidates" =~ ^[1-9][0-9]*$ \
       && "$assessment_events" == "$candidates" && "$distinct_sources" == "$candidates" \
       && "$candidates" == "$((eligible + blocked + rejected))" \
       && "$blockerless" == "0" && "$eligible_with_blocker" == "0" \
       && "$false_allocations" == "0" && "$qualifications" == "$qualification_events" \
       && "$qualifications" == "$controlled_canaries" && "$invalid_qualification_status" == "0" \
       && "$nonzero_qualification_holds" == "0" && "$qualification_mismatch" == "0" \
       && "$opening_holds" == "0" && "$invalid_opening_driver" == "0" \
       && "$post_qualification_legacy_writes" == "0" \
       && ( ( "$stage" == "ASSESSED_ONLY" && "$qualifications" == "0" \
              && "$opening_events" == "0" && "$opening_quantity" == "0.000000" \
              && ( "$readiness" == "BLOCKED" || "$readiness" == "READY_TO_QUALIFY" ) ) \
            || ( "$stage" == "QUALIFIED_ONLY" && "$qualifications" =~ ^[1-9][0-9]*$ \
                 && "$opening_events" == "0" && "$readiness" == "QUALIFIED_RUNTIME_GATED" ) \
            || ( "$stage" == "MIGRATED_CANARY" && "$qualifications" =~ ^[1-9][0-9]*$ \
                 && "$opening_events" == "$qualifications" \
                 && "$distinct_opening_qualifications" == "$qualifications" \
                 && "$opening_quantity" == "$qualified_quantity" \
                 && "$readiness" == "CANARY_RECONCILED" ) ) ]] || {
      echo "canonical Inventory migration reconciliation failed" >&2
      exit 1
    }
    run_tests
    ;;
  reconcile-canonical-catalog)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    test -n "$RUN_ID" || { echo "--run-id is required" >&2; exit 2; }
    require_running
    safe_run_id=${RUN_ID//\'/\'\'}
    style_code="YS-$(printf '%s' "$RUN_ID" | shasum -a 256 | awk '{print toupper(substr($1,1,8))}')"
    safe_style_code=${style_code//\'/\'\'}
    safe_reason="canonical-catalog-first-slice-v1:${safe_run_id}"
    result=$(sql --skip-column-names -e "
      SELECT COUNT(*) sku_count,
             COUNT(DISTINCT color_id) color_count,
             COUNT(DISTINCT size_id) size_count,
             COUNT(DISTINCT canonical_spu_id) spu_count,
             COUNT(DISTINCT IF(catalog_status='ACTIVE', canonical_sku_id, NULL)) active_sku_count
      FROM yshopping_dim.dim_canonical_catalog_sku_current
      WHERE tenant_id=$TENANT_ID AND style_code='$safe_style_code';")
    readiness=$(sql --skip-column-names -e "
      SELECT readiness_status
      FROM yshopping_ads.ads_canonical_catalog_readiness
      WHERE tenant_id=$TENANT_ID AND style_code='$safe_style_code';")
    lifecycle_events=$(sql --skip-column-names -e "
      SELECT COUNT(*)
      FROM yshopping_dwd.dwd_canonical_catalog_status_change
      WHERE tenant_id=$TENANT_ID AND reason='$safe_reason';")
    require_single_row "$result" "canonical Catalog aggregate"
    require_single_row "$readiness" "canonical Catalog readiness"
    require_single_row "$lifecycle_events" "canonical Catalog lifecycle"
    echo -e "sku_count\tcolor_count\tsize_count\tspu_count\tactive_sku_count\tlifecycle_events\treadiness_status"
    read -r sku_count color_count size_count spu_count active_sku_count <<< "$result"
    echo -e "$result\t$lifecycle_events\t$readiness"
    if [[ "$sku_count" != "6" || "$color_count" != "2" || "$size_count" != "3" || "$spu_count" != "1" \
       || "$active_sku_count" != "6" || "$readiness" != "CATALOG_ACTIVE" ]] \
       || ! [[ "$lifecycle_events" =~ ^[0-9]+$ ]] \
       || (( lifecycle_events < 10 || lifecycle_events > 16 )); then
      echo "canonical Catalog reconciliation failed" >&2
      exit 1
    fi
    run_tests
    ;;
