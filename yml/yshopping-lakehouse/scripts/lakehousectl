  reconcile-canonical-merchant)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    test -n "$MERCHANT_ID" || { echo "--merchant-id is required" >&2; exit 2; }
    test -n "$SOURCE_SYSTEM" || { echo "--source-system is required" >&2; exit 2; }
    test -n "$SOURCE_TYPE" || { echo "--source-type is required" >&2; exit 2; }
    test -n "$SOURCE_ID" || { echo "--source-id is required" >&2; exit 2; }
    require_running
    result=$(sql --skip-column-names -e "
      SELECT readiness.legal_entity_status, readiness.merchant_status, readiness.shop_status,
             readiness.onboarding_status, readiness.active_operator_count, readiness.active_owner_count,
             onboarding.onboarding_event_count, merchant.entity_event_count,
             shop.entity_event_count, legal_entity.entity_event_count,
             source.source_status, source.principal_status, readiness.readiness_status
      FROM yshopping_ads.ads_canonical_merchant_readiness readiness
      JOIN yshopping_dim.dim_canonical_merchant_onboarding_current onboarding
        ON onboarding.tenant_id=readiness.tenant_id
       AND onboarding.merchant_id=readiness.merchant_id
       AND onboarding.shop_id=readiness.shop_id
      JOIN yshopping_dim.dim_canonical_merchant_current merchant
        ON merchant.tenant_id=readiness.tenant_id AND merchant.merchant_id=readiness.merchant_id
      JOIN yshopping_dim.dim_canonical_shop_current shop
        ON shop.tenant_id=readiness.tenant_id AND shop.shop_id=readiness.shop_id
      JOIN yshopping_dim.dim_canonical_merchant_legal_entity_current legal_entity
        ON legal_entity.tenant_id=readiness.tenant_id
       AND legal_entity.legal_entity_id=readiness.legal_entity_id
      JOIN yshopping_dim.dim_canonical_identity_source_current source
        ON source.tenant_id=readiness.tenant_id
       AND source.principal_id=readiness.owner_principal_id
       AND source.identity_source_system='$SOURCE_SYSTEM'
       AND source.source_type='$SOURCE_TYPE'
       AND source.source_id='$SOURCE_ID'
      WHERE readiness.tenant_id=$TENANT_ID AND readiness.merchant_id='$MERCHANT_ID';")
    require_single_row "$result" "canonical merchant reconciliation"
    echo -e "legal_entity_status\tmerchant_status\tshop_status\tonboarding_status\tactive_operators\tactive_owners\tonboarding_events\tmerchant_events\tshop_events\tlegal_entity_events\tsource_status\tprincipal_status\treadiness"
    echo "$result"
    read -r legal_status merchant_status shop_status onboarding_status active_operators active_owners \
      onboarding_events merchant_events shop_events legal_events source_status principal_status readiness <<< "$result"
    [[ "$legal_status" == "VERIFIED" && "$merchant_status" == "ACTIVE" \
       && "$shop_status" == "ACTIVE" && "$onboarding_status" == "APPROVED" \
       && "$active_operators" == "1" && "$active_owners" == "1" \
       && "$onboarding_events" == "4" && "$merchant_events" -ge 2 \
       && "$shop_events" -ge 2 && "$legal_events" == "2" \
       && "$source_status" == "ACTIVE" && "$principal_status" == "ACTIVE" \
       && "$readiness" == "MERCHANT_SHOP_READY" ]] || {
      echo "canonical merchant reconciliation failed" >&2
      exit 1
    }
    run_tests
    ;;
  reconcile-canonical-merchant-deposit)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    test -n "$RUN_ID" || { echo "--run-id is required" >&2; exit 2; }
    test -n "$MERCHANT_ID" || { echo "--merchant-id is required" >&2; exit 2; }
    require_running
    safe_run_id=${RUN_ID//\'/\'\'}
    result=$(sql --skip-column-names -e "
      SELECT ledger_entry_count, account_version, required_amount_minor, held_amount_minor,
             frozen_amount_minor, paid_amount_minor, deducted_amount_minor, coverage_status,
             enforcement_status, critical_deposit_event_id, suspension_event_count,
             unpublish_saga_count, unpublish_saga_status, unpublish_saga_readiness, readiness_status
      FROM yshopping_ads.ads_canonical_merchant_deposit_readiness
      WHERE tenant_id=$TENANT_ID AND merchant_id='$MERCHANT_ID' AND run_id='$safe_run_id';")
    require_single_row "$result" "canonical Merchant deposit reconciliation"
    echo -e "ledger_entries\taccount_version\trequired_minor\theld_minor\tfrozen_minor\tpaid_minor\tdeducted_minor\tcoverage\tenforcement\tcritical_event\tsuspensions\tunpublish_sagas\tsaga_status\tsaga_readiness\treadiness"
    echo "$result"
    read -r ledger_entries account_version required held frozen paid deducted coverage enforcement \
      critical_event suspensions sagas saga_status saga_readiness readiness <<< "$result"
    [[ "$ledger_entries" =~ ^[0-9]+$ ]] && (( ledger_entries >= 6 )) \
      && [[ "$ledger_entries" == "$account_version" && "$required" == "$held" \
         && "$frozen" == "0" && "$held" == "$((paid - deducted))" \
         && "$coverage" == "SUFFICIENT" && "$enforcement" == "ENFORCED" \
         && -n "$critical_event" && "$suspensions" == "1" && "$sagas" == "1" \
         && "$saga_status" == "COMPLETED" && "$saga_readiness" == "RECONCILED" \
         && "$readiness" == "RECONCILED" ]] || {
      echo "canonical Merchant deposit reconciliation failed" >&2
      exit 1
    }
    run_tests
    ;;
  reconcile-canonical-warehouse-network)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    test -n "$WAREHOUSE_ID" || { echo "--warehouse-id is required" >&2; exit 2; }
    test -n "$SOURCE_SYSTEM" || { echo "--source-system is required" >&2; exit 2; }
    test -n "$SOURCE_TYPE" || { echo "--source-type is required" >&2; exit 2; }
    test -n "$SOURCE_ID" || { echo "--source-id is required" >&2; exit 2; }
    require_running
    result=$(sql --skip-column-names -e "
      SELECT readiness.warehouse_status, readiness.zone_count, readiness.active_zone_count,
             readiness.location_count, readiness.active_location_count,
             readiness.active_mapping_count, readiness.active_operator_count,
             warehouse.entity_event_count,
             COALESCE(mapping.exact_active_source_count, 0), readiness.readiness_status
      FROM yshopping_ads.ads_canonical_warehouse_network_readiness readiness
      JOIN yshopping_dim.dim_canonical_warehouse_current warehouse
        ON warehouse.tenant_id=readiness.tenant_id AND warehouse.warehouse_id=readiness.warehouse_id
      LEFT JOIN (
        SELECT tenant_id, warehouse_id, COUNT(*) exact_active_source_count
        FROM (
          SELECT event.*,
                 ROW_NUMBER() OVER (
                   PARTITION BY tenant_id, mapping_id
                   ORDER BY aggregate_version DESC, recorded_at DESC, event_id DESC
                 ) row_num
          FROM yshopping_dwd.dwd_canonical_warehouse_source_mapping_event event
          WHERE mapping_source_system='$SOURCE_SYSTEM'
            AND source_type='$SOURCE_TYPE' AND source_id='$SOURCE_ID'
        ) ranked
        WHERE row_num=1 AND current_status='ACTIVE'
        GROUP BY tenant_id, warehouse_id
      ) mapping ON mapping.tenant_id=readiness.tenant_id AND mapping.warehouse_id=readiness.warehouse_id
      WHERE readiness.tenant_id=$TENANT_ID AND readiness.warehouse_id='$WAREHOUSE_ID';")
    require_single_row "$result" "canonical warehouse network reconciliation"
    echo -e "warehouse_status\tzones\tactive_zones\tlocations\tactive_locations\tactive_mappings\tactive_operators\twarehouse_events\texact_source_mappings\treadiness"
    echo "$result"
    read -r warehouse_status zones active_zones locations active_locations active_mappings \
      active_operators warehouse_events exact_source_mappings readiness <<< "$result"
    [[ "$warehouse_status" == "ACTIVE" && "$zones" == "1" && "$active_zones" == "1" \
       && "$locations" == "1" && "$active_locations" == "1" \
       && "$active_mappings" =~ ^[1-9][0-9]*$ && "$active_operators" == "1" \
       && "$warehouse_events" == "2" && "$exact_source_mappings" == "1" \
       && "$readiness" == "WAREHOUSE_NETWORK_READY" ]] || {
      echo "canonical warehouse network reconciliation failed" >&2
      exit 1
    }
    run_tests
    ;;
  *)
    usage
    exit 2
    ;;
esac
