  reconcile-canonical-aftersales)
    test -n "$TENANT_ID" || { echo "--tenant is required" >&2; exit 2; }
    test -n "$RUN_ID" || { echo "--run-id is required" >&2; exit 2; }
    require_running
    safe_run_id=${RUN_ID//\'/\'\'}
    after_sale_filter=""
    if [[ -n "$AFTER_SALE_ID" ]]; then
      after_sale_filter=" AND after_sale_id='$AFTER_SALE_ID'"
    fi
    result=$(sql --skip-column-names -e "
      SELECT saga_event_count, saga_version, saga_status, after_sale_status, refund_status,
             return_fulfillment_status, inspection_result,
             requested_quantity, accepted_quantity, inventory_return_quantity,
             reported_gross_amount_minor, reported_benefit_amount_minor, reported_net_amount_minor,
             approved_amount_minor, refunded_amount_minor, payment_effect_refund_amount_minor,
             payment_effect_cumulative_refunded_amount_minor,
             payment_effect_remaining_refundable_amount_minor, payment_effect_status,
             benefit_reversal_status, benefit_reversal_amount_minor,
             recorded_benefit_reversal_amount_minor, funding_reversal_amount_minor,
             benefit_reversal_count, funding_reversal_count,
             entitlement_application_count, entitlement_effect_count,
             retained_entitlement_count, returned_entitlement_count,
             settlement_status, order_return_full, settlement_quantity,
             settlement_cumulative_refunded_net_amount_minor,
             order_returned_quantity, order_total_quantity,
             order_status, recorded_order_valid, readiness_status, recovery_status
      FROM yshopping_ads.ads_canonical_after_sale_readiness
      WHERE tenant_id=$TENANT_ID AND run_id='$safe_run_id'$after_sale_filter;")
    require_single_row "$result" "canonical after-sales reconciliation"
    echo -e "saga_events\tsaga_version\tsaga_status\tafter_sale_status\trefund_status\treturn_status\tinspection\trequested_qty\taccepted_qty\tinventory_return_qty\tgross\tbenefit\tnet\tapproved\trefunded\tpayment_delta\tpayment_cumulative\tpayment_remaining\tpayment_effect_status\tbenefit_reversal_status\tbenefit_reversed\trecorded_benefit\tfunding_reversed\tbenefit_rows\tfunding_rows\tentitlement_apps\tentitlement_effects\tretained_entitlements\treturned_entitlements\tsettlement_status\torder_return_full\tsettlement_qty\tsettlement_refunded\torder_returned_qty\torder_total_qty\torder_status\trecorded_order_valid\treadiness\trecovery"
    echo "$result"
    IFS=$'\t' read -r saga_events saga_version saga_status after_sale_status refund_status return_status inspection \
      requested_qty accepted_qty inventory_return_qty gross benefit net approved refunded payment_delta \
      payment_cumulative payment_remaining payment_effect_status \
      benefit_reversal_status benefit_reversed recorded_benefit funding_reversed benefit_rows funding_rows \
      entitlement_apps entitlement_effects retained_entitlements returned_entitlements \
      settlement_status order_return_full settlement_qty settlement_refunded \
      order_returned_qty order_total_qty order_status recorded_order_valid readiness recovery <<< "$result"
    saga_baseline=8
    benefit_reconciled=false
    if [[ "$benefit" =~ ^[0-9]+$ && "$benefit" -gt 0 ]]; then
      saga_baseline=10
      [[ "$benefit_reversal_status" == "RECORDED" && "$benefit_reversed" == "$benefit" \
         && "$recorded_benefit" == "$benefit" && "$funding_reversed" == "$benefit" \
         && "$benefit_rows" =~ ^[1-9][0-9]*$ && "$funding_rows" =~ ^[1-9][0-9]*$ \
         && "$entitlement_apps" == "$entitlement_effects" \
         && $((retained_entitlements + returned_entitlements)) -eq "$entitlement_effects" ]] \
        && benefit_reconciled=true
    elif [[ "$benefit" == "0" && "$benefit_reversal_status" == "NOT_REQUIRED" \
            && "$benefit_reversed" == "0" ]]; then
      benefit_reconciled=true
    fi
    terminal_reconciled=false
    if [[ "$order_return_full" == "1" && "$settlement_status" == "FULL" \
          && "$order_returned_qty" == "$order_total_qty" \
          && "$payment_effect_status" == "REFUNDED" && "$payment_remaining" == "0" \
          && "$order_status" == "RETURNED" ]]; then
      saga_baseline=$((saga_baseline + 4))
      terminal_reconciled=true
    elif [[ "$order_return_full" == "0" && "$settlement_status" == "PARTIAL" \
            && "$order_returned_qty" != "$order_total_qty" \
            && "$payment_effect_status" == "PARTIALLY_REFUNDED" \
            && "$payment_remaining" =~ ^[1-9][0-9]*$ ]]; then
      terminal_reconciled=true
    fi
    [[ "$saga_events" == "$saga_version" && "$saga_version" =~ ^[0-9]+$ \
       && "$saga_version" -ge "$saga_baseline" \
       && $(((saga_version - saga_baseline) % 2)) -eq 0 \
       && "$saga_status" == "COMPLETED" \
       && "$after_sale_status" == "COMPLETED" && "$refund_status" == "SUCCEEDED" \
       && "$return_status" == "INSPECTION_ACCEPTED" && "$inspection" == "ACCEPTED" \
       && "$requested_qty" == "$accepted_qty" && "$accepted_qty" == "$inventory_return_qty" \
       && "$gross" -eq $((benefit + net)) && "$net" == "$approved" \
       && "$approved" == "$refunded" && "$refunded" == "$payment_delta" \
       && "$payment_cumulative" == "$settlement_refunded" \
       && "$settlement_qty" == "$requested_qty" \
       && "$benefit_reconciled" == "true" \
       && "$terminal_reconciled" == "true" \
       && "$recorded_order_valid" == "1" && "$readiness" == "RECONCILED" ]] || {
      echo "canonical after-sales reconciliation failed" >&2
      exit 1
    }
    run_tests
    ;;
