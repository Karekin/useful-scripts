    echo "$result"
    read -r saga_events saga_status saga_id order_previous order_pre_cancellation order_status order_saga_id expected declared matched \
      reservation_facts release_facts order_reservation_facts order_release_facts release_before_cancel payment_facts \
      fulfillment_facts readiness recovery <<< "$result"
    [[ "$saga_events" =~ ^[0-9]+$ ]] && (( saga_events >= 5 )) \
      && [[ "$saga_status" == "COMPLETED" \
         && "$order_previous" == "CANCELLATION_PENDING" \
         && "$order_pre_cancellation" == "INVENTORY_RESERVED" \
         && "$order_status" == "CANCELLED" && "$order_saga_id" == "$saga_id" \
         && "$expected" =~ ^[1-9][0-9]*$ \
         && "$declared" == "$expected" && "$matched" == "$expected" \
         && "$reservation_facts" == "$expected" && "$release_facts" == "$expected" \
         && "$order_reservation_facts" == "$expected" && "$order_release_facts" == "$expected" \
         && "$release_before_cancel" == "1" \
         && "$payment_facts" == "0" && "$fulfillment_facts" == "0" \
         && "$readiness" == "RECONCILED" ]] || {
      echo "canonical cancellation Saga reconciliation failed" >&2
      exit 1
    }
    run_tests
