        f"metadata={status['metadata_final_disposition_verified_count']}/"
        f"{status['metadata_source_asset_count']}, "
        f"commerce={status['commerce_final_disposition_verified_count']}/"
        f"{status['commerce_source_asset_count']}, "
        f"product={status['product_final_disposition_verified_count']}/"
        f"{status['product_source_asset_count']}, "
        f"merchant={status['merchant_final_disposition_verified_count']}/"
        f"{status['merchant_source_asset_count']}, "
        f"coupon={status['coupon_final_disposition_verified_count']}/"
        f"{status['coupon_source_asset_count']}, "
        f"user={status['user_final_disposition_verified_count']}/"
        f"{status['user_source_asset_count']}, "
        f"advertising={status['advertising_final_disposition_verified_count']}/"
        f"{status['advertising_source_asset_count']}, "
        f"engagement={status['engagement_final_disposition_verified_count']}/"
        f"{status['engagement_source_asset_count']}, "
        f"compensation={status['compensation_final_disposition_verified_count']}/"
        f"{status['compensation_source_asset_count']}, "
        f"ticket={status['ticket_final_disposition_verified_count']}/"
        f"{status['ticket_source_asset_count']}, "
        f"supply_chain={status['supply_chain_final_disposition_verified_count']}/"
        f"{status['supply_chain_source_asset_count']}, "
        f"llm={status['llm_final_disposition_verified_count']}/"
        f"{status['llm_source_asset_count']}, "
        f"operations_intelligence={status['operations_intelligence_final_disposition_verified_count']}/"
        f"{status['operations_intelligence_source_asset_count']}; routing is not completion"
    )


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "command", choices=("validate", "summary", "inventory", "disposition-status")
    )
    parser.add_argument("--reference-root", type=Path, default=DEFAULT_REFERENCE_ROOT)
    args = parser.parse_args()
    inventory = extract_inventory(args.reference_root)
    errors = validate_inventory(inventory)
    errors.extend(validate_source_domain_policy(inventory))
    errors.extend(validate_source_asset_routes(inventory))
    errors.extend(validate_game_source_dispositions(inventory))
    errors.extend(validate_metadata_source_dispositions(inventory))
    errors.extend(validate_commerce_source_dispositions(inventory))
    errors.extend(validate_product_source_dispositions(inventory))
    errors.extend(validate_merchant_source_dispositions(inventory))
    errors.extend(validate_coupon_source_dispositions(inventory))
    errors.extend(validate_user_source_dispositions(inventory))
    errors.extend(validate_payment_source_schema_request(inventory))
    errors.extend(validate_advertising_source_schema_request(inventory))
    errors.extend(validate_engagement_source_dispositions(inventory))
    errors.extend(validate_compensation_source_dispositions(inventory))
    errors.extend(validate_ticket_source_dispositions(inventory))
    errors.extend(validate_supply_chain_source_dispositions(inventory))
    errors.extend(validate_llm_source_dispositions(inventory))
    errors.extend(validate_operations_intelligence_source_dispositions(inventory))
    errors.extend(
        validate_trade_admission(
            TRADE_HISTORY_ADMISSION,
            args.reference_root / LAYER_DOCUMENTS["ODS"],
        )
    )
    if errors:
        raise SourceAssetError("; ".join(errors))
    if args.command == "inventory":
        print(json.dumps(inventory, ensure_ascii=False, indent=2))
    elif args.command == "disposition-status":
        print("\n".join(disposition_lines(inventory)))
    else:
        print("\n".join(summary_lines(inventory)))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SourceAssetError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)
