        f"({status['supply_chain_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"llm={status['llm_runtime_nonempty_reconciled_count']}/"
        f"{status['llm_source_asset_count']} "
        f"({status['llm_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"operations_intelligence={status['operations_intelligence_runtime_nonempty_reconciled_count']}/"
