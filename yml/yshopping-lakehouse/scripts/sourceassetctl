def commerce_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_commerce_source_dispositions()
    domains = contract.get("source_scope", {}).get("domains", [])
    expected, _ = _commerce_expected_assets(inventory, domains)
    assets = contract.get("assets", []) if isinstance(contract, dict) else []
    specified = [
        asset for asset in assets
        if isinstance(asset, dict) and asset.get("specification_status") == "specified"
    ]
    reconciled = [
        asset for asset in assets
        if isinstance(asset, dict)
        and _runtime_reconciliation_verified(
            asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", "")
        )
    ]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = len(expected) or 1
    return {
        "commerce_source_asset_count": len(expected),
        "commerce_detailed_disposition_specified_count": len(specified),
        "commerce_runtime_nonempty_reconciled_count": len(reconciled),
        "commerce_final_disposition_verified_count": len(verified),
        "commerce_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "commerce_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "commerce_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def validate_product_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate the ten ODS product-onboarding and operations assets."""
    errors: list[str] = []
    contract = contract or load_product_source_dispositions()
    expected = authoritative_ods_domain_assets(inventory, "商品")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["product source dispositions requires source_scope"]
    if scope.get("domain") != "商品":
        errors.append("product source dispositions source_scope.domain must be 商品")
    if scope.get("expected_asset_count") != len(expected):
        errors.append(
            "product source dispositions expected count differs from ODS overview: "
            f"contract={scope.get('expected_asset_count')}, observed={len(expected)}"
        )
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("product source dispositions must state the source detail limit")

    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["product source dispositions requires verification_policy"]
    allowed_decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if allowed_decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("product source dispositions has an invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("product source dispositions has an invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("product source dispositions has an invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("product source dispositions must reject empty tables as evidence")
    lifecycle = contract.get("lifecycle_policy_defaults")
    required_lifecycle = {"history_policy", "delete_policy", "backfill_policy"}
    if (
        not isinstance(lifecycle, dict)
        or set(lifecycle) != required_lifecycle
        or any(not isinstance(value, str) or not value.strip() for value in lifecycle.values())
    ):
        errors.append(
            f"product lifecycle defaults must define exactly {sorted(required_lifecycle)}"
        )

    detail_expectations = {
        "ods_goods_goods_new_apply_df": ("ddl_backed", 3864, 3894, "ods_goods_goods_new_apply_df"),
        "ods_goods_goods_operate_result_df": ("ddl_backed", 3895, 3932, "ods_goods_goods_operate_result_df"),
        "ods_goods_goods_operate_log_di": ("ddl_backed", 3933, 3965, "ods_goods_goods_operate_log_di"),
        "ods_goods_scene_base_info_df": ("ddl_backed", 3966, 3993, "ods_goods_scene_base_info_df"),
        "ods_goods_user_info_df": ("ddl_backed", 3994, 4022, "ods_goods_user_info_df"),
        "ods_goods_goods_operate_import_df": ("ddl_backed", 4023, 4052, "ods_goods_goods_operate_import_df"),
        "ods_goods_goods_operate_reject_df": ("ddl_backed", 4053, 4082, "ods_goods_goods_operate_reject_df"),
        "ods_goods_goods_operate_user_salary_settlement_df": ("name_conflict", 4083, 4107, "ods_goods_goods_operate_reject_df"),
        "ods_goods_goods_white_df": ("ddl_backed", 4108, 4124, "ods_goods_goods_white_df"),
        "ods_goods_goods_quilty_check_df": ("ddl_backed", 4125, 4159, "ods_goods_goods_quilty_check_df"),
    }
    source_document = (
        Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT))
        / scope.get("authoritative_document", "")
    )
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read product source document {source_document}: {exc}")
        source_lines = []
    assets = contract.get("assets")
    if not isinstance(assets, list):
        return errors + ["product source dispositions requires assets"]
    seen: set[str] = set()
    required_semantic_rules = {
        "grain", "identity", "money_or_quantity", "history", "security", "authority"
    }
    evidence_counts: Counter[str] = Counter()
    for index, asset in enumerate(assets):
        label = f"product source dispositions assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if not isinstance(name, str) or not name:
            errors.append(f"{label}: requires source_asset")
            continue
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative ODS 商品 asset: {name}")
        else:
            if [asset.get("source_label")] != observed["source_labels"]:
                errors.append(f"{label}: source label differs from ODS overview for {name}")
            anchor = asset.get("source_anchor")
            actual_anchor = (
                (anchor.get("document"), anchor.get("line"))
                if isinstance(anchor, dict) else None
            )
            if actual_anchor not in observed["anchors"]:
                errors.append(f"{label}: source anchor differs from ODS overview for {name}")
        evidence = asset.get("source_evidence")
        expectation = detail_expectations.get(name)
        if not isinstance(evidence, dict) or expectation is None:
            errors.append(f"{label}: requires governed source evidence")
        else:
            expected_status, heading_line, end_line, heading_asset = expectation
            expected_anchor = {
                "heading_line": heading_line,
                "end_line": end_line,
                "source_asset": heading_asset,
            }
            if evidence.get("status") != expected_status or evidence.get("detail_anchor") != expected_anchor:
                errors.append(f"{label}: source detail evidence differs for {name}")
            else:
                evidence_counts[expected_status] += 1
            if source_lines:
                heading_name = name if expected_status == "name_conflict" else heading_asset
                heading_valid = (
                    heading_line <= len(source_lines)
                    and heading_name.replace("_", r"\_") in source_lines[heading_line - 1]
                )
                conflict_target_present = (
                    expected_status != "name_conflict"
                    or heading_asset in "\n".join(source_lines[heading_line:end_line])
                )
                if not heading_valid or not conflict_target_present:
                    errors.append(f"{label}: source detail evidence does not prove {expectation}")
        if not isinstance(asset.get("source_grain"), str) or not asset["source_grain"].strip():
            errors.append(f"{label}: requires source_grain")
        if asset.get("decision") not in allowed_decisions:
            errors.append(f"{label}: invalid decision")
        if not _nonempty_strings(asset.get("canonical_entities")):
            errors.append(f"{label}: requires canonical_entities")
        semantic_rules = asset.get("semantic_rules")
        if not isinstance(semantic_rules, dict) or set(semantic_rules) != required_semantic_rules:
            errors.append(f"{label}: semantic_rules must define exactly {sorted(required_semantic_rules)}")
        elif any(not isinstance(value, str) or not value.strip() for value in semantic_rules.values()):
            errors.append(f"{label}: semantic_rules values must be non-empty")
        if not _nonempty_strings(asset.get("corrections")):
            errors.append(f"{label}: requires corrections")
        if asset.get("model_status") not in model_statuses:
            errors.append(f"{label}: invalid model_status")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict):
            errors.append(f"{label}: requires runtime_nonempty_reconciliation")
        else:
            if runtime.get("status") not in runtime_statuses:
                errors.append(f"{label}: invalid runtime reconciliation status")
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not gate_ref.strip() or not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: runtime reconciliation requires an existing gate_ref")
            for count_key in ("row_count", "tenant_count"):
                count = runtime.get(count_key)
                if not isinstance(count, int) or isinstance(count, bool) or count < 0:
                    errors.append(f"{label}: {count_key} must be a non-negative integer")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(
                    f"{label}: verified runtime reconciliation lacks governed production evidence: "
                    + "; ".join(_runtime_reconciliation_errors(runtime, name))
                )
        expected_specification = "specified" if evidence.get("status") == "ddl_backed" else "provisional"
        if asset.get("specification_status") != expected_specification:
            errors.append(f"{label}: specification_status must be {expected_specification}")
        if asset.get("verification_status") not in {"unverified", "verified"}:
            errors.append(f"{label}: invalid verification_status")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(f"{label}: final verification is forbidden without governed reconciliation")
    if seen != set(expected):
        errors.append(
            "product source dispositions differ from authoritative ODS overview: "
            f"missing={sorted(set(expected) - seen)}, extra={sorted(seen - set(expected))}"
        )
    if dict(evidence_counts) != scope.get("expected_source_evidence_counts"):
        errors.append(
            "product source evidence counts differ: "
            f"contract={scope.get('expected_source_evidence_counts')!r}, observed={dict(evidence_counts)!r}"
        )
    by_name = {asset.get("source_asset"): asset for asset in assets if isinstance(asset, dict)}
    result = by_name.get("ods_goods_goods_operate_result_df", {})
    if "latest" not in result.get("semantic_rules", {}).get("history", ""):
        errors.append("product operation result must reject latest-state projection as history")
    salary = by_name.get("ods_goods_goods_operate_user_salary_settlement_df", {})
    if salary.get("specification_status") != "provisional" or "HR/payroll" not in salary.get("semantic_rules", {}).get("authority", ""):
        errors.append("product salary source must remain provisional and outside Catalog authority")
    import_job = by_name.get("ods_goods_goods_operate_import_df", {})
    if "restricted" not in import_job.get("semantic_rules", {}).get("security", ""):
        errors.append("product import artifacts must remain restricted")
    quality = by_name.get("ods_goods_goods_quilty_check_df", {})
    if not any("misspelled" in correction for correction in quality.get("corrections", [])):
        errors.append("product quality disposition must preserve the misspelled source provenance")
    return errors


def product_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_product_source_dispositions()
    expected_count = len(authoritative_ods_domain_assets(inventory, "商品"))
    assets = contract.get("assets", []) if isinstance(contract, dict) else []
    specified = [
        asset for asset in assets
        if isinstance(asset, dict) and asset.get("specification_status") == "specified"
    ]
    reconciled = [
        asset for asset in assets
        if isinstance(asset, dict)
        and _runtime_reconciliation_verified(
            asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", "")
        )
    ]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = expected_count or 1
    return {
        "product_source_asset_count": expected_count,
        "product_detailed_disposition_specified_count": len(specified),
        "product_runtime_nonempty_reconciled_count": len(reconciled),
        "product_final_disposition_verified_count": len(verified),
        "product_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "product_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "product_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def validate_merchant_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate Merchant, legal, deposit, payout, appeal and assistant boundaries."""
    errors: list[str] = []
    contract = contract or load_merchant_source_dispositions()
    expected = authoritative_ods_domain_assets(inventory, "商家")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["merchant source dispositions requires source_scope"]
    if scope.get("domain") != "商家":
        errors.append("merchant source dispositions source_scope.domain must be 商家")
    if scope.get("expected_asset_count") != len(expected):
        errors.append(
            "merchant source dispositions expected count differs from ODS overview: "
            f"contract={scope.get('expected_asset_count')}, observed={len(expected)}"
        )
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("merchant source dispositions must state the source detail limit")

    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["merchant source dispositions requires verification_policy"]
    allowed_decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if allowed_decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("merchant source dispositions has an invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("merchant source dispositions has an invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("merchant source dispositions has an invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("merchant source dispositions must reject empty tables as evidence")
    lifecycle = contract.get("lifecycle_policy_defaults")
    required_lifecycle = {"history_policy", "delete_policy", "backfill_policy"}
    if (
        not isinstance(lifecycle, dict)
        or set(lifecycle) != required_lifecycle
        or any(not isinstance(value, str) or not value.strip() for value in lifecycle.values())
    ):
        errors.append(
            f"merchant lifecycle defaults must define exactly {sorted(required_lifecycle)}"
        )

    detail_expectations = {
        "ods_merchant_sys_entry_apply_df": ("ddl_backed", 7469, 7535, "ods_merchant_sys_entry_apply_df"),
        "ods_merchant_sys_info_df": ("ddl_backed", 7536, 7616, "ods_merchant_sys_info_df"),
        "ods_merchant_sys_appeal_df": ("ddl_backed", 7617, 7644, "ods_merchant_sys_appeal_df"),
        "ods_merchant_sys_withdraw_df": ("ddl_backed", 7645, 7673, "ods_merchant_sys_withdraw_df"),
        "ods_merchant_sys_exit_df": ("name_conflict", 7674, 7703, "ods_merchant_sys_withdraw_df"),
        "ods_merchant_sys_deposit_recharge_df": ("ddl_backed", 7704, 7727, "ods_merchant_sys_deposit_recharge_df"),
        "ods_merchant_ai_merchant_ai_answer_df": ("ddl_backed", 7728, 7758, "ods_merchant_ai_merchant_ai_answer_df"),
    }
    source_document = (
        Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT))
        / scope.get("authoritative_document", "")
    )
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read merchant source document {source_document}: {exc}")
        source_lines = []
    assets = contract.get("assets")
    if not isinstance(assets, list):
        return errors + ["merchant source dispositions requires assets"]
    seen: set[str] = set()
    evidence_counts: Counter[str] = Counter()
    required_semantic_rules = {
        "grain", "identity", "money_or_quantity", "history", "security", "authority"
    }
    for index, asset in enumerate(assets):
        label = f"merchant source dispositions assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if not isinstance(name, str) or not name:
            errors.append(f"{label}: requires source_asset")
            continue
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative ODS 商家 asset: {name}")
        else:
            if [asset.get("source_label")] != observed["source_labels"]:
                errors.append(f"{label}: source label differs from ODS overview for {name}")
            anchors = asset.get("source_anchors")
            actual_anchors = sorted(
                (anchor.get("document"), anchor.get("line"))
                for anchor in anchors or [] if isinstance(anchor, dict)
            )
            if actual_anchors != observed["anchors"]:
                errors.append(
                    f"{label}: source anchors differ for {name}: "
                    f"contract={actual_anchors!r}, observed={observed['anchors']!r}"
                )
        expectation = detail_expectations.get(name)
        evidence = asset.get("source_evidence")
        if expectation is None or not isinstance(evidence, dict):
            errors.append(f"{label}: requires governed source evidence")
        else:
            expected_status, heading_line, end_line, heading_asset = expectation
            expected_anchor = {
                "heading_line": heading_line,
                "end_line": end_line,
                "source_asset": heading_asset,
            }
            if evidence.get("status") != expected_status or evidence.get("detail_anchor") != expected_anchor:
                errors.append(f"{label}: source detail evidence differs for {name}")
            else:
                evidence_counts[expected_status] += 1
            if source_lines:
                heading_name = name if expected_status == "name_conflict" else heading_asset
                heading_valid = (
                    heading_line <= len(source_lines)
                    and heading_name.replace("_", r"\_") in source_lines[heading_line - 1]
                )
                conflict_target_present = (
                    expected_status != "name_conflict"
                    or heading_asset in "\n".join(source_lines[heading_line:end_line])
                )
                if not heading_valid or not conflict_target_present:
                    errors.append(f"{label}: source detail evidence does not prove {expectation}")
        if not isinstance(asset.get("source_grain"), str) or not asset["source_grain"].strip():
            errors.append(f"{label}: requires source_grain")
        if asset.get("decision") not in allowed_decisions:
            errors.append(f"{label}: invalid decision")
        if not _nonempty_strings(asset.get("canonical_entities")):
            errors.append(f"{label}: requires canonical_entities")
        semantic_rules = asset.get("semantic_rules")
        if not isinstance(semantic_rules, dict) or set(semantic_rules) != required_semantic_rules:
            errors.append(f"{label}: semantic_rules must define exactly {sorted(required_semantic_rules)}")
        elif any(not isinstance(value, str) or not value.strip() for value in semantic_rules.values()):
            errors.append(f"{label}: semantic_rules values must be non-empty")
        if not _nonempty_strings(asset.get("corrections")):
            errors.append(f"{label}: requires corrections")
        if asset.get("model_status") not in model_statuses:
            errors.append(f"{label}: invalid model_status")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict):
            errors.append(f"{label}: requires runtime_nonempty_reconciliation")
        else:
            if runtime.get("status") not in runtime_statuses:
                errors.append(f"{label}: invalid runtime reconciliation status")
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not gate_ref.strip() or not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: runtime reconciliation requires an existing gate_ref")
            for count_key in ("row_count", "tenant_count"):
                count = runtime.get(count_key)
                if not isinstance(count, int) or isinstance(count, bool) or count < 0:
                    errors.append(f"{label}: {count_key} must be a non-negative integer")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(
                    f"{label}: verified runtime reconciliation lacks governed production evidence: "
                    + "; ".join(_runtime_reconciliation_errors(runtime, name))
                )
        expected_specification = "specified" if evidence.get("status") == "ddl_backed" else "provisional"
        if asset.get("specification_status") != expected_specification:
            errors.append(f"{label}: specification_status must be {expected_specification}")
        if asset.get("verification_status") not in {"unverified", "verified"}:
            errors.append(f"{label}: invalid verification_status")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(f"{label}: final verification is forbidden without governed reconciliation")
    if seen != set(expected):
        errors.append(
            "merchant source dispositions differ from authoritative ODS overview: "
            f"missing={sorted(set(expected) - seen)}, extra={sorted(seen - set(expected))}"
        )
    if dict(evidence_counts) != scope.get("expected_source_evidence_counts"):
        errors.append(
            "merchant source evidence counts differ: "
            f"contract={scope.get('expected_source_evidence_counts')!r}, observed={dict(evidence_counts)!r}"
        )
    by_name = {asset.get("source_asset"): asset for asset in assets if isinstance(asset, dict)}
    onboarding = by_name.get("ods_merchant_sys_entry_apply_df", {})
    onboarding_corrections = " ".join(onboarding.get("corrections", []))
    if "Shop" not in onboarding_corrections or "do not" not in onboarding_corrections:
        errors.append("merchant onboarding must forbid inventing a Shop")
    info = by_name.get("ods_merchant_sys_info_df", {})
    if "tokenized/restricted" not in info.get("semantic_rules", {}).get("security", ""):
        errors.append("merchant information must tokenize regulated identity and bank data")
    withdrawal = by_name.get("ods_merchant_sys_withdraw_df", {})
    if "currency is absent" not in withdrawal.get("semantic_rules", {}).get("money_or_quantity", ""):
        errors.append("merchant withdrawal must fail closed on absent currency")
    exit_asset = by_name.get("ods_merchant_sys_exit_df", {})
    if exit_asset.get("specification_status") != "provisional":
        errors.append("merchant exit must remain provisional while its DDL creates withdraw")
    deposit = by_name.get("ods_merchant_sys_deposit_recharge_df", {})
    if "STRING" not in deposit.get("semantic_rules", {}).get("money_or_quantity", ""):
        errors.append("merchant deposit must correct the string generic-unit amount")
    assistant = by_name.get("ods_merchant_ai_merchant_ai_answer_df", {})
    if "not a financial fact" not in assistant.get("semantic_rules", {}).get("money_or_quantity", ""):
        errors.append("merchant AI answers must not become financial authority")
    return errors


def merchant_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_merchant_source_dispositions()
    expected_count = len(authoritative_ods_domain_assets(inventory, "商家"))
    assets = contract.get("assets", []) if isinstance(contract, dict) else []
    specified = [
        asset for asset in assets
        if isinstance(asset, dict) and asset.get("specification_status") == "specified"
    ]
    reconciled = [
        asset for asset in assets
        if isinstance(asset, dict)
        and _runtime_reconciliation_verified(
            asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", "")
        )
    ]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = expected_count or 1
    return {
        "merchant_source_asset_count": expected_count,
        "merchant_detailed_disposition_specified_count": len(specified),
        "merchant_runtime_nonempty_reconciled_count": len(reconciled),
        "merchant_final_disposition_verified_count": len(verified),
        "merchant_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "merchant_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "merchant_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def validate_coupon_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate Template/Campaign/Entitlement/Order-benefit coupon boundaries."""
    errors: list[str] = []
    contract = contract or load_coupon_source_dispositions()
    expected = authoritative_ods_domain_assets(inventory, "优惠券")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["coupon source dispositions requires source_scope"]
    if scope.get("domain") != "优惠券":
        errors.append("coupon source dispositions source_scope.domain must be 优惠券")
    if scope.get("expected_asset_count") != len(expected):
        errors.append(
            "coupon source dispositions expected count differs from ODS overview: "
            f"contract={scope.get('expected_asset_count')}, observed={len(expected)}"
        )
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("coupon source dispositions must state the source detail limit")
    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["coupon source dispositions requires verification_policy"]
    allowed_decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if allowed_decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("coupon source dispositions has an invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("coupon source dispositions has an invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("coupon source dispositions has an invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("coupon source dispositions must reject empty tables as evidence")
    lifecycle = contract.get("lifecycle_policy_defaults")
    required_lifecycle = {"history_policy", "delete_policy", "backfill_policy"}
    if (
        not isinstance(lifecycle, dict)
        or set(lifecycle) != required_lifecycle
        or any(not isinstance(value, str) or not value.strip() for value in lifecycle.values())
    ):
        errors.append(f"coupon lifecycle defaults must define exactly {sorted(required_lifecycle)}")

    detail_expectations = {
        "ods_coupon_coupon_send_di": (1649, 1683),
        "ods_coupon_coupon_template_df": (1684, 1712),
        "ods_coupon_coupon_activity_df": (1713, 1740),
        "ods_coupon_coupon_snap_di": (1741, 1763),
        "ods_coupon_coupon_refund_di": (1764, 1787),
        "ods_coupon_coupon_allowance_di": (1788, 1813),
    }
    source_document = (
        Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT))
        / scope.get("authoritative_document", "")
    )
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read coupon source document {source_document}: {exc}")
        source_lines = []
    assets = contract.get("assets")
    if not isinstance(assets, list):
        return errors + ["coupon source dispositions requires assets"]
    seen: set[str] = set()
    evidence_counts: Counter[str] = Counter()
    required_semantic_rules = {
        "grain", "identity", "money_or_quantity", "history", "security", "authority"
    }
    for index, asset in enumerate(assets):
        label = f"coupon source dispositions assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if not isinstance(name, str) or not name:
            errors.append(f"{label}: requires source_asset")
            continue
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative ODS 优惠券 asset: {name}")
        else:
            if [asset.get("source_label")] != observed["source_labels"]:
                errors.append(f"{label}: source label differs from ODS overview for {name}")
            anchor = asset.get("source_anchor")
            actual_anchor = (
                (anchor.get("document"), anchor.get("line"))
                if isinstance(anchor, dict) else None
            )
            if actual_anchor not in observed["anchors"]:
                errors.append(f"{label}: source anchor differs from ODS overview for {name}")
        expectation = detail_expectations.get(name)
        evidence = asset.get("source_evidence")
        if expectation is None or not isinstance(evidence, dict):
            errors.append(f"{label}: requires governed source evidence")
        else:
            heading_line, end_line = expectation
            expected_anchor = {
                "heading_line": heading_line,
                "end_line": end_line,
                "source_asset": name,
            }
            if evidence.get("status") != "ddl_backed" or evidence.get("detail_anchor") != expected_anchor:
                errors.append(f"{label}: source detail evidence differs for {name}")
            else:
                evidence_counts["ddl_backed"] += 1
            if source_lines and (
                heading_line > len(source_lines)
                or name.replace("_", r"\_") not in source_lines[heading_line - 1]
                or name not in "\n".join(source_lines[heading_line:end_line])
            ):
                errors.append(f"{label}: detailed DDL does not prove {name}")
        if not isinstance(asset.get("source_grain"), str) or not asset["source_grain"].strip():
            errors.append(f"{label}: requires source_grain")
        if asset.get("decision") not in allowed_decisions:
            errors.append(f"{label}: invalid decision")
        if not _nonempty_strings(asset.get("canonical_entities")):
            errors.append(f"{label}: requires canonical_entities")
        semantic_rules = asset.get("semantic_rules")
        if not isinstance(semantic_rules, dict) or set(semantic_rules) != required_semantic_rules:
            errors.append(f"{label}: semantic_rules must define exactly {sorted(required_semantic_rules)}")
        elif any(not isinstance(value, str) or not value.strip() for value in semantic_rules.values()):
            errors.append(f"{label}: semantic_rules values must be non-empty")
        if not _nonempty_strings(asset.get("corrections")):
            errors.append(f"{label}: requires corrections")
        if asset.get("model_status") not in model_statuses:
            errors.append(f"{label}: invalid model_status")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict):
            errors.append(f"{label}: requires runtime_nonempty_reconciliation")
        else:
            if runtime.get("status") not in runtime_statuses:
                errors.append(f"{label}: invalid runtime reconciliation status")
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not gate_ref.strip() or not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: runtime reconciliation requires an existing gate_ref")
            for count_key in ("row_count", "tenant_count"):
                count = runtime.get(count_key)
                if not isinstance(count, int) or isinstance(count, bool) or count < 0:
                    errors.append(f"{label}: {count_key} must be a non-negative integer")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(
                    f"{label}: verified runtime reconciliation lacks governed production evidence: "
                    + "; ".join(_runtime_reconciliation_errors(runtime, name))
                )
        if asset.get("specification_status") != "specified":
            errors.append(f"{label}: DDL-backed coupon source must be specified")
        if asset.get("verification_status") not in {"unverified", "verified"}:
            errors.append(f"{label}: invalid verification_status")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(f"{label}: final verification is forbidden without governed reconciliation")
    if seen != set(expected):
        errors.append(
            "coupon source dispositions differ from authoritative ODS overview: "
            f"missing={sorted(set(expected) - seen)}, extra={sorted(seen - set(expected))}"
        )
    if dict(evidence_counts) != scope.get("expected_source_evidence_counts"):
        errors.append(
            "coupon source evidence counts differ: "
            f"contract={scope.get('expected_source_evidence_counts')!r}, observed={dict(evidence_counts)!r}"
        )
    by_name = {asset.get("source_asset"): asset for asset in assets if isinstance(asset, dict)}
    issued = by_name.get("ods_coupon_coupon_send_di", {})
    if "found_type_code" not in " ".join(issued.get("corrections", [])):
        errors.append("coupon issuance must preserve the ambiguous found_type_code defect")
    template = by_name.get("ods_coupon_coupon_template_df", {})
    if "trailing comma" not in " ".join(template.get("corrections", [])):
        errors.append("coupon template must repair the prototype syntax defect")
    acquisition = by_name.get("ods_coupon_coupon_snap_di", {})
    if "does not itself prove" not in acquisition.get("semantic_rules", {}).get("authority", ""):
        errors.append("coupon acquisition attempts must not fabricate entitlements")
    refund = by_name.get("ods_coupon_coupon_refund_di", {})
    if "exact original Order benefit allocation" not in " ".join(refund.get("corrections", [])):
        errors.append("coupon refund must bind the original Order allocation")
    allowance = by_name.get("ods_coupon_coupon_allowance_di", {})
    if "do not assume" not in " ".join(allowance.get("corrections", [])):
        errors.append("coupon allowance must not guess the funder from its label")
    return errors


def coupon_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_coupon_source_dispositions()
    expected_count = len(authoritative_ods_domain_assets(inventory, "优惠券"))
    assets = contract.get("assets", []) if isinstance(contract, dict) else []
    specified = [
        asset for asset in assets
        if isinstance(asset, dict) and asset.get("specification_status") == "specified"
    ]
    reconciled = [
        asset for asset in assets
        if isinstance(asset, dict)
        and _runtime_reconciliation_verified(
            asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", "")
        )
    ]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = expected_count or 1
    return {
        "coupon_source_asset_count": expected_count,
        "coupon_detailed_disposition_specified_count": len(specified),
        "coupon_runtime_nonempty_reconciled_count": len(reconciled),
        "coupon_final_disposition_verified_count": len(verified),
        "coupon_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "coupon_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "coupon_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def validate_user_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate Principal/Profile/Auth/Verification user-source boundaries."""
    errors: list[str] = []
    contract = contract or load_user_source_dispositions()
    expected = authoritative_ods_domain_assets(inventory, "用户")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["user source dispositions requires source_scope"]
    if scope.get("domain") != "用户":
        errors.append("user source dispositions source_scope.domain must be 用户")
    if scope.get("expected_asset_count") != len(expected):
        errors.append(
            "user source dispositions expected count differs from ODS overview: "
            f"contract={scope.get('expected_asset_count')}, observed={len(expected)}"
        )
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("user source dispositions must state the source detail limit")
    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["user source dispositions requires verification_policy"]
    allowed_decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if allowed_decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("user source dispositions has an invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("user source dispositions has an invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("user source dispositions has an invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("user source dispositions must reject empty tables as evidence")
    lifecycle = contract.get("lifecycle_policy_defaults")
    required_lifecycle = {"history_policy", "delete_policy", "backfill_policy"}
    if (
        not isinstance(lifecycle, dict)
        or set(lifecycle) != required_lifecycle
        or any(not isinstance(value, str) or not value.strip() for value in lifecycle.values())
    ):
        errors.append(f"user lifecycle defaults must define exactly {sorted(required_lifecycle)}")

    source_document = (
        Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT))
        / scope.get("authoritative_document", "")
    )
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read user source document {source_document}: {exc}")
        source_lines = []
    detail_expectations = {
        "ods_user_user_detail_df": (1856, 1908),
        "ods_user_user_login_di": (1910, 1931),
    }
    detailed = contract.get("ddl_backed_assets")
    if not isinstance(detailed, list):
        return errors + ["user source dispositions requires ddl_backed_assets"]
    seen: set[str] = set()
    evidence_counts: Counter[str] = Counter()
    required_semantic_rules = {
        "grain", "identity", "money_or_quantity", "history", "security", "authority"
    }
    for index, asset in enumerate(detailed):
        label = f"user source dispositions ddl_backed_assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if not isinstance(name, str) or not name:
            errors.append(f"{label}: requires source_asset")
            continue
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative ODS 用户 asset: {name}")
        else:
            if [asset.get("source_label")] != observed["source_labels"]:
                errors.append(f"{label}: source label differs from ODS overview for {name}")
            anchor = asset.get("source_anchor")
            actual_anchor = (
                (anchor.get("document"), anchor.get("line"))
                if isinstance(anchor, dict) else None
            )
            if actual_anchor not in observed["anchors"]:
                errors.append(f"{label}: source anchor differs from ODS overview for {name}")
        expectation = detail_expectations.get(name)
        evidence = asset.get("source_evidence")
        if expectation is None or not isinstance(evidence, dict):
            errors.append(f"{label}: requires governed source evidence")
        else:
            heading_line, end_line = expectation
            expected_anchor = {
                "heading_line": heading_line,
                "end_line": end_line,
                "source_asset": name,
            }
            if evidence.get("status") != "ddl_backed" or evidence.get("detail_anchor") != expected_anchor:
                errors.append(f"{label}: source detail evidence differs for {name}")
            else:
                evidence_counts["ddl_backed"] += 1
            if source_lines and (
                heading_line > len(source_lines)
                or name.replace("_", r"\_") not in source_lines[heading_line - 1]
                or name not in "\n".join(source_lines[heading_line:end_line])
            ):
                errors.append(f"{label}: detailed DDL does not prove {name}")
        if not isinstance(asset.get("source_grain"), str) or not asset["source_grain"].strip():
            errors.append(f"{label}: requires source_grain")
        if asset.get("decision") not in allowed_decisions:
            errors.append(f"{label}: invalid decision")
        if not _nonempty_strings(asset.get("canonical_entities")):
            errors.append(f"{label}: requires canonical_entities")
        semantic_rules = asset.get("semantic_rules")
        if not isinstance(semantic_rules, dict) or set(semantic_rules) != required_semantic_rules:
            errors.append(f"{label}: semantic_rules must define exactly {sorted(required_semantic_rules)}")
        elif any(not isinstance(value, str) or not value.strip() for value in semantic_rules.values()):
            errors.append(f"{label}: semantic_rules values must be non-empty")
        if not _nonempty_strings(asset.get("corrections")):
            errors.append(f"{label}: requires corrections")
        if asset.get("model_status") not in model_statuses:
            errors.append(f"{label}: invalid model_status")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict):
            errors.append(f"{label}: requires runtime_nonempty_reconciliation")
        else:
            if runtime.get("status") not in runtime_statuses:
                errors.append(f"{label}: invalid runtime reconciliation status")
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not gate_ref.strip() or not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: runtime reconciliation requires an existing gate_ref")
            for count_key in ("row_count", "tenant_count"):
                count = runtime.get(count_key)
                if not isinstance(count, int) or isinstance(count, bool) or count < 0:
                    errors.append(f"{label}: {count_key} must be a non-negative integer")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(f"{label}: verified runtime reconciliation lacks governed production evidence")
        if asset.get("specification_status") != "specified":
            errors.append(f"{label}: DDL-backed user source must be specified")
        if asset.get("verification_status") not in {"unverified", "verified"}:
            errors.append(f"{label}: invalid verification_status")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(f"{label}: final verification is forbidden without governed reconciliation")

    groups = contract.get("overview_only_groups")
    if not isinstance(groups, list) or not groups:
        return errors + ["user source dispositions requires overview_only_groups"]
    required_group_fields = {"group", "decision", "canonical_entities", "authority", "security", "assets"}
    for group_index, group in enumerate(groups):
        label = f"user source dispositions overview_only_groups[{group_index}]"
        if not isinstance(group, dict) or set(group) != required_group_fields:
            errors.append(f"{label}: must define exactly {sorted(required_group_fields)}")
            continue
        if group.get("decision") not in allowed_decisions:
            errors.append(f"{label}: invalid decision")
        if not _nonempty_strings(group.get("canonical_entities")):
            errors.append(f"{label}: requires canonical_entities")
        for text_key in ("group", "authority", "security"):
            if not isinstance(group.get(text_key), str) or not group[text_key].strip():
                errors.append(f"{label}: requires {text_key}")
        assets = group.get("assets")
        if not isinstance(assets, list) or not assets:
            errors.append(f"{label}: requires assets")
            continue
        for asset_index, asset in enumerate(assets):
            asset_label = f"{label}.assets[{asset_index}]"
            if not isinstance(asset, dict) or set(asset) != {"source_asset", "source_label", "line", "table_rule"}:
                errors.append(f"{asset_label}: requires explicit source_asset/source_label/line/table_rule")
                continue
            name = asset.get("source_asset")
            if name in seen:
                errors.append(f"{asset_label}: duplicate source_asset {name}")
            seen.add(name)
            observed = expected.get(name)
            if observed is None:
                errors.append(f"{asset_label}: not an authoritative ODS 用户 asset: {name}")
                continue
            if [asset.get("source_label")] != observed["source_labels"]:
                errors.append(f"{asset_label}: source label differs from ODS overview for {name}")
            if (scope.get("authoritative_document"), asset.get("line")) not in observed["anchors"]:
                errors.append(f"{asset_label}: source anchor differs from ODS overview for {name}")
            if not isinstance(asset.get("table_rule"), str) or not asset["table_rule"].strip():
                errors.append(f"{asset_label}: requires table-specific semantic rule")
            evidence_counts["overview_only"] += 1
    if seen != set(expected):
        errors.append(
            "user source dispositions differ from authoritative ODS overview: "
            f"missing={sorted(set(expected) - seen)}, extra={sorted(seen - set(expected))}"
        )
    if dict(evidence_counts) != scope.get("expected_source_evidence_counts"):
        errors.append(
            "user source evidence counts differ: "
            f"contract={scope.get('expected_source_evidence_counts')!r}, observed={dict(evidence_counts)!r}"
        )
    profile = next((asset for asset in detailed if asset.get("source_asset") == "ods_user_user_detail_df"), {})
    if "is_complete" not in " ".join(profile.get("corrections", [])):
        errors.append("user profile must replace the ambiguous is_complete consent flag")
    if "idcard" not in " ".join(profile.get("corrections", [])):
        errors.append("user profile must explicitly restrict raw legal identifiers")
    login = next((asset for asset in detailed if asset.get("source_asset") == "ods_user_user_login_di"), {})
    if "Markdown bold" not in " ".join(login.get("corrections", [])):
        errors.append("user login must repair the malformed prototype identifier")
    if "explicit login outcome" not in " ".join(login.get("corrections", [])):
        errors.append("user login must fail closed without outcome/method semantics")
    return errors


def user_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_user_source_dispositions()
    expected_count = len(authoritative_ods_domain_assets(inventory, "用户"))
    assets = contract.get("ddl_backed_assets", []) if isinstance(contract, dict) else []
    specified = [
        asset for asset in assets
        if isinstance(asset, dict) and asset.get("specification_status") == "specified"
    ]
    reconciled = [
        asset for asset in assets
        if isinstance(asset, dict)
        and _runtime_reconciliation_verified(
            asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", "")
        )
    ]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = expected_count or 1
    return {
        "user_source_asset_count": expected_count,
        "user_detailed_disposition_specified_count": len(specified),
        "user_runtime_nonempty_reconciled_count": len(reconciled),
        "user_final_disposition_verified_count": len(verified),
        "user_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "user_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "user_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def validate_payment_source_schema_request(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Keep overview-only payment assets blocked behind exact schema delivery."""
    errors: list[str] = []
    contract = contract or load_payment_source_schema_request()
    expected = authoritative_ods_domain_assets(inventory, "支付")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["payment source schema request requires source_scope"]
    governed = set(scope.get("already_governed_elsewhere") or [])
    requested = set(expected) - governed
    if scope.get("domain") != "支付" or scope.get("status") != "BLOCKED_MISSING_SOURCE_SCHEMA":
        errors.append("payment source schema request must remain blocked for 支付")
    if scope.get("authoritative_unique_asset_count") != len(expected):
        errors.append("payment source schema request authoritative count differs")
    if scope.get("requested_schema_asset_count") != len(requested):
        errors.append("payment source schema request missing-schema count differs")
    if governed != {"ods_logistic_logistic_track_structure_di", "ods_trade_trade_invoice_apply_df"}:
        errors.append("payment source schema request governed exclusions differ")
    delivery = contract.get("delivery_requirements")
    required_delivery_groups = {
        "source_identity", "schema", "change_semantics", "governance", "reconciliation"
    }
    if not isinstance(delivery, dict) or set(delivery) != required_delivery_groups:
        errors.append(f"payment delivery requirements must define exactly {sorted(required_delivery_groups)}")
    elif any(not _nonempty_strings(value) for value in delivery.values()):
        errors.append("payment delivery requirement groups must contain non-empty fields")
    admission = contract.get("admission_policy")
    false_gates = {
        "overview_name_is_schema_evidence",
        "documentation_volume_is_denominator",
        "sampled_rows_are_final_evidence",
        "empty_extract_is_evidence",
        "raw_pan_password_otp_or_bank_credentials_are_accepted",
    }
    if not isinstance(admission, dict):
        errors.append("payment source schema request requires admission_policy")
    else:
        for gate in false_gates:
            if admission.get(gate) is not False:
                errors.append(f"payment admission gate {gate} must be false")
        for rule in ("promotion_rule", "runtime_rule"):
            if not isinstance(admission.get(rule), str) or not admission[rule].strip():
                errors.append(f"payment admission policy requires {rule}")
    assets = contract.get("assets")
    if not isinstance(assets, list):
        return errors + ["payment source schema request requires assets"]
    seen: set[str] = set()
    for index, asset in enumerate(assets):
        label = f"payment source schema request assets[{index}]"
        required_fields = {
            "source_asset", "source_label", "overview_line", "target_boundary", "required_semantics"
        }
        if not isinstance(asset, dict) or set(asset) != required_fields:
            errors.append(f"{label}: must define exactly {sorted(required_fields)}")
            continue
        name = asset.get("source_asset")
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None or name not in requested:
            errors.append(f"{label}: not a missing-schema 支付 asset: {name}")
            continue
        if [asset.get("source_label")] != observed["source_labels"]:
            errors.append(f"{label}: source label differs from ODS overview for {name}")
        if (scope.get("authoritative_document"), asset.get("overview_line")) not in observed["anchors"]:
            errors.append(f"{label}: source anchor differs from ODS overview for {name}")
        if not isinstance(asset.get("target_boundary"), str) or not asset["target_boundary"].strip():
            errors.append(f"{label}: requires target_boundary")
        semantics = asset.get("required_semantics")
        if not _nonempty_strings(semantics) or len(semantics) < 5 or len(set(semantics)) != len(semantics):
            errors.append(f"{label}: requires at least five unique table-specific semantics")
    if seen != requested:
        errors.append(
            "payment source schema requests differ from missing-schema overview assets: "
            f"missing={sorted(requested - seen)}, extra={sorted(seen - requested)}"
        )
    by_name = {asset.get("source_asset"): asset for asset in assets if isinstance(asset, dict)}
    bind_card = " ".join(by_name.get("ods_fin_bind_card_df", {}).get("required_semantics", []))
    if "pan_cvv" not in bind_card:
        errors.append("payment card schema request must explicitly exclude PAN/CVV secrets")
    queue = " ".join(by_name.get("ods_transfer_queue_df", {}).get("required_semantics", []))
    if "validated_against_instruction" not in queue:
        errors.append("payment transfer queue must remain transport rather than financial authority")
    for name in ("ods_userscashaccountdetail_df", "ods_acc_personal_detail_df", "ods_bom_wallet_flow_log_df"):
        if " ".join(by_name.get(name, {}).get("required_semantics", [])).find("counter") < 0:
            errors.append(f"payment ledger source request must require counter-entry evidence for {name}")
    return errors


def validate_advertising_source_schema_request(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Keep overview-only advertising assets from fabricating grain or authority."""
    errors: list[str] = []
    contract = contract or load_advertising_source_schema_request()
    expected = authoritative_ods_domain_assets(inventory, "广告")
    expected_anchors = {
        "ods_bilibill_df": ("哔哩哔哩", 206),
        "ods_media_bilibili_df": ("哔哩哔哩媒", 207),
        "ods_kuaishou_df": ("快手", 208),
        "ods_toutiaoevent_df": ("头条", 209),
        "ods_media_toutiao_df": ("头条媒", 210),
        "ods_xinlangclick_df": ("新浪点击", 211),
        "ods_kafka_market_launch_label_di": ("硬广点击日志表", 212),
    }
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["advertising source schema request requires source_scope"]
    document = scope.get("authoritative_document")
    if scope.get("domain") != "广告" or scope.get("status") != "BLOCKED_MISSING_SOURCE_SCHEMA":
        errors.append("advertising source schema request must remain blocked for 广告")
    if set(expected) != set(expected_anchors):
        errors.append(
            "authoritative Advertising overview assets changed: "
            f"missing={sorted(set(expected_anchors) - set(expected))}, "
            f"extra={sorted(set(expected) - set(expected_anchors))}"
        )
    if scope.get("authoritative_unique_asset_count") != len(expected):
        errors.append("advertising source schema request authoritative count differs")
    if scope.get("requested_schema_asset_count") != len(expected):
        errors.append("advertising source schema request missing-schema count differs")

    delivery = contract.get("delivery_requirements")
    required_delivery_groups = {
        "source_identity", "schema", "change_semantics", "governance",
        "money_and_attribution", "reconciliation",
    }
    if not isinstance(delivery, dict) or set(delivery) != required_delivery_groups:
        errors.append(
            "advertising delivery requirements must define exactly "
            f"{sorted(required_delivery_groups)}"
        )
    elif any(not _nonempty_strings(value) for value in delivery.values()):
        errors.append("advertising delivery requirement groups must contain non-empty fields")

    admission = contract.get("admission_policy")
    false_gates = {
        "overview_name_is_schema_evidence",
        "platform_name_implies_event_grain",
        "sampled_rows_are_final_evidence",
        "empty_extract_is_evidence",
        "click_or_impression_proves_conversion",
        "attribution_proves_order_or_payment",
        "spend_without_currency_or_settlement_is_accepted",
        "raw_device_cookie_ip_or_platform_identifier_is_broadly_exposed",
    }
    if not isinstance(admission, dict):
        errors.append("advertising source schema request requires admission_policy")
    else:
        for gate in false_gates:
            if admission.get(gate) is not False:
                errors.append(f"advertising admission gate {gate} must be false")
        for rule in ("promotion_rule", "runtime_rule"):
            if not isinstance(admission.get(rule), str) or not admission[rule].strip():
                errors.append(f"advertising admission policy requires {rule}")

    references = contract.get("implementation_refs")
    if not isinstance(references, dict) or set(references) != {"backend_refs", "lakehouse_refs"}:
        errors.append("advertising implementation_refs must define backend_refs and lakehouse_refs")
    else:
        for kind, values in references.items():
            if not _nonempty_strings(values):
                errors.append(f"advertising {kind} must contain non-empty references")
                continue
            for value in values:
                reference_error = _contract_reference_error(value)
                if reference_error:
                    errors.append(f"advertising {kind} reference {value!r}: {reference_error}")

    assets = contract.get("assets")
    if not isinstance(assets, list):
        return errors + ["advertising source schema request requires assets"]
    logical_by_name = {
        asset["normalized_name"]: asset for asset in inventory.get("logical_assets", [])
    }
    seen: set[str] = set()
    for index, asset in enumerate(assets):
        label = f"advertising source schema request assets[{index}]"
        required_fields = {
            "source_asset", "source_label", "overview_line", "target_boundary",
            "required_semantics",
        }
        if not isinstance(asset, dict) or set(asset) != required_fields:
            errors.append(f"{label}: must define exactly {sorted(required_fields)}")
            continue
        name = asset.get("source_asset")
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        locked = expected_anchors.get(name)
        if observed is None or locked is None:
            errors.append(f"{label}: not an authoritative Advertising asset: {name}")
            continue
        expected_label, expected_line = locked
        if asset.get("source_label") != expected_label or observed.get("source_labels") != [expected_label]:
            errors.append(f"{label}: source label differs from locked ODS overview for {name}")
        if asset.get("overview_line") != expected_line or (document, expected_line) not in observed.get("anchors", []):
            errors.append(f"{label}: source anchor differs from locked ODS overview for {name}")
        if not isinstance(asset.get("target_boundary"), str) or not asset["target_boundary"].strip():
            errors.append(f"{label}: requires target_boundary")
        semantics = asset.get("required_semantics")
        if not _nonempty_strings(semantics) or len(semantics) < 6 or len(set(semantics)) != len(semantics):
            errors.append(f"{label}: requires at least six unique table-specific semantics")

        occurrences = logical_by_name.get(name, {}).get("occurrences", [])
        overview_only = (
            len(occurrences) == 1
            and occurrences[0].get("role") == "candidate"
            and occurrences[0].get("document") == document
            and occurrences[0].get("line") == expected_line
            and "数据表总览" in occurrences[0].get("heading_path", [])
        )
        if not overview_only:
            errors.append(
                f"{label}: exact field-level evidence may now exist for {name}; "
                "review and replace the missing-schema classification"
            )
    if seen != set(expected_anchors):
        errors.append(
            "advertising source schema requests differ from locked overview assets: "
            f"missing={sorted(set(expected_anchors) - seen)}, "
            f"extra={sorted(seen - set(expected_anchors))}"
        )

    by_name = {asset.get("source_asset"): asset for asset in assets if isinstance(asset, dict)}
    bilibili = " ".join(by_name.get("ods_bilibill_df", {}).get("required_semantics", []))
    if "bilibill_spelling" not in bilibili or "qualified_source" not in bilibili:
        errors.append("Advertising Bilibili request must resolve the ambiguous source spelling")
    toutiao_event = " ".join(by_name.get("ods_toutiaoevent_df", {}).get("required_semantics", []))
    if "prohibition_on_inferring_conversion_order_or_payment" not in toutiao_event:
        errors.append("Toutiao event name must not imply conversion, order or payment")
    sina_click = " ".join(by_name.get("ods_xinlangclick_df", {}).get("required_semantics", []))
    if "exclusion_of_conversion_order_payment_and_settlement_inference" not in sina_click:
        errors.append("Sina click observations must not imply downstream business effects")
    kafka = " ".join(by_name.get("ods_kafka_market_launch_label_di", {}).get("required_semantics", []))
    for token in ("topic_partition_offset", "schema_registry", "replay_duplicate", "does_not_authorize"):
        if token not in kafka:
            errors.append(f"Advertising Kafka request must require {token} semantics")
    return errors


def advertising_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_advertising_source_schema_request()
    expected_count = len(authoritative_ods_domain_assets(inventory, "广告"))
    denominator = expected_count or 1
    return {
        "advertising_source_asset_count": expected_count,
        "advertising_detailed_disposition_specified_count": 0,
        "advertising_runtime_nonempty_reconciled_count": 0,
        "advertising_final_disposition_verified_count": 0,
        "advertising_detailed_disposition_percent": round(0.0 / denominator, 2),
        "advertising_runtime_nonempty_reconciled_percent": round(0.0 / denominator, 2),
        "advertising_final_disposition_verified_percent": round(0.0 / denominator, 2),
    }


def validate_engagement_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate Notification/Favorite/Reminder source semantics."""
    errors: list[str] = []
    contract = contract or load_engagement_source_dispositions()
    expected_by_domain = {
        domain: authoritative_ods_domain_assets(inventory, domain)
        for domain in ("推送", "收藏")
    }
    expected = {
        name: value
        for domain_assets in expected_by_domain.values()
        for name, value in domain_assets.items()
    }
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["engagement source dispositions requires source_scope"]
    observed_domain_counts = {domain: len(assets) for domain, assets in expected_by_domain.items()}
    if scope.get("domains") != observed_domain_counts:
        errors.append("engagement source domain counts differ from ODS overview")
    if scope.get("expected_asset_count") != len(expected):
        errors.append("engagement source expected count differs from ODS overview")
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("engagement source dispositions must state source detail limits")
    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["engagement source dispositions requires verification_policy"]
    allowed_decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if allowed_decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("engagement source dispositions has an invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("engagement source dispositions has an invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("engagement source dispositions has an invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("engagement source dispositions must reject empty tables as evidence")
    lifecycle = contract.get("lifecycle_policy_defaults")
    required_lifecycle = {"history_policy", "delete_policy", "backfill_policy"}
    if (
        not isinstance(lifecycle, dict)
        or set(lifecycle) != required_lifecycle
        or any(not isinstance(value, str) or not value.strip() for value in lifecycle.values())
    ):
        errors.append(f"engagement lifecycle defaults must define exactly {sorted(required_lifecycle)}")
    detail_expectations = {
        "ods_push_push_message_log_di": (1818, 1833),
        "ods_push_push_app_log_di": (1835, 1852),
        "ods_collect_collect_spu_di": (1935, 1954),
        "ods_collect_collect_remind_di": (1956, 1979),
    }
    source_document = (
        Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT))
        / scope.get("authoritative_document", "")
    )
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read engagement source document {source_document}: {exc}")
        source_lines = []
    assets = contract.get("assets")
    if not isinstance(assets, list):
        return errors + ["engagement source dispositions requires assets"]
    seen: set[str] = set()
    evidence_counts: Counter[str] = Counter()
    semantic_keys = {"grain", "identity", "money_or_quantity", "history", "security", "authority"}
    for index, asset in enumerate(assets):
        label = f"engagement source dispositions assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative Push/Collect asset: {name}")
        else:
            if asset.get("source_labels") != observed["source_labels"]:
                errors.append(f"{label}: source labels differ from ODS overview for {name}")
            actual_anchors = [
                (anchor.get("document"), anchor.get("line"))
                for anchor in asset.get("source_anchors", [])
                if isinstance(anchor, dict)
            ]
            if actual_anchors != observed["anchors"]:
                errors.append(f"{label}: source anchors differ from ODS overview for {name}")
        expectation = detail_expectations.get(name)
        evidence = asset.get("source_evidence")
        if expectation is None or not isinstance(evidence, dict):
            errors.append(f"{label}: requires governed DDL evidence")
        else:
            heading_line, end_line = expectation
            expected_anchor = {"heading_line": heading_line, "end_line": end_line, "source_asset": name}
            if evidence.get("status") != "ddl_backed" or evidence.get("detail_anchor") != expected_anchor:
                errors.append(f"{label}: source detail evidence differs for {name}")
            else:
                evidence_counts["ddl_backed"] += 1
            if source_lines and (
                name.replace("_", r"\_") not in source_lines[heading_line - 1]
                or name not in "\n".join(source_lines[heading_line:end_line])
            ):
                errors.append(f"{label}: detailed DDL does not prove {name}")
        for text_key in ("source_grain",):
            if not isinstance(asset.get(text_key), str) or not asset[text_key].strip():
                errors.append(f"{label}: requires {text_key}")
        if asset.get("decision") not in allowed_decisions:
            errors.append(f"{label}: invalid decision")
        if not _nonempty_strings(asset.get("canonical_entities")):
            errors.append(f"{label}: requires canonical_entities")
        semantic_rules = asset.get("semantic_rules")
        if not isinstance(semantic_rules, dict) or set(semantic_rules) != semantic_keys:
            errors.append(f"{label}: semantic_rules must define exactly {sorted(semantic_keys)}")
        if not _nonempty_strings(asset.get("corrections")):
            errors.append(f"{label}: requires corrections")
        if asset.get("model_status") not in model_statuses:
            errors.append(f"{label}: invalid model_status")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            for reference in asset.get(ref_key, []):
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
            if not _nonempty_strings(asset.get(ref_key)):
                errors.append(f"{label}: requires {ref_key}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict) or runtime.get("status") not in runtime_statuses:
            errors.append(f"{label}: invalid runtime reconciliation")
        else:
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: runtime reconciliation requires an existing gate_ref")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(f"{label}: verified runtime reconciliation lacks governed production evidence")
        if asset.get("specification_status") != "specified":
            errors.append(f"{label}: DDL-backed engagement source must be specified")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(f"{label}: final verification is forbidden without governed reconciliation")
    if seen != set(expected):
        errors.append(
            "engagement source dispositions differ from authoritative ODS overview: "
            f"missing={sorted(set(expected) - seen)}, extra={sorted(seen - set(expected))}"
        )
    if dict(evidence_counts) != scope.get("expected_source_evidence_counts"):
        errors.append("engagement source evidence counts differ")
    by_name = {asset.get("source_asset"): asset for asset in assets if isinstance(asset, dict)}
    for name in ("ods_push_push_message_log_di", "ods_push_push_app_log_di"):
        if "versioned JSON schema" not in " ".join(by_name.get(name, {}).get("corrections", [])):
            errors.append(f"push source must require versioned JSON schema for {name}")
    for name in ("ods_collect_collect_spu_di", "ods_collect_collect_remind_di"):
        if "trailing comma" not in " ".join(by_name.get(name, {}).get("corrections", [])):
            errors.append(f"collect source must repair prototype syntax for {name}")
    return errors


def engagement_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_engagement_source_dispositions()
    expected_count = sum(
        len(authoritative_ods_domain_assets(inventory, domain)) for domain in ("推送", "收藏")
    )
    assets = contract.get("assets", []) if isinstance(contract, dict) else []
    specified = [asset for asset in assets if isinstance(asset, dict) and asset.get("specification_status") == "specified"]
    reconciled = [
        asset for asset in assets
        if isinstance(asset, dict)
        and _runtime_reconciliation_verified(asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", ""))
    ]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = expected_count or 1
    return {
        "engagement_source_asset_count": expected_count,
        "engagement_detailed_disposition_specified_count": len(specified),
        "engagement_runtime_nonempty_reconciled_count": len(reconciled),
        "engagement_final_disposition_verified_count": len(verified),
        "engagement_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "engagement_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "engagement_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def validate_compensation_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate Compensation Case/Entitlement/Execution authority boundaries."""
    errors: list[str] = []
    contract = contract or load_compensation_source_dispositions()
    expected = authoritative_ods_domain_assets(inventory, "赔付")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["compensation source dispositions requires source_scope"]
    if scope.get("domain") != "赔付" or scope.get("expected_asset_count") != len(expected):
        errors.append("compensation source scope differs from authoritative 赔付 overview")
    if scope.get("expected_source_evidence_counts") != {"ddl_backed": 1, "overview_only": 2}:
        errors.append("compensation source evidence counts must remain 1 DDL and 2 overview-only")
    if scope.get("unadvertised_detailed_asset_count") != 1:
        errors.append("compensation must retain the unadvertised reason-table finding")
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("compensation source dispositions must state source detail limits")
    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["compensation source dispositions requires verification_policy"]
    decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("compensation has invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("compensation has invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("compensation has invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("compensation must reject empty tables as evidence")
    lifecycle = contract.get("lifecycle_policy_defaults")
    if not isinstance(lifecycle, dict) or set(lifecycle) != {"history_policy", "delete_policy", "backfill_policy"}:
        errors.append("compensation lifecycle defaults are incomplete")

    source_document = (
        Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT))
        / scope.get("authoritative_document", "")
    )
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read compensation source document {source_document}: {exc}")
        source_lines = []
    detailed = contract.get("ddl_backed_assets")
    overview_only = contract.get("overview_only_assets")
    unadvertised = contract.get("unadvertised_detailed_assets")
    if not isinstance(detailed, list) or len(detailed) != 1:
        return errors + ["compensation requires exactly one DDL-backed overview asset"]
    if not isinstance(overview_only, list) or len(overview_only) != 2:
        return errors + ["compensation requires exactly two overview-only assets"]
    if not isinstance(unadvertised, list) or len(unadvertised) != 1:
        return errors + ["compensation requires exactly one unadvertised detailed asset"]
    seen: set[str] = set()
    asset = detailed[0]
    name = asset.get("source_asset") if isinstance(asset, dict) else None
    if name != "ods_repay_repay_bill_df":
        errors.append("compensation DDL-backed asset must be ods_repay_repay_bill_df")
    else:
        seen.add(name)
        observed = expected.get(name)
        if observed is None or [asset.get("source_label")] != observed["source_labels"]:
            errors.append("compensation bill label differs from ODS overview")
        anchor = asset.get("source_anchor", {})
        if (anchor.get("document"), anchor.get("line")) not in observed["anchors"]:
            errors.append("compensation bill anchor differs from ODS overview")
        expected_detail = {"heading_line": 1499, "end_line": 1544, "source_asset": name}
        evidence = asset.get("source_evidence", {})
        if evidence.get("status") != "ddl_backed" or evidence.get("detail_anchor") != expected_detail:
            errors.append("compensation bill detailed evidence differs")
        if source_lines and (
            name.replace("_", r"\_") not in source_lines[1498]
            or name not in "\n".join(source_lines[1499:1544])
        ):
            errors.append("compensation bill DDL is not proven at the locked lines")
        semantic_keys = {"grain", "identity", "money_or_quantity", "history", "security", "authority"}
        if set(asset.get("semantic_rules", {})) != semantic_keys:
            errors.append("compensation bill semantic rules are incomplete")
        if asset.get("decision") not in decisions or asset.get("model_status") not in model_statuses:
            errors.append("compensation bill decision/model status is invalid")
        if not _nonempty_strings(asset.get("canonical_entities")) or not _nonempty_strings(asset.get("corrections")):
            errors.append("compensation bill requires canonical entities and corrections")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"compensation bill requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"compensation bill invalid {ref_key[:-1]} {reference}: {reference_error}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict) or runtime.get("status") not in runtime_statuses:
            errors.append("compensation bill runtime reconciliation is invalid")
        else:
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not _resolve_contract_reference(gate_ref).is_file():
                errors.append("compensation bill runtime gate does not exist")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append("compensation bill verified reconciliation lacks governed production evidence")
        if asset.get("specification_status") != "specified":
            errors.append("compensation bill must be specified")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append("compensation bill final verification is forbidden without governed reconciliation")
        corrections = " ".join(asset.get("corrections", []))
        if "do not equate compensation with AfterSale or Payment refund" not in corrections:
            errors.append("compensation must remain distinct from AfterSale and Payment refund")
        if "typed entitlements" not in corrections or "named funder" not in corrections:
            errors.append("compensation must split typed entitlements and named funding")

    required_overview_fields = {
        "source_asset", "source_label", "source_anchor", "decision", "target_boundary",
        "required_schema_semantics", "specification_status"
    }
    for index, item in enumerate(overview_only):
        label = f"compensation overview_only_assets[{index}]"
        if not isinstance(item, dict) or set(item) != required_overview_fields:
            errors.append(f"{label}: fields differ")
            continue
        item_name = item.get("source_asset")
        if item_name in seen:
            errors.append(f"{label}: duplicate source_asset {item_name}")
        seen.add(item_name)
        observed = expected.get(item_name)
        if observed is None:
            errors.append(f"{label}: not an authoritative 赔付 asset")
            continue
        if [item.get("source_label")] != observed["source_labels"]:
            errors.append(f"{label}: source label differs")
        anchor = item.get("source_anchor", {})
        if (anchor.get("document"), anchor.get("line")) not in observed["anchors"]:
            errors.append(f"{label}: source anchor differs")
        if item.get("decision") not in decisions or item.get("specification_status") != "provisional":
            errors.append(f"{label}: must remain a provisional governed decision")
        if not isinstance(item.get("target_boundary"), str) or not item["target_boundary"].strip():
            errors.append(f"{label}: requires target_boundary")
        semantics = item.get("required_schema_semantics")
        if not _nonempty_strings(semantics) or len(semantics) < 5:
            errors.append(f"{label}: requires at least five schema semantics")
    if seen != set(expected):
        errors.append(
            "compensation dispositions differ from authoritative overview: "
            f"missing={sorted(set(expected) - seen)}, extra={sorted(seen - set(expected))}"
        )

    orphan = unadvertised[0]
    orphan_name = orphan.get("source_asset") if isinstance(orphan, dict) else None
    orphan_evidence = orphan.get("source_evidence", {}) if isinstance(orphan, dict) else {}
    expected_orphan_anchor = {
        "heading_line": 1546, "end_line": 1569, "source_asset": "ods_repay_repay_reason_df"
    }
    if (
        orphan_name != "ods_repay_repay_reason_df"
        or orphan_name in expected
        or orphan_evidence.get("status") != "ddl_backed_unadvertised"
        or orphan_evidence.get("detail_anchor") != expected_orphan_anchor
        or orphan.get("denominator_credit") is not False
        or orphan.get("decision") != "correct"
    ):
        errors.append("compensation unadvertised reason table governance differs")
    if source_lines and (
        "ods_repay_repay_reason_df" not in "\n".join(source_lines[1545:1569])
    ):
        errors.append("compensation unadvertised reason DDL is not proven")
    return errors


def compensation_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_compensation_source_dispositions()
    expected_count = len(authoritative_ods_domain_assets(inventory, "赔付"))
    assets = contract.get("ddl_backed_assets", []) if isinstance(contract, dict) else []
    specified = [asset for asset in assets if isinstance(asset, dict) and asset.get("specification_status") == "specified"]
    reconciled = [
        asset for asset in assets
        if isinstance(asset, dict)
        and _runtime_reconciliation_verified(asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", ""))
    ]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = expected_count or 1
    return {
        "compensation_source_asset_count": expected_count,
        "compensation_detailed_disposition_specified_count": len(specified),
        "compensation_runtime_nonempty_reconciled_count": len(reconciled),
        "compensation_final_disposition_verified_count": len(verified),
        "compensation_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "compensation_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "compensation_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def validate_ticket_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate Ticket/Message/Quality/Risk/AI source boundaries and name conflicts."""
    errors: list[str] = []
    contract = contract or load_ticket_source_dispositions()
    expected = authoritative_ods_domain_assets(inventory, "工单")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["ticket source dispositions requires source_scope"]
    if scope.get("domain") != "工单" or scope.get("expected_asset_count") != len(expected):
        errors.append("ticket source scope differs from authoritative 工单 overview")
    if scope.get("expected_source_evidence_counts") != {"ddl_backed": 11, "name_conflict": 4}:
        errors.append("ticket source evidence counts must remain 11 DDL and 4 conflicts")
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("ticket source dispositions must state source detail limits")
    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["ticket source dispositions requires verification_policy"]
    decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("ticket has invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("ticket has invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("ticket has invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("ticket must reject empty tables as evidence")
    lifecycle = contract.get("lifecycle_policy_defaults")
    if not isinstance(lifecycle, dict) or set(lifecycle) != {"history_policy", "delete_policy", "backfill_policy"}:
        errors.append("ticket lifecycle defaults are incomplete")
    profiles = contract.get("semantic_profiles")
    required_profiles = {
        "ticket_case", "message_content", "workflow_task", "taxonomy",
        "attachment", "operator", "quality_risk", "ai_evidence"
    }
    semantic_keys = {"grain", "identity", "money_or_quantity", "history", "security", "authority"}
    if not isinstance(profiles, dict) or set(profiles) != required_profiles:
        errors.append(f"ticket semantic profiles must define exactly {sorted(required_profiles)}")
        profiles = {}
    else:
        for profile_name, profile in profiles.items():
            if not isinstance(profile, dict) or set(profile) != semantic_keys:
                errors.append(f"ticket semantic profile {profile_name} must define exactly {sorted(semantic_keys)}")
            elif any(not isinstance(value, str) or not value.strip() for value in profile.values()):
                errors.append(f"ticket semantic profile {profile_name} contains empty rules")

    detail_expectations = {
        "ods_ticket_ticket_detail_di": (1065, 1108),
        "ods_ticket_ticket_comment_di": (1143, 1166),
        "ods_ticket_ticket_task_node_di": (1167, 1208),
        "ods_ticket_ticket_source_df": (1209, 1233),
        "ods_ticket_ticket_type_df": (1234, 1258),
        "ods_ticket_ticket_chat_message_di": (1259, 1292),
        "ods_ticket_ticket_attachment_df": (1295, 1319),
        "ods_ticket_ticket_operator_df": (1320, 1346),
        "ods_ticket_ticket_check_df": (1347, 1366),
        "ods_ticket_ticket_risk_handle_df": (1367, 1400),
        "ods_yshopping_model_predict_log_ri": (1401, 1420),
    }
    conflict_expectations = {
        "ods_ticket_ticket_order_detail_di": (1109, 1142, "ods_ticket_ticket_detail_order_di"),
        "ods_ticket_ticket_message_unit_ri": (1421, 1452, "ods_ticket_ticket_message_unit_di"),
        "ods_ticket_ticket_tag_ri": (1453, 1475, "ods_ticket_ticket_tag_di"),
        "ods_ticket_ticket_problem_attribution_ri": (1476, 1496, "ods_ticket_ticket_problem_attribution_di"),
    }
    source_document = (
        Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT))
        / scope.get("authoritative_document", "")
    )
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read ticket source document {source_document}: {exc}")
        source_lines = []
    detailed = contract.get("ddl_backed_assets")
    conflicts = contract.get("name_conflict_assets")
    if not isinstance(detailed, list) or len(detailed) != 11:
        return errors + ["ticket requires exactly eleven DDL-backed assets"]
    if not isinstance(conflicts, list) or len(conflicts) != 4:
        return errors + ["ticket requires exactly four name-conflict assets"]
    seen: set[str] = set()
    for index, asset in enumerate(detailed):
        label = f"ticket ddl_backed_assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative 工单 asset")
            continue
        if asset.get("source_labels") != observed["source_labels"]:
            errors.append(f"{label}: source labels differ")
        actual_anchors = [
            (anchor.get("document"), anchor.get("line"))
            for anchor in asset.get("source_anchors", []) if isinstance(anchor, dict)
        ]
        if actual_anchors != observed["anchors"]:
            errors.append(f"{label}: source anchors differ")
        expectation = detail_expectations.get(name)
        evidence = asset.get("source_evidence", {})
        if expectation is None:
            errors.append(f"{label}: asset is not in locked detail expectations")
        else:
            heading_line, end_line = expectation
            expected_anchor = {"heading_line": heading_line, "end_line": end_line, "source_asset": name}
            if evidence.get("status") != "ddl_backed" or evidence.get("detail_anchor") != expected_anchor:
                errors.append(f"{label}: detailed evidence differs")
            if source_lines and (
                name.replace("_", r"\_") not in source_lines[heading_line - 1]
                or name not in "\n".join(source_lines[heading_line:end_line])
            ):
                errors.append(f"{label}: same-name DDL is not proven")
        profile_name = asset.get("semantic_profile")
        if profile_name not in profiles:
            errors.append(f"{label}: invalid semantic profile")
        if not isinstance(asset.get("table_rule"), str) or not asset["table_rule"].strip():
            errors.append(f"{label}: requires table_rule")
        if asset.get("decision") not in decisions or asset.get("model_status") not in model_statuses:
            errors.append(f"{label}: invalid decision/model status")
        if not _nonempty_strings(asset.get("canonical_entities")) or not _nonempty_strings(asset.get("corrections")):
            errors.append(f"{label}: requires entities and corrections")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict) or runtime.get("status") not in runtime_statuses:
            errors.append(f"{label}: invalid runtime reconciliation")
        else:
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: runtime gate does not exist")
            for count_key in ("row_count", "tenant_count"):
                value = runtime.get(count_key)
                if not isinstance(value, int) or isinstance(value, bool) or value < 0:
                    errors.append(f"{label}: {count_key} must be non-negative integer")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(f"{label}: verified runtime lacks governed production evidence")
        if asset.get("specification_status") != "specified":
            errors.append(f"{label}: DDL-backed asset must be specified")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(f"{label}: final verification is forbidden without governed reconciliation")

    required_conflict_fields = {
        "source_asset", "source_labels", "source_anchors", "detail_anchor", "decision",
        "target_boundary", "conflict_rule", "specification_status"
    }
    for index, asset in enumerate(conflicts):
        label = f"ticket name_conflict_assets[{index}]"
        if not isinstance(asset, dict) or set(asset) != required_conflict_fields:
            errors.append(f"{label}: fields differ")
            continue
        name = asset.get("source_asset")
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative 工单 asset")
            continue
        if asset.get("source_labels") != observed["source_labels"]:
            errors.append(f"{label}: source labels differ")
        actual_anchors = [
            (anchor.get("document"), anchor.get("line"))
            for anchor in asset.get("source_anchors", []) if isinstance(anchor, dict)
        ]
        if actual_anchors != observed["anchors"]:
            errors.append(f"{label}: source anchors differ")
        expectation = conflict_expectations.get(name)
        if expectation is None:
            errors.append(f"{label}: conflict is not locked")
        else:
            heading_line, end_line, actual_create = expectation
            expected_anchor = {
                "heading_line": heading_line,
                "end_line": end_line,
                "actual_create_asset": actual_create,
            }
            if asset.get("detail_anchor") != expected_anchor:
                errors.append(f"{label}: conflict detail evidence differs")
            if source_lines and actual_create not in "\n".join(source_lines[heading_line:end_line]):
                errors.append(f"{label}: conflicting CREATE target is not proven")
        if asset.get("decision") != "correct" or asset.get("specification_status") != "provisional":
            errors.append(f"{label}: must remain provisional/correct")
        for text_key in ("target_boundary", "conflict_rule"):
            if not isinstance(asset.get(text_key), str) or not asset[text_key].strip():
                errors.append(f"{label}: requires {text_key}")
    if seen != set(expected):
        errors.append(
            "ticket dispositions differ from authoritative overview: "
            f"missing={sorted(set(expected) - seen)}, extra={sorted(seen - set(expected))}"
        )
    by_name = {asset.get("source_asset"): asset for asset in detailed if isinstance(asset, dict)}
    if "reject password field entirely" not in by_name.get("ods_ticket_ticket_operator_df", {}).get("corrections", []):
        errors.append("ticket operator must reject password migration")
    if "require versioned raw message schema" not in by_name.get("ods_yshopping_model_predict_log_ri", {}).get("corrections", []):
        errors.append("ticket AI prediction must require a versioned payload schema")
    conflict_by_name = {asset.get("source_asset"): asset for asset in conflicts if isinstance(asset, dict)}
    if "order_detail and detail_order" not in conflict_by_name.get("ods_ticket_ticket_order_detail_di", {}).get("conflict_rule", ""):
        errors.append("ticket order-detail reversed-name conflict must remain explicit")
    return errors


def ticket_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_ticket_source_dispositions()
    expected_count = len(authoritative_ods_domain_assets(inventory, "工单"))
    assets = contract.get("ddl_backed_assets", []) if isinstance(contract, dict) else []
    specified = [asset for asset in assets if isinstance(asset, dict) and asset.get("specification_status") == "specified"]
    reconciled = [
        asset for asset in assets
        if isinstance(asset, dict)
        and _runtime_reconciliation_verified(asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", ""))
    ]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = expected_count or 1
    return {
        "ticket_source_asset_count": expected_count,
        "ticket_detailed_disposition_specified_count": len(specified),
        "ticket_runtime_nonempty_reconciled_count": len(reconciled),
        "ticket_final_disposition_verified_count": len(verified),
        "ticket_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "ticket_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "ticket_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def validate_supply_chain_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate governed SCM/WMS/Quality/AI semantics without fabricating stock authority."""
    errors: list[str] = []
    contract = contract or load_supply_chain_source_dispositions()
    expected = authoritative_ods_domain_assets(inventory, "供应链")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["supply-chain source dispositions requires source_scope"]
    if scope.get("domain") != "供应链" or scope.get("expected_asset_count") != len(expected):
        errors.append("supply-chain source scope differs from authoritative 供应链 overview")
    if scope.get("expected_source_evidence_counts") != {"ddl_backed": 23, "name_conflict": 0}:
        errors.append("supply-chain source evidence counts must remain 23 DDL and 0 conflicts")
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("supply-chain source dispositions must state source detail limits")

    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["supply-chain source dispositions requires verification_policy"]
    decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("supply-chain has invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("supply-chain has invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("supply-chain has invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("supply-chain must reject empty tables as evidence")
    lifecycle = contract.get("lifecycle_policy_defaults")
    if not isinstance(lifecycle, dict) or set(lifecycle) != {"history_policy", "delete_policy", "backfill_policy"}:
        errors.append("supply-chain lifecycle defaults are incomplete")

    required_profiles = {
        "receipt_line", "receipt_header", "warehouse_operation", "quality_decision",
        "quality_taxonomy", "shipment_handoff", "warehouse_master",
        "workforce_assignment", "ai_case", "image_evidence", "ai_observation",
        "human_review", "report_projection", "feedback", "policy_config",
        "model_version", "model_lifecycle", "rule_decision",
    }
    semantic_keys = {"grain", "identity", "money_or_quantity", "history", "security", "authority"}
    profiles = contract.get("semantic_profiles")
    if not isinstance(profiles, dict) or set(profiles) != required_profiles:
        errors.append(f"supply-chain semantic profiles must define exactly {sorted(required_profiles)}")
        profiles = {}
    else:
        for profile_name, profile in profiles.items():
            if not isinstance(profile, dict) or set(profile) != semantic_keys:
                errors.append(f"supply-chain semantic profile {profile_name} must define exactly {sorted(semantic_keys)}")
            elif any(not isinstance(value, str) or not value.strip() for value in profile.values()):
                errors.append(f"supply-chain semantic profile {profile_name} contains empty rules")

    detail_expectations = {
        "ods_scm_inbound_di": (6732, 6767),
        "ods_scm_inbound_header_di": (6768, 6809),
        "ods_scm_sorting_di": (6810, 6841),
        "ods_scm_quality_operate_di": (6842, 6882),
        "ods_scm_quality_check_result_di": (6883, 6918),
        "ods_scm_quality_reason_df": (6919, 6948),
        "ods_scm_quality_identify_result_di": (6949, 6980),
        "ods_scm_outbound_di": (6981, 7009),
        "ods_scm_warehouse_df": (7010, 7036),
        "ods_scm_user_info_df": (7037, 7067),
        "ods_scm_quality_ai_identify_apply_di": (7068, 7113),
        "ods_scm_quality_ai_identify_image_di": (7114, 7144),
        "ods_scm_quality_ai_image_quality_check_di": (7145, 7171),
        "ods_scm_quality_ai_part_feature_result_di": (7172, 7198),
        "ods_scm_quality_ai_analyze_result_di": (7199, 7234),
        "ods_scm_quality_ai_manual_review_di": (7235, 7262),
        "ods_scm_quality_ai_report_post_di": (7263, 7289),
        "ods_scm_quality_ai_feedback_di": (7290, 7311),
        "ods_scm_quality_ai_product_config_df": (7312, 7351),
        "ods_scm_quality_ai_rule_config_df": (7352, 7384),
        "ods_scm_quality_ai_model_version_df": (7385, 7414),
        "ods_scm_quality_ai_model_lifecycle_di": (7415, 7437),
        "ods_scm_quality_ai_rule_decision_di": (7438, 7466),
    }
    source_document = (
        Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT))
        / scope.get("authoritative_document", "")
    )
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read supply-chain source document {source_document}: {exc}")
        source_lines = []
    assets = contract.get("ddl_backed_assets")
    if not isinstance(assets, list) or len(assets) != 23:
        return errors + ["supply-chain requires exactly twenty-three DDL-backed assets"]

    seen: set[str] = set()
    by_name: dict[str, dict[str, Any]] = {}
    for index, asset in enumerate(assets):
        label = f"supply-chain ddl_backed_assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if not isinstance(name, str) or not name:
            errors.append(f"{label}: requires source_asset")
            continue
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        by_name[name] = asset
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative 供应链 asset")
            continue
        if asset.get("source_labels") != observed["source_labels"]:
            errors.append(f"{label}: source labels differ")
        actual_anchors = [
            (anchor.get("document"), anchor.get("line"))
            for anchor in asset.get("source_anchors", []) if isinstance(anchor, dict)
        ]
        if actual_anchors != observed["anchors"]:
            errors.append(f"{label}: source anchors differ")
        expectation = detail_expectations.get(name)
        evidence = asset.get("source_evidence")
        if expectation is None or not isinstance(evidence, dict):
            errors.append(f"{label}: requires locked DDL evidence")
        else:
            heading_line, end_line = expectation
            expected_anchor = {"heading_line": heading_line, "end_line": end_line, "source_asset": name}
            if evidence.get("status") != "ddl_backed" or evidence.get("detail_anchor") != expected_anchor:
                errors.append(f"{label}: detailed evidence differs")
            if source_lines and (
                name.replace("_", r"\_") not in source_lines[heading_line - 1]
                or name not in "\n".join(source_lines[heading_line:end_line])
            ):
                errors.append(f"{label}: same-name DDL is not proven")
        if asset.get("semantic_profile") not in profiles:
            errors.append(f"{label}: invalid semantic profile")
        if not isinstance(asset.get("table_rule"), str) or not asset["table_rule"].strip():
            errors.append(f"{label}: requires table_rule")
        if asset.get("decision") not in decisions or asset.get("model_status") not in model_statuses:
            errors.append(f"{label}: invalid decision/model status")
        if not _nonempty_strings(asset.get("canonical_entities")) or not _nonempty_strings(asset.get("corrections")):
            errors.append(f"{label}: requires canonical entities and corrections")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict) or runtime.get("status") not in runtime_statuses:
            errors.append(f"{label}: invalid runtime reconciliation")
        else:
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: runtime gate does not exist")
            for count_key in ("row_count", "tenant_count"):
                value = runtime.get(count_key)
                if not isinstance(value, int) or isinstance(value, bool) or value < 0:
                    errors.append(f"{label}: {count_key} must be non-negative integer")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(f"{label}: verified runtime lacks governed production evidence")
        if asset.get("specification_status") != "specified":
            errors.append(f"{label}: must be specified")
        if asset.get("verification_status") not in {"unverified", "verified"}:
            errors.append(f"{label}: invalid verification status")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(f"{label}: final verification is forbidden without governed reconciliation")
    if seen != set(expected):
        errors.append(
            "supply-chain dispositions differ from authoritative overview: "
            f"missing={sorted(set(expected) - seen)}, extra={sorted(seen - set(expected))}"
        )

    locked_corrections = {
        "ods_scm_inbound_di": "do not equate P-code unique_id with canonical Lot or SKU",
        "ods_scm_sorting_di": "source prose says repeated sorting is overwritten so history is incomplete",
        "ods_scm_quality_operate_di": "repair DDL/sample drift task_no versus task_detail_no duplicated unique_id and omitted identify_pass_type_code",
        "ods_scm_quality_check_result_di": "repair DDL/sample drift for check_status check_time qc_time and inbound_id versus inbound_detail_id",
        "ods_scm_outbound_di": "repair DDL/sample drift type versus reference_type and missing modify_time sample value",
        "ods_scm_user_info_df": "repair trailing comma in DDL before execution",
        "ods_scm_quality_ai_analyze_result_di": "do not promote suggest_action_code or ai_result_code to business decision",
        "ods_scm_quality_ai_rule_decision_di": "do not promote final_action_code to Inventory pass reject callback or publication effect",
    }
    for name, correction in locked_corrections.items():
        if correction not in by_name.get(name, {}).get("corrections", []):
            errors.append(f"supply-chain locked correction missing for {name}")
    warehouse_entities = set(by_name.get("ods_scm_warehouse_df", {}).get("canonical_entities", []))
    if not {"warehouse.Warehouse", "warehouse.WarehouseSourceMapping", "warehouse.WarehouseLocation"} <= warehouse_entities:
        errors.append("supply-chain Warehouse must retain canonical identity, mapping and Location boundaries")
    operation_authority = profiles.get("warehouse_operation", {}).get("authority", "")
    if "Inventory owns accepted movement ledger" not in operation_authority:
        errors.append("supply-chain physical operations must not become Inventory authority")
    return errors


def supply_chain_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_supply_chain_source_dispositions()
    expected_count = len(authoritative_ods_domain_assets(inventory, "供应链"))
    assets = contract.get("ddl_backed_assets", []) if isinstance(contract, dict) else []
    specified = [asset for asset in assets if isinstance(asset, dict) and asset.get("specification_status") == "specified"]
    reconciled = [
        asset for asset in assets
        if isinstance(asset, dict)
        and _runtime_reconciliation_verified(asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", ""))
    ]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = expected_count or 1
    return {
        "supply_chain_source_asset_count": expected_count,
        "supply_chain_detailed_disposition_specified_count": len(specified),
        "supply_chain_runtime_nonempty_reconciled_count": len(reconciled),
        "supply_chain_final_disposition_verified_count": len(verified),
        "supply_chain_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "supply_chain_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "supply_chain_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def validate_llm_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate AI workflow and token-platform sources without inventing schemas or effects."""
    errors: list[str] = []
    contract = contract or load_llm_source_dispositions()
    expected = authoritative_ods_domain_assets(inventory, "大模型")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["LLM source dispositions requires source_scope"]
    if scope.get("domain") != "大模型" or scope.get("expected_asset_count") != len(expected):
        errors.append("LLM source scope differs from authoritative 大模型 overview")
    locked_counts = {"ddl_backed": 14, "name_conflict": 2, "overview_only": 0}
    if scope.get("expected_source_evidence_counts") != locked_counts:
        errors.append("LLM source evidence counts must remain 14 DDL, 2 conflicts and 0 overview-only")
    if scope.get("unadvertised_detailed_finding_count") != 2:
        errors.append("LLM must retain the unadvertised account and Skill-search findings")
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("LLM source dispositions must state source detail limits")
    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["LLM source dispositions requires verification_policy"]
    decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("LLM has invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("LLM has invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("LLM has invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("LLM must reject empty tables as evidence")
    lifecycle = contract.get("lifecycle_policy_defaults")
    if not isinstance(lifecycle, dict) or set(lifecycle) != {"history_policy", "delete_policy", "backfill_policy"}:
        errors.append("LLM lifecycle defaults are incomplete")

    source_document = Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT)) / scope.get("authoritative_document", "")
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read LLM source document {source_document}: {exc}")
        source_lines = []
    detail_expectations = {
        "ods_ai_workflow_workflow_runs_df": (4156, 4195),
        "ods_ai_workflow_workflow_df": (4196, 4227),
        "ods_ai_workflow_node_executions_di": (4228, 4268),
        "ods_ai_workflow_app_log_di": (4269, 4295),
    }
    conflict_expectations = {
        "ods_ai_workflow_request_log_ri": (4352, 4376, "ods_ai_workflow_request_log_di"),
        "ods_ai_workflow_app_df": (4326, 4351, "ods_dwd_risk_ai_apps_df"),
    }
    ytoken_detail_expectations = {
        "ods_paimon_ytoken_login_ri": (7818, 7841),
        "ods_paimon_ytoken_user_ri": (7842, 7868),
        "ods_paimon_ytoken_top_up_ri": (7869, 7892),
        "ods_paimon_ytoken_configure_ri": (7893, 7919),
        "ods_paimon_ytoken_token_ri": (7920, 7965),
        "ods_paimon_ytoken_model_ri": (7966, 7993),
        "ods_paimon_ytoken_operate_log_ri": (7994, 8026),
        "ods_paimon_ytoken_image_create_ri": (8027, 8061),
        "ods_paimon_ytoken_skill_skill_info_ri": (8062, 8096),
        "ods_paimon_ytoken_skill_download_ri": (8097, 8124),
    }
    seen: set[str] = set()
    evidence_counts: Counter[str] = Counter({key: 0 for key in locked_counts})
    semantic_keys = {"grain", "identity", "money_or_quantity", "history", "security", "authority"}
    detailed = contract.get("ddl_backed_assets")
    conflicts = contract.get("name_conflict_assets")
    groups = contract.get("ddl_backed_groups")
    findings = contract.get("unadvertised_detailed_findings")
    if not isinstance(detailed, list) or len(detailed) != 4:
        return errors + ["LLM requires exactly four DDL-backed assets"]
    if not isinstance(conflicts, list) or len(conflicts) != 2:
        return errors + ["LLM requires exactly two name-conflict assets"]
    if not isinstance(groups, list) or not groups:
        return errors + ["LLM requires ytoken DDL-backed groups"]

    by_name: dict[str, dict[str, Any]] = {}
    for index, asset in enumerate(detailed):
        label = f"LLM ddl_backed_assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if not isinstance(name, str) or not name:
            errors.append(f"{label}: requires source_asset")
            continue
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        by_name[name] = asset
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative 大模型 asset")
        else:
            if [asset.get("source_label")] != observed["source_labels"]:
                errors.append(f"{label}: source label differs")
            anchor = asset.get("source_anchor")
            actual_anchor = (anchor.get("document"), anchor.get("line")) if isinstance(anchor, dict) else None
            if actual_anchor not in observed["anchors"]:
                errors.append(f"{label}: source anchor differs")
        expectation = detail_expectations.get(name)
        evidence = asset.get("source_evidence")
        if expectation is None or not isinstance(evidence, dict):
            errors.append(f"{label}: requires locked DDL evidence")
        else:
            heading_line, end_line = expectation
            expected_anchor = {"heading_line": heading_line, "end_line": end_line, "source_asset": name}
            if evidence.get("status") != "ddl_backed" or evidence.get("detail_anchor") != expected_anchor:
                errors.append(f"{label}: detailed evidence differs")
            else:
                evidence_counts["ddl_backed"] += 1
            if source_lines and (
                name.replace("_", r"\_") not in source_lines[heading_line - 1]
                or name not in "\n".join(source_lines[heading_line:end_line])
            ):
                errors.append(f"{label}: same-name DDL is not proven")
        if not isinstance(asset.get("source_grain"), str) or not asset["source_grain"].strip():
            errors.append(f"{label}: requires source_grain")
        if asset.get("decision") not in decisions or asset.get("model_status") not in model_statuses:
            errors.append(f"{label}: invalid decision/model status")
        if not _nonempty_strings(asset.get("canonical_entities")) or not _nonempty_strings(asset.get("corrections")):
            errors.append(f"{label}: requires canonical entities and corrections")
        semantic_rules = asset.get("semantic_rules")
        if not isinstance(semantic_rules, dict) or set(semantic_rules) != semantic_keys:
            errors.append(f"{label}: semantic_rules must define exactly {sorted(semantic_keys)}")
        elif any(not isinstance(value, str) or not value.strip() for value in semantic_rules.values()):
            errors.append(f"{label}: semantic rules contain empty values")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict) or runtime.get("status") not in runtime_statuses:
            errors.append(f"{label}: invalid runtime reconciliation")
        else:
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: runtime gate does not exist")
            for count_key in ("row_count", "tenant_count"):
                value = runtime.get(count_key)
                if not isinstance(value, int) or isinstance(value, bool) or value < 0:
                    errors.append(f"{label}: {count_key} must be non-negative integer")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(f"{label}: verified runtime lacks governed production evidence")
        if asset.get("specification_status") != "specified":
            errors.append(f"{label}: must be specified")
        if asset.get("verification_status") not in {"unverified", "verified"}:
            errors.append(f"{label}: invalid verification status")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(f"{label}: final verification is forbidden without governed reconciliation")

    required_conflict_fields = {"source_asset", "source_label", "line", "detail_anchor", "decision", "target_boundary", "conflict_rule", "specification_status"}
    for index, asset in enumerate(conflicts):
        label = f"LLM name_conflict_assets[{index}]"
        if not isinstance(asset, dict) or set(asset) != required_conflict_fields:
            errors.append(f"{label}: fields differ from contract")
            continue
        name = asset.get("source_asset")
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative 大模型 asset")
            continue
        if [asset.get("source_label")] != observed["source_labels"] or (scope.get("authoritative_document"), asset.get("line")) not in observed["anchors"]:
            errors.append(f"{label}: source overview evidence differs")
        expectation = conflict_expectations.get(name)
        if expectation is None:
            errors.append(f"{label}: unexpected conflict asset")
            continue
        heading_line, end_line, actual_create = expectation
        expected_anchor = {"heading_line": heading_line, "end_line": end_line, "actual_create_asset": actual_create}
        if asset.get("detail_anchor") != expected_anchor or asset.get("specification_status") != "provisional":
            errors.append(f"{label}: conflict evidence/status differs")
        if asset.get("decision") not in decisions or not all(isinstance(asset.get(key), str) and asset[key].strip() for key in ("target_boundary", "conflict_rule")):
            errors.append(f"{label}: conflict governance is incomplete")
        heading_asset = (
            actual_create
            if name == "ods_ai_workflow_request_log_ri"
            else name
        )
        if source_lines and (
            heading_asset.replace("_", r"\_") not in source_lines[heading_line - 1]
            or actual_create not in "\n".join(source_lines[heading_line:end_line])
        ):
            errors.append(f"{label}: name conflict is not proven")
        evidence_counts["name_conflict"] += 1

    required_group_fields = {
        "group", "decision", "canonical_entities", "authority", "security",
        "backend_refs", "lakehouse_refs", "assets",
    }
    required_group_asset_fields = {
        "source_asset", "source_label", "line", "detail_anchor", "source_grain",
        "table_rule", "corrections", "specification_status", "verification_status",
        "runtime_nonempty_reconciliation",
    }
    for group_index, group in enumerate(groups):
        label = f"LLM ddl_backed_groups[{group_index}]"
        if not isinstance(group, dict) or set(group) != required_group_fields:
            errors.append(f"{label}: fields differ from contract")
            continue
        if group.get("decision") not in decisions or not _nonempty_strings(group.get("canonical_entities")):
            errors.append(f"{label}: invalid decision/entities")
        if not all(isinstance(group.get(key), str) and group[key].strip() for key in ("group", "authority", "security")):
            errors.append(f"{label}: requires group authority and security")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = group.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
        assets = group.get("assets")
        if not isinstance(assets, list) or not assets:
            errors.append(f"{label}: requires assets")
            continue
        for asset_index, asset in enumerate(assets):
            asset_label = f"{label}.assets[{asset_index}]"
            if not isinstance(asset, dict) or set(asset) != required_group_asset_fields:
                errors.append(f"{asset_label}: fields differ from contract")
                continue
            name = asset.get("source_asset")
            if name in seen:
                errors.append(f"{asset_label}: duplicate source_asset {name}")
            seen.add(name)
            observed = expected.get(name)
            if observed is None:
                errors.append(f"{asset_label}: not an authoritative 大模型 asset")
                continue
            if [asset.get("source_label")] != observed["source_labels"] or (scope.get("authoritative_document"), asset.get("line")) not in observed["anchors"]:
                errors.append(f"{asset_label}: source evidence differs")
            expectation = ytoken_detail_expectations.get(name)
            if expectation is None:
                errors.append(f"{asset_label}: unexpected ytoken detailed asset")
            else:
                heading_line, end_line = expectation
                if asset.get("detail_anchor") != {"heading_line": heading_line, "end_line": end_line}:
                    errors.append(f"{asset_label}: detailed evidence differs")
                elif source_lines and (
                    name.replace("_", r"\_") not in source_lines[heading_line - 1]
                    or name not in "\n".join(source_lines[heading_line:end_line])
                ):
                    errors.append(f"{asset_label}: same-name ytoken DDL is not proven")
                else:
                    evidence_counts["ddl_backed"] += 1
            if not all(
                isinstance(asset.get(key), str) and asset[key].strip()
                for key in ("source_grain", "table_rule")
            ) or not _nonempty_strings(asset.get("corrections")):
                errors.append(f"{asset_label}: requires grain, table rule and corrections")
            if asset.get("specification_status") != "specified":
                errors.append(f"{asset_label}: must be specified")
            if asset.get("verification_status") not in {"unverified", "verified"}:
                errors.append(f"{asset_label}: invalid verification status")
            runtime = asset.get("runtime_nonempty_reconciliation")
            if not isinstance(runtime, dict) or runtime.get("status") not in runtime_statuses:
                errors.append(f"{asset_label}: invalid runtime reconciliation")
            else:
                gate_ref = runtime.get("gate_ref")
                if not isinstance(gate_ref, str) or not _resolve_contract_reference(gate_ref).is_file():
                    errors.append(f"{asset_label}: runtime gate does not exist")
                for count_key in ("row_count", "tenant_count"):
                    value = runtime.get(count_key)
                    if not isinstance(value, int) or isinstance(value, bool) or value < 0:
                        errors.append(f"{asset_label}: {count_key} must be non-negative integer")
                if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                    errors.append(f"{asset_label}: verified runtime lacks governed production evidence")
            if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(f"{asset_label}: final verification is forbidden without governed reconciliation")
    if seen != set(expected):
        errors.append(f"LLM dispositions differ from authoritative overview: missing={sorted(set(expected)-seen)}, extra={sorted(seen-set(expected))}")
    if dict(evidence_counts) != locked_counts:
        errors.append(f"LLM source evidence counts differ: observed={dict(evidence_counts)}")

    if not isinstance(findings, list) or len(findings) != 2:
        errors.append("LLM requires exactly two unadvertised detailed findings")
    else:
        expected_findings = [{
            "heading_asset":"ods_ai_workflow_account_df", "heading_line":4296, "end_line":4325,
            "actual_create_asset":"ods_ai_workflow_app_log_df", "decision":"reject",
            "finding":"The non-overview account heading creates a log-named table and includes password and password_salt; reject credential ingestion and require a qualified Identity source plus vault-held credential lifecycle.",
            "denominator_credit":False,
        }, {
            "heading_asset":"ods_paimon_ytoken_skill_search_log_ri", "heading_line":8125, "end_line":8151,
            "actual_create_asset":"ods_paimon_ytoken_skill_search_log_ri", "decision":"derive",
            "finding":"The non-overview Skill search log is a restricted search-behavior observation; govern query text and Principal identity but grant no denominator credit.",
            "denominator_credit":False,
        }]
        if findings != expected_findings:
            errors.append("LLM unadvertised account or Skill-search finding differs")
        elif source_lines and (
            "ods\\_ai\\_workflow\\_account\\_df" not in source_lines[4295]
            or "ods_ai_workflow_app_log_df" not in "\n".join(source_lines[4296:4325])
            or "password_salt" not in "\n".join(source_lines[4296:4325])
            or "ods\\_paimon\\_ytoken\\_skill\\_search\\_log\\_ri" not in source_lines[8124]
            or "ods_paimon_ytoken_skill_search_log_ri" not in "\n".join(source_lines[8125:8151])
        ):
            errors.append("LLM unadvertised source findings are not proven")
    node_corrections = " ".join(by_name.get("ods_ai_workflow_node_executions_di", {}).get("corrections", []))
    if "reuse id across multiple index" not in node_corrections:
        errors.append("LLM node attempts must reject source id as a unique attempt key")
    workflow_security = by_name.get("ods_ai_workflow_workflow_df", {}).get("semantic_rules", {}).get("security", "")
    if "secret values remain in a vault" not in workflow_security:
        errors.append("LLM workflow versions must not ingest environment secrets")
    return errors


def llm_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_llm_source_dispositions()
    expected_count = len(authoritative_ods_domain_assets(inventory, "大模型"))
    assets = contract.get("ddl_backed_assets", []) if isinstance(contract, dict) else []
    if isinstance(contract, dict):
        assets = list(assets) + [
            asset
            for group in contract.get("ddl_backed_groups", [])
            if isinstance(group, dict)
            for asset in group.get("assets", [])
        ]
    specified = [asset for asset in assets if isinstance(asset, dict) and asset.get("specification_status") == "specified"]
    reconciled = [asset for asset in assets if isinstance(asset, dict) and _runtime_reconciliation_verified(asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", ""))]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = expected_count or 1
    return {
        "llm_source_asset_count": expected_count,
        "llm_detailed_disposition_specified_count": len(specified),
        "llm_runtime_nonempty_reconciled_count": len(reconciled),
        "llm_final_disposition_verified_count": len(verified),
        "llm_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "llm_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "llm_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def validate_operations_intelligence_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate Algorithm, Platform and Intelligence sources without granting model authority."""
    errors: list[str] = []
    contract = contract or load_operations_intelligence_source_dispositions()
    expected: dict[str, dict[str, Any]] = {}
    expected_asset_domains: dict[str, str] = {}
    expected_domains = {"算法": 1, "中台": 3, "情报系统": 3}
    for domain, expected_count in expected_domains.items():
        assets = authoritative_ods_domain_assets(inventory, domain)
        if len(assets) != expected_count:
            errors.append(f"operations/intelligence {domain} overview count differs")
        expected.update(assets)
        expected_asset_domains.update({name: domain for name in assets})
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return errors + ["operations/intelligence requires source_scope"]
    locked_counts = {"ddl_backed": 5, "name_conflict": 1, "overview_only": 1}
    if scope.get("domains") != expected_domains or scope.get("expected_asset_count") != len(expected):
        errors.append("operations/intelligence source scope differs")
    if scope.get("expected_source_evidence_counts") != locked_counts:
        errors.append("operations/intelligence evidence must remain 5 DDL, 1 conflict and 1 overview-only")
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("operations/intelligence must state source detail limits")
    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["operations/intelligence requires verification_policy"]
    decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("operations/intelligence has invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("operations/intelligence has invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("operations/intelligence has invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("operations/intelligence must reject empty tables as evidence")
    lifecycle = contract.get("lifecycle_policy_defaults")
    if not isinstance(lifecycle, dict) or set(lifecycle) != {"history_policy", "delete_policy", "backfill_policy"}:
        errors.append("operations/intelligence lifecycle defaults are incomplete")

    source_document = Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT)) / scope.get("authoritative_document", "")
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read operations/intelligence source document {source_document}: {exc}")
        source_lines = []
    detail_expectations = {
        "ods_ng_all_log_ri": (3169, 3191),
        "ods_discover_ng_monitor_rule_data_ri": (3192, 3209),
        "ods_yeyes_alarm_record_df": (3808, 3844),
        "ods_intelligence_model_result_df": (4377, 4410),
        "ods_intelligence_event_code_level_df": (4440, 4461),
    }
    detailed = contract.get("ddl_backed_assets")
    conflicts = contract.get("name_conflict_assets")
    overview_only = contract.get("overview_only_assets")
    if not isinstance(detailed, list) or len(detailed) != 5:
        return errors + ["operations/intelligence requires exactly five DDL-backed assets"]
    if not isinstance(conflicts, list) or len(conflicts) != 1:
        return errors + ["operations/intelligence requires exactly one name-conflict asset"]
    if not isinstance(overview_only, list) or len(overview_only) != 1:
        return errors + ["operations/intelligence requires exactly one overview-only asset"]
    seen: set[str] = set()
    counts: Counter[str] = Counter({key: 0 for key in locked_counts})
    by_name: dict[str, dict[str, Any]] = {}
    semantic_keys = {"grain", "identity", "money_or_quantity", "history", "security", "authority"}
    for index, asset in enumerate(detailed):
        label = f"operations/intelligence ddl_backed_assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if not isinstance(name, str) or not name:
            errors.append(f"{label}: requires source_asset")
            continue
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        by_name[name] = asset
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative scoped asset")
        else:
            anchor = asset.get("source_anchor")
            actual_anchor = (anchor.get("document"), anchor.get("line")) if isinstance(anchor, dict) else None
            if [asset.get("source_label")] != observed["source_labels"] or actual_anchor not in observed["anchors"]:
                errors.append(f"{label}: overview evidence differs")
            if asset.get("source_domain") != expected_asset_domains.get(name):
                errors.append(f"{label}: source domain differs")
        expectation = detail_expectations.get(name)
        evidence = asset.get("source_evidence")
        if expectation is None or not isinstance(evidence, dict):
            errors.append(f"{label}: requires locked DDL evidence")
        else:
            heading_line, end_line = expectation
            expected_anchor = {"heading_line": heading_line, "end_line": end_line, "source_asset": name}
            if evidence.get("status") != "ddl_backed" or evidence.get("detail_anchor") != expected_anchor:
                errors.append(f"{label}: detailed evidence differs")
            elif source_lines and (
                name.replace("_", r"\_") not in source_lines[heading_line - 1]
                or name not in "\n".join(source_lines[heading_line:end_line])
            ):
                errors.append(f"{label}: same-name DDL is not proven")
            else:
                counts["ddl_backed"] += 1
            anchors = evidence.get("downstream_anchors")
            if not isinstance(anchors, list) or not anchors:
                errors.append(f"{label}: requires downstream anchors")
            else:
                for anchor in anchors:
                    path = Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT)) / anchor.get("document", "")
                    try:
                        lines = path.read_text(encoding="utf-8").splitlines()
                        excerpt = "\n".join(lines[anchor.get("start_line", 1) - 1:anchor.get("end_line", 0)])
                    except (OSError, TypeError):
                        excerpt = ""
                    if name not in excerpt:
                        errors.append(f"{label}: downstream anchor does not prove {name}")
        if asset.get("decision") not in decisions or asset.get("model_status") not in model_statuses:
            errors.append(f"{label}: invalid decision/model status")
        if not isinstance(asset.get("source_grain"), str) or not asset["source_grain"].strip():
            errors.append(f"{label}: requires source_grain")
        if not _nonempty_strings(asset.get("canonical_entities")) or not _nonempty_strings(asset.get("corrections")):
            errors.append(f"{label}: requires canonical entities and corrections")
        semantic_rules = asset.get("semantic_rules")
        if not isinstance(semantic_rules, dict) or set(semantic_rules) != semantic_keys:
            errors.append(f"{label}: semantic_rules fields differ")
        elif any(not isinstance(value, str) or not value.strip() for value in semantic_rules.values()):
            errors.append(f"{label}: semantic rule is empty")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict) or runtime.get("status") not in runtime_statuses:
            errors.append(f"{label}: invalid runtime reconciliation")
        else:
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: runtime gate does not exist")
            for count_key in ("row_count", "tenant_count"):
                value = runtime.get(count_key)
                if not isinstance(value, int) or isinstance(value, bool) or value < 0:
                    errors.append(f"{label}: {count_key} must be non-negative integer")
        if asset.get("specification_status") != "specified":
            errors.append(f"{label}: must be specified")
        if asset.get("verification_status") not in {"unverified", "verified"}:
            errors.append(f"{label}: invalid verification status")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(f"{label}: final verification is forbidden without governed reconciliation")

    conflict = conflicts[0]
    required_conflict_fields = {"source_asset", "source_domain", "source_label", "line", "detail_anchor", "decision", "target_boundary", "conflict_rule", "specification_status"}
    if not isinstance(conflict, dict) or set(conflict) != required_conflict_fields:
        errors.append("operations/intelligence name conflict fields differ")
    else:
        name = conflict.get("source_asset")
        seen.add(name)
        observed = expected.get(name)
        if observed is None or [conflict.get("source_label")] != observed["source_labels"] or (scope.get("authoritative_document"), conflict.get("line")) not in observed["anchors"]:
            errors.append("operations/intelligence clue overview evidence differs")
        expected_anchor = {"heading_line": 4411, "end_line": 4438, "actual_create_asset": "ods_intelligence_clues_df"}
        if conflict.get("detail_anchor") != expected_anchor or conflict.get("specification_status") != "provisional":
            errors.append("operations/intelligence clue conflict evidence differs")
        elif source_lines and (
            "ods\\_intelligence\\_clue\\_df" not in source_lines[4410]
            or "ods_intelligence_clues_df" not in "\n".join(source_lines[4411:4438])
        ):
            errors.append("operations/intelligence clue conflict is not proven")
        else:
            counts["name_conflict"] += 1
        if conflict.get("decision") not in decisions or not all(isinstance(conflict.get(key), str) and conflict[key].strip() for key in ("target_boundary", "conflict_rule")):
            errors.append("operations/intelligence clue conflict governance is incomplete")

    overview = overview_only[0]
    required_overview_fields = {"source_asset", "source_domain", "source_label", "line", "decision", "canonical_entities", "target_boundary", "table_rule", "specification_status"}
    if not isinstance(overview, dict) or set(overview) != required_overview_fields:
        errors.append("operations/intelligence overview-only fields differ")
    else:
        name = overview.get("source_asset")
        seen.add(name)
        observed = expected.get(name)
        if observed is None or [overview.get("source_label")] != observed["source_labels"] or (scope.get("authoritative_document"), overview.get("line")) not in observed["anchors"]:
            errors.append("operations/intelligence Algorithm overview evidence differs")
        if overview.get("specification_status") != "provisional" or overview.get("decision") not in decisions or not _nonempty_strings(overview.get("canonical_entities")):
            errors.append("operations/intelligence Algorithm disposition is incomplete")
        if not all(isinstance(overview.get(key), str) and overview[key].strip() for key in ("target_boundary", "table_rule")):
            errors.append("operations/intelligence Algorithm boundary is incomplete")
        counts["overview_only"] += 1
    if seen != set(expected):
        errors.append(f"operations/intelligence dispositions differ: missing={sorted(set(expected)-seen)}, extra={sorted(seen-set(expected))}")
    if dict(counts) != locked_counts:
        errors.append(f"operations/intelligence evidence counts differ: observed={dict(counts)}")
    algorithm_rule = overview.get("table_rule", "") if isinstance(overview, dict) else ""
    if "cannot prove cluster membership" not in algorithm_rule or "cannot prove" not in algorithm_rule:
        errors.append("Algorithm prose must not fabricate schema or enforcement authority")
    model_authority = by_name.get("ods_intelligence_model_result_df", {}).get("semantic_rules", {}).get("authority", "")
    if "never directly blocks users" not in model_authority:
        errors.append("Intelligence model results must not become direct business authority")
    return errors


def operations_intelligence_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_operations_intelligence_source_dispositions()
    expected_count = sum(len(authoritative_ods_domain_assets(inventory, domain)) for domain in ("算法", "中台", "情报系统"))
    assets = contract.get("ddl_backed_assets", []) if isinstance(contract, dict) else []
    specified = [asset for asset in assets if isinstance(asset, dict) and asset.get("specification_status") == "specified"]
    reconciled = [asset for asset in assets if isinstance(asset, dict) and _runtime_reconciliation_verified(asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", ""))]
    verified = [asset for asset in reconciled if asset.get("verification_status") == "verified"]
    denominator = expected_count or 1
    return {
        "operations_intelligence_source_asset_count": expected_count,
        "operations_intelligence_detailed_disposition_specified_count": len(specified),
        "operations_intelligence_runtime_nonempty_reconciled_count": len(reconciled),
        "operations_intelligence_final_disposition_verified_count": len(verified),
        "operations_intelligence_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "operations_intelligence_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "operations_intelligence_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


def disposition_status(
    inventory: dict[str, Any], policy: dict[str, Any] | None = None
) -> dict[str, Any]:
    policy = policy or load_source_domain_policy()
    domains = policy["domains"]
    inferred = infer_source_domains(inventory)
    candidate_assets = [
        item for item in inventory["logical_assets"] if "candidate" in item.get("roles", [])
    ]
    source_assets = [item for item in candidate_assets if item.get("source_domains")]
    rejected_names = set(policy.get("explicit_rejections", {}))
    routed = [
        item
        for item in candidate_assets
        if item["normalized_name"] not in rejected_names
        if inferred[item["logical_asset_id"]]["domains"]
        and all(
            domain in domains
            for domain in inferred[item["logical_asset_id"]]["domains"]
        )
    ]
    bounded = [
        item
        for item in routed
        if all(
            not domains[domain]["requires_row_level_split"]
            for domain in inferred[item["logical_asset_id"]]["domains"]
        )
    ]
    rejected = [
        item for item in inventory["logical_assets"]
        if item["normalized_name"] in rejected_names
    ]
    candidate_count = inventory["summary"]["unique_by_kind"]["candidate"]
    preliminary_count = len(routed) + len(rejected)
    game_status = game_disposition_status(inventory)
    metadata_status = metadata_disposition_status(inventory)
    commerce_status = commerce_disposition_status(inventory)
    product_status = product_disposition_status(inventory)
    merchant_status = merchant_disposition_status(inventory)
    coupon_status = coupon_disposition_status(inventory)
    user_status = user_disposition_status(inventory)
    advertising_status = advertising_disposition_status(inventory)
    engagement_status = engagement_disposition_status(inventory)
    compensation_status = compensation_disposition_status(inventory)
    ticket_status = ticket_disposition_status(inventory)
    supply_chain_status = supply_chain_disposition_status(inventory)
    llm_status = llm_disposition_status(inventory)
    operations_intelligence_status = operations_intelligence_disposition_status(inventory)
    detailed_count = (
        game_status["game_detailed_disposition_specified_count"]
        + metadata_status["metadata_detailed_disposition_specified_count"]
        + commerce_status["commerce_detailed_disposition_specified_count"]
        + product_status["product_detailed_disposition_specified_count"]
        + merchant_status["merchant_detailed_disposition_specified_count"]
        + coupon_status["coupon_detailed_disposition_specified_count"]
        + user_status["user_detailed_disposition_specified_count"]
        + advertising_status["advertising_detailed_disposition_specified_count"]
        + engagement_status["engagement_detailed_disposition_specified_count"]
        + compensation_status["compensation_detailed_disposition_specified_count"]
        + ticket_status["ticket_detailed_disposition_specified_count"]
        + supply_chain_status["supply_chain_detailed_disposition_specified_count"]
        + llm_status["llm_detailed_disposition_specified_count"]
        + operations_intelligence_status["operations_intelligence_detailed_disposition_specified_count"]
    )
    runtime_count = (
        game_status["game_runtime_nonempty_reconciled_count"]
        + metadata_status["metadata_runtime_nonempty_reconciled_count"]
        + commerce_status["commerce_runtime_nonempty_reconciled_count"]
        + product_status["product_runtime_nonempty_reconciled_count"]
        + merchant_status["merchant_runtime_nonempty_reconciled_count"]
        + coupon_status["coupon_runtime_nonempty_reconciled_count"]
        + user_status["user_runtime_nonempty_reconciled_count"]
        + advertising_status["advertising_runtime_nonempty_reconciled_count"]
        + engagement_status["engagement_runtime_nonempty_reconciled_count"]
        + compensation_status["compensation_runtime_nonempty_reconciled_count"]
        + ticket_status["ticket_runtime_nonempty_reconciled_count"]
        + supply_chain_status["supply_chain_runtime_nonempty_reconciled_count"]
        + llm_status["llm_runtime_nonempty_reconciled_count"]
        + operations_intelligence_status["operations_intelligence_runtime_nonempty_reconciled_count"]
    )
    verified_count = (
        game_status["game_final_disposition_verified_count"]
        + metadata_status["metadata_final_disposition_verified_count"]
        + commerce_status["commerce_final_disposition_verified_count"]
        + product_status["product_final_disposition_verified_count"]
        + merchant_status["merchant_final_disposition_verified_count"]
        + coupon_status["coupon_final_disposition_verified_count"]
        + user_status["user_final_disposition_verified_count"]
        + advertising_status["advertising_final_disposition_verified_count"]
        + engagement_status["engagement_final_disposition_verified_count"]
        + compensation_status["compensation_final_disposition_verified_count"]
        + ticket_status["ticket_final_disposition_verified_count"]
        + supply_chain_status["supply_chain_final_disposition_verified_count"]
        + llm_status["llm_final_disposition_verified_count"]
        + operations_intelligence_status["operations_intelligence_final_disposition_verified_count"]
    )
    return {
        "candidate_asset_count": candidate_count,
        "authoritative_ods_overview_asset_count": len(source_assets),
        "heading_lineage_inferred_asset_count": sum(
            1
            for item in candidate_assets
            if "heading_lineage" in inferred[item["logical_asset_id"]]["evidence_kinds"]
        ),
        "explicit_asset_route_count": sum(
            1
            for item in candidate_assets
            if "explicit_asset_route" in inferred[item["logical_asset_id"]]["evidence_kinds"]
        ),
        "domain_routed_asset_count": len(routed),
        "bounded_domain_asset_count": len(bounded),
        "explicit_rejection_count": len(rejected),
        "preliminary_handled_count": preliminary_count,
        "detailed_disposition_specified_count": detailed_count,
        "runtime_nonempty_reconciled_count": runtime_count,
        "final_disposition_verified_count": verified_count,
        "routing_percent": round(len(routed) * 100.0 / candidate_count, 2),
        "preliminary_handled_percent": round(preliminary_count * 100.0 / candidate_count, 2),
        "detailed_disposition_specified_percent": round(
            detailed_count * 100.0 / candidate_count, 2
        ),
        "runtime_nonempty_reconciled_percent": round(
            runtime_count * 100.0 / candidate_count, 2
        ),
        "final_disposition_percent": round(
            verified_count * 100.0 / candidate_count, 2
        ),
        **game_status,
        **metadata_status,
        **commerce_status,
        **product_status,
        **merchant_status,
        **coupon_status,
        **user_status,
        **advertising_status,
        **engagement_status,
        **compensation_status,
        **ticket_status,
        **supply_chain_status,
        **llm_status,
        **operations_intelligence_status,
    }


def infer_source_domains(
    inventory: dict[str, Any], asset_routes: dict[str, Any] | None = None
) -> dict[str, dict[str, Any]]:
    """Propagate authoritative ODS domains through bounded table-heading lineage.

    A heading group is accepted only when it is narrow (2-25 assets) and carries
    at most three already authoritative/inherited domains. Broad overview and
    chapter groups are intentionally ignored. The result is routing evidence,
    never a final semantic decision.
    """
    result: dict[str, dict[str, Any]] = {
        item["logical_asset_id"]: {
            "domains": set(item.get("source_domains", [])),
            "evidence_kinds": {"ods_overview"} if item.get("source_domains") else set(),
        }
        for item in inventory["logical_assets"]
    }
    groups: dict[tuple[str, tuple[str, ...]], set[str]] = defaultdict(set)
    for item in inventory["logical_assets"]:
        for occurrence in item["occurrences"]:
            headings = tuple(occurrence.get("heading_path", []))
            if len(headings) < 2 or any("数据表总览" in heading for heading in headings):
                continue
            groups[(occurrence["document"], headings)].add(item["logical_asset_id"])

    changed = True
    while changed:
        changed = False
        for asset_ids in groups.values():
            if not 2 <= len(asset_ids) <= 25:
                continue
            inherited = set().union(*(result[asset_id]["domains"] for asset_id in asset_ids))
            if not 1 <= len(inherited) <= 3:
                continue
            for asset_id in asset_ids:
                if "ods_overview" in result[asset_id]["evidence_kinds"]:
                    continue
                before = len(result[asset_id]["domains"])
                result[asset_id]["domains"].update(inherited)
                if len(result[asset_id]["domains"]) != before:
                    result[asset_id]["evidence_kinds"].add("heading_lineage")
                    changed = True
    asset_routes = asset_routes or load_source_asset_routes()
    logical_by_name = {
        item["normalized_name"]: item["logical_asset_id"]
        for item in inventory["logical_assets"]
    }
    for route in asset_routes.get("routes", []):
        for name in route.get("assets", []):
            asset_id = logical_by_name.get(name)
            if asset_id is None:
                continue
            result[asset_id]["domains"].update(route.get("source_domains", []))
            result[asset_id]["evidence_kinds"].add("explicit_asset_route")
    for value in result.values():
        value["domains"] = sorted(value["domains"])
        value["evidence_kinds"] = sorted(value["evidence_kinds"])
    return result


def summary_lines(inventory: dict[str, Any]) -> Iterable[str]:
    summary = inventory["summary"]
    yield (
        f"source inventory valid: {len(inventory['documents'])} documents, "
        f"{summary['unique_logical_asset_count']} semantic-layer logical assets "
        f"({summary['global_unique_name_count']} global names), "
        f"{summary['unique_asset_count']} role-qualified SQL-shaped assets, "
        f"{summary['topic_count']} headings, "
        f"{summary['unparsed_statement_line_count']} statement-like lines requiring review"
    )
    for layer, values in summary["unique_by_layer_and_kind"].items():
        yield f"{layer}: " + ", ".join(f"{key}={value}" for key, value in values.items())


def disposition_lines(inventory: dict[str, Any]) -> Iterable[str]:
    status = disposition_status(inventory)
    yield (
        "source disposition status: "
        f"{status['domain_routed_asset_count']}/{status['candidate_asset_count']} "
        f"assets domain-routed ({status['routing_percent']:.2f}%), "
        f"{status['heading_lineage_inferred_asset_count']} inherited through bounded headings, "
        f"{status['explicit_asset_route_count']} explicitly reviewed routes, "
        f"{status['bounded_domain_asset_count']} have a bounded single-domain route, "
        f"{status['explicit_rejection_count']} placeholders explicitly rejected"
    )
    yield (
        "preliminary source handling: "
        f"{status['preliminary_handled_count']}/{status['candidate_asset_count']} "
        f"({status['preliminary_handled_percent']:.2f}%) routed or rejected"
    )
    yield (
        "detailed source dispositions specified: "
        f"{status['detailed_disposition_specified_count']}/{status['candidate_asset_count']} "
        f"({status['detailed_disposition_specified_percent']:.2f}% overall); "
        f"game={status['game_detailed_disposition_specified_count']}/"
        f"{status['game_source_asset_count']} "
        f"({status['game_detailed_disposition_percent']:.2f}%); "
        f"metadata={status['metadata_detailed_disposition_specified_count']}/"
        f"{status['metadata_source_asset_count']} "
        f"({status['metadata_detailed_disposition_percent']:.2f}%); "
        f"commerce={status['commerce_detailed_disposition_specified_count']}/"
        f"{status['commerce_source_asset_count']} "
        f"({status['commerce_detailed_disposition_percent']:.2f}%); "
        f"product={status['product_detailed_disposition_specified_count']}/"
        f"{status['product_source_asset_count']} "
        f"({status['product_detailed_disposition_percent']:.2f}%); "
        f"merchant={status['merchant_detailed_disposition_specified_count']}/"
        f"{status['merchant_source_asset_count']} "
        f"({status['merchant_detailed_disposition_percent']:.2f}%); "
        f"coupon={status['coupon_detailed_disposition_specified_count']}/"
        f"{status['coupon_source_asset_count']} "
        f"({status['coupon_detailed_disposition_percent']:.2f}%); "
        f"user={status['user_detailed_disposition_specified_count']}/"
        f"{status['user_source_asset_count']} "
        f"({status['user_detailed_disposition_percent']:.2f}%); "
        f"advertising={status['advertising_detailed_disposition_specified_count']}/"
        f"{status['advertising_source_asset_count']} "
        f"({status['advertising_detailed_disposition_percent']:.2f}%); "
        f"engagement={status['engagement_detailed_disposition_specified_count']}/"
        f"{status['engagement_source_asset_count']} "
        f"({status['engagement_detailed_disposition_percent']:.2f}%); "
        f"compensation={status['compensation_detailed_disposition_specified_count']}/"
        f"{status['compensation_source_asset_count']} "
        f"({status['compensation_detailed_disposition_percent']:.2f}%); "
        f"ticket={status['ticket_detailed_disposition_specified_count']}/"
        f"{status['ticket_source_asset_count']} "
        f"({status['ticket_detailed_disposition_percent']:.2f}%); "
        f"supply_chain={status['supply_chain_detailed_disposition_specified_count']}/"
        f"{status['supply_chain_source_asset_count']} "
        f"({status['supply_chain_detailed_disposition_percent']:.2f}%); "
        f"llm={status['llm_detailed_disposition_specified_count']}/"
        f"{status['llm_source_asset_count']} "
        f"({status['llm_detailed_disposition_percent']:.2f}%); "
        f"operations_intelligence={status['operations_intelligence_detailed_disposition_specified_count']}/"
        f"{status['operations_intelligence_source_asset_count']} "
        f"({status['operations_intelligence_detailed_disposition_percent']:.2f}%)"
    )
    yield (
        "non-empty runtime reconciliations: "
        f"{status['runtime_nonempty_reconciled_count']}/{status['candidate_asset_count']} "
        f"({status['runtime_nonempty_reconciled_percent']:.2f}% overall); "
        f"game={status['game_runtime_nonempty_reconciled_count']}/"
        f"{status['game_source_asset_count']} "
        f"({status['game_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"metadata={status['metadata_runtime_nonempty_reconciled_count']}/"
        f"{status['metadata_source_asset_count']} "
        f"({status['metadata_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"commerce={status['commerce_runtime_nonempty_reconciled_count']}/"
        f"{status['commerce_source_asset_count']} "
        f"({status['commerce_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"product={status['product_runtime_nonempty_reconciled_count']}/"
        f"{status['product_source_asset_count']} "
        f"({status['product_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"merchant={status['merchant_runtime_nonempty_reconciled_count']}/"
        f"{status['merchant_source_asset_count']} "
        f"({status['merchant_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"coupon={status['coupon_runtime_nonempty_reconciled_count']}/"
        f"{status['coupon_source_asset_count']} "
        f"({status['coupon_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"user={status['user_runtime_nonempty_reconciled_count']}/"
        f"{status['user_source_asset_count']} "
        f"({status['user_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"advertising={status['advertising_runtime_nonempty_reconciled_count']}/"
        f"{status['advertising_source_asset_count']} "
        f"({status['advertising_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"engagement={status['engagement_runtime_nonempty_reconciled_count']}/"
        f"{status['engagement_source_asset_count']} "
        f"({status['engagement_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"compensation={status['compensation_runtime_nonempty_reconciled_count']}/"
        f"{status['compensation_source_asset_count']} "
        f"({status['compensation_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"ticket={status['ticket_runtime_nonempty_reconciled_count']}/"
        f"{status['ticket_source_asset_count']} "
        f"({status['ticket_runtime_nonempty_reconciled_percent']:.2f}%); "
        f"supply_chain={status['supply_chain_runtime_nonempty_reconciled_count']}/"
