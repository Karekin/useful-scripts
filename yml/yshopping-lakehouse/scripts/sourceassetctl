def _heading_path(headings: dict[int, str]) -> list[str]:
    return [headings[level] for level in sorted(headings)]


def _clean_markdown_cell(value: str) -> str:
    value = re.sub(r"<br\s*/?>", "", value, flags=re.IGNORECASE)
    value = re.sub(r"<[^>]+>", "", value)
    return value.replace("\\", "").strip()


def _asset_id(layer: str, kind: str, normalized_name: str) -> str:
    return f"{layer.lower()}:{kind}:{normalized_name}"


def _occurrence(
    *,
    filename: str,
    line_number: int,
    raw_identifier: str,
    qualified_name: str,
    document_layer: str,
    headings: dict[int, str],
    relation: str | None = None,
    object_type: str | None = None,
    reference_kind: str | None = None,
    source_domain: str | None = None,
    source_label: str | None = None,
) -> dict[str, Any]:
    value: dict[str, Any] = {
        "document": filename,
        "line": line_number,
        "raw_identifier": raw_identifier,
        "qualified_name": qualified_name,
        "document_layer": document_layer,
        "heading_path": _heading_path(headings),
    }
    if relation:
        value["relation"] = relation.upper()
    if object_type:
        value["object_type"] = object_type.upper()
    if reference_kind:
        value["reference_kind"] = reference_kind
    if source_domain:
        value["source_domain"] = source_domain
    if source_label:
        value["source_label"] = source_label
    return value


def _record_asset(
    assets: dict[str, dict[str, Any]],
    *,
    document_layer: str,
    kind: str,
    normalized_name: str,
    occurrence: dict[str, Any],
) -> None:
    name_layer = declared_layer(normalized_name)
    semantic_layer = name_layer or document_layer
    asset_id = _asset_id(semantic_layer, kind, normalized_name)
    asset = assets.setdefault(
        asset_id,
        {
            "asset_id": asset_id,
            "layer": semantic_layer,
            "declared_layer": name_layer,
            "document_layers": [],
            "kind": kind,
            "normalized_name": normalized_name,
            "occurrences": [],
        },
    )
    if document_layer not in asset["document_layers"]:
        asset["document_layers"].append(document_layer)
    if (
        name_layer
        and document_layer not in {name_layer, "MAIN"}
        and kind in {"create_target", "insert_target"}
    ):
        risk = f"wrong_layer_{'create' if kind == 'create_target' else 'insert'}"
        occurrence.setdefault("risk_flags", []).append(risk)
    asset["occurrences"].append(occurrence)


def extract_inventory(reference_root: Path = DEFAULT_REFERENCE_ROOT) -> dict[str, Any]:
    assets: dict[str, dict[str, Any]] = {}
    documents: list[dict[str, Any]] = []
    topics: list[dict[str, Any]] = []
    references: list[dict[str, Any]] = []
    unparsed_statement_lines: list[dict[str, Any]] = []

    for layer, filename in LAYER_DOCUMENTS.items():
        path = reference_root / filename
        if not path.is_file():
            raise SourceAssetError(f"missing source document {path}")
        lines = path.read_text(encoding="utf-8").splitlines()
        documents.append(
            {
                "layer": layer,
                "filename": filename,
                "sha256": sha256(path),
                "line_count": len(lines),
            }
        )
        headings: dict[int, str] = {}
        in_fence = False
        fence_marker: str | None = None
        fence_language = ""
        cte_aliases: set[str] = set()
        in_ods_overview = False
        ods_overview_domain = ""
        for line_number, line in enumerate(lines, start=1):
            stripped = line.lstrip()
            opening_marker = "```" if stripped.startswith("```") else "~~~" if stripped.startswith("~~~") else None
            if opening_marker:
                if not in_fence:
                    in_fence = True
                    fence_marker = opening_marker
                    fence_language = stripped[len(opening_marker) :].strip().lower().split(maxsplit=1)[0] if stripped[len(opening_marker) :].strip() else ""
                    cte_aliases = set()
                elif opening_marker == fence_marker:
                    in_fence = False
                    fence_marker = None
                    fence_language = ""
                    cte_aliases = set()
            heading = None if in_fence else HEADING_PATTERN.match(line)
            if heading:
                level = len(heading.group("marks"))
                headings = {key: value for key, value in headings.items() if key < level}
                headings[level] = heading.group("title").strip()
                topics.append(
                    {
                        "topic_id": f"{layer.lower()}:heading:{line_number}",
                        "layer": layer,
                        "document": filename,
                        "line": line_number,
                        "level": level,
                        "title": headings[level],
                        "heading_path": _heading_path(headings),
                    }
                )
                if layer == "ODS":
                    in_ods_overview = headings[level] == "数据表总览"

            source_domain = None
            source_label = None
            if in_ods_overview and line.startswith("|"):
                table_row = line.strip()
                cells = [_clean_markdown_cell(cell) for cell in table_row[1:-1].split("|")]
                if len(cells) >= 3 and cells[0] not in {"数据库", "---"}:
                    if cells[0]:
                        ods_overview_domain = cells[0]
                    if ods_overview_domain and cells[1] not in {"", "---"}:
                        source_domain = ods_overview_domain
                        source_label = cells[1]

            # Markdown bold markers occasionally appear inside a quoted SQL
            # identifier.  They are presentation syntax, not part of the name.
            searchable_line = line.replace("**", "")
            parsed_statement = False
            for match in CREATE_PATTERN.finditer(searchable_line):
                parsed_statement = True
                raw = match.group("identifier")
                qualified, normalized = normalize_identifier(raw)
                kind = "create_target"
                _record_asset(
                    assets,
                    document_layer=layer,
                    kind=kind,
                    normalized_name=normalized,
                    occurrence=
                    _occurrence(
                        filename=filename,
                        line_number=line_number,
                        raw_identifier=raw,
                        qualified_name=qualified,
                        document_layer=layer,
                        headings=headings,
                        object_type=match.group("object_type"),
                        source_domain=source_domain,
                        source_label=source_label,
                    ),
                )

            for match in INSERT_PATTERN.finditer(searchable_line):
                parsed_statement = True
                raw = match.group("identifier")
                qualified, normalized = normalize_identifier(raw)
                kind = "insert_target"
                _record_asset(
                    assets,
                    document_layer=layer,
                    kind=kind,
                    normalized_name=normalized,
                    occurrence=
                    _occurrence(
                        filename=filename,
                        line_number=line_number,
                        raw_identifier=raw,
                        qualified_name=qualified,
                        document_layer=layer,
                        headings=headings,
                        source_domain=source_domain,
                        source_label=source_label,
                    ),
                )

            is_sql_fence = in_fence and fence_language in {
                "sql",
                "hql",
                "hive",
                "flinksql",
                "mysql",
                "starrocks",
            }
            if is_sql_fence:
                cte_aliases.update(
                    match.group("identifier").lower()
                    for match in CTE_PATTERN.finditer(searchable_line)
                )
                alias_match = CTE_ALIAS_LINE_PATTERN.match(searchable_line)
                if alias_match:
                    cte_aliases.add(alias_match.group("identifier").lower())

            python_import = PYTHON_IMPORT_PATTERN.match(searchable_line)
            for match in DEPENDENCY_PATTERN.finditer(searchable_line):
                raw = match.group("identifier")
                qualified, normalized = normalize_identifier(raw)
                if is_sql_fence:
                    reference_kind = (
                        "cte" if "." not in qualified and normalized in cte_aliases else "physical_table"
                    )
                elif python_import and match.start() == python_import.start():
                    reference_kind = "python_import"
                elif in_fence:
                    reference_kind = "code_symbol"
                else:
                    reference_kind = "unclassified_reference"
                reference = _occurrence(
                    filename=filename,
                    line_number=line_number,
                    raw_identifier=raw,
                    qualified_name=qualified,
                    document_layer=layer,
                    headings=headings,
                    relation=match.group("relation"),
                    reference_kind=reference_kind,
                )
                references.append(reference)
                if reference_kind == "physical_table":
                    _record_asset(
                        assets,
                        document_layer=layer,
                        kind="dependency",
                        normalized_name=normalized,
                        occurrence=reference,
                    )

            candidate_line = searchable_line.replace("\\_", "_").replace("\\.", ".")
            for match in CANDIDATE_PATTERN.finditer(candidate_line):
                raw = match.group(0)
                qualified, normalized = normalize_identifier(raw)
                kind = "candidate"
                occurrence = _occurrence(
                    filename=filename,
                    line_number=line_number,
                    raw_identifier=raw,
                    qualified_name=qualified,
                    document_layer=layer,
                    headings=headings,
                    source_domain=source_domain,
                    source_label=source_label,
                )
                suffix = normalized.split("_", 1)[1]
                if not suffix.strip("_"):
                    occurrence["reference_kind"] = "placeholder"
                    occurrence["risk_flags"] = ["placeholder_identifier"]
                name_layer = declared_layer(normalized) or layer
                asset_id = _asset_id(name_layer, kind, normalized)
                existing = assets.get(asset_id)
                if existing is None or not any(
                    item["document"] == filename and item["line"] == line_number
                    for item in existing["occurrences"]
                ):
                    _record_asset(
                        assets,
                        document_layer=layer,
                        kind=kind,
                        normalized_name=normalized,
                        occurrence=occurrence,
                    )

            if STATEMENT_HINT_PATTERN.search(line) and not parsed_statement:
                unparsed_statement_lines.append(
                    {
                        "layer": layer,
                        "document": filename,
                        "line": line_number,
                        "text": line.strip(),
                        "heading_path": _heading_path(headings),
                    }
                )

    sorted_assets = sorted(assets.values(), key=lambda item: item["asset_id"])
    for asset in sorted_assets:
        asset["document_layers"].sort()
        asset["occurrences"].sort(key=lambda item: (item["document"], item["line"]))

    logical_by_id: dict[str, dict[str, Any]] = {}
    for asset in sorted_assets:
        logical_id = f"{asset['layer'].lower()}:object:{asset['normalized_name']}"
        logical = logical_by_id.setdefault(
            logical_id,
            {
                "logical_asset_id": logical_id,
                "layer": asset["layer"],
                "declared_layer": asset["declared_layer"],
                "document_layers": [],
                "source_domains": [],
                "source_labels": [],
                "normalized_name": asset["normalized_name"],
                "roles": [],
                "occurrences": [],
            },
        )
        logical["roles"].append(asset["kind"])
        logical["document_layers"].extend(asset["document_layers"])
        for occurrence in asset["occurrences"]:
            if occurrence.get("source_domain"):
                logical["source_domains"].append(occurrence["source_domain"])
            if occurrence.get("source_label"):
                logical["source_labels"].append(occurrence["source_label"])
            logical_occurrence = {"role": asset["kind"], **occurrence}
            key = (
                logical_occurrence["role"],
                logical_occurrence["document"],
                logical_occurrence["line"],
                logical_occurrence["qualified_name"],
            )
            existing_keys = {
                (item["role"], item["document"], item["line"], item["qualified_name"])
                for item in logical["occurrences"]
            }
            if key not in existing_keys:
                logical["occurrences"].append(logical_occurrence)
    logical_assets = sorted(logical_by_id.values(), key=lambda item: item["logical_asset_id"])
    for logical in logical_assets:
        logical["roles"] = sorted(set(logical["roles"]))
        logical["document_layers"] = sorted(set(logical["document_layers"]))
        logical["source_domains"] = sorted(set(logical["source_domains"]))
        logical["source_labels"] = sorted(set(logical["source_labels"]))
        logical["occurrences"].sort(
            key=lambda item: (item["document"], item["line"], item["role"])
        )

    by_kind = Counter(item["kind"] for item in sorted_assets)
    references.sort(key=lambda item: (item["document"], item["line"], item["qualified_name"]))
    references_by_kind = Counter(item["reference_kind"] for item in references)
    by_layer_kind: dict[str, Counter[str]] = defaultdict(Counter)
    occurrence_by_kind: Counter[str] = Counter()
    for item in sorted_assets:
        by_layer_kind[item["layer"]][item["kind"]] += 1
        occurrence_by_kind[item["kind"]] += len(item["occurrences"])

    document_role_keys: set[tuple[str, str, str]] = set()
    for item in sorted_assets:
        if item["kind"] == "dependency":
            continue
        for occurrence in item["occurrences"]:
            document_role_keys.add(
                (occurrence["document_layer"], item["kind"], item["normalized_name"])
            )
    for reference in references:
        document_role_keys.add(
            (
                reference["document_layer"],
                "dependency",
                normalize_identifier(reference["raw_identifier"])[1],
            )
        )
    document_role_by_kind = Counter(kind for _, kind, _ in document_role_keys)

    return {
        "inventory_version": 1,
        "reference_root": str(reference_root),
        "documents": documents,
        "summary": {
            "unique_asset_count": len(sorted_assets),
            "unique_logical_asset_count": len(logical_assets),
            "global_unique_name_count": len(
                {item["normalized_name"] for item in logical_assets}
            ),
            "unique_by_kind": dict(sorted(by_kind.items())),
            "document_role_unique_count": len(document_role_keys),
            "document_role_unique_by_kind": dict(sorted(document_role_by_kind.items())),
            "occurrences_by_kind": dict(sorted(occurrence_by_kind.items())),
            "reference_occurrence_count": len(references),
            "references_by_kind": dict(sorted(references_by_kind.items())),
            "unique_by_layer_and_kind": {
                layer: dict(sorted(values.items()))
                for layer, values in sorted(by_layer_kind.items())
            },
            "topic_count": len(topics),
            "unparsed_statement_line_count": len(unparsed_statement_lines),
        },
        "assets": sorted_assets,
        "logical_assets": logical_assets,
        "topics": topics,
        "references": references,
        "unparsed_statement_lines": unparsed_statement_lines,
    }


def validate_inventory(
    inventory: dict[str, Any],
    manifest: dict[str, Any] | None = None,
) -> list[str]:
    errors: list[str] = []
    manifest = manifest or load_alignment_manifest()
    expected_documents = {
        item.get("filename"): item
        for item in manifest.get("source_documents", [])
        if isinstance(item, dict)
    }
    actual_documents = {item["filename"]: item for item in inventory["documents"]}
    if set(actual_documents) != set(expected_documents):
        errors.append(
            "source documents differ from alignment contract: "
            f"actual={sorted(actual_documents)}, expected={sorted(expected_documents)}"
        )
    for filename, expected in expected_documents.items():
        actual = actual_documents.get(filename)
        if actual is None:
            continue
        if actual["sha256"] != expected.get("sha256"):
            errors.append(f"source drift detected for {filename}")
        if actual["line_count"] != expected.get("line_count"):
            errors.append(f"line count changed for {filename}")

    asset_ids = [item["asset_id"] for item in inventory["assets"]]
    if len(asset_ids) != len(set(asset_ids)):
        errors.append("asset ids must be unique")
    if not inventory["assets"]:
        errors.append("source inventory must not be empty")
    logical_ids = [item["logical_asset_id"] for item in inventory.get("logical_assets", [])]
    if not logical_ids:
        errors.append("logical source inventory must not be empty")
    if len(logical_ids) != len(set(logical_ids)):
        errors.append("logical asset ids must be unique")
    for item in inventory["assets"]:
        if item["layer"] not in LAYER_DOCUMENTS:
            errors.append(f"{item['asset_id']}: invalid layer")
        if item["kind"] not in {"candidate", "create_target", "insert_target", "dependency"}:
            errors.append(f"{item['asset_id']}: invalid kind")
        if not re.fullmatch(r"[a-z_][a-z0-9_$-]*", item["normalized_name"]):
            errors.append(f"{item['asset_id']}: invalid normalized name")
        if not item["occurrences"]:
            errors.append(f"{item['asset_id']}: requires source occurrences")
        for occurrence in item["occurrences"]:
            if occurrence.get("document_layer") not in LAYER_DOCUMENTS:
                errors.append(f"{item['asset_id']}: occurrence has invalid document layer")
    allowed_reference_kinds = {
        "physical_table",
        "cte",
        "python_import",
        "code_symbol",
        "unclassified_reference",
    }
    for reference in inventory.get("references", []):
        if reference.get("reference_kind") not in allowed_reference_kinds:
            errors.append("reference occurrence has invalid reference kind")
    return errors


def validate_source_domain_policy(
    inventory: dict[str, Any],
    policy: dict[str, Any] | None = None,
    manifest: dict[str, Any] | None = None,
) -> list[str]:
    errors: list[str] = []
    policy = policy or load_source_domain_policy()
    manifest = manifest or load_alignment_manifest()
    domains = policy.get("domains")
    if not isinstance(domains, dict) or not domains:
        return ["source domain policy requires domains"]
    observed_domains = {
        domain
        for item in inventory.get("logical_assets", [])
        for domain in item.get("source_domains", [])
    }
    if set(domains) != observed_domains:
        errors.append(
            "source domain policy differs from ODS overview: "
            f"policy={sorted(domains)}, observed={sorted(observed_domains)}"
        )
    allowed_units = set(manifest.get("required_alignment_units", []))
    for domain, rule in domains.items():
        label = f"source domain policy {domain}"
        if not isinstance(rule, dict):
            errors.append(f"{label}: rule must be an object")
            continue
        units = rule.get("allowed_alignment_units")
        contexts = rule.get("canonical_contexts")
        if not isinstance(units, list) or not units:
            errors.append(f"{label}: requires allowed_alignment_units")
        elif set(units) - allowed_units:
            errors.append(f"{label}: unknown units {sorted(set(units) - allowed_units)}")
        if not isinstance(contexts, list) or not contexts:
            errors.append(f"{label}: requires canonical_contexts")
        if not isinstance(rule.get("requires_row_level_split"), bool):
            errors.append(f"{label}: requires_row_level_split must be boolean")
    logical_names = {item["normalized_name"] for item in inventory.get("logical_assets", [])}
    rejections = policy.get("explicit_rejections")
    if not isinstance(rejections, dict) or not rejections:
        errors.append("source domain policy requires explicit_rejections")
    else:
        missing = set(rejections) - logical_names
        if missing:
            errors.append(f"explicit rejections do not exist in source inventory: {sorted(missing)}")
        for name, reason in rejections.items():
            if not isinstance(reason, str) or not reason.strip():
                errors.append(f"explicit rejection {name}: requires reason")
    return errors


def validate_source_asset_routes(
    inventory: dict[str, Any],
    routes_contract: dict[str, Any] | None = None,
    policy: dict[str, Any] | None = None,
) -> list[str]:
    errors: list[str] = []
    routes_contract = routes_contract or load_source_asset_routes()
    policy = policy or load_source_domain_policy()
    routes = routes_contract.get("routes")
    if not isinstance(routes, list) or not routes:
        return ["source asset routes requires routes"]
    logical_names = {item["normalized_name"] for item in inventory["logical_assets"]}
    allowed_domains = set(policy["domains"])
    rejected_names = set(policy.get("explicit_rejections", {}))
    seen: set[str] = set()
    for index, route in enumerate(routes):
        label = f"source asset routes[{index}]"
        if not isinstance(route, dict):
            errors.append(f"{label}: must be an object")
            continue
        domains = route.get("source_domains")
        assets = route.get("assets")
        if not isinstance(domains, list) or not domains:
            errors.append(f"{label}: requires source_domains")
        elif set(domains) - allowed_domains:
            errors.append(f"{label}: unknown domains {sorted(set(domains) - allowed_domains)}")
        if not isinstance(assets, list) or not assets:
            errors.append(f"{label}: requires assets")
            continue
        if not isinstance(route.get("decision_basis"), str) or not route["decision_basis"].strip():
            errors.append(f"{label}: requires decision_basis")
        for name in assets:
            if name in seen:
                errors.append(f"{label}: duplicate routed asset {name}")
            seen.add(name)
            if name not in logical_names:
                errors.append(f"{label}: unknown source asset {name}")
            if name in rejected_names:
                errors.append(f"{label}: rejected placeholder cannot be routed {name}")
    return errors


def authoritative_ods_domain_assets(
    inventory: dict[str, Any], domain: str
) -> dict[str, dict[str, Any]]:
    """Return only rows explicitly named by the authoritative ODS overview.

    Inferred heading lineage and manual routing are deliberately excluded: they
    are useful for broad routing, but cannot silently expand or shrink a locked
    source-domain disposition contract.
    """
    result: dict[str, dict[str, Any]] = {}
    for item in inventory.get("logical_assets", []):
        if "candidate" not in item.get("roles", []):
            continue
        occurrences = [
            occurrence
            for occurrence in item.get("occurrences", [])
            if occurrence.get("role") == "candidate"
            and occurrence.get("source_domain") == domain
        ]
        if not occurrences:
            continue
        result[item["normalized_name"]] = {
            "source_asset": item["normalized_name"],
            "source_labels": sorted(
                {
                    occurrence["source_label"]
                    for occurrence in occurrences
                    if occurrence.get("source_label")
                }
            ),
            "anchors": sorted(
                {
                    (occurrence["document"], occurrence["line"])
                    for occurrence in occurrences
                }
            ),
        }
    return result


def _nonempty_strings(value: Any) -> bool:
    return (
        isinstance(value, list)
        and bool(value)
        and all(isinstance(item, str) and item.strip() for item in value)
    )


def _resolve_contract_reference(value: str) -> Path:
    path = Path(value.split("#", 1)[0])
    if path.is_absolute():
        return path
    workspace_path = ROOT.parents[2] / path
    return workspace_path if workspace_path.exists() else ROOT / path


def _markdown_heading_fragment(line: str) -> str | None:
    match = re.match(r"^\s*#{1,6}\s+(.+?)\s*#*\s*$", line)
    if not match:
        return None
    heading = re.sub(r"[`*_~]", "", match.group(1)).strip().lower()
    return re.sub(r"[^a-z0-9]+", "-", heading).strip("-")


def _contract_reference_error(value: str) -> str | None:
    path = _resolve_contract_reference(value)
    if not path.is_file():
        return f"missing file {path}"
    if "#" not in value:
        return None
    fragment = value.split("#", 1)[1]
    if not fragment:
        return "empty fragment"
    try:
        content = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as exc:
        return f"cannot inspect fragment in {path}: {exc}"
    if fragment in content:
        return None
    normalized_fragment = fragment.lower().strip()
    if any(
        _markdown_heading_fragment(line) == normalized_fragment
        for line in content.splitlines()
    ):
        return None
    return f"missing fragment {fragment!r} in {path}"


def _runtime_reconciliation_errors(value: Any, expected_asset: str) -> list[str]:
    return runtime_reconciliation_errors(
        value,
        expected_asset=expected_asset,
        resolve_reference=_resolve_contract_reference,
    )


def _runtime_reconciliation_verified(value: Any, expected_asset: str) -> bool:
    return not _runtime_reconciliation_errors(value, expected_asset)


def validate_game_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    errors: list[str] = []
    contract = contract or load_game_source_dispositions()
    expected = authoritative_ods_domain_assets(inventory, "游戏")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["game source dispositions requires source_scope"]
    if scope.get("domain") != "游戏":
        errors.append("game source dispositions source_scope.domain must be 游戏")
    if scope.get("expected_asset_count") != len(expected):
        errors.append(
            "game source dispositions expected_asset_count differs from ODS overview: "
            f"contract={scope.get('expected_asset_count')}, observed={len(expected)}"
        )
    for name, source in expected.items():
        if len(source["anchors"]) != 1 or len(source["source_labels"]) != 1:
            errors.append(
                f"authoritative ODS 游戏 asset {name} must occur exactly once with one label: "
                f"anchors={source['anchors']!r}, labels={source['source_labels']!r}"
            )
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("game source dispositions must state the source detail limit")

    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["game source dispositions requires verification_policy"]
    allowed_decisions = policy.get("allowed_decisions")
    runtime_statuses = policy.get("runtime_statuses")
    if set(allowed_decisions or []) != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("game source dispositions has an invalid decision vocabulary")
    if set(runtime_statuses or []) != {"missing", "pending", "verified"}:
        errors.append("game source dispositions has an invalid runtime status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("game source dispositions must reject empty tables as evidence")

    assets = contract.get("assets")
    if not isinstance(assets, list):
        return errors + ["game source dispositions requires assets"]
    seen: set[str] = set()
    actual: set[str] = set()
    required_field_rules = {
        "tenant", "business_key", "time", "status", "quantity", "currency_boundary"
    }
    for index, asset in enumerate(assets):
        label = f"game source dispositions assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if not isinstance(name, str) or not name:
            errors.append(f"{label}: requires source_asset")
            continue
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        actual.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative ODS 游戏 asset: {name}")
        else:
            if [asset.get("source_label")] != observed["source_labels"]:
                errors.append(
                    f"{label}: source label differs from ODS overview for {name}: "
                    f"contract={asset.get('source_label')!r}, observed={observed['source_labels']!r}"
                )
            anchor = asset.get("source_anchor")
            actual_anchor = (
                anchor.get("document"), anchor.get("line")
            ) if isinstance(anchor, dict) else None
            if actual_anchor not in observed["anchors"]:
                errors.append(
                    f"{label}: source anchor differs from ODS overview for {name}: "
                    f"contract={actual_anchor!r}, observed={observed['anchors']!r}"
                )
        if not isinstance(asset.get("source_grain"), str) or not asset["source_grain"].strip():
            errors.append(f"{label}: requires source_grain")
        if asset.get("decision") not in set(allowed_decisions or []):
            errors.append(f"{label}: invalid decision {asset.get('decision')!r}")
        for key in ("canonical_entities", "canonical_targets", "corrections"):
            if not _nonempty_strings(asset.get(key)):
                errors.append(f"{label}: requires non-empty {key}")
        if not isinstance(asset.get("sor_owner"), str) or not asset["sor_owner"].strip():
            errors.append(f"{label}: requires sor_owner")
        field_rules = asset.get("field_rules")
        if not isinstance(field_rules, dict) or set(field_rules) != required_field_rules:
            errors.append(f"{label}: field_rules must define exactly {sorted(required_field_rules)}")
        elif any(not isinstance(value, str) or not value.strip() for value in field_rules.values()):
            errors.append(f"{label}: field_rules values must be non-empty strings")
        for key in ("history_policy", "delete_policy", "backfill_policy"):
            if not isinstance(asset.get(key), str) or not asset[key].strip():
                errors.append(f"{label}: requires {key}")
        if not _nonempty_strings(asset.get("backend_refs")):
            errors.append(f"{label}: requires backend_refs")
        else:
            for reference in asset["backend_refs"]:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(
                        f"{label}: invalid backend ref {reference}: {reference_error}"
                    )
        if not _nonempty_strings(asset.get("lakehouse_refs")):
            errors.append(f"{label}: requires lakehouse_refs")
        else:
            for reference in asset["lakehouse_refs"]:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(
                        f"{label}: invalid lakehouse ref {reference}: {reference_error}"
                    )
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict):
            errors.append(f"{label}: requires runtime_nonempty_reconciliation")
        else:
            if runtime.get("status") not in set(runtime_statuses or []):
                errors.append(f"{label}: invalid runtime reconciliation status")
            if not isinstance(runtime.get("gate_ref"), str) or not runtime["gate_ref"].strip():
                errors.append(f"{label}: runtime reconciliation requires gate_ref")
            for count_key in ("row_count", "tenant_count"):
                count = runtime.get(count_key)
                if not isinstance(count, int) or isinstance(count, bool) or count < 0:
                    errors.append(f"{label}: {count_key} must be a non-negative integer")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(
                    f"{label}: verified runtime reconciliation requires durable evidence, "
                    "run id, positive row/tenant counts, a valid production source bundle, "
                    "and independent full-denominator zero-difference reconciliation: "
                    + "; ".join(_runtime_reconciliation_errors(runtime, name))
                )
        if asset.get("specification_status") != "specified":
            errors.append(f"{label}: specification_status must be specified")
        if asset.get("verification_status") not in {"unverified", "verified"}:
            errors.append(f"{label}: invalid verification_status")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(
                f"{label}: final verification is forbidden without non-empty runtime reconciliation"
            )

    if actual != set(expected):
        errors.append(
            "game source dispositions differ from authoritative ODS overview: "
            f"missing={sorted(set(expected) - actual)}, extra={sorted(actual - set(expected))}"
        )

    required_design = {
        "ods_eliminate_user_coin_log_df": ("merge", "VirtualCurrencyLedgerEntry"),
        "ods_card_mall_coin_log_df": ("merge", "RedemptionIntent"),
        "ods_eliminate_mall_coin_log_df": ("merge", "RedemptionIntent"),
        "ods_factory_mall_coin_log_df": ("correct", "RedemptionIntent"),
        "ods_factory_user_coin_log_df": ("merge", "VirtualCurrencyLedgerEntry"),
        "ods_fortune_user_chip_detail_df": ("merge", "FragmentLedgerEntry"),
        "ods_fortune_season_series_df": ("split", "SeasonVersion"),
        "ods_fortune_gk_df": ("split", "CollectibleOwnership"),
        "ods_hacking_card_prod_ri": ("split", "DrawResult"),
        "ods_yshopping_growth_brainstorm_bst_game_round_di": ("reuse", "Round"),
        "ods_yshopping_growth_brainstorm_bst_friendship_df": ("reuse", "AssistRecord"),
        "ods_yshopping_newbie_aurora_user_task_complete_record_df": ("reuse", "TaskProgress"),
        "ods_fortune_user_gk_exchange_df": ("split", "RedemptionIntent"),
        "ods_fortune_gk_lottery_record_df": ("split", "DrawResult"),
        "ods_yshopping_hacking_world_users_df": ("split", "SourceIdentity"),
        "ods_yshopping_hacking_world_rank_currency_df": ("derive", "Leaderboard"),
        "ods_yshopping_hacking_world_rank_gift_df": ("derive", "Leaderboard"),
        "ods_yshopping_hacking_world_gift_send_record_df": ("reuse", "GiftTransfer"),
        "ods_yshopping_hacking_world_user_receive_record_df": ("split", "RewardClaim"),
    }
    by_name = {
        asset.get("source_asset"): asset for asset in assets if isinstance(asset, dict)
    }
    for name, (decision, entity_fragment) in required_design.items():
        asset = by_name.get(name)
        if asset is None:
            continue
        if asset.get("decision") != decision:
            errors.append(f"game source disposition {name}: decision must be {decision}")
        if not any(entity_fragment in entity for entity in asset.get("canonical_entities", [])):
            errors.append(
                f"game source disposition {name}: canonical entities must include {entity_fragment}"
            )
    for name in (
        "ods_card_mall_coin_log_df",
        "ods_eliminate_mall_coin_log_df",
        "ods_factory_mall_coin_log_df",
    ):
        asset = by_name.get(name, {})
        boundary = asset.get("field_rules", {}).get("currency_boundary", "")
        status_rule = asset.get("field_rules", {}).get("status", "")
        quantity_rule = asset.get("field_rules", {}).get("quantity", "")
        entities = asset.get("canonical_entities", [])
        if "gamification.VirtualCurrencyTransaction" not in entities:
            errors.append(f"game source disposition {name}: must link a game-currency transaction")
        if any("Collectible" in entity for entity in entities):
            errors.append(f"game source disposition {name}: mall coin log cannot use collectible mode")
        if (
            "GAME_VIRTUAL_CURRENCY" not in boundary
            or "mall balance" not in boundary
            or "never" not in boundary
        ):
            errors.append(
                f"game source disposition {name}: must use GAME_VIRTUAL_CURRENCY and fence mall balance ownership"
            )
        if "PENDING/SUCCEEDED/REJECTED" not in status_rule or "FAILED" in status_rule:
            errors.append(
                f"game source disposition {name}: redemption statuses must be PENDING/SUCCEEDED/REJECTED"
            )
        if (
            "amount_microunits" not in quantity_rule
            or "GAME_COIN_*" not in quantity_rule
            or "mall-side" not in quantity_rule
        ):
            errors.append(
                f"game source disposition {name}: amount must be the internal game-currency debit only"
            )
    for name in (
        "ods_yshopping_hacking_world_rank_currency_df",
        "ods_yshopping_hacking_world_rank_gift_df",
    ):
        asset = by_name.get(name, {})
        if not all("leaderboard" not in ref.lower() or "README.md" in ref for ref in asset.get("backend_refs", [])):
            errors.append(f"game source disposition {name}: leaderboard cannot have a backend write-model ref")
    return errors


def validate_metadata_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate the reviewed ten-row metadata disposition, not broad lineage inference."""
    errors: list[str] = []
    contract = contract or load_metadata_source_dispositions()
    expected = authoritative_ods_domain_assets(inventory, "元数据")
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["metadata source dispositions requires source_scope"]
    if scope.get("domain") != "元数据":
        errors.append("metadata source dispositions source_scope.domain must be 元数据")
    if scope.get("expected_asset_count") != len(expected):
        errors.append(
            "metadata source dispositions expected_asset_count differs from ODS overview: "
            f"contract={scope.get('expected_asset_count')}, observed={len(expected)}"
        )
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("metadata source dispositions must state the source detail limit")
    for name, source in expected.items():
        if len(source["anchors"]) != 1 or len(source["source_labels"]) != 1:
            errors.append(
                f"authoritative ODS 元数据 asset {name} must occur exactly once with one label: "
                f"anchors={source['anchors']!r}, labels={source['source_labels']!r}"
            )

    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["metadata source dispositions requires verification_policy"]
    allowed_decisions = set(policy.get("allowed_decisions") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if allowed_decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("metadata source dispositions has an invalid decision vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("metadata source dispositions has an invalid runtime status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("metadata source dispositions must reject empty tables as evidence")

    assets = contract.get("assets")
    if not isinstance(assets, list):
        return errors + ["metadata source dispositions requires assets"]
    seen: set[str] = set()
    required_field_rules = {
        "tenant", "business_key", "time", "status", "value_or_unit", "security_boundary"
    }
    for index, asset in enumerate(assets):
        label = f"metadata source dispositions assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if not isinstance(name, str) or not name:
            errors.append(f"{label}: requires source_asset")
            continue
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative ODS 元数据 asset: {name}")
        else:
            if [asset.get("source_label")] != observed["source_labels"]:
                errors.append(
                    f"{label}: source label differs from ODS overview for {name}: "
                    f"contract={asset.get('source_label')!r}, observed={observed['source_labels']!r}"
                )
            anchor = asset.get("source_anchor")
            actual_anchor = (
                (anchor.get("document"), anchor.get("line"))
                if isinstance(anchor, dict) else None
            )
            if actual_anchor not in observed["anchors"]:
                errors.append(
                    f"{label}: source anchor differs from ODS overview for {name}: "
                    f"contract={actual_anchor!r}, observed={observed['anchors']!r}"
                )
        if not isinstance(asset.get("source_grain"), str) or not asset["source_grain"].strip():
            errors.append(f"{label}: requires source_grain")
        if asset.get("decision") not in allowed_decisions:
            errors.append(f"{label}: invalid decision {asset.get('decision')!r}")
        for key in ("canonical_entities", "canonical_targets", "corrections"):
            if not _nonempty_strings(asset.get(key)):
                errors.append(f"{label}: requires non-empty {key}")
        if not isinstance(asset.get("sor_owner"), str) or not asset["sor_owner"].strip():
            errors.append(f"{label}: requires sor_owner")
        field_rules = asset.get("field_rules")
        if not isinstance(field_rules, dict) or set(field_rules) != required_field_rules:
            errors.append(f"{label}: field_rules must define exactly {sorted(required_field_rules)}")
        elif any(not isinstance(value, str) or not value.strip() for value in field_rules.values()):
            errors.append(f"{label}: field_rules values must be non-empty strings")
        for key in ("history_policy", "delete_policy", "backfill_policy"):
            if not isinstance(asset.get(key), str) or not asset[key].strip():
                errors.append(f"{label}: requires {key}")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(
                        f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}"
                    )
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict):
            errors.append(f"{label}: requires runtime_nonempty_reconciliation")
        else:
            if runtime.get("status") not in runtime_statuses:
                errors.append(f"{label}: invalid runtime reconciliation status")
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not gate_ref.strip():
                errors.append(f"{label}: runtime reconciliation requires gate_ref")
            elif not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: missing runtime gate {gate_ref}")
            for count_key in ("row_count", "tenant_count"):
                count = runtime.get(count_key)
                if not isinstance(count, int) or isinstance(count, bool) or count < 0:
                    errors.append(f"{label}: {count_key} must be a non-negative integer")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(
                    f"{label}: verified runtime reconciliation requires durable evidence, "
                    "run id, positive row/tenant counts, a valid production source bundle, "
                    "and independent full-denominator zero-difference reconciliation: "
                    + "; ".join(_runtime_reconciliation_errors(runtime, name))
                )
        if asset.get("specification_status") != "specified":
            errors.append(f"{label}: specification_status must be specified")
        if asset.get("verification_status") not in {"unverified", "verified"}:
            errors.append(f"{label}: invalid verification_status")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(
                f"{label}: final verification is forbidden without non-empty runtime reconciliation"
            )

    if seen != set(expected):
        errors.append(
            "metadata source dispositions differ from authoritative ODS overview: "
            f"missing={sorted(set(expected) - seen)}, extra={sorted(seen - set(expected))}"
        )

    required_design = {
        "ods_meta_task_instance_di": ("split", "TaskRunObservation"),
        "ods_meta_task_node_df": ("split", "TaskVersion"),
        "ods_sla_parent_child_nodes_df": ("correct", "TaskDependency"),
        "ods_sla_sla_task_df": ("merge", "TaskSla"),
        "ods_meta_table_df": ("split", "DatasetVersion"),
        "ods_meta_table_columns_df": ("merge", "FieldVersion"),
        "ods_meta_table_lineage_df": ("correct", "LineageVersion"),
        "ods_meta_dq_dqc_df": ("split", "DqcRuleVersion"),
        "ods_meta_dq_dqc_instance_df": ("split", "DqcResult"),
        "ods_metrics_metrics_info_df": ("split", "MetricVersion"),
    }
    by_name = {
        asset.get("source_asset"): asset for asset in assets if isinstance(asset, dict)
    }
    for name, (decision, entity_fragment) in required_design.items():
        asset = by_name.get(name)
        if asset is None:
            continue
        if asset.get("decision") != decision:
            errors.append(f"metadata source disposition {name}: decision must be {decision}")
        if not any(entity_fragment in entity for entity in asset.get("canonical_entities", [])):
            errors.append(
                f"metadata source disposition {name}: canonical entities must include {entity_fragment}"
            )

    task_run = by_name.get("ods_meta_task_instance_di", {})
    if "exact minor units" not in task_run.get("field_rules", {}).get("value_or_unit", ""):
        errors.append("metadata task-run disposition must use exact minor-unit cost")
    if "raw sql_content" not in task_run.get("field_rules", {}).get("security_boundary", ""):
        errors.append("metadata task-run disposition must forbid raw SQL")
    dependency = by_name.get("ods_sla_parent_child_nodes_df", {})
    if "direct edges only" not in dependency.get("field_rules", {}).get("value_or_unit", ""):
        errors.append("metadata dependency disposition must retain direct edges only")
    lineage = by_name.get("ods_meta_table_lineage_df", {})
    if "SOURCE_TO_TARGET" not in lineage.get("field_rules", {}).get("status", ""):
        errors.append("metadata lineage disposition must normalize SOURCE_TO_TARGET direction")
    metric = by_name.get("ods_metrics_metrics_info_df", {})
    metric_units = metric.get("field_rules", {}).get("value_or_unit", "")
    if "grain_code and metric_unit are distinct" not in metric_units:
        errors.append("metadata metric disposition must separate grain from unit")
    return errors


def _commerce_expected_assets(
    inventory: dict[str, Any], domains: list[str]
) -> tuple[dict[str, dict[str, Any]], dict[str, int]]:
    combined: dict[str, dict[str, Any]] = {}
    counts: dict[str, int] = {}
    for domain in domains:
        observed = authoritative_ods_domain_assets(inventory, domain)
        counts[domain] = len(observed)
        for name, source in observed.items():
            target = combined.setdefault(
                name,
                {"source_asset": name, "domains": set(), "source_labels": set(), "anchors": set()},
            )
            target["domains"].add(domain)
            target["source_labels"].update(source["source_labels"])
            target["anchors"].update(source["anchors"])
    for source in combined.values():
        source["domains"] = sorted(source["domains"])
        source["source_labels"] = sorted(source["source_labels"])
        source["anchors"] = sorted(source["anchors"])
    return combined, counts


def validate_commerce_source_dispositions(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> list[str]:
    """Validate the reviewed Order/Reverse/Payment/Inventory ODS overview slice."""
    errors: list[str] = []
    contract = contract or load_commerce_source_dispositions()
    scope = contract.get("source_scope")
    if not isinstance(scope, dict):
        return ["commerce source dispositions requires source_scope"]
    domains = scope.get("domains")
    if not _nonempty_strings(domains) or set(domains) != {"正向订单", "逆向订单", "支付", "库存"}:
        return ["commerce source dispositions must cover 正向订单/逆向订单/支付/库存"]
    expected, observed_counts = _commerce_expected_assets(inventory, domains)
    if scope.get("expected_domain_asset_counts") != observed_counts:
        errors.append(
            "commerce source dispositions domain counts differ from ODS overview: "
            f"contract={scope.get('expected_domain_asset_counts')!r}, observed={observed_counts!r}"
        )
    if scope.get("expected_unique_asset_count") != len(expected):
        errors.append(
            "commerce source dispositions unique count differs from ODS overview: "
            f"contract={scope.get('expected_unique_asset_count')!r}, observed={len(expected)}"
        )
    if not isinstance(scope.get("source_detail_limit"), str) or not scope["source_detail_limit"].strip():
        errors.append("commerce source dispositions must state the source detail limit")

    policy = contract.get("verification_policy")
    if not isinstance(policy, dict):
        return errors + ["commerce source dispositions requires verification_policy"]
    allowed_decisions = set(policy.get("allowed_decisions") or [])
    model_statuses = set(policy.get("allowed_model_statuses") or [])
    runtime_statuses = set(policy.get("runtime_statuses") or [])
    if allowed_decisions != {"reuse", "merge", "split", "derive", "correct", "reject"}:
        errors.append("commerce source dispositions has an invalid decision vocabulary")
    if model_statuses != {"partial", "missing", "rejected"}:
        errors.append("commerce source dispositions has an invalid model-status vocabulary")
    if runtime_statuses != {"missing", "pending", "verified"}:
        errors.append("commerce source dispositions has an invalid runtime-status vocabulary")
    if policy.get("empty_tables_are_evidence") is not False:
        errors.append("commerce source dispositions must reject empty tables as evidence")
    lifecycle_defaults = contract.get("lifecycle_policy_defaults")
    if not isinstance(lifecycle_defaults, dict) or set(lifecycle_defaults) != set(domains):
        errors.append("commerce source dispositions must define lifecycle defaults for every scoped domain")
    else:
        required_lifecycle_rules = {"history_policy", "delete_policy", "backfill_policy"}
        for domain, rules in lifecycle_defaults.items():
            if (
                not isinstance(rules, dict)
                or set(rules) != required_lifecycle_rules
                or any(not isinstance(value, str) or not value.strip() for value in rules.values())
            ):
                errors.append(
                    f"commerce lifecycle defaults for {domain} must define exactly "
                    f"{sorted(required_lifecycle_rules)}"
                )

    assets = contract.get("assets")
    if not isinstance(assets, list):
        return errors + ["commerce source dispositions requires assets"]
    seen: set[str] = set()
    required_semantic_rules = {
        "grain", "identity", "money_or_quantity", "history", "security", "authority"
    }
    detail_expectations = {
        "ods_trade_trade_order_di": ("ddl_backed", 304, 333, "ods_trade_trade_order_di"),
        "ods_trade_trade_sub_order_di": ("ddl_backed", 334, 389, "ods_trade_trade_sub_order_di"),
        "ods_trade_trade_discount_di": ("ddl_backed", 392, 419, "ods_trade_trade_discount_di"),
        "ods_trade_trade_log_di": ("ddl_backed", 420, 445, "ods_trade_trade_log_di"),
        "ods_trade_trade_order_appeal_status_df": ("ddl_backed", 544, 564, "ods_trade_trade_order_appeal_status_df"),
        "ods_trade_trade_payment_di": ("ddl_backed", 446, 474, "ods_trade_trade_payment_di"),
        "ods_trade_trade_logistic_order_di": ("ddl_backed", 475, 503, "ods_trade_trade_logistic_order_di"),
        "ods_trade_trade_logistic_track_structure_di": ("ddl_backed", 504, 543, "ods_trade_trade_logistic_track_structure_di"),
        "ods_trade_trade_trade_spu_df": ("name_conflict", 591, 633, "ods_commodity_commodity_trade_spu_df"),
        "ods_trade_trade_trade_sku_df": ("name_conflict", 634, 680, "ods_commodity_commodity_sku_df"),
        "ods_trade_trade_refund_exchange_rel_df": ("ddl_backed", 565, 588, "ods_trade_trade_refund_exchange_rel_df"),
        "ods_refund_refund_order_di": ("ddl_backed", 803, 858, "ods_refund_refund_order_di"),
        "ods_refund_refund_money_di": ("ddl_backed", 859, 886, "ods_refund_refund_money_di"),
        "ods_refund_refund_trade_reason_df": ("ddl_backed", 887, 917, "ods_refund_refund_trade_reason_df"),
        "ods_refund_refund_logistic_di": ("ddl_backed", 918, 949, "ods_refund_refund_logistic_di"),
        "ods_refund_refund_repay_reason_df": ("ddl_backed", 950, 979, "ods_refund_refund_repay_reason_df"),
        "ods_refund_refund_bill_di": ("ddl_backed", 980, 1032, "ods_refund_refund_bill_di"),
        "ods_refund_refund_discount_df": ("ddl_backed", 1033, 1062, "ods_refund_refund_discount_df"),
        "ods_trade_trade_invoice_apply_df": ("ddl_backed", 1599, 1646, "ods_trade_trade_invoice_apply_df"),
        "ods_trade_trade_inventory_flow_df": ("ddl_backed", 1573, 1596, "ods_trade_trade_inventory_flow_df"),
    }
    overview_only_assets = {
        "ods_pay_pay_log_di", "ods_transferlog_df", "ods_transfer_queue_df",
        "ods_userscashaccount_df", "ods_userscashaccountdetail_df", "ods_fin_bind_card_df",
        "ods_yshoppingcashier_cashier_pay_log_extra_df", "ods_acc_pay_order_df",
        "ods_acc_personal_detail_df", "ods_acc_personal_balance_df",
        "ods_fin_trans_order_pay_tool_df", "ods_bom_wallet_flow_log_df",
        "ods_inventory_sale_df", "ods_inventory_warehouse_df",
    }
    rejected_mislabeled_assets = {"ods_logistic_logistic_track_structure_di"}
    source_document = Path(inventory.get("reference_root", DEFAULT_REFERENCE_ROOT)) / scope["authoritative_document"]
    source_lines: list[str] = []
    try:
        source_lines = source_document.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        errors.append(f"cannot read commerce source document {source_document}: {exc}")
    for index, asset in enumerate(assets):
        label = f"commerce source dispositions assets[{index}]"
        if not isinstance(asset, dict):
            errors.append(f"{label}: must be an object")
            continue
        name = asset.get("source_asset")
        if not isinstance(name, str) or not name:
            errors.append(f"{label}: requires source_asset")
            continue
        if name in seen:
            errors.append(f"{label}: duplicate source_asset {name}")
        seen.add(name)
        observed = expected.get(name)
        if observed is None:
            errors.append(f"{label}: not an authoritative commerce ODS asset: {name}")
        else:
            if sorted(asset.get("domains") or []) != observed["domains"]:
                errors.append(f"{label}: domains differ for {name}")
            if sorted(asset.get("source_labels") or []) != observed["source_labels"]:
                errors.append(
                    f"{label}: source labels differ for {name}: "
                    f"contract={asset.get('source_labels')!r}, observed={observed['source_labels']!r}"
                )
            anchors = asset.get("source_anchors")
            actual_anchors = sorted(
                (anchor.get("document"), anchor.get("line"))
                for anchor in anchors or [] if isinstance(anchor, dict)
            )
            if actual_anchors != observed["anchors"]:
                errors.append(
                    f"{label}: source anchors differ for {name}: "
                    f"contract={actual_anchors!r}, observed={observed['anchors']!r}"
                )
        if not isinstance(asset.get("source_grain"), str) or not asset["source_grain"].strip():
            errors.append(f"{label}: requires source_grain")
        evidence = asset.get("source_evidence")
        if not isinstance(evidence, dict):
            errors.append(f"{label}: requires source_evidence")
        else:
            evidence_status = evidence.get("status")
            detail_anchors = evidence.get("detail_anchors")
            expected_detail = detail_expectations.get(name)
            if expected_detail is not None:
                expected_status, heading_line, end_line, heading_asset = expected_detail
                expected_anchor = [{
                    "document": scope["authoritative_document"],
                    "heading_line": heading_line,
                    "end_line": end_line,
                    "source_asset": heading_asset,
                }]
                if evidence_status != expected_status or detail_anchors != expected_anchor:
                    errors.append(
                        f"{label}: source detail evidence differs for {name}: "
                        f"contract={evidence!r}, expected_status={expected_status!r}, "
                        f"expected_anchors={expected_anchor!r}"
                    )
                if source_lines and (
                    heading_line > len(source_lines)
                    or heading_asset.replace("_", r"\_") not in source_lines[heading_line - 1]
                ):
                    errors.append(
                        f"{label}: source detail heading {heading_line} does not prove {heading_asset}"
                    )
            elif name in overview_only_assets:
                if evidence_status != "overview_only" or detail_anchors != []:
                    errors.append(f"{label}: overview-only asset must remain provisional without detail anchors")
            elif name in rejected_mislabeled_assets:
                if evidence_status != "rejected_mislabeled" or detail_anchors != []:
                    errors.append(f"{label}: rejected mislabeled source must retain empty detail evidence")
            else:
                errors.append(f"{label}: source evidence classification is not governed for {name}")
        if asset.get("decision") not in allowed_decisions:
            errors.append(f"{label}: invalid decision {asset.get('decision')!r}")
        if not _nonempty_strings(asset.get("canonical_entities")):
            errors.append(f"{label}: requires canonical_entities")
        semantic_rules = asset.get("semantic_rules")
        if not isinstance(semantic_rules, dict) or set(semantic_rules) != required_semantic_rules:
            errors.append(f"{label}: semantic_rules must define exactly {sorted(required_semantic_rules)}")
        elif any(not isinstance(value, str) or not value.strip() for value in semantic_rules.values()):
            errors.append(f"{label}: semantic_rules values must be non-empty strings")
        if not _nonempty_strings(asset.get("corrections")):
            errors.append(f"{label}: requires corrections")
        if asset.get("model_status") not in model_statuses:
            errors.append(f"{label}: invalid model_status")
        if asset.get("decision") == "reject" and asset.get("model_status") != "rejected":
            errors.append(f"{label}: rejected decision must have rejected model_status")
        if asset.get("model_status") == "rejected" and asset.get("decision") != "reject":
            errors.append(f"{label}: rejected model_status must have reject decision")
        for ref_key in ("backend_refs", "lakehouse_refs"):
            references = asset.get(ref_key)
            if not _nonempty_strings(references):
                errors.append(f"{label}: requires {ref_key}")
                continue
            for reference in references:
                reference_error = _contract_reference_error(reference)
                if reference_error:
                    errors.append(f"{label}: invalid {ref_key[:-1]} {reference}: {reference_error}")
        runtime = asset.get("runtime_nonempty_reconciliation")
        if not isinstance(runtime, dict):
            errors.append(f"{label}: requires runtime_nonempty_reconciliation")
        else:
            if runtime.get("status") not in runtime_statuses:
                errors.append(f"{label}: invalid runtime reconciliation status")
            gate_ref = runtime.get("gate_ref")
            if not isinstance(gate_ref, str) or not gate_ref.strip():
                errors.append(f"{label}: runtime reconciliation requires gate_ref")
            elif not _resolve_contract_reference(gate_ref).is_file():
                errors.append(f"{label}: missing runtime gate {gate_ref}")
            for count_key in ("row_count", "tenant_count"):
                count = runtime.get(count_key)
                if not isinstance(count, int) or isinstance(count, bool) or count < 0:
                    errors.append(f"{label}: {count_key} must be a non-negative integer")
            if runtime.get("status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
                errors.append(
                    f"{label}: verified runtime reconciliation requires durable non-empty "
                    "production evidence and independent zero-difference reconciliation: "
                    + "; ".join(_runtime_reconciliation_errors(runtime, name))
                )
        expected_specification = (
            "specified"
            if evidence.get("status") in {"ddl_backed", "rejected_mislabeled"}
            else "provisional"
        ) if isinstance(evidence, dict) else None
        if asset.get("specification_status") != expected_specification:
            errors.append(
                f"{label}: specification_status must be {expected_specification!r} "
                f"for source evidence {evidence.get('status')!r}"
            )
        if asset.get("verification_status") not in {"unverified", "verified"}:
            errors.append(f"{label}: invalid verification_status")
        if asset.get("verification_status") == "verified" and not _runtime_reconciliation_verified(runtime, name):
            errors.append(f"{label}: final verification is forbidden without non-empty reconciliation")
    if seen != set(expected):
        errors.append(
            "commerce source dispositions differ from authoritative ODS overview: "
            f"missing={sorted(set(expected) - seen)}, extra={sorted(seen - set(expected))}"
        )
    observed_evidence_counts: dict[str, int] = {}
    for asset in assets:
        if not isinstance(asset, dict) or not isinstance(asset.get("source_evidence"), dict):
            continue
        evidence_status = asset["source_evidence"].get("status")
        if isinstance(evidence_status, str):
            observed_evidence_counts[evidence_status] = observed_evidence_counts.get(evidence_status, 0) + 1
    if scope.get("expected_source_evidence_counts") != observed_evidence_counts:
        errors.append(
            "commerce source evidence counts differ from the governed classification: "
            f"contract={scope.get('expected_source_evidence_counts')!r}, "
            f"observed={observed_evidence_counts!r}"
        )

    by_name = {asset.get("source_asset"): asset for asset in assets if isinstance(asset, dict)}
    discount = by_name.get("ods_trade_trade_discount_di", {})
    discount_entities = " ".join(discount.get("canonical_entities", []))
    required_benefit_entities = {
        "OrderBenefitApplication", "OrderBenefitAllocation", "OrderBenefitFunding"
    }
    if not all(entity in discount_entities for entity in required_benefit_entities):
        errors.append("commerce order discount must split application, allocation and funding")
    discount_fields = discount.get("field_dispositions")
    expected_discount_fields = {
        "id", "discount_no", "order_no", "sub_order_no", "buyer_id", "discount_type",
        "discount_code", "use_status", "amount", "feature", "create_time", "modify_time",
        "subsidy_info", "pt",
    }
    if not isinstance(discount_fields, dict) or set(discount_fields) != expected_discount_fields:
        errors.append("commerce order discount must govern every DDL field and partition field")
    elif any(
        not isinstance(rule, dict)
        or set(rule) != {"decision", "target", "rule"}
        or any(not isinstance(value, str) or not value.strip() for value in rule.values())
        for rule in discount_fields.values()
    ):
        errors.append("commerce order discount field dispositions must define decision, target and rule")
    else:
        if "quarantine" not in discount_fields["amount"]["rule"]:
            errors.append("commerce order discount amount must quarantine ambiguous money units")
        subsidy_rule = discount_fields["subsidy_info"]["rule"]
        if "exact funding sum" not in subsidy_rule or "positional guessing" not in subsidy_rule:
            errors.append("commerce order discount subsidy_info must reject guessed funders")
        if discount_fields["feature"]["decision"] != "reject_raw":
            errors.append("commerce order discount feature JSON must remain restricted evidence")
    if "sum" not in discount.get("semantic_rules", {}).get("money_or_quantity", ""):
        errors.append("commerce order discount must state exact allocation/funding sums")
    refund_discount = by_name.get("ods_refund_refund_discount_df", {})
    if "original allocation" not in " ".join(refund_discount.get("corrections", [])):
        errors.append("commerce refund discount must reference the original allocation")
    bad_credit_alias = by_name.get("ods_logistic_logistic_track_structure_di", {})
    if bad_credit_alias.get("decision") != "reject" or bad_credit_alias.get("model_status") != "rejected":
        errors.append("commerce duplicate logistics-as-credit alias must be rejected")
    card = by_name.get("ods_fin_bind_card_df", {})
    if "PAN" not in card.get("semantic_rules", {}).get("security", ""):
        errors.append("commerce card disposition must forbid PAN")
    for name in ("ods_inventory_sale_df", "ods_inventory_warehouse_df"):
        rules = by_name.get(name, {}).get("semantic_rules", {})
        if not all(term in rules.get("grain", "") for term in ("Warehouse", "Location", "Lot", "UOM")):
            errors.append(f"commerce inventory disposition {name} must retain exact dimensions")
    return errors


def game_disposition_status(
    inventory: dict[str, Any], contract: dict[str, Any] | None = None
) -> dict[str, Any]:
    contract = contract or load_game_source_dispositions()
    expected_count = len(authoritative_ods_domain_assets(inventory, "游戏"))
    assets = contract.get("assets", []) if isinstance(contract, dict) else []
    specified = [
        asset for asset in assets
        if isinstance(asset, dict) and asset.get("specification_status") == "specified"
    ]
    reconciled = [
        asset for asset in assets
        if isinstance(asset, dict)
        and _runtime_reconciliation_verified(
            asset.get("runtime_nonempty_reconciliation"), asset.get("source_asset", "")
        )
    ]
    verified = [
        asset for asset in reconciled if asset.get("verification_status") == "verified"
    ]
    denominator = expected_count or 1
    return {
        "game_source_asset_count": expected_count,
        "game_detailed_disposition_specified_count": len(specified),
        "game_runtime_nonempty_reconciled_count": len(reconciled),
        "game_final_disposition_verified_count": len(verified),
        "game_detailed_disposition_percent": round(len(specified) * 100.0 / denominator, 2),
        "game_runtime_nonempty_reconciled_percent": round(len(reconciled) * 100.0 / denominator, 2),
        "game_final_disposition_verified_percent": round(len(verified) * 100.0 / denominator, 2),
    }


